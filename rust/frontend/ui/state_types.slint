// Closed UI discriminants shared with the generated Rust API.
export enum Screen { hub, systems, favorite-systems, games, favorites, recents, search, search-results, settings, about, credits, update, rename, ra-login, file-browser, decks, deck, top-played, top-played-systems, music, none }
export enum GamesMode { browse, favorites, recents, search, deck, decks, top-played }
export enum SystemsMode { category, favorites, top-played }
// What a games-screen footer notes after the focused name.
// What a menu row is: something to pick, a section's name (never focused),
// an action set apart at the foot of a form list, or a context-menu row
// that turns the menu to one of its pages.
// `check-off` and `check-on` are rows that toggle a membership, drawn with
// an empty or filled box (the Add to deck page). `chosen` is a picker's
// current choice, marked with a check. `toggle-off` and `toggle-on` are a
// setting switched in place, drawn with a toggle switch. `slider` is a
// setting adjusted in place with Left and Right: a track of ten cells, its
// `detail` the value, 0 to 100.
export enum MenuRole { option, header, action, submenu, check-off, check-on, chosen, toggle-off, toggle-on, slider }
// A game's four built-in collections, in the Options strip's order.
export enum UserFlag { favorite, like, dislike, play-later }
// What the context menu is showing: its own rows, or the page one of them
// opened in their place.
export enum ContextPage { root, write-token, manage-game, manage-system, manage-category, manage-deck, edit-tile, discs, versions, alternates, add-to-deck }
// The on-screen keyboard's key kinds, and the Search screen's focus zones
// and what its side pane lists.
export enum KeyKind { char, space, backspace, shift, symbols, submit }
// What the rename screen names: a Hub tile, a new deck, or a deck.
export enum RenamePurpose { tile, new-deck, rename-deck }
export enum SearchZone { system, filter, keys, pane }
export enum SearchPane { none, recents, preview }
export enum FileBrowserMode { plain, images }
// The Credits screen: its list of components, or one component's text.
export enum CreditsPage { list, reading }
// The music player: its pages (the player, the open playlist, the
// library), the transport controls in row order, what the background slot
// is doing, an open playlist's repeat mode, and why a control cannot act.
export enum MusicPage { player, playlist, library }
export enum MusicControl { shuffle, previous, play-pause, next, repeat }
export enum PlaybackState { stopped, playing, paused }
export enum RepeatMode { off, all, one }
export enum MusicUnavailable { none, nothing-playing, no-playlist, not-supported, starting }
// What "Search here" limited a search to: a folder, a system's top level,
// a category's systems, or a built-in list (which one is named beside the
// scope). `none` is an unscoped search.
export enum SearchScope { none, folder, system, category, list }
// `controllers` is the page the Controls page's Controllers row opens, and
// `paired-controllers` the page its Paired controllers row opens in turn;
// neither is a root tile.
export enum SettingsPage { root, appearance, library, online, display, controls, language, about, controllers, paired-controllers }
export enum ContentState { ready, loading, empty, error }
// What Core's current UI event puts on screen (`ui` / `ui.changed`). A
// confirmation uses the decision dialog, a loader and a notice the header
// line; only a picker has a surface of its own.
export enum CoreUiKind { none, picker, confirm, loader, notice }
// The header line's app cue. A wait (`launching` to `cancelling`) follows
// the shared delay and hold; a confirmation shows at once for a fixed time.
export enum AppCue {
    none,
    launching, loading-list, loading-more, loading-progress, loading-launchers, loading-details, saving, starting, cancelling, unlinking,
    added-to-hub, saved-to-hub, removed-from-hub, token-written
}
export enum BootStatus { connecting, starting, migrating, reconnecting, loading, unreachable }
// What the header (and the screensaver) shows for a logo: Zaparoo's own,
// the user's image, or nothing.
export enum HeaderLogo { zaparoo, custom, none }
export enum DisabledReason { none, no-recent-games, no-internet, not-available, deck-missing }
export enum RowKind { header, field }
export enum ControlKind { none, picker, toggle, action, navigate, tri-toggle, info, slider, device }
// What a controller card says about its power (`zaparoo_app::controllers::
// Reading`), and where a Bluetooth device row stands: a found row's
// pairing (`DeviceState`), or a paired row's connection
// (`not-connected`). `none` is every other row.
export enum DeviceValue {
    none,
    wired, charging, charging-percent, charged, percent, level-empty, level-low, level-medium, level-full, level-unknown,
    found, pairing, paired, connected, not-connected, failed
}
// The Controllers page's search, for the status line over its found list
// (`zaparoo_app::controllers::Search`, with the adapter read from Core's
// device state).
export enum PairSearch { searching, pairing, adapter-off, failed }
// The charge a header pad glyph shows (`zaparoo_app::controllers::Fill`).
export enum PadFill { empty, low, half, full }
// One controller's battery in the header
// (`zaparoo_app::controllers::HeaderPad`): its glyph's charge, a charging
// mark after it, the warning color, and how many marks come before it.
export struct HeaderPad {
    fill: PadFill,
    charging: bool,
    low: bool,
    marks-before: int,
}
// Why pairing a device failed (`zaparoo_app::controllers::PairError`).
export enum PairFailure { none, pin-required, not-powered, timeout, rejected, not-found, failed }
export enum ActionStatus {
    none, optimizing, paused, running, indexed, imported,
    folders-ready, folder-opening, folder-saved, folder-cancelled, folder-denied, folder-failed, folder-revoked,
    launcher-ready, launcher-opening, launcher-detected, launcher-cancelled, launcher-denied, launcher-failed, launcher-unavailable,
    playtime-verified, playtime-unverified, online-linked, online-unlinked
}
export enum ScrollAction { up, down, page-prev, page-next }
// Game Info's manual page: shut, fetching, showing pages, or why it could
// not open. `closed` is the details themselves.
export enum ManualState { closed, loading, ready, too-large, failed }
// How a manual page sits in its box: as wide as it, or wholly inside it.
export enum ManualFit { width, page }
// The Online page's two list screens, and what the open one is doing.
export enum OnlineListKind { none, backups, activity }
// The RetroAchievements login screen: which field is up, and what the last
// login attempt came to.
export enum RaLoginStep { username, password }
export enum RaLoginStatus { idle, verifying, wrong-credentials, refused, unreachable, save-failed, unsupported }
// The launcher preference modal's pages, and what each of its rows is.
export enum LauncherPrefsPage { list, entry, add }
export enum LauncherPrefsRowKind { launcher, group, add, move, remove }
export enum OnlineListStatus { ready, loading, failed, empty, backing-up, restoring }
// Why a list failed to load, when Core's answer says.
export enum OnlineListFailure { other, unlinked, needs-warp }
export enum SetupAction { select, start, toggle, change }
export enum SetupKind { index, scrape }
export enum SetupPicker { systems, source }
export enum ScopeKind { all, category, system, systems, game, source, source-loading, header, selected }
export enum LogPhase { uploading, done, failed }
// The "pair a device" panel. `closed` is the resting value; the panel's
// own open flag is what mounts it.
export enum PairPhase { closed, starting, showing, paired, expired }
// The "link Online account" panel, on the same terms as pairing.
export enum OnlineLinkPhase { closed, starting, showing, linked, failed, expired }
export enum PressOwner { none, hub, systems, games, file-browser, settings, setup, context, list, online-list, letter, card-write, dialog, log, wake, update, launcher-prefs, core-picker, music }
export enum StatusKind {
    none, disconnected, reconnecting, connecting, core-error, indexing-paused,
    indexing, optimizing, importing-paused, importing, indexed-files,
    indexing-complete, import-failed, imported, playtime-warning, inbox,
    core-loader, core-notice,
}
export enum Orientation { horizontal, cw, ccw }
export enum VideoStandard { ntsc, pal }
export enum DialogKind { none, quit-confirm, quit-blocked, restart-setting, notice, core-version, first-run, hub-full, action-error, unlink-online, restore-online-backup, update-stop, ra-log-out, delete-deck, forget-controller, core-confirm, logo-support }
export enum DialogButton { ok, yes, no, retry, cancel, i-understand, start-media-update, link-account }
export enum ErrorKind { generic, launch, launch-repair, favorite, collection, deck-list, deck-update, deck-create, media-visibility, media-busy, add-to-hub, save-to-hub, media-index, media-scrape, media-scrapers, media-cancel, launcher, launcher-save, alternate-discovery, disc-list, version-list, qr-code, card-write, setting, pairing, online, backup, config-file, image-picker, music, bluetooth }

// Text adapters are for vocabulary/resource keys and focus identity only,
// never routing. Runtime decisions use the enums themselves.
export global StateTokens {
    public pure function page(page: SettingsPage) -> string {
        if (page == SettingsPage.appearance) { return "pageAppearance"; }
        if (page == SettingsPage.library) { return "pageLibraryData"; }
        if (page == SettingsPage.online) { return "pageOnline"; }
        if (page == SettingsPage.display) { return "pageDisplayInterface"; }
        if (page == SettingsPage.controls) { return "pageControlsInput"; }
        if (page == SettingsPage.language) { return "pageLanguage"; }
        if (page == SettingsPage.about) { return "pageSupportAbout"; }
        if (page == SettingsPage.controllers) { return "pageControllers"; }
        if (page == SettingsPage.paired-controllers) { return "pagePairedControllers"; }
        return "";
    }
    public pure function games(mode: GamesMode) -> string {
        if (mode == GamesMode.favorites) { return "favorites"; }
        if (mode == GamesMode.recents) { return "recents"; }
        if (mode == GamesMode.search) { return "search-results"; }
        if (mode == GamesMode.deck) { return "deck"; }
        if (mode == GamesMode.decks) { return "decks"; }
        if (mode == GamesMode.top-played) { return "top-played"; }
        return "games";
    }
    public pure function systems(mode: SystemsMode) -> string {
        if (mode == SystemsMode.top-played) { return "top-played-systems"; }
        return mode == SystemsMode.favorites ? "favorite-systems" : "systems";
    }
    public pure function setup(kind: SetupKind) -> string {
        return kind == SetupKind.scrape ? "scrape" : "index";
    }
    public pure function launcher-prefs-page(page: LauncherPrefsPage) -> string {
        if (page == LauncherPrefsPage.entry) { return "entry"; }
        if (page == LauncherPrefsPage.add) { return "add"; }
        return "list";
    }
    public pure function picker(picker: SetupPicker) -> string {
        return picker == SetupPicker.source ? "source" : "systems";
    }
}
