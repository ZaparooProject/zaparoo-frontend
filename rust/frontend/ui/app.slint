export global GamesView {
    // The mode picks the title, empty/loading copy, and back route.
    in-out property <GamesMode> mode: GamesMode.browse;
    out property <Screen> screen: self.mode == GamesMode.favorites ? Screen.favorites
        : (self.mode == GamesMode.recents ? Screen.recents
        : (self.mode == GamesMode.search ? Screen.search-results
        : (self.mode == GamesMode.deck ? Screen.deck
        : (self.mode == GamesMode.decks ? Screen.decks
        : (self.mode == GamesMode.top-played ? Screen.top-played : Screen.games)))));
    // Games: the system's display name, or the folder's own name below
    // the system root; the Deck screen: the deck's name. The flat lists
    // compose their titles in the view.
    in-out property <string> title: "";
    // The Deck screen: an item is picked up by Move.
    in-out property <bool> moving: false;
    // Search results limited to a category or the favorites: the title's
    // parts before and after the scope, which only the view can name.
    in-out property <SearchScope> search-scope: SearchScope.none;
    // The built-in list a list scope searches.
    in-out property <UserFlag> search-list: UserFlag.favorite;
    in-out property <string> search-category: "";
    in-out property <string> title-head: "";
    in-out property <string> title-tail: "";

    // The title as shown. Empty when a search has nothing to name.
    public pure function display-title() -> string {
        if (self.mode != GamesMode.search
            || (self.search-scope != SearchScope.category && self.search-scope != SearchScope.list)) {
            return self.title;
        }
        let scope = self.search-scope == SearchScope.category
            ? Labels.hub("category:" + self.search-category, self.search-category)
            : Labels.list-title(self.search-list);
        let lead = self.title-head == "" ? scope : @tr("{} · {}", self.title-head, scope);
        return self.title-tail == "" ? lead : @tr("{} · {}", lead, self.title-tail);
    }
    // Whether Options opens a menu on the focused row; the help bar offers
    // it only then.
    in-out property <bool> options-available: true;
    // Whether the screen has a Menu: not Recently played, and not a folder
    // read straight from disk.
    in-out property <bool> page-menu: true;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
    // Loaded rows, Core's totals and whether the total is final.
    in-out property <int> count: 0;
    in-out property <int> total-items: 0;
    in-out property <bool> total-known: true;
    in-out property <int> total-files: 0;
    // The active browse filter as one line ("Platformer +1"); empty without one.
    in-out property <string> filter-text: "";
    in-out property <bool> has-more: false;
    // A page fetch the user is waiting on (a wrap, jump or list tail).
    in-out property <bool> focus-ready: false;
    // The page on screen and its fit (src/games.rs render).
    in-out property <[GridCell]> cells: [];
    in-out property <int> selected-local: 0;
    in-out property <int> current-index: 0;
    in-out property <int> columns: 4;
    in-out property <int> rows: 3;
    in-out property <length> cell-width: 0px;
    in-out property <length> cell-height: 0px;
    in-out property <length> block-offset-x: 0px;
    in-out property <length> block-offset-y: 0px;
    in-out property <length> grid-y: 0px;
    in-out property <length> grid-height: 0px;
    in-out property <length> label-y: 0px;
    in-out property <length> label-height: 0px;
    in-out property <int> page: 0;
    in-out property <int> total-pages: 1;
    in-out property <bool> has-pages-above: false;
    in-out property <bool> has-pages-below: false;
    // The focused item's info line: the grid's footer, the detail pane's
    // fact rows and a text list's focused row all show it.
    in-out property <InfoLineData> info: { item-count: -1 };
    in-out property <int> activate-pulse: 0;
    in-out property <int> release-pulse: 0;
    // Folder changes reuse the mounted strip horizontally; page changes move vertically.
    in-out property <[GridCell]> folder-from-cells: [];
    in-out property <int> folder-from-index: 0;
    in-out property <bool> folder-slide: false;
    // Page swoop: the incoming page, its direction and the strip's
    // animated progress; slide-anim gates the post-commit snap.
    in-out property <[GridCell]> next-cells: [];
    in-out property <int> slide-dir: 1;
    in-out property <float> page-slide: 0;
    in-out property <bool> slide-anim: true;
    in-out property <int> transition-target-index: 0;
    in-out property <bool> cached-transition: false;
    // The fast-scroll rail: up while a hold runs fast and briefly after.
    // Letters are the scope's letter buckets (empty where letters mean
    // nothing, which leaves only the position marker); `rail-index` is
    // the current one (-1 on a leading folder) and `rail-letter` its label.
    in-out property <bool> rail-visible: false;
    in-out property <[string]> rail-letters: [];
    in-out property <int> rail-index: -1;
    in-out property <string> rail-letter: "";
    in-out property <float> rail-fraction: 0;
    // Detailed list: one overscan row on either side of the minimal viewport.
    in-out property <int> list-scroll-top: 0;
    // How the list follows the selection; see `BrowseList.glide`. The step
    // is in milliseconds, 0 for a tap's eased glide.
    in-out property <bool> list-glide: true;
    in-out property <int> list-step-ms: 0;
    in-out property <[GridCell]> list-rows: [];
    in-out property <int> list-sel: 0;
    in-out property <int> list-view-top: 0;
    in-out property <int> list-visible: 10;
    in-out property <length> list-row-height: 0px;
    in-out property <int> list-page: 0;
    in-out property <int> list-total-pages: 1;
    in-out property <bool> has-items-above: false;
    in-out property <bool> has-items-below: false;
    in-out property <string> detail-title: "";
    in-out property <string> detail-path: "";
    in-out property <image> detail-cover;
    in-out property <bool> detail-has-cover: false;
    in-out property <bool> detail-cover-absent: false;
    // The pane's place among the game's images when Left and Right step
    // them; a count under two shows nothing.
    in-out property <int> detail-image-index: 0;
    in-out property <int> detail-image-count: 0;
    // The image type the pane shows while it counts, for its label.
    in-out property <string> detail-image-kind: "";
    in-out property <color> detail-placeholder;
    in-out property <bool> detail-has-placeholder: false;
    in-out property <[DetailRow]> detail-rows: [];
    in-out property <bool> detail-loading: false;
    in-out property <bool> rapid-active: false;
    // The detail pane's painted art box, as the view last reported it.
    in-out property <int> detail-art-width: 0;
    in-out property <int> detail-art-height: 0;
}

// Pointer and page-cue input from the games-style screens.
export global GamesInput {
    callback cell-hovered(int);
    callback cell-clicked(int);
    callback cell-right-clicked(int);
    callback page-requested(int);
    callback wheel(int);
    // The list detail pane's painted art box, in pixels.
    callback detail-art-box(int, int);
}

// Context menu, View menu, letter picker, and card-writer state.
export global Overlays {
    callback pointer-choice(PressOwner, int, bool);
    // A click on a list panel's slider row: a step down (-1) or up (+1).
    callback slider-step(int);
    in-out property <bool> context-open: false;
    in-out property <[MenuEntry]> context-entries: [];
    in-out property <int> context-index: 0;
    // The repeat interval of the held key that moved `context-index`, 0
    // for a single press: how the rows scroll to follow it.
    in-out property <int> context-step-ms: 0;
    // The page the rows belong to. Pages carry no title: the row that
    // opened one already named it, and Back returns to the menu.
    in-out property <ContextPage> context-page: ContextPage.root;
    // A game's collections, toggled in a strip above the rows on the
    // menu's own page. Empty for anything that is not a game.
    in-out property <[FlagButton]> context-strip: [];
    // The strip button that has focus, or -1 while a row has it.
    in-out property <int> context-strip-index: -1;
    // The scene rect of the row or tile the menu is about; the scrim
    // hole and the panel placement follow it.
    in-out property <length> context-anchor-x: 0px;
    in-out property <length> context-anchor-y: 0px;
    in-out property <length> context-anchor-w: 0px;
    in-out property <length> context-anchor-h: 0px;
    // The anchored thing's own corner radius, so the scrim cuts its hole to
    // the real silhouette instead of leaving bright notches past the arcs.
    in-out property <length> context-anchor-radius: 0px;
    // Whether the focus zoom is on the anchored thing. A zoomed tile paints
    // larger than its cell rect, so the hole has to grow with it.
    in-out property <bool> context-anchor-zoomed: false;
    in-out property <bool> list-open: false;
    in-out property <string> list-title: "";
    in-out property <bool> launcher-saving: false;
    in-out property <bool> launcher-saving-visible: false;
    // Non-empty while the picker is choosing a settings value: its rows
    // and title read through the settings vocabulary rather than the
    // plain labels the other pickers carry.
    in-out property <string> list-setting-id: "";
    in-out property <[MenuEntry]> list-entries: [];
    // A form list: left-aligned rows with their value on the right,
    // section headers and footer actions, windowed by `ListModal`.
    in-out property <bool> list-form: false;
    in-out property <int> list-index: 0;
    in-out property <bool> letter-open: false;
    in-out property <[LetterBucket]> letter-buckets: [];
    in-out property <int> letter-index: 0;
    // The letter index for the picker: loading, ready with buckets, empty
    // (the list has no sections), or error (Core could not supply it).
    in-out property <ContentState> letter-state: ContentState.ready;
    out property <int> letter-columns: Sizing.fit-letter-columns(self.letter-buckets.length,
        Sizing.pct-w(78) - 2 * Sizing.pct-w(4), Sizing.pct-h(52), Sizing.pct-w(1));
    in-out property <bool> card-write-open: false;
    in-out property <string> card-write-key: "";
    // Pairing a device with Core: Rust owns the phase, the PIN Core
    // minted, the seconds left on it and the name the device reported.
    // The PIN is cleared the moment it stops being worth reading out, so
    // the panel can never show a stale one.
    in-out property <bool> pair-open: false;
    in-out property <PairPhase> pair-phase: PairPhase.closed;
    in-out property <string> pair-pin: "";
    in-out property <int> pair-expires-in: 0;
    in-out property <string> pair-client: "";
    // The Online account link panel: Core's code, the URL to open, and
    // the same URL with the code in it as a QR code.
    in-out property <bool> online-open: false;
    in-out property <OnlineLinkPhase> online-phase: OnlineLinkPhase.closed;
    in-out property <string> online-code: "";
    in-out property <string> online-url: "";
    in-out property <int> online-expires-in: 0;
    in-out property <image> online-qr;
    in-out property <int> online-qr-modules: 0;
    // True on a host that can open the link itself (Android): Accept opens
    // it instead of only scanning the code or typing it in elsewhere.
    in-out property <bool> online-can-open-url: false;
    // The Online page's cloud-backup list and remote-activity log: one
    // modal, rows composed by Rust.
    in-out property <bool> online-list-open: false;
    in-out property <OnlineListKind> online-list-kind: OnlineListKind.none;
    in-out property <OnlineListStatus> online-list-status: OnlineListStatus.ready;
    in-out property <OnlineListFailure> online-list-failure: OnlineListFailure.other;
    in-out property <string> online-list-note: "";
    in-out property <[OnlineListRow]> online-list-rows: [];
    in-out property <int> online-list-index: 0;
    // Settings > Library's launcher preference: one modal, three pages of
    // its own panel. `entry` is the entry the Entry page acts on.
    in-out property <bool> launcher-prefs-open: false;
    in-out property <LauncherPrefsPage> launcher-prefs-page: LauncherPrefsPage.list;
    in-out property <[LauncherPrefsRow]> launcher-prefs-rows: [];
    in-out property <int> launcher-prefs-index: 0;
    in-out property <bool> launcher-prefs-moving: false;
    in-out property <LauncherPrefsRow> launcher-prefs-entry;
    // QR write deep-link modal: the matrix image is rendered by Rust
    // at module resolution (quiet zone baked in) and scaled up
    // pixelated to the largest whole multiple.
    in-out property <bool> qr-open: false;
    in-out property <bool> qr-documentation: false;
    in-out property <image> qr-image;
    in-out property <int> qr-modules: 0;
    // Decision dialog: the confirm and action-error kinds plus the
    // commercial notice and first-run bodies. Kinds never stack;
    // the router's startup chain is strictly sequential: notice,
    // core_version, first_run.
    in-out property <bool> dialog-open: false;
    in-out property <DialogKind> dialog-kind: DialogKind.none;
    in-out property <ErrorKind> dialog-error: ErrorKind.generic;
    // Runtime text (minimum Core version and context); `DialogLabels` composes the
    // words from these so every dialog string can be translated.
    in-out property <string> dialog-detail: "";
    in-out property <string> dialog-arg: "";
    // `ErrorKind.launch-repair` only: Core's own reason code plus the
    // display names it named, so `DialogLabels` can pick per-reason
    // wording instead of the generic body every other kind uses.
    // `dialog-arg` carries Core's fallback message for this kind.
    in-out property <string> dialog-repair-reason: "";
    in-out property <string> dialog-repair-launcher: "";
    in-out property <string> dialog-repair-plugin: "";
    in-out property <[DialogButton]> dialog-buttons: [];
    in-out property <int> dialog-focus: 0;
    // Full-framebuffer CRT calibration pattern. Unlike normal modals,
    // this mounts outside the safe-area/rotation scene so its edge and
    // safe-area guides represent real scanout pixels.
    in-out property <bool> crt-calibration-open: false;
    in-out property <int> crt-h-offset: 0;
    in-out property <int> crt-v-offset: 0;
    // Analog width stretch (word2 H size) and the calibration
    // adjustment selector: false = position, true = size.
    in-out property <int> crt-h-size: 0;
    in-out property <bool> crt-size-mode: false;
}

// Settings: the root is a grid of six category tiles; a page is a card of
// rows over a two-line hint band carrying the focused row's description.
// A context-menu row's label, set from the leading edge. Drawn twice for the
// same reason as a list panel row. A row that turns the menu to a page
// carries a chevron at the trailing edge, and its label stops short of it.
component ContextRowBody inherits Rectangle {
    in property <string> label;
    in property <length> pad-x;
    in property <length> pad-end;
    in property <color> content-color;
    in property <int> weight;
    in property <bool> opens-page;
    in property <length> chevron;
    in property <length> inset;
    // A membership row ends in a box, filled while the row is checked.
    in property <bool> checkable: false;
    in property <bool> checked: false;

    property <length> box-line: Sizing.card-border-width * (Sizing.tier-240 ? 1 : 2);
    if root.checkable: Rectangle {
        x: parent.width - self.width - root.inset;
        y: (parent.height - self.height) / 2;
        width: root.chevron;
        height: self.width;
        border-radius: Sizing.radius-sm;
        border-width: root.box-line;
        border-color: root.content-color;

        if root.checked: Rectangle {
            x: 2 * root.box-line;
            y: 2 * root.box-line;
            width: parent.width - 4 * root.box-line;
            height: parent.height - 4 * root.box-line;
            border-radius: Math.max(0px, Sizing.radius-sm - 2 * root.box-line);
            background: root.content-color;
        }
    }

    if root.opens-page: Image {
        x: parent.width - self.width - root.inset;
        y: Sizing.snap((parent.height - self.height) / 2);
        width: root.chevron;
        height: self.width;
        source: GlyphSource.glyph("icons/NavRight", Math.max(1px, self.width), root.content-color);
    }

    Text {
        x: root.pad-x;
        y: Sizing.snap((parent.height - self.height) / 2);
        width: Math.max(0px, parent.width - root.pad-x - root.pad-end);
        overflow: elide;
        text: root.label;
        color: root.content-color;
        font-size: Sizing.font-caption;
        font-weight: root.weight;
    }
}

component SettingsScreen inherits Rectangle {
    in property <bool> outgoing: false;
    property <SettingsPage> page: root.outgoing ? SettingsView.outgoing-page : SettingsView.page;
    property <bool> root-grid: root.page == SettingsPage.root;
    property <[SettingsRow]> rows: root.outgoing ? SettingsView.outgoing-rows : SettingsView.rows;
    property <int> index: root.outgoing ? SettingsView.outgoing-index : SettingsView.index;
    property <length> rows-height: root.outgoing ? SettingsView.outgoing-rows-height : SettingsView.rows-height;
    property <length> rows-clip-height: root.outgoing ? SettingsView.outgoing-rows-clip-height : SettingsView.rows-clip-height;
    property <length> scroll: root.outgoing ? SettingsView.outgoing-scroll : SettingsView.scroll;
    property <length> rows-content-h: root.rows.length > 0
        ? root.rows[root.rows.length - 1].y-offset + root.rows[root.rows.length - 1].height
        : 0px;

    TopStatusStrip {
        x: 0;
        y: Sizing.header-bottom + Layout.top-margin;
        height: Layout.strip-height;
        slot-margin: Layout.slot-margin;
        title: SettingsLabels.page-title(root.page);
        show-page-counter: !root.root-grid && !Sizing.crt;
        page-indicator-mode: true;
        item-position-mode: true;
        current-item: SettingsView.field-index;
        total-items: SettingsView.field-count;
        has-pages-above: root.scroll > 0px;
        has-pages-below: root.scroll + root.rows-clip-height < root.rows-content-h + 2 * root.pad;
        page-requested(delta) => { SettingsInput.page-requested(delta); }
        visible: Layout.top-strip-visible;
    }

    // Root: the category tiles, on the shared grid.
    if root.root-grid: PagedGridView {
        x: 0;
        y: SettingsView.grid-y;
        height: SettingsView.grid-height;
        cells: SettingsView.cells;
        press-held: PressFeedback.active(PressOwner.settings, root.index);
        focus-scope: "settings";
        columns: SettingsView.columns;
        cell-width: SettingsView.cell-width;
        cell-height: SettingsView.cell-height;
        block-offset-x: SettingsView.block-offset-x;
        block-offset-y: SettingsView.block-offset-y;
        left-inset: Sizing.hub-grid-side-inset;
        top-inset: Sizing.hub-grid-top-inset;
        column-gap: Sizing.hub-grid-column-gap;
        row-gap: Sizing.hub-grid-row-gap;
        selected-local: root.index;
        section-focused: !Overlays.list-open;
        focus-ready: true;
        card-radius: Layout.card-radius;
        cell-hovered(i) => { SettingsInput.cell-hovered(i); }
        cell-clicked(i) => { SettingsInput.cell-clicked(i); }
    }

    // The focused category is named under the grid, not inside the tile;
    // the tiles carry art only.
    if root.root-grid: ActiveLabel {
        x: 0;
        // Above 240p, 8% below the label holds the bar's 6% and a gap.
        y: parent.height - (Sizing.tier-240 ? Sizing.help-bar-height
            : Sizing.pct-h(8) - Sizing.pct-h(6) + Sizing.help-bar-band) - self.height;
        height: Sizing.tier-240 ? Sizing.hub-active-label-height : Sizing.pct-h(7);
        text: (root.index >= 0 && root.index < SettingsView.cells.length)
            ? SettingsLabels.label(SettingsView.cells[root.index].label-key)
            : "";
    }

    // Page: rows in a card, with the hint band pinned to its bottom.
    // The card carries its own margins rather than the browse profile's
    // card values, which belong to whichever browse view was last shown.
    property <length> card-x: Sizing.snap((self.width - self.card-w) / 2);
    property <length> card-y: SettingsView.card-y;
    property <length> card-w: Math.min(self.width - 2 * Sizing.pct-w(3), Sizing.pct-w(70));
    property <length> card-h: SettingsView.card-height;
    // One lip on all four sides, and the same value again either side of
    // the hint rule; see docs/style.md, "Surface containment". It is the
    // surface inset in whole pixels, the figure
    // `zaparoo_app::settings::page_geometry` took out of the rows viewport.
    property <length> pad: SettingsView.card-pad;
    property <length> row-h: Sizing.pct-h(8);
    // Descriptions are authored to fit two lines at the narrowest tier we
    // ship (docs/content-style.md's length budget is the 240p card), so
    // every wider tier fits them on one and a second reserved line is just
    // a blank band holding the rows up. The reservation is fixed per tier
    // rather than per row: it sets the rows viewport, and a band that grew
    // and shrank with the focused row's description would reflow the list
    // under the cursor.
    property <length> hint-h: SettingsView.hint-height;
    property <string> hint: root.index < 0 || root.index >= root.rows.length ? ""
        : !root.rows[root.index].enabled && SettingsLabels.disabled-reason(root.rows[root.index].id) != ""
            ? SettingsLabels.disabled-reason(root.rows[root.index].id)
            : SettingsLabels.description(root.rows[root.index].id);
    property <length> hint-y: self.card-h - self.pad - self.hint-h;
    property <length> hint-rule-y: self.hint-y - self.pad - Sizing.stroke(1);

    // The outgoing copy of a page turn never reports; the card it shows
    // is the one already baked.
    if !root.outgoing: GlassCard {
        shown: !root.root-grid;
        x: root.card-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        radius: Sizing.radius-md;
    }
    if !root.root-grid: Rectangle {
        x: root.card-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        background: Backdrop.glass ? transparent : Theme.surface-card;
        // The settings card is not a browse view, so it takes the shared
        // radius rather than whichever profile the last browse screen left
        // in `Layout` -- same reason it carries its own margins.
        border-radius: Sizing.radius-md;
        border-width: Sizing.card-border-width;
        border-color: Theme.border-mid;
        clip: true;

        // Rows stack from the top inside a clipped viewport; a busy
        // action row is taller, so Rust stacks the offsets and scrolls
        // the band to keep the focused row on screen. The fill travels
        // with the rows (below), so a row past the edge slides into view
        // under it; only a jump of more than a viewport (a wrap) snaps.
        row-scroll := ScrollOffset {
            target: root.scroll;
            step: root.rows-height;
            reveal: true;
            duration: Motion.scroll-ms;
            focus-start: root.rows[root.index].y-offset;
            focus-size: root.rows[root.index].height;
            viewport: root.rows-height;
            scope: StateTokens.page(root.page) + ":" + Motion.epoch;
        }
        // The band runs from the card's frame to one clear line over the
        // hint rule, so rows leave under those edges rather than under a
        // margin inside them and never abut the rule.
        rows-band := Rectangle {
            x: root.pad;
            y: Sizing.card-border-width;
            width: root.card-w - 2 * root.pad;
            height: root.hint-rule-y - Sizing.stroke(1) - self.y;
            clip: true;

        // The fill and the rows hang off one scrolled parent, positioned
        // against where the band is going to settle rather than against
        // the offset that is still moving. So the cursor animates only the
        // step the scroll does not already absorb -- a move that pulls the
        // list up by exactly one row leaves the fill where it is, which is
        // what it looks like on screen -- and whatever the scroll animates
        // on top is a rigid translation over rows and fill together.
        // Chasing the live offset instead made the fill lag the row it was
        // inverting, so the covered band grew and shrank for the length of
        // every scroll.
        Rectangle {
            y: root.pad - rows-band.y + root.scroll - row-scroll.offset;

        sel := SelectionCursor {
            radius: Layout.row-radius;
            activate-pulse: SettingsView.activate-pulse;
            release-pulse: SettingsView.release-pulse;
            screen-settling: Shell.active-screen != Screen.settings;
            press-held: PressFeedback.active(PressOwner.settings, root.index);
            // Toggles answer with their knob slide, not a flash.
            flash-enabled: root.index >= 0 && root.index < root.rows.length
                && root.rows[root.index].control != ControlKind.toggle;
            target: { x: 0px,
                y: root.index >= 0 && root.index < root.rows.length ? root.rows[root.index].y-offset - root.scroll : 0px,
                w: rows-band.width,
                h: root.index >= 0 && root.index < root.rows.length ? root.rows[root.index].height : 0px,
                column: 0, row: root.index,
                // The scroll position is part of the scope, so a move that
                // scrolls the band snaps instead of gliding. The rows under
                // the fill jump when the band scrolls, so the fill has to
                // jump with them: gliding left it growing or shrinking to
                // the new row's height in place, over rows that had already
                // moved. Browse lists and the picker key their scope the
                // same way; the settings card was the one that did not.
                scope: StateTokens.page(root.page) + ":" + root.scroll / 1px,
                valid: root.index >= 0 && root.index < root.rows.length };
        }
        for row[i] in root.rows: Rectangle {
            x: 0;
            y: row.y-offset - root.scroll;
            height: row.height;

            // The shared group heading, not a smaller private one: a band
            // title is a label-colored line on a hairline rule at body
            // size everywhere else in the app, and the settings card is
            // where most of them appear.
            if row.kind == RowKind.header: SectionHeader {
                height: parent.height;
                label: SettingsLabels.label(row.id);
            }

            property <bool> lit: sel.fill-bottom > self.y && sel.fill-top < self.y + self.height;

            if row.kind == RowKind.field: SettingsRowView {
                entry: row;
                focused: false;
            }
            // The same row again, colored as selected and clipped to the
            // fill, so the inversion boundary is the fill's own edge.
            if row.kind == RowKind.field && lit: SelectionClip {
                radius: Layout.row-radius;
                row-top: parent.y; row-height: parent.height;
                fill-top: sel.fill-top; fill-bottom: sel.fill-bottom;
                fill: sel.fill;
                SettingsRowView {
                    entry: row;
                    focused: true;
                    flashing: sel.flashing;
                }
            }

            TouchArea {
                enabled: row.kind == RowKind.field && row.enabled;
                mouse-cursor: pointer;
                changed has-hover => {
                    if (self.has-hover) { SettingsInput.row-hovered(i); }
                }
                clicked => { SettingsInput.row-clicked(i); }
            }
        }
        }
        }

        // Hint band: the focused row's own description. The rows scroll
        // and clip under it, so the boundary carries a structural rule,
        // full card width, with the card's own lip either side of it.
        Divider {
            x: 0;
            y: root.hint-rule-y;
            width: parent.width;
        }
        Text {
            x: rows-band.x;
            y: root.hint-y;
            width: rows-band.width;
            height: root.hint-h;
            wrap: word-wrap;
            overflow: elide;
            text: root.hint;
            color: Theme.text-label;
            font-size: Sizing.font-body;
        }
    }
}


// One Menu chip: a page action on the page, worded in the muted label
// color until focus lands on it. It has no fill or border of its own, so
// the row reads as part of the header; the row's ring is the focus mark.
// A chip is as wide as its words; only a row too long for the screen
// squeezes its chips, which then elide.
component MenuChip inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <length> pad;
    property <percent> zoom: Motion.enabled ? Motion.focus-zoom : 100%;
    callback clicked();

    preferred-width: label.preferred-width + 2 * root.pad;
    max-width: self.preferred-width;
    min-width: 4 * root.pad;
    // The focus zoom a tile has, where the renderer draws transforms. Where
    // it does not, type keeps its size and the row's ring grows instead.
    transform-scale-x: !Motion.zoom-by-size && root.focused ? root.zoom : 100%;
    transform-scale-y: !Motion.zoom-by-size && root.focused ? root.zoom : 100%;
    animate transform-scale-x, transform-scale-y {
        duration: Motion.dur(Motion.zoom-ms);
        easing: ease-out-quad;
    }
    label := Text {
        x: root.pad;
        width: Math.max(0px, parent.width - 2 * root.pad);
        text: root.text;
        color: root.focused ? Theme.text-primary : Theme.text-label;
        font-size: Sizing.font-body;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        enabled: Shell.mouse-enabled;
        clicked => { root.clicked(); }
    }
}

// The Menu chip row, from `side-inset`: the Menu button's glyph, which is
// the way in (the d-pad never walks into the row), then the chips. Rust
// publishes the chips and the focus; the row draws them, and one ring
// glides between chips the way it does between tiles.
component MenuChipRow inherits Rectangle {
    in property <[MenuEntry]> chips;
    in property <length> side-inset;
    property <length> pad: Sizing.surface-pad;
    property <length> glyph-size: GlyphSource.side(Sizing.pct-h(4));
    property <percent> zoom: Motion.enabled ? Motion.focus-zoom : 100%;
    property <float> ring-grow: Motion.zoom-by-size ? root.zoom - 100% : 0%;
    property <bool> has-focus: PageBar.focused && PageBar.index >= 0 && PageBar.index < root.chips.length;
    // The focused chip's span, reported by the chip, since the layout owns it.
    property <length> focus-x;
    property <length> focus-w;

    HorizontalLayout {
        padding-left: root.side-inset;
        padding-right: root.side-inset;
        spacing: root.pad;
        alignment: start;
        Image {
            y: (root.height - self.height) / 2;
            width: root.glyph-size;
            height: root.glyph-size;
            source: GlyphSource.glyph(Buttons.key("ButtonY"), root.glyph-size, Theme.text-label);
        }
        for chip[i] in root.chips: MenuChip {
            text: Labels.menu(chip.label-key, chip.label);
            pad: root.pad;
            focused: PageBar.focused && PageBar.index == i;
            clicked => { PageBarInput.chip-clicked(i); }
            init => { self.report(); }
            changed focused => { self.report(); }
            changed x => { self.report(); }
            changed width => { self.report(); }
            function report() {
                if (self.focused) {
                    root.focus-x = self.x;
                    root.focus-w = self.width;
                }
            }
        }
    }

    // Scales about the same center as the focused chip, so the ring stays on it.
    FocusCursor {
        transform-scale-x: !Motion.zoom-by-size && root.has-focus ? root.zoom : 100%;
        transform-scale-y: !Motion.zoom-by-size && root.has-focus ? root.zoom : 100%;
        animate transform-scale-x, transform-scale-y {
            duration: Motion.dur(Motion.zoom-ms);
            easing: ease-out-quad;
        }
        glide-size: true;
        target: {
            x: root.focus-x - root.focus-w * root.ring-grow / 2,
            y: -root.height * root.ring-grow / 2,
            w: root.focus-w * (1 + root.ring-grow),
            h: root.height * (1 + root.ring-grow),
            column: PageBar.index, row: 0, scope: "chips:" + root.chips.length,
            valid: root.has-focus
        };
    }
}

// Hub screen: one paged grid of square tiles between the
// header and the help bar, the focused entry's caption under it with the
// page cue in the footer's right slot, and the in-screen empty or failed
// cue. Rust owns the entries, the cursor and the geometry.
component HubScreen inherits Rectangle {
    in property <bool> gated: false;
    property <bool> error: HubView.hub-error != "";

    // The Menu chip row, under the header. Its band is already out of the
    // grid's budget.
    MenuChipRow {
        x: 0;
        y: Sizing.header-bottom + Sizing.menu-row-gap;
        height: Sizing.menu-row-height;
        chips: PageBar.hub-chips;
        // On the header's margin, lined up with the logo above it.
        side-inset: Sizing.header-side-margin;
        visible: !root.gated && PageBar.shown(PageBar.hub-chips);
    }

    strip := PageStrip {
        y: HubView.grid-y;
        height: HubView.grid-height - Sizing.label-raise;
        visible: !root.gated && !root.error;
        page-slide: HubView.page-slide;
        slide-anim: HubView.slide-anim;
        slide-dir: HubView.slide-dir;

        grid := PagedGridView {
            x: 0;
            y: 0;
            height: HubView.grid-height;
            cells: HubView.cells;
            press-held: PressFeedback.active(PressOwner.hub, HubView.selected-local);
            focus-scope: "hub:" + HubView.page;
            focus-motion: HubView.page-slide == 0 && !HubView.cached-transition;
            columns: HubView.columns;
            cell-width: HubView.cell-width;
            cell-height: HubView.cell-height;
            block-offset-x: HubView.block-offset-x;
            block-offset-y: HubView.block-offset-y;
            left-inset: Sizing.hub-grid-side-inset;
            top-inset: Sizing.hub-grid-top-inset;
            column-gap: Sizing.hub-grid-column-gap;
            row-gap: Sizing.hub-grid-row-gap;
            selected-local: HubView.cached-transition ? -1 : HubView.selected-local;
            focus-art: HubView.focus-art;
            focus-art-muted: HubView.focus-art-muted;
            focus-art-local: HubView.focus-art-local;
            ring-suppressed: Overlays.context-open;
            // Focus is on the Menu chip row: the tile drops its zoom, tint and
            // focused cover as well as its ring.
            section-focused: !PageBar.focused;
            focus-ready: HubView.focus-ready;
            held-local: HubView.cached-transition ? -1 : HubView.held-local;
            move-origins: HubView.move-origins;
            move-pulse: HubView.move-pulse;
            compact-padding: true;
            card-radius: Sizing.radius-md;
            skip-empty-cells: !HubView.move-armed;
            caption-for(cell) => { return Labels.hub-tile(cell.label-key, cell.name, cell.custom-name); }
            cell-hovered(i) => { HubInput.cell-hovered(i); }
            cell-clicked(i) => { HubInput.cell-clicked(i); }
            cell-right-clicked(i) => { HubInput.cell-right-clicked(i); }
            wheel(delta) => { HubInput.wheel(delta); }
        }
        PagedGridView {
            y: strip.incoming-y;
            height: HubView.grid-height;
            cells: HubView.next-cells;
            columns: HubView.columns;
            cell-width: HubView.cell-width;
            cell-height: HubView.cell-height;
            block-offset-x: HubView.block-offset-x;
            block-offset-y: HubView.block-offset-y;
            left-inset: Sizing.hub-grid-side-inset;
            top-inset: Sizing.hub-grid-top-inset;
            column-gap: Sizing.hub-grid-column-gap;
            row-gap: Sizing.hub-grid-row-gap;
            selected-local: HubView.move-armed ? HubView.transition-target-index : -1;
            held-local: HubView.move-armed ? HubView.transition-target-index : -1;
            focus-motion: false;
            compact-padding: true;
            card-radius: Sizing.radius-md;
            caption-for(cell) => { return Labels.hub-tile(cell.label-key, cell.name, cell.custom-name); }
        }
    }

    // Footer row: the focused entry's name, with the page cue reserved in
    // the right corner (the same inset paid on the left for symmetry).
    label := ActiveLabel {
        x: 0;
        y: HubView.label-y - Sizing.label-raise;
        height: HubView.label-height;
        side-inset: indicator.width + Sizing.hub-grid-side-inset;
        text: Labels.hub-tile(HubView.label-key, HubView.label-name, HubView.label-custom);
        tags: Labels.hub-reason(HubView.label-reason);
        visible: !root.gated && HubView.label-visible && !PageBar.focused;
    }

    indicator := FooterIndicator {
        right-margin: Sizing.hub-grid-side-inset;
        cue-y: Sizing.snap(label.y + (label.height - self.height) / 2);
        current-page: HubView.page;
        total-pages: HubView.total-pages;
        has-pages-above: HubView.has-pages-above;
        has-pages-below: HubView.has-pages-below;
        visible: label.visible;
        page-requested(delta) => { HubInput.page-requested(delta); }
    }

    // Indexing starts on its own, so a first run's empty Hub names the
    // operation instead of reading as a failure report.
    StateCue {
        x: 0;
        y: HubView.grid-y;
        height: HubView.grid-height;
        state: root.error ? ContentState.error : ((HubView.loaded && HubView.catalog-empty) ? ContentState.empty : ContentState.ready);
        empty-text: HubView.indexing ? @tr("Updating the media database") : @tr("No games found yet");
        empty-detail: HubView.indexing
            ? @tr("Your games appear here as Core finds them.")
            : @tr("Update media database in Settings > Library.");
    }
}

// Systems screen: the three-slot top strip, the
// paged grid of logo tiles between it and the footer caption, and the
// state cue. Rust projects the rows and owns the cursor; the swoop
// strip slides one page period when a page turns.
component SystemsScreen inherits Rectangle {
    in property <bool> gated: false;
    property <bool> list-layout: Shell.systems-list-layout;
    property <bool> list-only: Shell.systems-list-only;
    property <bool> tate-list: self.list-layout && Shell.orientation != Orientation.horizontal;
    property <ContentState> state: SystemsView.error != "" ? ContentState.error
        : (SystemsView.loading ? ContentState.loading : (SystemsView.count == 0 ? ContentState.empty : ContentState.ready));
    property <bool> gate-hide: root.gated || SystemsView.loading || cue.loading-visible || SystemsView.error != "";
    property <bool> page-cue-in-footer: Layout.page-cue-in-footer;
    property <bool> show-grid-page-cue: !root.list-layout && !root.page-cue-in-footer;
    property <bool> show-top-page-cue: root.show-grid-page-cue || (root.list-layout && !root.page-cue-in-footer);
    property <bool> favorites: SystemsView.mode == SystemsMode.favorites;
    property <bool> top-played: SystemsView.mode == SystemsMode.top-played;
    property <string> title: root.top-played ? @tr("Top played")
        : (root.favorites
            ? Labels.list-title(Shell.active-list)
            : Labels.hub("category:" + SystemsView.category, SystemsView.category));
    property <string> count-text: SystemsView.count <= 0 ? ""
        : (Sizing.tier-240
            ? Labels.count(SystemsView.count)
            : (root.favorites
                ? Labels.list-systems(Shell.active-list, SystemsView.count)
                : @tr("{} systems", Labels.count(SystemsView.count))));

    TopStatusStrip {
        x: 0;
        y: Sizing.header-bottom + Layout.top-margin;
        height: Layout.strip-height;
        slot-margin: Layout.slot-margin;
        title: root.title;
        current-page: root.list-layout ? SystemsView.list-page : SystemsView.page;
        total-pages: root.list-layout ? SystemsView.list-total-pages : SystemsView.total-pages;
        total-text: root.count-text;
        show-page-counter: root.show-top-page-cue;
        page-indicator-mode: root.show-top-page-cue;
        item-position-mode: root.list-layout;
        current-item: SystemsView.current-index;
        total-items: SystemsView.count;
        page-indicator-chevron-size: Layout.grid-page-chevron-size;
        has-pages-above: root.list-layout ? SystemsView.has-items-above : SystemsView.has-pages-above;
        has-pages-below: root.list-layout ? SystemsView.has-items-below : SystemsView.has-pages-below;
        visible: !root.gate-hide && Layout.top-strip-visible;
        page-requested(delta) => { SystemsInput.page-requested(delta); }
    }

    // The Menu chip row, under the strip.
    MenuChipRow {
        x: 0;
        y: Sizing.header-bottom + Layout.top-margin + Layout.strip-height + Sizing.menu-row-gap;
        height: Sizing.menu-row-height;
        chips: PageBar.systems-chips;
        side-inset: Layout.slot-margin;
        visible: !root.gate-hide && PageBar.shown(PageBar.systems-chips);
    }

    // The current and the incoming page in the shared page-turn strip.
    if !root.list-layout: systems-strip := PageStrip {
        x: 0;
        y: SystemsView.grid-y;
        height: SystemsView.grid-height - Sizing.label-raise;
        visible: !root.gate-hide;
        page-slide: SystemsView.page-slide;
        slide-anim: SystemsView.slide-anim;
        slide-dir: SystemsView.slide-dir;

        PagedGridView {
            x: 0;
            y: 0;
            cells: SystemsView.cells;
            focus-scope: StateTokens.systems(SystemsView.mode) + ":" + SystemsView.page;
            focus-motion: SystemsView.page-slide == 0 && !SystemsView.cached-transition;
            columns: SystemsView.columns;
            cell-width: SystemsView.cell-width;
            cell-height: SystemsView.cell-height;
            block-offset-x: SystemsView.block-offset-x;
            block-offset-y: SystemsView.block-offset-y;
            left-inset: Layout.grid-left-inset;
            top-inset: Layout.grid-top-inset;
            column-gap: Layout.grid-column-gap;
            row-gap: Layout.grid-row-gap;
            selected-local: SystemsView.cached-transition ? -1 : SystemsView.selected-local;
            focus-art: SystemsView.focus-art;
            focus-art-muted: SystemsView.focus-art-muted;
            focus-art-local: SystemsView.focus-art-local;
            ring-suppressed: Overlays.context-open;
            // Focus is on the Menu chip row: the tile drops its zoom, tint and
            // focused cover as well as its ring.
            section-focused: !PageBar.focused;
            focus-ready: SystemsView.focus-ready;
            press-held: PressFeedback.active(PressOwner.systems, SystemsView.selected-local);
            card-radius: Layout.card-radius;
            caption-for(cell) => { return cell.name; }
            cell-hovered(i) => { SystemsInput.cell-hovered(i); }
            cell-clicked(i) => { SystemsInput.cell-clicked(i); }
            cell-right-clicked(i) => { SystemsInput.cell-right-clicked(i); }
            wheel(delta) => { SystemsInput.wheel(delta); }
        }
        PagedGridView {
            x: 0;
            y: systems-strip.incoming-y;
            cells: SystemsView.next-cells;
            columns: SystemsView.columns;
            cell-width: SystemsView.cell-width;
            cell-height: SystemsView.cell-height;
            block-offset-x: SystemsView.block-offset-x;
            block-offset-y: SystemsView.block-offset-y;
            left-inset: Layout.grid-left-inset;
            top-inset: Layout.grid-top-inset;
            column-gap: Layout.grid-column-gap;
            row-gap: Layout.grid-row-gap;
            selected-local: -1;
            focus-ready: false;
            card-radius: Layout.card-radius;
            caption-for(cell) => { return cell.name; }
        }
    }

    // Detailed list: BrowseListDetailView over the systems list profile.
    property <length> list-card-x: Layout.card-side-margin;
    property <length> list-card-y: Sizing.header-bottom + Layout.top-margin + Layout.strip-height
        + (PageBar.shown(PageBar.systems-chips) ? Sizing.menu-row-block : 0px) + Layout.card-top-margin;
    property <length> list-card-w: self.width - 2 * self.list-card-x;
    property <length> list-card-h: self.height - self.list-card-y - (Sizing.tier-240 ? Sizing.help-bar-height + Layout.card-bottom-margin - Sizing.help-bar-band : Layout.card-bottom-margin);

    // Where the list card sits, for a glass background. Reported whenever
    // the list layout is on, loading or not, so the darker card area stays
    // put while the rows load.
    GlassCard {
        shown: root.list-layout;
        x: root.list-card-x;
        y: root.list-card-y;
        width: root.list-card-w;
        height: root.list-card-h;
        radius: Layout.card-radius;
    }

    if root.list-layout && !root.list-only && !root.gate-hide: BrowseListDetailView {
        glass: Backdrop.glass;
        x: root.list-card-x;
        y: root.list-card-y;
        width: root.list-card-w;
        height: root.list-card-h;
        rows: SystemsView.list-rows;
        model-top: SystemsView.list-view-top;
        glide: SystemsView.list-glide;
        step: SystemsView.list-step-ms * 1ms;
        scroll-top: SystemsView.list-scroll-top;
        scope: StateTokens.systems(SystemsView.mode) + ":" + SystemsView.category;
        selected: SystemsView.list-sel;
        focus-ready: SystemsView.focus-ready && !PageBar.focused;
        activate-pulse: SystemsView.activate-pulse;
        release-pulse: SystemsView.release-pulse;
        settling: Shell.active-screen != SystemsView.screen;
        row-height: SystemsView.list-row-height;
        detail-title: SystemsView.detail-title;
        show-title: true;
        cover: SystemsView.detail-cover;
        has-cover: SystemsView.detail-has-cover;
        cover-exact: SystemsView.detail-cover-exact;
        // Whole pixels inside the box: the logo must never pass it.
        art-box(w, h) => { SystemsInput.detail-art-box(Math.floor(w / 1px), Math.floor(h / 1px)); }
        wordmark: SystemsView.detail-wordmark;
        placeholder-key: "icons/Console";
        detail-rows: SystemsView.detail-rows;
        row-hovered(i) => { SystemsInput.cell-hovered(i); }
        row-clicked(i) => { SystemsInput.cell-clicked(i); }
        row-right-clicked(i) => { SystemsInput.cell-right-clicked(i); }
        wheel(delta) => { SystemsInput.wheel(delta); }
    }

    // Text-only list: BrowseList standalone, no detail pane.
    if root.list-only && !root.gate-hide: BrowseList {
        glass: Backdrop.glass;
        x: root.list-card-x;
        y: root.list-card-y;
        width: root.list-card-w;
        height: root.list-card-h;
        show-chrome: true;
        rows: SystemsView.list-rows;
        model-top: SystemsView.list-view-top;
        glide: SystemsView.list-glide;
        step: SystemsView.list-step-ms * 1ms;
        scroll-top: SystemsView.list-scroll-top;
        scope: StateTokens.systems(SystemsView.mode) + ":" + SystemsView.category;
        selected: SystemsView.list-sel;
        focus-ready: SystemsView.focus-ready;
        activate-pulse: SystemsView.activate-pulse;
        release-pulse: SystemsView.release-pulse;
        settling: Shell.active-screen != SystemsView.screen;
        row-height: SystemsView.list-row-height;
        row-hovered(i) => { SystemsInput.cell-hovered(i); }
        row-clicked(i) => { SystemsInput.cell-clicked(i); }
        row-right-clicked(i) => { SystemsInput.cell-right-clicked(i); }
        wheel(delta) => { SystemsInput.wheel(delta); }
    }

    // Footer: the focused system's name, with the count and page cue
    // in the corners on CRT. Digital counts remain in the top strip.
    property <length> label-y: root.height - (Sizing.tier-240 ? Sizing.help-bar-height : Layout.active-label-bottom-margin) - Layout.active-label-height;
    property <length> footer-left-inset: Math.ceil(footer-count-measure.preferred-width / 1px) * 1px + Layout.bottom-status-left-margin;
    property <length> footer-right-inset: footer-indicator.width + Layout.bottom-status-right-margin;

    footer-count-measure := Text {
        visible: false;
        text: root.count-text;
        font-size: Sizing.font-section;
    }

    if !root.list-layout: ActiveLabel {
        x: 0;
        y: root.label-y - Sizing.label-raise;
        height: Layout.active-label-height;
        side-inset: root.page-cue-in-footer
            ? (Layout.top-strip-visible ? root.footer-right-inset : Math.max(root.footer-left-inset, root.footer-right-inset))
            : Layout.slot-margin;
        text: SystemsView.label-name;
        tags: root.top-played
            ? (SystemsView.label-count >= 0 ? @tr("{n} game" | "{n} games" % SystemsView.label-count) : "")
            : (root.favorites
                ? (SystemsView.label-count >= 0 ? Labels.list-count(Shell.active-list, SystemsView.label-count) : "")
                : (SystemsView.label-hidden ? @tr("Hidden") : ""));
        visible: !root.gate-hide && !PageBar.focused;
    }

    if !root.list-layout && !Layout.top-strip-visible && root.page-cue-in-footer && root.count-text != "": Text {
        x: Layout.bottom-status-left-margin;
        y: Sizing.snap(root.label-y + (Layout.active-label-height - self.height) / 2) - Sizing.label-raise;
        width: root.footer-left-inset - Layout.bottom-status-left-margin;
        height: Sizing.font-section;
        vertical-alignment: center;
        overflow: elide;
        text: root.count-text;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
        visible: !root.gate-hide;
    }

    footer-indicator := FooterIndicator {
        right-margin: Layout.bottom-status-right-margin;
        cue-y: Sizing.snap(root.label-y + (Layout.active-label-height - self.height) / 2) - Sizing.label-raise;
        current-page: root.list-layout ? SystemsView.list-page : SystemsView.page;
        total-pages: root.list-layout ? SystemsView.list-total-pages : SystemsView.total-pages;
        item-position-mode: root.list-layout;
        current-item: SystemsView.current-index;
        total-items: SystemsView.count;
        has-pages-above: root.list-layout ? SystemsView.has-items-above : SystemsView.has-pages-above;
        has-pages-below: root.list-layout ? SystemsView.has-items-below : SystemsView.has-pages-below;
        visible: !root.gate-hide && root.page-cue-in-footer;
        page-requested(delta) => { SystemsInput.page-requested(delta); }
    }

    cue := StateCue {
        x: 0;
        y: root.list-layout ? root.list-card-y : SystemsView.grid-y;
        height: root.list-layout ? Math.max(0px, root.height - root.list-card-y - Layout.overlay-bottom-margin) : SystemsView.grid-height;
        cue-center-y: root.height / 2 - self.y;
        state: root.state;
        empty-text: root.top-played ? @tr("Nothing played yet")
            : (root.favorites ? Labels.list-empty(Shell.active-list) : @tr("No systems in this category"));
    }
}

// The Menu and picker list: a title over the list panel's rows (see
// `list_panel.slint`). One panel for every list a screen or setting opens,
// short menus and long structured lists alike: a long list (Rust's
// `list-form`, the tags and systems pickers) builds only the rows on
// screen and its window snaps; a short one builds every row and glides.
// Rows that carry a value (Sort, Volume, a tag's count) show it on the
// right; a setting switched in place shows a toggle switch.
component ListModal inherits ModalShell {
    in property <string> title-text;
    in property <[MenuEntry]> entries;
    in property <int> current-index;
    // Set while picking a settings value; see Overlays.list-setting-id.
    in property <string> setting-id;
    in property <bool> windowed;

    pure function entry-name(entry: MenuEntry, i: int) -> string {
        if (Overlays.launcher-saving-visible && i == root.current-index) { return @tr("Saving…"); }
        // A settings value with a label of its own (a user color scheme) is
        // shown as written.
        if (root.setting-id != "") { return entry.label != "" ? entry.label : SettingsLabels.picker-value(root.setting-id, entry.id); }
        return entry.label-key != "" ? Labels.menu-name(entry.label-key, entry.label) : entry.label;
    }
    // The right-hand text: why a row cannot act, a value, or a count.
    pure function entry-value(entry: MenuEntry) -> string {
        if (!entry.enabled && entry.reason-key != "") { return Labels.launcher-reason(entry.reason-key); }
        if (entry.role == MenuRole.slider) { return @tr("{}%", entry.detail); }
        if (entry.detail-key != "") { return Labels.menu(entry.detail-key, entry.detail); }
        if (entry.detail != "") { return entry.detail; }
        return entry.label-key != "" ? Labels.menu-row-value(entry.label-key, entry.label) : "";
    }
    property <bool> on-toggle: root.current-index >= 0 && root.current-index < root.entries.length
        && (root.entries[root.current-index].role == MenuRole.toggle-off
            || root.entries[root.current-index].role == MenuRole.toggle-on);

    title: root.setting-id != "" ? SettingsLabels.label(root.setting-id) : root.title-text;
    panel-width: ListPanel.width;
    content-height: vp.height;

    vp := ListViewport {
        x: root.pad;
        y: root.content-y;
        width: root.content-width;
        count: root.entries.length;
        current: root.current-index;
        scope: root.title-text + ":" + root.setting-id;
        glide: !root.windowed;
        press-held: PressFeedback.active(PressOwner.list, root.current-index);
        flash-enabled: !root.on-toggle;
        current-under-header: root.windowed && root.current-index > 0
            && root.current-index <= root.entries.length
            && root.entries[root.current-index - 1].role == MenuRole.header;

        for entry[i] in (root.windowed ? [] : root.entries): ListRow {
            x: 0;
            y: (i - vp.top) * vp.stride;
            width: vp.width;
            height: vp.row-h;
            role: entry.role;
            name: root.entry-name(entry, i);
            value: root.entry-value(entry);
            swatch-id: root.setting-id == "colorScheme" ? entry.id : "";
            level: entry.role == MenuRole.slider ? entry.detail.to-float() : 0;
            enabled: entry.enabled;
            fill-top: vp.fill-top;
            fill-bottom: vp.fill-bottom;
            fill: vp.fill;
            content: vp.content;
            content-muted: vp.content-muted;
            hovered => { Overlays.pointer-choice(PressOwner.list, i, false); }
            clicked => { Overlays.pointer-choice(PressOwner.list, i, true); }
            slid(direction) => { Overlays.pointer-choice(PressOwner.list, i, false); Overlays.slider-step(direction); }
        }
        // Windowed: one row per slot, holding whichever entry is there.
        for slot in (root.windowed ? vp.visible-rows : 0): cell := ListRow {
            property <int> i: vp.top + slot;
            property <MenuEntry> entry: root.entries[self.i];
            visible: self.i < root.entries.length;
            x: 0;
            y: slot * vp.stride;
            width: vp.width;
            height: vp.row-h;
            role: cell.entry.role;
            name: root.entry-name(cell.entry, cell.i);
            value: root.entry-value(cell.entry);
            level: cell.entry.role == MenuRole.slider ? cell.entry.detail.to-float() : 0;
            enabled: cell.entry.enabled;
            fill-top: vp.fill-top;
            fill-bottom: vp.fill-bottom;
            fill: vp.fill;
            content: vp.content;
            content-muted: vp.content-muted;
            hovered => { Overlays.pointer-choice(PressOwner.list, cell.i, false); }
            clicked => { Overlays.pointer-choice(PressOwner.list, cell.i, true); }
            slid(direction) => { Overlays.pointer-choice(PressOwner.list, cell.i, false); Overlays.slider-step(direction); }
        }
    }
}

// Core's picker: a list of Core's choices titled as Core titled it, and,
// when choices are games, the focused one's cover beside the list. A Core
// event may sit above any other surface, so this is drawn above them and
// below only the decision dialog.
component CorePickerModal inherits ModalShell {
    property <int> count: CoreUiView.rows.length;
    // The cover box: as tall as the list and never wider than a third of
    // the panel, so the labels keep the room they need at 240p.
    // Snapped so the list column starts on a whole pixel where the bitmap
    // face is in use.
    property <length> art-side: CoreUiView.has-art
        ? Sizing.snap(Math.min(vp.height, root.content-width / 3)) : 0px;
    property <length> art-gap: CoreUiView.has-art ? root.pad : 0px;
    property <length> list-x: root.pad + root.art-side + root.art-gap;
    property <length> list-w: Sizing.even(Math.max(0px, root.content-width - root.art-side - root.art-gap));

    title: CoreUiView.title;
    panel-width: ListPanel.width;
    content-height: vp.height;

    if CoreUiView.has-art: Rectangle {
        x: root.pad;
        y: root.content-y;
        width: root.art-side;
        height: root.content-height;
        init => { CoreUiView.art-box(Math.round(self.width / 1px), Math.round(self.height / 1px)); }
        changed width => { CoreUiView.art-box(Math.round(self.width / 1px), Math.round(self.height / 1px)); }
        changed height => { CoreUiView.art-box(Math.round(self.width / 1px), Math.round(self.height / 1px)); }
        // An Image takes its source's size unless told otherwise.
        Image {
            width: parent.width;
            height: parent.height;
            source: CoreUiView.cover;
            image-fit: contain;
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
            visible: CoreUiView.has-cover;
        }
        // Only a confirmed lack of art shows the chip; a cover on its way
        // leaves the box empty, like the detail pane.
        if !CoreUiView.has-cover && CoreUiView.cover-absent: Image {
            property <length> s: GlyphSource.side(parent.width * 0.4);
            x: (parent.width - self.s) / 2;
            y: (parent.height - self.s) / 2;
            width: self.s;
            height: self.s;
            source: GlyphSource.glyph("icons/File", self.s, Theme.text-label);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }
    }

    // Core's choices on the list panel: the name, and what Core says of it
    // (a game's system) on the right.
    vp := ListViewport {
        x: root.list-x;
        y: root.content-y;
        width: root.list-w;
        count: root.count;
        current: CoreUiView.index;
        scope: CoreUiView.title;
        press-held: PressFeedback.active(PressOwner.core-picker, CoreUiView.index);

        for row[i] in CoreUiView.rows: ListRow {
            x: 0;
            y: (i - vp.top) * vp.stride;
            width: vp.width;
            height: vp.row-h;
            name: row.label;
            value: row.detail;
            fill-top: vp.fill-top;
            fill-bottom: vp.fill-bottom;
            fill: vp.fill;
            content: vp.content;
            content-muted: vp.content-muted;
            hovered => { Overlays.pointer-choice(PressOwner.core-picker, i, false); }
            clicked => { Overlays.pointer-choice(PressOwner.core-picker, i, true); }
        }
    }
}


// Jump-to-letter grid picker: the buckets come from `media.browse.index`
// (only non-empty sections in sort order), and each cell shows the bucket
// label with its item count. Pure presentation - the router owns
// navigation and the cursor seek.
component LetterJumpModal inherits ModalShell {
    in property <[LetterBucket]> buckets;
    in property <int> current-index;
    in property <ContentState> state: ContentState.ready;
    in property <int> columns: 9;

    property <length> gap: Sizing.pct-w(1);
    property <int> rows: Math.max(1, Math.ceil(root.buckets.length / Math.max(1, root.columns)));
    // The widest the grid may grow. The panel then hugs what it shows: the
    // grid, or the title or status line where those are wider.
    property <length> max-content: Sizing.pct-w(78) - 2 * root.pad;
    property <length> cell: Sizing.snap(Math.max(Sizing.pct-w(7), Math.min(Sizing.pct-w(13),
        Sizing.fit-letter-cell(root.buckets.length, root.columns, root.max-content,
            Sizing.pct-h(52), root.gap))));
    property <length> grid-h: root.rows * root.cell + (root.rows - 1) * root.gap;
    property <length> grid-w: root.columns * root.cell + (root.columns - 1) * root.gap;
    property <length> ring-gap: Sizing.card-border-width;
    property <length> stack-gap: Sizing.pct-h(0.4);
    property <length> stack-h: Sizing.font-hero + root.stack-gap + Sizing.font-small;
    property <bool> pressed: PressFeedback.active(PressOwner.letter, root.current-index);
    property <float> press-t: root.pressed ? 1 : 0;
    animate press-t {
        duration: Motion.dur(root.pressed ? Motion.press-ms : Motion.settle-ms);
        easing: ease-out-quad;
    }

    title: @tr("Go to…");
    // The status line in place of the grid, with the wait cue's hourglass.
    property <string> status-text: root.state == ContentState.loading ? @tr("Loading sections…")
        : root.state == ContentState.error ? @tr("Failed to load sections") : @tr("No sections");
    title-measure := Text {
        visible: false;
        text: root.title;
        font-size: Sizing.font-title;
    }
    status-measure := Text {
        visible: false;
        text: root.status-text;
        font-size: Sizing.font-body;
    }
    property <length> content-w: Math.max(title-measure.preferred-width,
        root.buckets.length > 0 ? root.grid-w : status-measure.preferred-width + 2 * Sizing.font-size(3));
    panel-width: Math.min(Sizing.pct-w(78), Math.ceil(root.content-w / 1px) * 1px + 2 * root.pad);
    content-height: root.grid-h;

    wait := WaitCue {
        x: 0;
        y: root.content-y;
        width: root.panel-width;
        height: root.grid-h;
        waiting: root.buckets.length == 0 && root.state == ContentState.loading;
        text: root.status-text;
    }
    if root.buckets.length == 0 && root.state != ContentState.loading && !wait.shown: Text {
        x: Sizing.snap((root.panel-width - self.width) / 2);
        y: root.content-y + (root.grid-h - self.height) / 2;
        text: root.status-text;
        color: Theme.text-label;
        font-size: Sizing.font-body;
    }

    Rectangle {
        x: Sizing.snap((root.panel-width - root.grid-w) / 2);
        y: root.content-y;
        width: root.grid-w;
        height: root.grid-h;

        for bucket[i] in root.buckets: cell := PressableSurface {
            x: Math.mod(i, root.columns) * (root.cell + root.gap);
            y: Math.floor(i / root.columns) * (root.cell + root.gap);
            width: root.cell;
            height: root.cell;
            pressed: PressFeedback.active(PressOwner.letter, i);

            // Letter over count, stacked by font size rather than by line
            // height: a line's spare room above and below its glyphs would
            // push the two apart and the count off the face of a small
            // cell. Each line centers in a box its own font size tall.
            letter := Text {
                x: 2 * root.ring-gap;
                y: (cell.face-height - root.stack-h) / 2;
                width: Sizing.even(parent.width - 4 * root.ring-gap);
                height: Sizing.font-hero;
                text: bucket.label;
                color: i == root.current-index ? Theme.text-primary : Theme.text-label;
                font-size: Sizing.font-hero;
                font-weight: FontWeight.medium;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: letter.x;
                y: letter.y + letter.height + root.stack-gap;
                width: letter.width;
                height: Sizing.font-small;
                text: bucket.count;
                color: Theme.text-label;
                font-size: Sizing.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                mouse-cursor: pointer;
                changed has-hover => { if (self.has-hover) { Overlays.pointer-choice(PressOwner.letter, i, false); } }
                clicked => { Overlays.pointer-choice(PressOwner.letter, i, true); }
            }
        }
        FocusCursor {
            radius: Math.max(0px, Sizing.radius-sm - root.ring-gap);
            stroke: Sizing.card-border-width * 2;
            target: {
                x: Math.mod(Math.max(0, root.current-index), root.columns) * (root.cell + root.gap) + root.ring-gap,
                y: Math.floor(Math.max(0, root.current-index) / root.columns) * (root.cell + root.gap)
                    + root.ring-gap + root.press-t * Sizing.press-edge-height,
                w: root.cell - 2 * root.ring-gap,
                h: root.cell - Sizing.press-edge-height - 2 * root.ring-gap,
                column: Math.mod(Math.max(0, root.current-index), root.columns),
                row: Math.floor(Math.max(0, root.current-index) / root.columns),
                scope: "letters:" + root.columns,
                valid: root.state != ContentState.loading && root.current-index >= 0 && root.current-index < root.buckets.length
            };
        }
    }
}

// Card write transient: a tap prompt and a focused Cancel surface.
// Failures replace this modal with the router's Retry alert.
component CardWriteModal inherits ModalShell {
    property <length> btn-h: Sizing.pct-h(7);

    title: @tr("Hold a writable token near the reader");
    panel-width: Sizing.snap(Math.min(Math.min(root.width * 0.92, Sizing.pct-h(90)),
        Math.max(Sizing.pct-w(30), root.title-width + 2 * root.pad)));
    content-height: root.btn-h;

    // The shell centres and elides its title; this one wants to wrap, so
    // the panel sizes around a measurement instead.
    title-measure := Text {
        visible: false;
        text: root.title;
        font-size: Sizing.font-title;
    }
    property <length> title-width: Math.ceil(title-measure.preferred-width / 1px) * 1px;

    cancel-button := PressableSurface {
        x: Sizing.snap((root.panel-width - self.width) / 2);
        y: root.content-y;
        width: Math.min(Sizing.pct-w(28), root.content-width);
        height: root.btn-h;
        focused: true;
        pressed: PressFeedback.active(PressOwner.card-write, 0);
        Text {
            x: Sizing.snap((parent.width - self.width) / 2);
            y: Sizing.snap((cancel-button.face-height - self.height) / 2);
            text: @tr("Cancel");
            color: Theme.text-primary;
            font-size: Sizing.font-body;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Overlays.pointer-choice(PressOwner.card-write, 0, true); }
        }
    }
}

// Pairing a device: the PIN Core minted, set large enough to read from
// across the room, with the time left on it, then the name of whatever
// device used it. Display only, like the QR shell - Rust owns every phase
// change and the help bar names the one or two controls that apply.
component PairDeviceModal inherits ModalShell {
    property <length> pin-size: Sizing.font-size(10);
    // Whole minutes left, rounded up, so the last minute reads "1 minute"
    // rather than "0" for its whole length. Under a minute the line
    // counts seconds instead.
    property <int> minutes-left: Math.ceil(Overlays.pair-expires-in / 60);

    title: @tr("Pair a device");
    // Sized around the PIN itself: it is the widest thing here and the
    // whole point of the panel, so it never elides.
    panel-width: Sizing.snap(Math.min(Math.min(root.width * 0.92, Sizing.pct-h(110)),
        Math.max(Sizing.pct-w(50), pin-measure.preferred-width + 2 * root.pad)));
    content-height: Math.ceil(content.preferred-height / 1px) * 1px;

    pin-measure := Text {
        visible: false;
        text: Overlays.pair-pin;
        font-size: root.pin-size;
        font-weight: FontWeight.medium;
    }

    content := VerticalLayout {
        x: root.pad;
        y: root.content-y;
        width: root.content-width;
        height: self.preferred-height;
        spacing: root.pad;

        if Overlays.pair-phase == PairPhase.starting: WaitCue {
            height: self.glyph;
            waiting: true;
            text: @tr("Starting…");
        }

        if Overlays.pair-phase == PairPhase.showing: Rectangle {
            height: Math.ceil(pin.preferred-height / 1px) * 1px;
            pin := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: Math.min(Math.ceil(self.preferred-width / 1px) * 1px, parent.width);
                text: Overlays.pair-pin;
                color: Theme.accent;
                font-size: root.pin-size;
                font-weight: FontWeight.medium;
            }
        }
        if Overlays.pair-phase == PairPhase.showing: Rectangle {
            height: Math.ceil(instructions.preferred-height / 1px) * 1px;
            instructions := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: @tr("Enter this PIN on the device you are pairing.");
                color: Theme.text-primary;
                font-size: Sizing.font-body;
                wrap: word-wrap;
            }
        }
        if Overlays.pair-phase == PairPhase.showing: Rectangle {
            height: Math.ceil(expiry.preferred-height / 1px) * 1px;
            expiry := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: Overlays.pair-expires-in >= 60
                    ? @tr("Expires in {n} minute" | "Expires in {n} minutes" % root.minutes-left)
                    : @tr("Expires in {n} second" | "Expires in {n} seconds" % Overlays.pair-expires-in);
                color: Theme.text-label;
                font-size: Sizing.font-caption;
                wrap: word-wrap;
            }
        }

        if Overlays.pair-phase == PairPhase.paired: Rectangle {
            height: Math.ceil(paired.preferred-height / 1px) * 1px;
            paired := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                // Core names the device it paired; it does not always have
                // a name to give.
                text: Overlays.pair-client == ""
                    ? @tr("A device is now paired with Core.")
                    : @tr("{} is now paired with Core.", Overlays.pair-client);
                color: Theme.text-primary;
                font-size: Sizing.font-body;
                wrap: word-wrap;
            }
        }

        if Overlays.pair-phase == PairPhase.expired: Rectangle {
            height: Math.ceil(expired.preferred-height / 1px) * 1px;
            expired := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: @tr("The PIN expired before a device used it. Pair again for a new one.");
                color: Theme.text-primary;
                font-size: Sizing.font-body;
                wrap: word-wrap;
            }
        }
    }
}

// Linking an Online account: a code to scan, the short code and URL for
// typing it in instead, and the time left, then the outcome. Display only;
// Rust owns every phase change, like the pairing panel.
component OnlineLinkModal inherits ModalShell {
    property <length> code-size: Sizing.font-size(7);
    property <int> minutes-left: Math.ceil(Overlays.online-expires-in / 60);
    property <bool> showing: Overlays.online-phase == OnlineLinkPhase.showing;
    property <length> max-px: Math.min(Sizing.pct-w(32), Sizing.pct-h(38));
    property <length> module-px: Overlays.online-qr-modules > 0
        ? Math.max(1, Math.floor(root.max-px / Overlays.online-qr-modules / 1px)) * 1px
        : 1px;
    property <length> qr-px: root.module-px * Overlays.online-qr-modules;

    title: @tr("Link Online account");
    panel-width: Sizing.snap(Math.min(root.width * 0.78, Sizing.pct-h(110)));
    content-height: Math.ceil(content.preferred-height / 1px) * 1px;

    content := VerticalLayout {
        x: root.pad;
        y: root.content-y;
        width: root.content-width;
        height: self.preferred-height;
        spacing: root.pad;

        if Overlays.online-phase == OnlineLinkPhase.starting: WaitCue {
            height: self.glyph;
            waiting: true;
            text: @tr("Starting…");
        }

        if !root.showing && Overlays.online-phase != OnlineLinkPhase.starting: Rectangle {
            height: Math.ceil(message.preferred-height / 1px) * 1px;
            message := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: Overlays.online-phase == OnlineLinkPhase.linked ? @tr("This device is now linked to your Zaparoo Online account.")
                    : Overlays.online-phase == OnlineLinkPhase.expired ? @tr("The code expired before it was approved. Link again for a new one.")
                    : @tr("Linking failed. Check the network connection and try again.");
                color: Theme.text-primary;
                font-size: Sizing.font-body;
                wrap: word-wrap;
            }
        }

        if root.showing: Rectangle {
            height: Math.ceil(instructions.preferred-height / 1px) * 1px;
            instructions := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: @tr("Scan this code with your phone, or open the address below and enter the code.");
                color: Theme.text-primary;
                font-size: Sizing.font-caption;
                wrap: word-wrap;
            }
        }
        if root.showing && Overlays.online-can-open-url: Rectangle {
            height: Math.ceil(open-hint.preferred-height / 1px) * 1px;
            open-hint := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: @tr("Or press Accept to open it on this device.");
                color: Theme.text-label;
                font-size: Sizing.font-caption;
                wrap: word-wrap;
            }
        }
        if root.showing && Overlays.online-qr-modules > 0: Rectangle {
            height: root.qr-px;
            QrPlate {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: root.qr-px;
                height: root.qr-px;
                code: Overlays.online-qr;
                quiet-zone: root.module-px * 4;
            }
        }
        if root.showing: Rectangle {
            height: Math.ceil(code.preferred-height / 1px) * 1px;
            code := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: Math.min(Math.ceil(self.preferred-width / 1px) * 1px, parent.width);
                text: Overlays.online-code;
                color: Theme.accent;
                font-size: root.code-size;
                font-weight: FontWeight.medium;
            }
        }
        if root.showing: Rectangle {
            height: Math.ceil(url.preferred-height / 1px) * 1px;
            url := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: Overlays.online-url;
                color: Theme.text-primary;
                font-size: Sizing.font-small;
                wrap: char-wrap;
            }
        }
        if root.showing: Rectangle {
            height: Math.ceil(expiry.preferred-height / 1px) * 1px;
            expiry := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                horizontal-alignment: center;
                text: Overlays.online-expires-in >= 60
                    ? @tr("Expires in {n} minute" | "Expires in {n} minutes" % root.minutes-left)
                    : @tr("Expires in {n} second" | "Expires in {n} seconds" % Overlays.online-expires-in);
                color: Theme.text-label;
                font-size: Sizing.font-caption;
                wrap: word-wrap;
            }
        }
    }
}

// The Online page's two lists, one modal: cloud backup snapshots (Accept
// restores, after asking) and the remote-control activity log (read only).
// Rust composes every row; the list itself is the picker's: the shared
// cursor, the reserved scroll cues, a window that glides, and rows that
// answer the pointer. The first row of the backup list is "back up now".
component OnlineListModal inherits ModalShell {
    property <[OnlineListRow]> entries: Overlays.online-list-rows;
    property <int> current-index: Overlays.online-list-index;
    property <bool> backups: Overlays.online-list-kind == OnlineListKind.backups;
    // A wait (loading the list, a backup or a restore running) takes the
    // status row only once its cue is up; a failure or an empty list has
    // it at once.
    property <bool> waiting: Overlays.online-list-status == OnlineListStatus.loading
        || Overlays.online-list-status == OnlineListStatus.backing-up
        || Overlays.online-list-status == OnlineListStatus.restoring;
    property <bool> has-status: wait.shown
        || Overlays.online-list-status == OnlineListStatus.failed
        || Overlays.online-list-status == OnlineListStatus.empty;
    property <bool> has-note: Overlays.online-list-note != "";

    // Why the list could not load, in the user's terms: two causes they
    // can fix themselves, and the network for anything else.
    pure function failure-text() -> string {
        if (Overlays.online-list-failure == OnlineListFailure.unlinked) {
            return @tr("This device is not linked. Link your Zaparoo Online account, then try again.");
        }
        if (Overlays.online-list-failure == OnlineListFailure.needs-warp) {
            return @tr("Cloud backup needs an active Zaparoo Warp subscription.");
        }
        return @tr("Could not load this. Check the network connection and try again.");
    }
    pure function row-label(row: OnlineListRow) -> string {
        return row.id == "run" ? @tr("Back up now") : row.label;
    }
    pure function row-detail(row: OnlineListRow) -> string {
        // The only row that cannot be accepted is a snapshot a newer
        // Zaparoo made; it says so where its detail already is.
        if (!row.enabled) { return @tr("{}, needs a newer Zaparoo", row.detail); }
        return row.this-device ? @tr("{}, this device", row.detail) : row.detail;
    }

    property <length> note-h: root.has-note ? Math.ceil(Sizing.font-caption / 1px * 1.6) * 1px + root.pad : 0px;
    property <length> status-h: root.has-status ? vp.row-h + (root.entries.length > 0 ? root.pad : 0px) : 0px;
    property <length> list-y: root.content-y + root.note-h + root.status-h;

    title: root.backups ? @tr("Cloud backups") : @tr("Remote activity");
    panel-width: ListPanel.width;
    content-height: root.note-h + root.status-h + vp.height;

    if root.has-note: Text {
        x: root.pad;
        y: root.content-y;
        width: root.content-width;
        horizontal-alignment: center;
        overflow: elide;
        text: Overlays.online-list-note;
        color: Theme.text-label;
        font-size: Sizing.font-caption;
    }
    wait := WaitCue {
        x: root.pad;
        y: root.content-y + root.note-h;
        width: root.content-width;
        height: vp.row-h;
        glyph: Sizing.font-body;
        waiting: root.waiting;
        text: Overlays.online-list-status == OnlineListStatus.backing-up ? @tr("Backing up…")
            : Overlays.online-list-status == OnlineListStatus.restoring ? @tr("Restoring…")
            : (root.backups ? @tr("Loading backups…") : @tr("Loading activity…"));
    }
    if root.has-status && !wait.shown: Text {
        x: root.pad;
        y: root.content-y + root.note-h;
        width: root.content-width;
        height: vp.row-h;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        text: Overlays.online-list-status == OnlineListStatus.failed ? root.failure-text()
            : (root.backups ? @tr("No cloud backups yet.") : @tr("Nothing has run through remote control yet."));
        color: Overlays.online-list-status == OnlineListStatus.failed ? Theme.accent : Theme.text-label;
        font-size: Sizing.font-body;
    }

    vp := ListViewport {
        x: root.pad;
        y: root.list-y;
        width: root.content-width;
        count: root.entries.length;
        current: root.current-index;
        scope: "online-list:" + (root.backups ? "backups" : "activity");
        max-viewport: Sizing.pct-h(46);
        press-held: PressFeedback.active(PressOwner.online-list, root.current-index);

        for row[i] in root.entries: ListRow {
            x: 0;
            y: (i - vp.top) * vp.stride;
            width: vp.width;
            height: vp.row-h;
            name: root.row-label(row);
            value: root.row-detail(row);
            // Muted, never hidden: a snapshot this Core cannot restore
            // still lists.
            enabled: row.enabled;
            accent: row.id == "run";
            fill-top: vp.fill-top;
            fill-bottom: vp.fill-bottom;
            fill: vp.fill;
            content: vp.content;
            content-muted: vp.content-muted;
            hovered => { Overlays.pointer-choice(PressOwner.online-list, i, false); }
            clicked => { Overlays.pointer-choice(PressOwner.online-list, i, true); }
        }
    }
}

// Settings > Library's launcher preference: Core's ordered list of
// launchers and groups, with Add… at its end, one entry's Move and Remove,
// and what can be added, as three pages of one panel. Rust builds every
// row; groups get their display names here, launchers keep Core's ids.
// The list is the picker's: the shared cursor, the reserved scroll cues,
// a window that glides, and rows that answer the pointer.
component LauncherPrefsModal inherits ModalShell {
    property <[LauncherPrefsRow]> entries: Overlays.launcher-prefs-rows;

    property <int> current-index: Overlays.launcher-prefs-index;
    changed current-index => { root.blink-on = true; }

    // A held entry blinks, as a held Hub tile does: only its own text
    // repaints.
    property <bool> blink-on: true;
    Timer {
        interval: Motion.held-blink-ms;
        running: Overlays.launcher-prefs-moving && Motion.enabled;
        triggered => { root.blink-on = !root.blink-on; }
    }

    pure function group-name(id: string) -> string {
        if (id == "DualRAM") { return @tr("Dual SDRAM"); }
        if (id == "KodiTV") { return @tr("Kodi TV"); }
        if (id == "KodiMusic") { return @tr("Kodi music"); }
        if (id == "MisterArcade") { return @tr("MiSTer arcade"); }
        if (id == "MediaPlayers") { return @tr("Media players"); }
        if (id == "Native") { return @tr("Native"); }
        if (id == "Unstable") { return @tr("Unstable"); }
        if (id == "Video") { return @tr("Video"); }
        return id;
    }
    pure function row-label(row: LauncherPrefsRow) -> string {
        if (row.kind == LauncherPrefsRowKind.add) { return @tr("Add…"); }
        if (row.kind == LauncherPrefsRowKind.move) { return @tr("Move"); }
        if (row.kind == LauncherPrefsRowKind.remove) { return @tr("Remove"); }
        if (row.kind == LauncherPrefsRowKind.group) { return root.group-name(row.id); }
        return row.id;
    }
    pure function row-detail(row: LauncherPrefsRow) -> string {
        if (row.kind == LauncherPrefsRowKind.group) {
            return row.enabled ? @tr("Group") : @tr("Group, not installed");
        }
        if (row.kind == LauncherPrefsRowKind.launcher) {
            if (row.enabled) { return row.detail; }
            return row.detail == "" ? @tr("Not installed") : @tr("{}, not installed", row.detail);
        }
        return "";
    }

    title: Overlays.launcher-prefs-page == LauncherPrefsPage.entry ? root.row-label(Overlays.launcher-prefs-entry)
        : Overlays.launcher-prefs-page == LauncherPrefsPage.add ? @tr("Add")
        : @tr("Launcher preference");
    panel-width: ListPanel.width;
    content-height: vp.height;

    vp := ListViewport {
        x: root.pad;
        y: root.content-y;
        width: root.content-width;
        count: root.entries.length;
        current: root.current-index;
        scope: "launcher-prefs:" + StateTokens.launcher-prefs-page(Overlays.launcher-prefs-page);
        max-viewport: Sizing.pct-h(46);
        press-held: PressFeedback.active(PressOwner.launcher-prefs, root.current-index);

        for row[i] in root.entries: ListRow {
            x: 0;
            y: (i - vp.top) * vp.stride;
            width: vp.width;
            height: vp.row-h;
            visible: !(row.held && !root.blink-on);
            name: root.row-label(row);
            value: root.row-detail(row);
            // Muted, never hidden: Core keeps an entry that is not
            // installed yet.
            enabled: row.enabled;
            accent: row.kind == LauncherPrefsRowKind.add;
            fill-top: vp.fill-top;
            fill-bottom: vp.fill-bottom;
            fill: vp.fill;
            content: vp.content;
            content-muted: vp.content-muted;
            hovered => { Overlays.pointer-choice(PressOwner.launcher-prefs, i, false); }
            clicked => { Overlays.pointer-choice(PressOwner.launcher-prefs, i, true); }
        }
    }
}

// QR shell: translated purpose and instructions above an integer module
// matrix, with a readable documentation URL for composite video.
component QrCodeModal inherits ModalShell {
    in property <image> qr;
    in property <int> modules;

    property <length> max-px: Math.min(Sizing.pct-w(36), Sizing.pct-h(48));
    property <length> module-px: root.modules > 0
        ? Math.max(1, Math.floor(root.max-px / root.modules / 1px)) * 1px
        : 1px;
    property <length> qr-px: root.module-px * root.modules;

    title: Overlays.qr-documentation ? @tr("Documentation") : @tr("Write with App");
    // Not content-sized: the code fixes the width, so this takes the plain
    // 0.78 cap rather than the 0.92 a measured panel gets.
    panel-width: Sizing.snap(Math.min(root.width * 0.78, Sizing.pct-h(105)));
    content-height: Math.ceil(content.preferred-height / 1px) * 1px;

    content := VerticalLayout {
        x: root.pad;
        y: root.content-y;
        width: root.content-width;
        height: self.preferred-height;
        spacing: root.pad;
        Rectangle {
            height: Math.ceil(instructions.preferred-height / 1px) * 1px;
            instructions := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: Math.min(Math.ceil(self.preferred-width / 1px) * 1px, parent.width);
                text: Overlays.qr-documentation
                    ? @tr("Scan this code to open the Zaparoo Frontend guide on your phone.")
                    : @tr("Scan this code with the Zaparoo App to write this game to a Zaparoo token.");
                color: Theme.text-primary;
                font-size: Sizing.font-caption;
                wrap: word-wrap;
            }
        }
        Rectangle {
            height: root.qr-px;
            QrPlate {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: root.qr-px;
                height: root.qr-px;
                code: root.qr;
                quiet-zone: root.module-px * 4;
            }
        }
        if Overlays.qr-documentation: Rectangle {
            height: Math.ceil(url.preferred-height / 1px) * 1px;
            url := Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: 0px;
                width: Math.min(Math.ceil(self.preferred-width / 1px) * 1px, parent.width);
                text: "zaparoo.org/docs/frontend";
                color: Theme.text-label;
                font-size: Sizing.font-small;
                wrap: char-wrap;
            }
        }
    }
}

// Decision dialog: a rounded panel over the scrim with title, wrapped
// body and a centered row of raised commitment
// buttons. Purely presentational - the router owns which buttons exist
// and what they mean.
component DialogModal inherits ModalShell {

    // The shared panel rule: as wide as the copy needs, capped at
    // 92% of the screen and at a height-derived maximum, so a long body
    // does not stack up into extra lines on a 240p screen.
    title-measure := Text {
        visible: false;
        text: DialogLabels.title(Overlays.dialog-kind, Overlays.dialog-error, Overlays.dialog-detail);
        font-size: Sizing.font-title;
    }
    body-measure := Text {
        visible: false;
        text: DialogLabels.body(Overlays.dialog-kind, Overlays.dialog-error, Overlays.dialog-detail, Overlays.dialog-arg, Overlays.dialog-repair-reason, Overlays.dialog-repair-launcher, Overlays.dialog-repair-plugin);
        font-size: Sizing.font-body;
    }
    line-measure := Text {
        visible: false;
        text: "abcdefghijklmnopqrstuvwxyz";
        font-size: Sizing.font-body;
    }
    button-measure := HorizontalLayout {
        visible: false;
        spacing: root.btn-gap;
        for label in Overlays.dialog-buttons: Rectangle {
            width: caption.preferred-width + Sizing.pct-w(8);
            caption := Text { text: DialogLabels.button(label); font-size: Sizing.font-body; }
        }
    }
    property <length> desired-w: Math.max(title-measure.preferred-width,
        Math.max(Math.min(body-measure.preferred-width, line-measure.preferred-width * 45 / 26),
            button-measure.preferred-width)) + 2 * root.pad;
    // CommercialNoticeModal uses a wider shell for its long legal copy.
    property <length> panel-w-raw: Math.ceil((Overlays.dialog-kind == DialogKind.notice
        ? Math.min(root.width * 0.78, Sizing.pct-h(110))
        : Math.min(Math.min(root.width * 0.92, Sizing.pct-h(90)),
            Math.max(Sizing.pct-w(30), root.desired-w))) / 1px) * 1px;
    property <length> btn-h: Sizing.pct-h(7);
    property <length> btn-gap: Sizing.pct-w(2);
    property <length> body-h: body-t.preferred-height;
    property <length> body-y: root.content-y;
    property <length> button-y: root.body-y + root.body-h + root.pad;

    title: DialogLabels.title(Overlays.dialog-kind, Overlays.dialog-error, Overlays.dialog-detail);
    panel-width: root.panel-w-raw;
    content-height: root.button-y + root.btn-h - root.content-y;

        body-t := Text {
            x: Sizing.snap((root.panel-width - self.width) / 2);
            y: root.body-y;
            width: Math.min(Math.ceil(body-measure.preferred-width / 1px) * 1px, root.content-width);
            wrap: word-wrap;
            text: DialogLabels.body(Overlays.dialog-kind, Overlays.dialog-error, Overlays.dialog-detail, Overlays.dialog-arg, Overlays.dialog-repair-reason, Overlays.dialog-repair-launcher, Overlays.dialog-repair-plugin);
            color: Theme.text-primary;
            font-size: Sizing.font-body;
            horizontal-alignment: center;
        }

        // Same raised surfaces and safe-area width cap as ModalShell.
        property <length> available-btn-w: Math.floor((root.content-width
            - Math.max(0, Overlays.dialog-buttons.length - 1) * root.btn-gap)
            / Math.max(1, Overlays.dialog-buttons.length) / 1px) * 1px;
        // A one-word alert action sizes around its label like the panel does;
        // it must not inflate to nearly the full width of the panel.
        // Setup's commitment is longer than a one-word alert, especially
        // in the CRT bitmap font. Fit its caption instead of the usual cap.
        property <length> btn-w: Overlays.dialog-kind == DialogKind.first-run
            ? Math.min(self.available-btn-w, button-measure.preferred-width)
            : Math.min(Sizing.pct-w(28),
                Overlays.dialog-kind == DialogKind.action-error && Overlays.dialog-buttons.length == 1
                    ? Math.min(self.available-btn-w, button-measure.preferred-width)
                    : self.available-btn-w);
        for label[i] in Overlays.dialog-buttons: button := PressableSurface {
            x: Sizing.snap((root.panel-width
                - (Overlays.dialog-buttons.length * parent.btn-w
                    + (Overlays.dialog-buttons.length - 1) * root.btn-gap)) / 2)
                + i * (parent.btn-w + root.btn-gap);
            y: root.button-y;
            width: parent.btn-w;
            height: root.btn-h;
            focused: i == Overlays.dialog-focus;
            pressed: PressFeedback.active(PressOwner.dialog, i);

            Text {
                x: Sizing.snap((parent.width - self.width) / 2);
                y: Sizing.snap((button.face-height - self.height) / 2);
                max-width: parent.width - Sizing.pct-w(1);
                overflow: elide;
                text: DialogLabels.button(label);
                color: button.focused ? Theme.text-primary : Theme.text-label;
                font-size: Sizing.font-body;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Overlays.pointer-choice(PressOwner.dialog, i, true); }
            }
        }
}

// Screen-burn protection: a solid-black backstop - the only background
// that gives OLED pixels-off rest and CRT phosphor a true break - with
// one copy of the logo starting at the header position, holding 1 s,
// then drifting DVD-style at 45° at one screen-width per 10 s. Per step
// only the logo's own box repaints, so the software renderer's cost
// stays tiny. Mounted fresh on every arm, so init state is always clean.
// A custom logo bounces the same way at its header size; with no logo,
// the clock bounces instead.
component ScreensaverOverlay inherits Rectangle {
    background: black;

    // The header's logo box.
    property <length> box-h: Sizing.header-height;
    property <length> box-w: root.box-h * Brand.aspect;
    property <bool> clock: Brand.mode == HeaderLogo.none;
    // The clock's box: the widest reading for the format, so the walk's
    // edges never move as the digits change.
    property <length> clock-w: Math.ceil(clock-measure.preferred-width / 1px) * 1px;
    property <length> clock-h: Math.ceil(clock-measure.preferred-height / 1px) * 1px;
    property <length> lw: root.clock
        ? root.clock-w
        : (Brand.mode == HeaderLogo.custom ? Brand.custom-width(root.box-w, root.box-h) : root.box-w);
    property <length> lh: root.clock
        ? root.clock-h
        : (Brand.mode == HeaderLogo.custom ? Brand.custom-height(root.box-w, root.box-h) : root.box-h);
    // Always the on-dark variant: the backstop is solid black whatever
    // the preset.
    property <image> logo: Brand.mode == HeaderLogo.custom
        ? Brand.custom-image(root.box-w, root.box-h)
        : Brand.saver-logo(root.lw);

    clock-measure := Text {
        visible: false;
        text: Shell.clock-sample;
        font-size: Sizing.font-hero;
    }

    // Float pixel positions; the Image rounds on paint. Start mirrors
    // the header logo so activation reads as the logo walking off.
    property <float> lx: Sizing.header-side-margin / 1px;
    property <float> ly: Sizing.header-top-margin / 1px;
    property <float> dxs: 1;
    property <float> dys: 1;
    property <bool> bouncing: false;

    // 1 s hold at the header position before the walk starts.
    Timer {
        interval: 1s;
        running: !root.bouncing;
        triggered() => {
            root.bouncing = true;
        }
    }

    // Drift ticks. 16 ms steps at one screen-width per 10 s keeps the
    // classic slow DVD-player feel at every resolution.
    Timer {
        interval: 16ms;
        running: root.bouncing;
        triggered() => {
            root.step();
        }
    }

    function step() {
        root.lx += root.dxs * (root.width / 1px) * 0.0016;
        root.ly += root.dys * (root.width / 1px) * 0.0016;
        if (root.lx <= 0) {
            root.lx = 0;
            root.dxs = 1;
        }
        if (root.lx >= (root.width - root.lw) / 1px) {
            root.lx = (root.width - root.lw) / 1px;
            root.dxs = -1;
        }
        if (root.ly <= 0) {
            root.ly = 0;
            root.dys = 1;
        }
        if (root.ly >= (root.height - root.lh) / 1px) {
            root.ly = (root.height - root.lh) / 1px;
            root.dys = -1;
        }
    }

    if !root.clock: Image {
        x: root.lx * 1px;
        y: root.ly * 1px;
        width: root.lw;
        height: root.lh;
        source: root.logo;
        image-fit: contain;
        image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
    }
    // Bitmap-font text starts on whole pixels.
    if root.clock: Text {
        x: Sizing.snap(root.lx * 1px);
        y: Sizing.snap(root.ly * 1px);
        width: root.lw;
        height: root.lh;
        text: Shell.clock-text;
        // The backstop is black whatever the preset, like the logo's
        // on-dark variant.
        color: white;
        font-size: Sizing.font-hero;
    }
}

// Item-scoped context menu: the panel positions itself beside the
// anchored tile (right, then left, then below/above) and clamps to the
// window; the scrim is four bands drawn AROUND the anchor so the tile the
// menu is about stays bright while the rest of the screen dims. Static
// scrim, one repaint on open - no animation over the grid.
component ContextMenu inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <int> current-index;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-w;
    in property <length> anchor-h;
    in property <length> anchor-radius: 0px;
    in property <bool> anchor-zoomed: false;
    // A game's collections, as a strip of toggles above the rows, and the
    // strip button with focus (-1 while a row has it).
    in property <[FlagButton]> strip: [];
    in property <int> strip-index: -1;

    // The bright hole, which is the anchored thing's painted silhouette
    // rather than its layout rect. A focused tile grows about its own
    // centre by `Motion.focus-zoom`, so the hole grows the same way under
    // the same condition the zoom itself uses; without this the tile spills
    // past the bright area the moment the zoom holds through a menu.
    property <bool> hole-zoomed: root.anchor-zoomed && Motion.enabled;
    property <length> grow-x: root.hole-zoomed
        ? root.anchor-w * (Motion.focus-zoom - 100%) / 2 : 0px;
    property <length> grow-y: root.hole-zoomed
        ? root.anchor-h * (Motion.focus-zoom - 100%) / 2 : 0px;
    property <length> hole-x: root.anchor-x - root.grow-x;
    property <length> hole-y: root.anchor-y - root.grow-y;
    property <length> hole-w: root.anchor-w + 2 * root.grow-x;
    property <length> hole-h: root.anchor-h + 2 * root.grow-y;
    // Skip the corner pieces rather than overlap them on an anchor too
    // small to hold two of them.
    property <length> corner: root.anchor-radius;
    property <bool> cut-corners: root.corner > 0px
        && root.hole-w >= 2 * root.corner && root.hole-h >= 2 * root.corner;

    // The menu's own geometry tokens.
    property <length> margin: Sizing.pct-h(2);
    property <length> gap: Sizing.pct-w(1.2);
    property <length> row-h: Sizing.pct-h(6);
    property <length> row-sp: Sizing.pct-h(1);
    // The row's own text inset, which is a horizontal measure inside a
    // row rather than the panel's lip; the browse list's row text padding
    // is the same kind of value.
    property <length> label-inset: Sizing.pct-w(2);
    // The panel's lip: the shared surface inset, all four sides. A menu is
    // a panel like any other, so it takes the same number rather than a
    // second scale a hair below it.
    property <length> pad: Sizing.surface-pad;
    property <length> panel-radius: Sizing.radius-md;
    property <length> min-panel-w: Sizing.pct-w(12);
    // A vertical layout's preferred width is the widest child's, which
    // is the measurement the panel sizes around; measured at the
    // selected row's weight so a row cannot outgrow the panel when it
    // gains focus.
    // A row that opens a page reserves its chevron at the trailing edge.
    property <length> chevron: Sizing.pct-h(3);
    property <length> chevron-room: root.chevron + Sizing.pct-w(1);
    // The collections strip: four square buttons a row tall, centered
    // above the rows, which keep their own scroll below it.
    property <bool> has-strip: root.strip.length > 0;
    property <length> strip-button: root.row-h;
    property <length> strip-gap: root.gap;
    property <length> strip-w: root.strip.length * root.strip-button
        + Math.max(0, root.strip.length - 1) * root.strip-gap;
    property <length> strip-band: root.has-strip ? root.strip-button + root.row-sp : 0px;
    measure := VerticalLayout {
        visible: false;
        for entry in root.entries: HorizontalLayout {
            padding-right: entry.role == MenuRole.submenu || entry.role == MenuRole.check-off
                || entry.role == MenuRole.check-on ? root.chevron-room : 0px;
            Text {
                text: entry.label-key != "" ? Labels.menu(entry.label-key, entry.label) : entry.label;
                font-size: Sizing.font-caption;
                font-weight: FontWeight.medium;
            }
        }
    }
    property <length> desired-panel-w: Math.max(measure.preferred-width + 2 * root.label-inset,
        root.strip-w) + 2 * root.pad + 2 * Sizing.stroke(2);
    property <length> panel-w: Math.min(Math.max(root.min-panel-w, root.desired-panel-w),
        Math.max(0px, root.width - 2 * root.margin));
    property <length> rows-h: root.entries.length * root.row-h
        + Math.max(0, root.entries.length - 1) * root.row-sp;
    property <length> content-h: root.rows-h + 2 * root.pad + root.strip-band;
    property <length> usable-bottom: Math.max(root.margin,
        root.height - Sizing.help-bar-clearance - root.margin);
    property <length> panel-h: Math.min(root.content-h,
        Math.max(0px, root.usable-bottom - root.margin));
    // The discovery list can outrun the room the anchor leaves, and until
    // now nothing said so: the panel just clipped. Same reserved band and
    // same cue as the pickers.
    property <bool> scrollable: root.content-h > root.panel-h;
    property <length> arrow: Sizing.pct-h(3);
    property <length> arrow-band: root.scrollable ? root.arrow + Sizing.pct-h(0.5) : 0px;
    property <length> viewport-h: Math.max(0px,
        root.panel-h - 2 * root.pad - root.strip-band - 2 * root.arrow-band);
    // Keep the focused row in view.
    property <length> row-bottom: (root.current-index + 1) * root.row-h
        + root.current-index * root.row-sp;
    property <length> scroll: Math.max(0px, Math.min(root.row-bottom - root.viewport-h,
        root.rows-h - root.viewport-h));

    // Measured off the hole, not the layout rect: the gap should read from
    // the tile's painted edge, which is where the zoom put it.
    property <bool> fits-right: root.hole-x + root.hole-w + root.gap + root.panel-w <= root.width - root.margin;
    property <bool> fits-left: root.hole-x - root.gap - root.panel-w >= root.margin;
    property <bool> beside: root.fits-right || root.fits-left;
    property <bool> fits-below: root.hole-y + root.hole-h + root.gap + root.panel-h <= root.usable-bottom;
    property <length> panel-x: Sizing.snap(Math.min(Math.max(root.beside
        ? (root.fits-right ? root.hole-x + root.hole-w + root.gap : root.hole-x - root.gap - root.panel-w)
        : root.hole-x + (root.hole-w - root.panel-w) / 2, root.margin),
        root.width - root.margin - root.panel-w));
    property <length> raw-y: root.beside
        ? root.hole-y + (root.hole-h - root.panel-h) / 2
        : (root.fits-below ? root.hole-y + root.hole-h + root.gap : root.hole-y - root.gap - root.panel-h);
    property <length> panel-y: Sizing.snap(Math.min(Math.max(root.raw-y, root.margin),
        root.usable-bottom - root.panel-h));

    // Four bands around the hole: the tile the menu is about stays bright
    // while the rest of the screen dims.
    Rectangle { x: 0; y: 0; height: root.hole-y; background: Theme.scrim; }
    Rectangle { x: 0; y: root.hole-y + root.hole-h; height: Math.max(0px, parent.height - root.hole-y - root.hole-h); background: Theme.scrim; }
    Rectangle { x: 0; y: root.hole-y; width: root.hole-x; height: root.hole-h; background: Theme.scrim; }
    Rectangle { x: root.hole-x + root.hole-w; y: root.hole-y; width: Math.max(0px, parent.width - root.hole-x - root.hole-w); height: root.hole-h; background: Theme.scrim; }
    // Four masks take the bands' square hole down to the anchor's rounded
    // silhouette. They sit inside the hole, in its own corners, never over
    // a band -- the scrim is translucent, so an overlap would composite to
    // a darker patch.
    if root.cut-corners: Image {
        x: root.hole-x; y: root.hole-y; width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-tl", root.corner, Theme.scrim);
    }
    if root.cut-corners: Image {
        x: root.hole-x + root.hole-w - root.corner; y: root.hole-y;
        width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-tr", root.corner, Theme.scrim);
    }
    if root.cut-corners: Image {
        x: root.hole-x; y: root.hole-y + root.hole-h - root.corner;
        width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-bl", root.corner, Theme.scrim);
    }
    if root.cut-corners: Image {
        x: root.hole-x + root.hole-w - root.corner; y: root.hole-y + root.hole-h - root.corner;
        width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-br", root.corner, Theme.scrim);
    }

    Rectangle {
        x: root.panel-x;
        y: root.panel-y;
        width: root.panel-w;
        height: root.panel-h;
        background: Theme.bg-panel;
        border-radius: root.panel-radius;
        clip: true;

        for button[i] in root.strip: Rectangle {
            property <bool> focused: i == root.strip-index;
            property <length> icon: GlyphSource.side(root.strip-button * 60%);
            property <string> glyph: button.flag == UserFlag.favorite
                ? (button.on ? "icons/HeartFilled" : "icons/HeartOutline")
                : button.flag == UserFlag.like ? (button.on ? "icons/ThumbsUp" : "icons/ThumbsUpOutline")
                : button.flag == UserFlag.dislike ? (button.on ? "icons/ThumbsDown" : "icons/ThumbsDownOutline")
                : (button.on ? "icons/Bookmark" : "icons/BookmarkOutline");
            // Every icon, set (filled) or not (outline), takes the strip's ink.
            property <color> tint: self.focused ? Theme.on-accent : Theme.text-primary;
            x: (parent.width - root.strip-w) / 2 + i * (root.strip-button + root.strip-gap);
            y: root.pad;
            width: root.strip-button;
            height: root.strip-button;
            border-radius: Sizing.radius-sm;
            background: self.focused ? Theme.selection-fill : Colors.transparent;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.icon;
                height: parent.icon;
                source: GlyphSource.glyph(parent.glyph, parent.icon, parent.tint);
                image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
            }
            TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if (self.has-hover) { ContextInput.strip-hovered(i); }
                }
                clicked => { ContextInput.strip-clicked(i); }
            }
        }

        if root.scrollable: ScrollCue {
            x: Sizing.snap((parent.width - self.width) / 2);
            y: root.pad + root.strip-band;
            width: root.arrow;
            glyph: "icons/ScrollUp";
            live: root.scroll > 0px;
        }
        if root.scrollable: ScrollCue {
            x: Sizing.snap((parent.width - self.width) / 2);
            y: parent.height - root.pad - root.arrow;
            width: root.arrow;
            glyph: "icons/ScrollDown";
            live: root.scroll < root.rows-h - root.viewport-h;
        }

        // The rows glide under the cues instead of jumping; the fill
        // travels with them, the same way the settings card scrolls.
        // A held key walks the rows at its repeat cadence, as a list does.
        context-scroll := ScrollOffset {
            target: root.scroll;
            step: root.viewport-h;
            reveal: true;
            duration: Overlays.context-step-ms > 0 ? Overlays.context-step-ms * 1ms : Motion.scroll-ms;
            steady: Overlays.context-step-ms > 0;
            viewport: root.viewport-h;
            scope: "context:" + Motion.epoch;
        }
        Rectangle {
        x: 0;
        y: root.pad + root.strip-band + root.arrow-band;
        height: root.viewport-h;
        clip: true;

        Rectangle {
        y: root.scroll - context-scroll.offset;
        height: parent.height;

        sel := SelectionCursor {
            press-held: PressFeedback.active(PressOwner.context, root.current-index);
            target: { x: root.pad, y: root.current-index * (root.row-h + root.row-sp) - root.scroll,
                w: parent.width - 2 * root.pad, h: root.row-h, column: 0, row: root.current-index,
                scope: "context:" + root.scroll / 1px,
                valid: root.current-index >= 0 && root.current-index < root.entries.length };
        }
        for entry[i] in root.entries: Rectangle {
            x: root.pad;
            y: i * (root.row-h + root.row-sp) - root.scroll;
            width: parent.width - 2 * root.pad;
            height: root.row-h;

            // Entering the strip clears the row selection; the cursor keeps its
            // last place, so a row is lit only while a row has focus.
            property <bool> lit: root.current-index >= 0
                && sel.fill-bottom > self.y && sel.fill-top < self.y + self.height;

            ContextRowBody {
                label: entry.label-key != "" ? Labels.menu(entry.label-key, entry.label) : entry.label;
                pad-x: root.label-inset;
                pad-end: root.label-inset + (entry.role == MenuRole.submenu || entry.role == MenuRole.check-off
                    || entry.role == MenuRole.check-on ? root.chevron-room : 0px);
                content-color: entry.enabled ? Theme.text-primary : Theme.text-label;
                weight: FontWeight.normal;
                opens-page: entry.role == MenuRole.submenu;
                checkable: entry.role == MenuRole.check-off || entry.role == MenuRole.check-on;
                checked: entry.role == MenuRole.check-on;
                chevron: root.chevron;
                inset: root.label-inset;
            }
            if lit: SelectionClip {
                row-top: parent.y; row-height: parent.height;
                fill-top: sel.fill-top; fill-bottom: sel.fill-bottom;
                fill: sel.fill;
                ContextRowBody {
                    label: entry.label-key != "" ? Labels.menu(entry.label-key, entry.label) : entry.label;
                    pad-x: root.label-inset;
                    pad-end: root.label-inset + (entry.role == MenuRole.submenu || entry.role == MenuRole.check-off
                        || entry.role == MenuRole.check-on ? root.chevron-room : 0px);
                    content-color: entry.enabled ? sel.content : sel.content-muted;
                    weight: FontWeight.medium;
                    opens-page: entry.role == MenuRole.submenu;
                    checkable: entry.role == MenuRole.check-off || entry.role == MenuRole.check-on;
                    checked: entry.role == MenuRole.check-on;
                    chevron: root.chevron;
                    inset: root.label-inset;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if (self.has-hover) { ContextInput.row-hovered(i); }
                }
                clicked => { ContextInput.row-clicked(i); }
            }
        }
        }
        }
    }
}

// Games, Favorites and Recently played: one shell over the shared paged
// grid. The folder rules, paging and persistence live in src/games.rs;
// this paints the page Rust pushes into GamesView. The detailed list
// still uses the prototype rows.

component GamesScreen inherits Rectangle {
    in property <bool> gated: false;
    property <bool> list-layout: Shell.browse-list-layout;
    property <bool> list-only: Shell.browse-list-only;
    property <bool> tate-list: self.list-layout && Shell.orientation != Orientation.horizontal;
    property <bool> is-games: GamesView.mode == GamesMode.browse;
    property <string> title: GamesView.mode == GamesMode.favorites ? Labels.list-title(Shell.active-list)
        : GamesView.mode == GamesMode.decks ? @tr("Decks")
        : GamesView.mode == GamesMode.top-played ? @tr("Top played")
        : (GamesView.mode == GamesMode.deck ? GamesView.title
        : (GamesView.mode == GamesMode.recents ? @tr("Recently played")
        : (GamesView.mode == GamesMode.search && GamesView.display-title() == "" ? @tr("Search") : GamesView.display-title())));
    property <ContentState> state: GamesView.error != "" ? ContentState.error
        : (GamesView.loading ? ContentState.loading : (GamesView.count == 0 ? ContentState.empty : ContentState.ready));
    property <bool> gate-hide: root.gated || GamesView.loading || cue.loading-visible || GamesView.error != "";
    property <bool> page-cue-in-footer: Layout.page-cue-in-footer;
    property <bool> show-grid-page-cue: !root.list-layout && !root.page-cue-in-footer;
    property <bool> show-top-page-cue: root.show-grid-page-cue || (root.list-layout && !root.page-cue-in-footer);
    // Core's file total as "{} games" (Games only; the flat lists carry
    // no known total). The 240p footer keeps the bare number.
    property <string> count-text: GamesView.mode == GamesMode.decks
        ? (GamesView.count <= 0 ? ""
            : (Sizing.tier-240 ? Labels.count(GamesView.count) : @tr("{n} deck" | "{n} decks" % GamesView.count)))
        : (!root.is-games || GamesView.total-files <= 0 ? ""
        : (Sizing.tier-240 ? Labels.count(GamesView.total-files) : @tr("{} games", Labels.count(GamesView.total-files))));
    // The browse filter's name, then the count where the grid shows one.
    property <string> filter-and-count: GamesView.filter-text == "" ? root.count-text
        : (root.count-text == "" ? GamesView.filter-text : @tr("{} · {}", GamesView.filter-text, root.count-text));
    // The footer's left text, where the strip is hidden and the footer
    // keeps the count.
    property <string> footer-left-text: root.list-layout ? GamesView.filter-text : root.filter-and-count;

    TopStatusStrip {
        x: 0;
        y: Sizing.header-bottom + Layout.top-margin;
        height: Layout.strip-height;
        slot-margin: Layout.slot-margin;
        title: root.title;
        current-page: root.list-layout ? GamesView.list-page : GamesView.page;
        total-pages: root.list-layout ? GamesView.list-total-pages : GamesView.total-pages;
        page-total-known: GamesView.total-known;
        total-text: root.count-text;
        filter-text: root.is-games ? GamesView.filter-text : "";
        show-page-counter: root.show-top-page-cue;
        page-indicator-mode: root.show-top-page-cue;
        item-position-mode: root.list-layout;
        current-item: GamesView.current-index;
        total-items: GamesView.total-items;
        page-indicator-chevron-size: Layout.grid-page-chevron-size;
        has-pages-above: root.list-layout ? GamesView.has-items-above : GamesView.has-pages-above;
        has-pages-below: root.list-layout ? GamesView.has-items-below : GamesView.has-pages-below;
        visible: !root.gate-hide && Layout.top-strip-visible;
        page-requested(delta) => { GamesInput.page-requested(delta); }
    }

    // The Menu chip row, under the strip.
    MenuChipRow {
        x: 0;
        y: Sizing.header-bottom + Layout.top-margin + Layout.strip-height + Sizing.menu-row-gap;
        height: Sizing.menu-row-height;
        chips: PageBar.games-chips;
        side-inset: Layout.slot-margin;
        visible: !root.gate-hide && PageBar.shown(PageBar.games-chips);
    }

    // The current and the incoming page in the shared page-turn strip.
    if !root.list-layout: games-strip := PageStrip {
        x: 0;
        y: GamesView.grid-y;
        height: GamesView.grid-height - Sizing.label-raise;
        visible: !root.gate-hide;
        page-slide: GamesView.page-slide;
        slide-anim: GamesView.slide-anim;
        slide-dir: GamesView.slide-dir;

        PagedGridView {
            x: 0;
            y: 0;
            cells: GamesView.cells;
            focus-scope: StateTokens.games(GamesView.mode) + ":" + GamesView.title + ":" + GamesView.page;
            focus-motion: GamesView.page-slide == 0 && !GamesView.cached-transition;
            columns: GamesView.columns;
            cell-width: GamesView.cell-width;
            cell-height: GamesView.cell-height;
            block-offset-x: GamesView.block-offset-x;
            block-offset-y: GamesView.block-offset-y;
            left-inset: Layout.grid-left-inset;
            top-inset: Layout.grid-top-inset;
            column-gap: Layout.grid-column-gap;
            row-gap: Layout.grid-row-gap;
            selected-local: GamesView.cached-transition ? -1 : GamesView.selected-local;
            held-local: GamesView.moving ? GamesView.selected-local : -1;
            ring-suppressed: Overlays.context-open;
            // Focus is on the Menu chip row: the tile drops its zoom, tint and
            // focused cover as well as its ring.
            section-focused: !PageBar.focused;
            focus-ready: GamesView.focus-ready;
            press-held: PressFeedback.active(PressOwner.games, GamesView.selected-local);
            show-caption: true;
            card-radius: Layout.card-radius;
            caption-for(cell) => { return cell.name; }
            cell-hovered(i) => { GamesInput.cell-hovered(i); }
            cell-clicked(i) => { GamesInput.cell-clicked(i); }
            cell-right-clicked(i) => { GamesInput.cell-right-clicked(i); }
            wheel(delta) => { GamesInput.wheel(delta); }
        }
        PagedGridView {
            y: games-strip.incoming-y;
            cells: GamesView.next-cells;
            columns: GamesView.columns;
            cell-width: GamesView.cell-width;
            cell-height: GamesView.cell-height;
            block-offset-x: GamesView.block-offset-x;
            block-offset-y: GamesView.block-offset-y;
            left-inset: Layout.grid-left-inset;
            top-inset: Layout.grid-top-inset;
            column-gap: Layout.grid-column-gap;
            row-gap: Layout.grid-row-gap;
            selected-local: -1;
            focus-ready: false;
            show-caption: true;
            card-radius: Layout.card-radius;
            caption-for(cell) => { return cell.name; }
        }
    }

    // Detailed list: BrowseListDetailView over the games list profile.
    property <length> list-card-x: Layout.card-side-margin;
    property <length> list-card-y: Sizing.header-bottom + Layout.top-margin + Layout.strip-height
        + (PageBar.shown(PageBar.games-chips) ? Sizing.menu-row-block : 0px) + Layout.card-top-margin;
    property <length> list-card-w: self.width - 2 * self.list-card-x;
    property <length> list-card-h: self.height - self.list-card-y - (Sizing.tier-240 ? Sizing.help-bar-height + Layout.card-bottom-margin - Sizing.help-bar-band : Layout.card-bottom-margin);

    // Where the list card sits, for a glass background. Reported whenever
    // the list layout is on, loading or not, so the darker card area stays
    // put while the rows load.
    GlassCard {
        shown: root.list-layout;
        x: root.list-card-x;
        y: root.list-card-y;
        width: root.list-card-w;
        height: root.list-card-h;
        radius: Layout.card-radius;
    }

    if root.list-layout && !root.list-only && !root.gate-hide: BrowseListDetailView {
        glass: Backdrop.glass;
        x: root.list-card-x;
        y: root.list-card-y;
        width: root.list-card-w;
        height: root.list-card-h;
        rows: GamesView.list-rows;
        model-top: GamesView.list-view-top;
        glide: GamesView.list-glide;
        step: GamesView.list-step-ms * 1ms;
        scroll-top: GamesView.list-scroll-top;
        scope: StateTokens.games(GamesView.mode) + ":" + GamesView.title;
        selected: GamesView.list-sel;
        held: GamesView.moving;
        info: GamesView.info;
        focus-ready: GamesView.focus-ready && !PageBar.focused;
        activate-pulse: GamesView.activate-pulse;
        release-pulse: GamesView.release-pulse;
        settling: Shell.active-screen != GamesView.screen;
        row-height: GamesView.list-row-height;
        detail-title: GamesView.detail-title;
        show-title: false;
        cover: GamesView.detail-cover;
        has-cover: GamesView.detail-has-cover;
        cover-absent: GamesView.detail-cover-absent;
        image-index: GamesView.detail-image-index;
        image-count: GamesView.detail-image-count;
        image-kind: GamesView.detail-image-kind;
        art-box(w, h) => { GamesInput.detail-art-box(Math.round(w / 1px), Math.round(h / 1px)); }
        wordmark: false;
        detail-rows: GamesView.detail-rows;
        detail-loading: GamesView.detail-loading;
        loading-text: @tr("Loading game…");
        row-hovered(i) => { GamesInput.cell-hovered(i); }
        row-clicked(i) => { GamesInput.cell-clicked(i); }
        row-right-clicked(i) => { GamesInput.cell-right-clicked(i); }
        wheel(delta) => { GamesInput.wheel(delta); }
    }

    // Text-only list: BrowseList standalone, no detail pane.
    if root.list-only && !root.gate-hide: BrowseList {
        glass: Backdrop.glass;
        x: root.list-card-x;
        y: root.list-card-y;
        width: root.list-card-w;
        height: root.list-card-h;
        show-chrome: true;
        rows: GamesView.list-rows;
        model-top: GamesView.list-view-top;
        glide: GamesView.list-glide;
        step: GamesView.list-step-ms * 1ms;
        scroll-top: GamesView.list-scroll-top;
        scope: StateTokens.games(GamesView.mode) + ":" + GamesView.title;
        selected: GamesView.list-sel;
        held: GamesView.moving;
        show-focus-facts: true;
        focus-info: GamesView.info;
        focus-ready: GamesView.focus-ready;
        activate-pulse: GamesView.activate-pulse;
        release-pulse: GamesView.release-pulse;
        settling: Shell.active-screen != GamesView.screen;
        row-height: GamesView.list-row-height;
        row-hovered(i) => { GamesInput.cell-hovered(i); }
        row-clicked(i) => { GamesInput.cell-clicked(i); }
        row-right-clicked(i) => { GamesInput.cell-right-clicked(i); }
        wheel(delta) => { GamesInput.wheel(delta); }
    }

    // The focused row's name and dim suffix stay below the grid. CRT,
    // which has no title strip, also keeps its count and cue here.
    // A page fetch the user is waiting on replaces the name.
    property <length> label-y: GamesView.label-y;
    property <length> footer-left-inset: Math.min(Math.ceil(footer-count-measure.preferred-width / 1px) * 1px, root.width * 0.4) + Layout.bottom-status-left-margin;
    property <length> footer-right-inset: footer-indicator.width + Layout.bottom-status-right-margin;

    footer-count-measure := Text {
        visible: false;
        text: root.footer-left-text;
        font-size: Sizing.font-section;
    }

    if !root.list-layout: InfoLineLabel {
        x: 0;
        y: root.label-y - Sizing.label-raise;
        height: GamesView.label-height;
        side-inset: root.page-cue-in-footer
            ? (Layout.top-strip-visible ? root.footer-right-inset : Math.max(root.footer-left-inset, root.footer-right-inset))
            : Layout.slot-margin;
        info: GamesView.info;
        visible: !root.gate-hide && !PageBar.focused;
    }

    if !Layout.top-strip-visible && root.page-cue-in-footer && root.footer-left-text != "": Text {
        x: Layout.bottom-status-left-margin;
        y: Sizing.snap(root.label-y + (GamesView.label-height - self.height) / 2) - Sizing.label-raise;
        width: root.footer-left-inset - Layout.bottom-status-left-margin;
        height: Sizing.font-section;
        vertical-alignment: center;
        overflow: elide;
        text: root.footer-left-text;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
        visible: !root.gate-hide;
    }

    footer-indicator := FooterIndicator {
        right-margin: Layout.bottom-status-right-margin;
        cue-y: Sizing.snap(root.label-y + (GamesView.label-height - self.height) / 2) - Sizing.label-raise;
        current-page: root.list-layout ? GamesView.list-page : GamesView.page;
        total-pages: root.list-layout ? GamesView.list-total-pages : GamesView.total-pages;
        item-position-mode: root.list-layout;
        current-item: GamesView.current-index;
        total-items: GamesView.total-items;
        page-total-known: GamesView.total-known;
        has-pages-above: root.list-layout ? GamesView.has-items-above : GamesView.has-pages-above;
        has-pages-below: root.list-layout ? GamesView.has-items-below : GamesView.has-pages-below;
        visible: !root.gate-hide && root.page-cue-in-footer;
        page-requested(delta) => { GamesInput.page-requested(delta); }
    }

    // Where a fast scroll is, on the right edge of the grid or list. Over
    // the HDMI list it sits inside the card, clear of its border by the
    // card's own padding: lined up with the border, a pixel of rounding
    // reads as a near miss.
    property <bool> rail-in-card: root.list-layout && !Sizing.crt;
    FastScrollRail {
        x: root.width - self.width - (Sizing.crt ? Layout.card-side-margin
            : root.rail-in-card ? root.list-card-x + Layout.card-padding-right : Sizing.pct-w(1));
        y: root.list-layout ? root.list-card-y + (root.rail-in-card ? Layout.card-padding-top : 0px) : GamesView.grid-y;
        height: root.list-layout
            ? root.list-card-h - (root.rail-in-card ? Layout.card-padding-top + Layout.card-padding-bottom : 0px)
            : GamesView.grid-height;
        shown: !root.gate-hide && GamesView.rail-visible && GamesView.count > 0;
        letters: GamesView.rail-letters;
        current: GamesView.rail-index;
        letter: GamesView.rail-letter;
        fraction: GamesView.rail-fraction;
    }

    cue := StateCue {
        x: 0;
        y: root.list-layout ? root.list-card-y : GamesView.grid-y;
        height: root.list-layout ? Math.max(0px, root.height - root.list-card-y - Layout.overlay-bottom-margin) : GamesView.grid-height;
        cue-center-y: root.height / 2 - self.y;
        state: GamesView.folder-slide ? ContentState.ready : root.state;
        empty-text: GamesView.mode == GamesMode.favorites ? Labels.list-empty(Shell.active-list)
            : GamesView.mode == GamesMode.deck ? @tr("This deck is empty")
            : GamesView.mode == GamesMode.decks ? @tr("No decks yet")
            : (GamesView.mode == GamesMode.recents || GamesView.mode == GamesMode.top-played ? @tr("Nothing played yet")
            : (GamesView.mode == GamesMode.search ? @tr("No matches")
            : (GamesView.filter-text != "" ? @tr("No games match these tags") : @tr("No games in this system"))));
        loading-text: GamesView.mode == GamesMode.favorites ? Labels.list-loading(Shell.active-list)
            : GamesView.mode == GamesMode.deck ? @tr("Loading deck…")
            : GamesView.mode == GamesMode.decks ? @tr("Loading decks…")
            : GamesView.mode == GamesMode.top-played ? @tr("Loading top played…")
            : (GamesView.mode == GamesMode.recents ? @tr("Loading recently played…")
            : (GamesView.mode == GamesMode.search ? @tr("Searching…") : @tr("Loading games…")));
        error-detail: GamesView.error;
    }
}

// Full-framebuffer 240p-test-suite style calibration pattern. Mounted
// by App outside the rotated/safe-area scene so every guide maps to a
// physical scanout pixel. Rust owns input and live DDR offset updates.
component CrtCalibrationPattern inherits Rectangle {
    background: #000000;
    property <length> stroke: Sizing.stroke(1);
    property <length> action-x: Math.round(self.width * 0.05 / 1px) * 1px;
    property <length> action-y: Math.round(self.height * 0.05 / 1px) * 1px;
    property <length> title-x: Math.round(self.width * 0.10 / 1px) * 1px;
    property <length> title-y: Math.round(self.height * 0.10 / 1px) * 1px;

    for col in 17: Rectangle {
        x: Math.min(parent.width - root.stroke,
            Math.round(col * (parent.width - root.stroke) / 16px) * 1px);
        y: 0;
        width: root.stroke;
        background: Theme.text-label;
    }
    for row in 13: Rectangle {
        x: 0;
        y: Math.min(parent.height - root.stroke,
            Math.round(row * (parent.height - root.stroke) / 12px) * 1px);
        height: root.stroke;
        background: Theme.text-label;
    }

    Rectangle {
        x: 0;
        y: 0;
        border-width: root.stroke;
        border-color: Theme.text-primary;
    }
    Rectangle {
        x: root.action-x;
        y: root.action-y;
        width: parent.width - 2 * root.action-x;
        height: parent.height - 2 * root.action-y;
        border-width: root.stroke;
        border-color: Theme.accent;
    }
    Rectangle {
        x: root.title-x;
        y: root.title-y;
        width: parent.width - 2 * root.title-x;
        height: parent.height - 2 * root.title-y;
        border-width: root.stroke;
        border-color: Theme.text-primary;
    }

    // Readout plate. Sized by its own layout so no row can outgrow the
    // border (the old fixed formula overflowed at 240p where fonts
    // quantize to 8 px), translucent so the guides it covers stay
    // readable, and parked on the lower third so the center crossing
    // stays clear while adjusting.
    plate := Rectangle {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: parent.height * 0.62;
        width: plate-rows.preferred-width;
        height: plate-rows.preferred-height;
        background: #000000CC;
        border-width: root.stroke;
        border-color: Theme.text-primary;

        plate-rows := VerticalLayout {
            padding: Sizing.pct-min(2);
            spacing: Sizing.pct-h(1);
            Text {
                horizontal-alignment: center;
                text: "H \{Overlays.crt-h-offset}  V \{Overlays.crt-v-offset}  W \{Overlays.crt-h-size}";
                color: Theme.text-primary;
                font-size: Sizing.font-size(3.2);
                font-weight: FontWeight.semi-bold;
            }
            Text {
                horizontal-alignment: center;
                text: Overlays.crt-size-mode
                    ? @tr("Left/Right adjust width")
                    : @tr("Arrows adjust position");
                color: Theme.accent;
                font-size: Sizing.font-size(2.4);
            }
            // The mode switch, named with the controller's own button: the
            // help bar that also lists it is under this full-screen pattern.
            Rectangle {
                property <length> glyph: GlyphSource.help-side();
                property <length> gap: Sizing.pct-w(1);
                property <length> row-w: self.glyph + self.gap + switch-label.preferred-width;
                min-width: self.row-w;
                height: Math.max(self.glyph, switch-label.preferred-height);
                Image {
                    x: Sizing.snap((parent.width - parent.row-w) / 2);
                    y: (parent.height - self.height) / 2;
                    width: parent.glyph;
                    height: parent.glyph;
                    source: GlyphSource.glyph(Buttons.key("ButtonX"), parent.glyph, Theme.text-primary);
                    image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
                }
                switch-label := Text {
                    x: Sizing.snap((parent.width - parent.row-w) / 2) + parent.glyph + parent.gap;
                    y: (parent.height - self.height) / 2;
                    text: Overlays.crt-size-mode ? @tr("Adjust position") : @tr("Adjust width");
                    color: Theme.text-primary;
                    font-size: Sizing.font-size(2.4);
                }
            }
            Text {
                horizontal-alignment: center;
                text: @tr("Accept or Back saves");
                color: Theme.text-label;
                font-size: Sizing.font-size(2.4);
            }
        }
    }
}

component RouteScreen inherits Rectangle {
    in property <Screen> screen-token: Screen.hub;
    in property <bool> outgoing: false;
    // Hold this screen's content hidden even though the global cue is
    // down: set on the outgoing half of a route slide.
    in property <bool> gated: false;

    if root.screen-token == Screen.hub && !Shell.boot-curtain: HubScreen {
        gated: root.gated;
    }

    if root.screen-token == Screen.systems || root.screen-token == Screen.favorite-systems
        || root.screen-token == Screen.top-played-systems: SystemsScreen {
        gated: root.gated;
    }

    if root.screen-token == Screen.settings: SettingsScreen {
        outgoing: root.outgoing;
    }

    if root.screen-token == Screen.about: AboutScreen {}

    if root.screen-token == Screen.update: UpdateScreen {}

    if root.screen-token == Screen.search: SearchScreen {}

    if root.screen-token == Screen.rename: RenameScreen {}
    if root.screen-token == Screen.ra-login: RaLoginScreen {}

    if root.screen-token == Screen.file-browser: FileBrowserScreen {}

    if root.screen-token == Screen.music: Rectangle {
        MusicScreen {
            content-focused: !PageBar.focused;
        }
        // The Menu chip row, under the strip.
        MenuChipRow {
            x: 0;
            y: Sizing.header-bottom + Layout.top-margin + Layout.strip-height + Sizing.menu-row-gap;
            height: Sizing.menu-row-height;
            chips: PageBar.music-chips;
            side-inset: Layout.slot-margin;
            visible: PageBar.shown(PageBar.music-chips);
        }
    }

    if root.screen-token == Screen.games || root.screen-token == Screen.favorites
        || root.screen-token == Screen.recents || root.screen-token == Screen.search-results
        || root.screen-token == Screen.deck || root.screen-token == Screen.decks
        || root.screen-token == Screen.top-played: GamesScreen {
        gated: root.gated;
    }
}

export component App inherits Window {
    callback game-info-scroll(ScrollAction);
    // Up or Down on the focused description scrolls it first; true when
    // it did, so focus stays.
    callback game-info-step-within(bool) -> bool;
    game-info-step-within(down) => { info-modal.step-within(down) }
    game-info-scroll(action) => {
        if (manual-reader.reading) {
            manual-reader.scroll(action);
        } else {
            info-modal.scroll(action);
        }
    }
    title: @tr("Zaparoo Frontend");
    background: Theme.bg-deep;
    default-font-family: Theme.font-ui;
    preferred-width: 1280px;
    preferred-height: 720px;

    // Native CRT keeps all interaction inside the action-safe area while
    // App's own background remains full bleed. The 12px inset follows the
    // scanline axis (framebuffer width) and the 5% inset follows the
    // other axis (framebuffer height). In TATE the window axes swap, so
    // the formulas swap with them to stay on the correct physical axis.
    property <bool> tate: Shell.orientation == Orientation.cw || Shell.orientation == Orientation.ccw;
    property <length> crt-inset-w: Theme.crt
        ? (root.tate ? 2 * Math.round(self.width * 0.05 / 1px) * 1px : 12px)
        : 0px;
    property <length> crt-inset-h: Theme.crt
        ? (root.tate ? 12px : 2 * Math.round(self.height * 0.05 / 1px) * 1px)
        : 0px;
    property <length> scene-width: Math.max(1px, self.width - self.crt-inset-w);
    property <length> scene-height: Math.max(1px, self.height - self.crt-inset-h);

    pure function browse-header-title() -> string {
        if (!Layout.title-in-header) { return ""; }
        if (Shell.active-screen == Screen.settings) { return SettingsLabels.page-title(SettingsView.page); }
        if (Shell.active-screen == Screen.systems) { return Labels.hub("category:" + SystemsView.category, SystemsView.category); }
        if (Shell.active-screen == Screen.favorite-systems) { return Labels.list-title(Shell.active-list); }
        if (Shell.active-screen == Screen.games) { return GamesView.title; }
        if (Shell.active-screen == Screen.favorites) { return Labels.list-title(Shell.active-list); }
        if (Shell.active-screen == Screen.recents) { return @tr("Recently played"); }
        if (Shell.active-screen == Screen.decks) { return @tr("Decks"); }
        if (Shell.active-screen == Screen.deck) { return GamesView.title; }
        if (Shell.active-screen == Screen.top-played) { return @tr("Top played"); }
        if (Shell.active-screen == Screen.top-played-systems) { return @tr("Top played"); }
        if (Shell.active-screen == Screen.search) { return SearchView.title(); }
        if (Shell.active-screen == Screen.rename) {
            return RenameView.purpose == RenamePurpose.new-deck ? @tr("New deck")
                : (RenameView.purpose == RenamePurpose.rename-deck ? @tr("Rename deck") : @tr("Rename tile"));
        }
        if (Shell.active-screen == Screen.ra-login) { return @tr("RetroAchievements"); }
        if (Shell.active-screen == Screen.file-browser) {
            return FileBrowserView.places ? @tr("Places") : FileBrowserView.title;
        }
        if (Shell.active-screen == Screen.music) {
            return MusicView.page == MusicPage.library
                ? (MusicView.library-top ? @tr("Browse music") : MusicView.library-title)
                : MusicView.page == MusicPage.player || MusicView.playlist-name == "" ? @tr("Background music")
                : MusicView.playlist-name;
        }
        if (Shell.active-screen == Screen.search-results) {
            return GamesView.display-title() == "" ? @tr("Search") : GamesView.display-title();
        }
        return "";
    }

    pure function has-modal() -> bool {
        return LogUploadView.open || SetupModalView.open || GameInfoView.modal-open || Overlays.card-write-open || Overlays.qr-open
            || Overlays.pair-open || Overlays.online-open || Overlays.online-list-open || Overlays.launcher-prefs-open || Overlays.dialog-open || Overlays.list-open || Overlays.letter-open
            || Overlays.context-open || CoreUiView.kind == CoreUiKind.picker;
    }

    // Router state, owned by Rust.
    // Media-database build progress (indexing/optimizing); wins the
    // header's status slot over transient status text while active.

    // Help-bar vocabulary: the `help-entries` table over the state the
    // globals carry. Modal rows win outright; per-screen
    // rows vary with the data state. Button names are semantic tokens
    // (ButtonA = confirm, ButtonB = cancel, ButtonX = options,
    // ButtonY = menu) resolved by the Buttons global. D-pad is always
    // "Move"; A is "Open" for drill-downs and launches; B is "Back" on
    // every screen with one to go back to; L/R shoulder glyphs join the
    // Move cue only when there is a second page to jump to. The source
    // row stays put during a forward transition: the input gate
    // swallows presses, but a bar that empties reads as dismantling.
    // What A does on the focused item of Game Info, or "" where it does
    // nothing.
    pure function info-action() -> string {
        // Nothing focused (a failed panel, or nothing on it acts): every
        // stop is -1 then, so the comparisons below would all match.
        if (GameInfoView.focus < 0) { return ""; }
        if (GameInfoView.focus == GameInfoView.image-stop) { return @tr("View"); }
        if (GameInfoView.focus == GameInfoView.manual-stop) { return @tr("Open"); }
        if (GameInfoView.focus == GameInfoView.description-stop) { return ""; }
        if (GameInfoView.focus >= 0 && GameInfoView.focus > GameInfoView.description-stop
            && GameInfoView.focus > GameInfoView.manual-stop && GameInfoView.focus > GameInfoView.image-stop) {
            return @tr("Search");
        }
        return "";
    }
    // A manual's page turn, and the fit Accept switches to.
    pure function manual-page-cue() -> HelpEntry {
        return { buttons: ["ButtonL", "ButtonR", "DpadLeft", "DpadRight"], label: @tr("Page") };
    }
    pure function manual-fit-cue() -> HelpEntry {
        return { buttons: ["ButtonA"], label: GameInfoView.manual-fit == ManualFit.width ? @tr("Whole page") : @tr("Fit width") };
    }
    // A list whose Left and Right step images moves only up and down.
    pure function list-move-cue(pages: int) -> HelpEntry {
        return { buttons: pages > 1 ? ["ButtonL", "ButtonR", "DpadUp", "DpadDown"] : ["DpadUp", "DpadDown"], label: @tr("Move") };
    }
    pure function move-cue(pages: int) -> HelpEntry {
        return { buttons: pages > 1 ? ["ButtonL", "ButtonR", "Dpad"] : ["Dpad"], label: @tr("Move") };
    }
    // The help bar is the contract for what a button does. A control that
    // cannot be used right now offers no Accept; see docs/style.md,
    // "Disabled controls".
    pure function focused-settings-enabled() -> bool {
        return SettingsView.index >= 0 && SettingsView.index < SettingsView.rows.length
            ? SettingsView.rows[SettingsView.index].enabled : true;
    }
    pure function focused-settings-control() -> ControlKind {
        return SettingsView.index >= 0 && SettingsView.index < SettingsView.rows.length
            ? SettingsView.rows[SettingsView.index].control : ControlKind.none;
    }
    pure function update-help-label(label: UpdateHelpLabel) -> string {
        if (label == UpdateHelpLabel.move) { return @tr("Move"); }
        if (label == UpdateHelpLabel.select) { return @tr("Select"); }
        if (label == UpdateHelpLabel.start) { return @tr("Start"); }
        if (label == UpdateHelpLabel.cancel) { return @tr("Cancel"); }
        if (label == UpdateHelpLabel.close) { return @tr("Close"); }
        if (label == UpdateHelpLabel.toggle) { return @tr("Toggle"); }
        if (label == UpdateHelpLabel.info) { return @tr("Info"); }
        return @tr("Back");
    }
    pure function update-help-entry(index: int) -> HelpEntry {
        return { buttons: [UpdateView.help[index].button], label: root.update-help-label(UpdateView.help[index].label) };
    }
    // The Search screen: the keyboard types, deletes and spaces; a field
    // opens its picker.
    pure function search-help-entries() -> [HelpEntry] {
        // A real keyboard types, deletes and spaces with its own keys.
        // The Search key with nothing to search for does nothing.
        if (SearchView.zone == SearchZone.keys && SearchView.key-kind == KeyKind.submit && !SearchView.can-search) {
            if (Buttons.style == "style_e") {
                return [
                    { buttons: ["Dpad"], label: @tr("Move") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonY"], label: @tr("Delete") },
                { buttons: ["ButtonX"], label: @tr("Space") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (SearchView.zone == SearchZone.keys && Buttons.style == "style_e") {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: SearchView.key-kind == KeyKind.submit ? @tr("Search") : @tr("Select") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (SearchView.zone == SearchZone.keys) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: SearchView.key-kind == KeyKind.submit ? @tr("Search") : @tr("Select") },
                { buttons: ["ButtonY"], label: @tr("Delete") },
                { buttons: ["ButtonX"], label: @tr("Space") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (SearchView.zone == SearchZone.pane) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: SearchView.pane-on-clear ? @tr("Select") : @tr("Open") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            { buttons: ["Dpad"], label: @tr("Move") },
            { buttons: ["ButtonA"], label: @tr("Change") },
            { buttons: ["ButtonB"], label: @tr("Back") },
        ];
    }
    // The rename screen: the Search keyboard's buttons, with Save on its
    // submit key. A real keyboard types, deletes and spaces with its own
    // keys.
    pure function rename-help-entries() -> [HelpEntry] {
        if (RenameView.key-kind == KeyKind.submit && !RenameView.can-save) {
            if (Buttons.style == "style_e") {
                return [
                    { buttons: ["Dpad"], label: @tr("Move") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonY"], label: @tr("Delete") },
                { buttons: ["ButtonX"], label: @tr("Space") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Buttons.style == "style_e") {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: RenameView.key-kind != KeyKind.submit ? @tr("Select")
                    : (RenameView.purpose == RenamePurpose.new-deck ? @tr("Create") : @tr("Save")) },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            { buttons: ["Dpad"], label: @tr("Move") },
            { buttons: ["ButtonA"], label: RenameView.key-kind != KeyKind.submit ? @tr("Select")
                    : (RenameView.purpose == RenamePurpose.new-deck ? @tr("Create") : @tr("Save")) },
            { buttons: ["ButtonY"], label: @tr("Delete") },
            { buttons: ["ButtonX"], label: @tr("Space") },
            { buttons: ["ButtonB"], label: @tr("Back") },
        ];
    }
    // The RetroAchievements login: the rename keyboard's buttons, with Next
    // on the username and Log in on the password. While the login is
    // checked, Back is the only thing that does anything.
    pure function ra-login-help-entries() -> [HelpEntry] {
        if (RaLoginView.status == RaLoginStatus.verifying) {
            return [{ buttons: ["ButtonB"], label: @tr("Cancel") }];
        }
        if (RaLoginView.key-kind == KeyKind.submit && !RaLoginView.can-submit) {
            if (Buttons.style == "style_e") {
                return [
                    { buttons: ["Dpad"], label: @tr("Move") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonY"], label: @tr("Delete") },
                { buttons: ["ButtonX"], label: @tr("Space") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Buttons.style == "style_e") {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: root.ra-login-accept() },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            { buttons: ["Dpad"], label: @tr("Move") },
            { buttons: ["ButtonA"], label: root.ra-login-accept() },
            { buttons: ["ButtonY"], label: @tr("Delete") },
            { buttons: ["ButtonX"], label: @tr("Space") },
            { buttons: ["ButtonB"], label: @tr("Back") },
        ];
    }
    pure function ra-login-accept() -> string {
        if (RaLoginView.key-kind != KeyKind.submit) { return @tr("Select"); }
        return RaLoginView.step == RaLoginStep.password ? @tr("Log in") : @tr("Next");
    }
    // The launcher preference modal: a held entry moves, everything else
    // is a list to walk.
    pure function launcher-prefs-help-entries() -> [HelpEntry] {
        if (Overlays.launcher-prefs-moving) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Done") },
                { buttons: ["ButtonB"], label: @tr("Cancel") },
            ];
        }
        if (Overlays.launcher-prefs-page == LauncherPrefsPage.add) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Add") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            { buttons: ["Dpad"], label: @tr("Move") },
            { buttons: ["ButtonA"], label: @tr("Select") },
            { buttons: ["ButtonB"], label: Overlays.launcher-prefs-page == LauncherPrefsPage.list ? @tr("Close") : @tr("Back") },
        ];
    }
    // The file browser: Open a folder or a Place, Select a file.
    pure function file-browser-help-entries() -> [HelpEntry] {
        if (FileBrowserView.focused-opens || FileBrowserView.focused-picks) {
            if (FileBrowserView.has-menu) {
                return [
                    self.move-cue(FileBrowserView.mode == FileBrowserMode.plain ? FileBrowserView.list-total-pages : FileBrowserView.total-pages),
                    { buttons: ["ButtonA"], label: FileBrowserView.focused-opens ? @tr("Open") : @tr("Select") },
                    { buttons: ["ButtonY"], label: @tr("Menu") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                self.move-cue(FileBrowserView.mode == FileBrowserMode.plain ? FileBrowserView.list-total-pages : FileBrowserView.total-pages),
                { buttons: ["ButtonA"], label: FileBrowserView.focused-opens ? @tr("Open") : @tr("Select") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (FileBrowserView.has-menu) {
            return [
                self.move-cue(FileBrowserView.mode == FileBrowserMode.plain ? FileBrowserView.list-total-pages : FileBrowserView.total-pages),
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            self.move-cue(FileBrowserView.mode == FileBrowserMode.plain ? FileBrowserView.list-total-pages : FileBrowserView.total-pages),
            { buttons: ["ButtonB"], label: @tr("Back") },
        ];
    }
    // On the collections strip, A says what it would change; on a row it
    // selects.
    pure function context-accept-label() -> string {
        if (Overlays.context-page != ContextPage.root || Overlays.context-strip-index < 0
            || Overlays.context-strip-index >= Overlays.context-strip.length) {
            return @tr("Select");
        }
        let button = Overlays.context-strip[Overlays.context-strip-index];
        if (button.flag == UserFlag.favorite) {
            return Labels.menu(button.on ? "favorite:remove" : "favorite:add", "");
        }
        if (button.flag == UserFlag.like) {
            return Labels.menu(button.on ? "like:remove" : "like:add", "");
        }
        if (button.flag == UserFlag.dislike) {
            return Labels.menu(button.on ? "dislike:remove" : "dislike:add", "");
        }
        return Labels.menu(button.on ? "play_later:remove" : "play_later:add", "");
    }

    // The music player. On the player page A runs the focused control and
    // L and R skip tracks; on the playlist page A plays the focused track
    // (pauses the one playing); on the library page A opens a folder or
    // plays from a track.
    pure function music-help-entries() -> [HelpEntry] {
        if (MusicView.page == MusicPage.library) {
            // A folder that failed to read, or read empty, tries again.
            if (MusicView.state == ContentState.error || MusicView.state == ContentState.empty) {
                return [
                    { buttons: ["ButtonA"], label: @tr("Retry") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (MusicView.state != ContentState.ready) {
                return [{ buttons: ["ButtonB"], label: @tr("Back") }];
            }
            // Options acts on the focused folder, or on a track's folder;
            // Menu on the folder on screen.
            return [
                self.move-cue(MusicView.list-total-pages),
                { buttons: ["ButtonA"], label: MusicView.focused-opens ? @tr("Open") : @tr("Play") },
                { buttons: ["ButtonX"], label: @tr("Options") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (MusicView.page == MusicPage.playlist) {
            if (MusicView.count == 0) {
                return [{ buttons: ["ButtonB"], label: @tr("Back") }];
            }
            return [
                self.move-cue(MusicView.list-total-pages),
                { buttons: ["ButtonA"], label: MusicView.focused-pauses() ? @tr("Pause") : @tr("Play") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (MusicView.focused-button().unavailable != MusicUnavailable.none) {
            if (MusicView.can-skip()) {
                return [
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Move") },
                    { buttons: ["ButtonL", "ButtonR"], label: @tr("Track") },
                    { buttons: ["ButtonY"], label: @tr("Menu") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["DpadLeft", "DpadRight"], label: @tr("Move") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (MusicView.can-skip()) {
            return [
                { buttons: ["DpadLeft", "DpadRight"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: MusicLabels.control(MusicView.focused-button().control) },
                { buttons: ["ButtonL", "ButtonR"], label: @tr("Track") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            { buttons: ["DpadLeft", "DpadRight"], label: @tr("Move") },
            { buttons: ["ButtonA"], label: MusicLabels.control(MusicView.focused-button().control) },
            { buttons: ["ButtonY"], label: @tr("Menu") },
            { buttons: ["ButtonB"], label: @tr("Back") },
        ];
    }
    pure function help-entries() -> [HelpEntry] {
        if (Shell.boot-curtain) {
            return [];
        }
        // Core's picker is above every surface but the decision dialog.
        if (CoreUiView.kind == CoreUiKind.picker && !Overlays.dialog-open) {
            if (CoreUiView.dismissible) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: @tr("Select") },
                    { buttons: ["ButtonB"], label: @tr("Cancel") },
                ];
            }
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Select") },
            ];
        }
        // The uploader: nothing to confirm while it runs.
        if (LogUploadView.open) {
            if (LogUploadView.phase == LogPhase.uploading) {
                return [{ buttons: ["ButtonB"], label: @tr("Back") }];
            }
            return [
                { buttons: ["ButtonA"], label: LogUploadView.phase == LogPhase.failed ? @tr("Retry") : @tr("Done") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // The setup panel: its confirm cue names what the focused row
        // does, and Back steps out of a picker page before the panel.
        if (SetupModalView.open) {
            // A row that cannot be used right now offers no confirm.
            if (!SetupModalView.picker-page && SetupModalView.index >= 0
                && SetupModalView.index < SetupModalView.rows.length
                && !SetupModalView.rows[SetupModalView.index].enabled) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: SettingsLabels.setup-action(
                    SetupModalView.picker-page
                        ? (SetupModalView.picker-toggle ? SetupAction.toggle : SetupAction.select)
                        : (SetupModalView.index >= 0 && SetupModalView.index < SetupModalView.rows.length
                            ? (SetupModalView.rows[SetupModalView.index].control == ControlKind.action
                                ? SetupAction.start
                                : (SetupModalView.rows[SetupModalView.index].control == ControlKind.toggle ? SetupAction.toggle : SetupAction.change))
                            : SetupAction.change)) },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Overlays.dialog-open) {
            if (Overlays.dialog-buttons.length > 1) {
                return [
                    { buttons: ["Dpad"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: @tr("Select") },
                    { buttons: ["ButtonB"], label: @tr("Cancel") },
                ];
            }
            return [
                { buttons: ["ButtonA"], label: Overlays.dialog-buttons.length > 0
                    ? DialogLabels.button(Overlays.dialog-buttons[0])
                    : @tr("OK") },
            ];
        }
        if (Overlays.context-open) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: root.context-accept-label() },
                // Back on a page returns to the rows it replaced.
                { buttons: ["ButtonB", "ButtonX"], label: Overlays.context-page == ContextPage.root
                    ? @tr("Close") : @tr("Back") },
            ];
        }
        if (Overlays.card-write-open) {
            return [{ buttons: ["ButtonB"], label: @tr("Cancel") }];
        }
        if (Overlays.qr-open) {
            return [{ buttons: ["ButtonB"], label: @tr("Close") }];
        }
        // Pairing: while a PIN is live, Back is the only thing that can
        // happen and it calls the pairing off. Once it is finished or
        // spent there is nothing to call off, so both buttons just close.
        // Online link: while a code is live, Back calls it off; once it has
        // an outcome both buttons just close.
        if (Overlays.launcher-prefs-open) {
            return root.launcher-prefs-help-entries();
        }
        if (Overlays.online-list-open) {
            if (Overlays.online-list-kind == OnlineListKind.backups && Overlays.online-list-rows.length > 0
                && Overlays.online-list-index >= 0 && Overlays.online-list-index < Overlays.online-list-rows.length
                && Overlays.online-list-rows[Overlays.online-list-index].enabled
                && Overlays.online-list-status != OnlineListStatus.backing-up
                && Overlays.online-list-status != OnlineListStatus.restoring) {
                return [
                    { buttons: ["Dpad"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: @tr("Select") },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            if (Overlays.online-list-rows.length > 1) {
                return [
                    { buttons: ["Dpad"], label: @tr("Move") },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            return [{ buttons: ["ButtonB"], label: @tr("Close") }];
        }
        if (Overlays.online-open) {
            if (Overlays.online-phase == OnlineLinkPhase.linked || Overlays.online-phase == OnlineLinkPhase.failed
                || Overlays.online-phase == OnlineLinkPhase.expired) {
                return [
                    { buttons: ["ButtonA"], label: @tr("Done") },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            return [{ buttons: ["ButtonB"], label: @tr("Cancel") }];
        }
        if (Overlays.pair-open) {
            if (Overlays.pair-phase == PairPhase.paired || Overlays.pair-phase == PairPhase.expired) {
                return [
                    { buttons: ["ButtonA"], label: @tr("Done") },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            return [{ buttons: ["ButtonB"], label: @tr("Cancel") }];
        }
        if (manual-reader.reading && GameInfoView.viewer-open) {
            if (GameInfoView.image-count > 1) {
                return [
                    { buttons: ["ButtonL", "ButtonR", "DpadLeft", "DpadRight"], label: @tr("Image") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [{ buttons: ["ButtonB"], label: @tr("Back") }];
        }
        if (manual-reader.reading) {
            if (GameInfoView.manual-state != ManualState.ready) {
                return [{ buttons: ["ButtonB"], label: @tr("Back") }];
            }
            if (GameInfoView.manual-pages > 1 && manual-reader.scrollable) {
                return [
                    self.manual-page-cue(),
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Scroll") },
                    self.manual-fit-cue(),
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (GameInfoView.manual-pages > 1) {
                return [
                    self.manual-page-cue(),
                    self.manual-fit-cue(),
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (manual-reader.scrollable) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Scroll") },
                    self.manual-fit-cue(),
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                self.manual-fit-cue(),
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (GameInfoView.modal-open && GameInfoView.values-open) {
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Search") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // What A does follows focus; Left and Right always step the images.
        if (GameInfoView.modal-open && GameInfoView.image-count > 1) {
            if (GameInfoView.focus == GameInfoView.image-stop) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                    { buttons: ["ButtonA"], label: @tr("View") },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            if (self.info-action() != "") {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                    { buttons: ["ButtonA"], label: self.info-action() },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                { buttons: ["ButtonB"], label: @tr("Close") },
            ];
        }
        if (GameInfoView.modal-open) {
            if (self.info-action() != "") {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: self.info-action() },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            if (info-modal.scrollable) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Scroll") },
                    { buttons: ["ButtonB"], label: @tr("Close") },
                ];
            }
            return [{ buttons: ["ButtonB"], label: @tr("Close") }];
        }
        // A form list keeps every pick as it is made, so Back leaves
        // rather than cancels.
        if (Overlays.list-open && Overlays.list-form) {
            return [
                // The shoulder buttons jump or page only a list long enough
                // to scroll.
                self.move-cue(Overlays.list-entries.length > 7 ? 2 : 1),
                { buttons: ["ButtonA"], label: @tr("Select") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // A picker with no sections has nothing to select.
        if (Overlays.letter-open && Overlays.letter-buckets.length == 0) {
            return [
                { buttons: ["ButtonB"], label: @tr("Cancel") },
            ];
        }
        // So does a list holding only a placeholder row ("No tags
        // available"): unusable, with no reason of its own. A launcher that
        // is not ready carries a reason and stays pickable.
        if (Overlays.list-open && Overlays.list-index >= 0 && Overlays.list-index < Overlays.list-entries.length
            && !Overlays.list-entries[Overlays.list-index].enabled
            && Overlays.list-entries[Overlays.list-index].reason-key == "") {
            return [
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // A slider row is adjusted sideways; Accept does nothing on it.
        if (Overlays.list-open && Overlays.list-index >= 0 && Overlays.list-index < Overlays.list-entries.length
            && Overlays.list-entries[Overlays.list-index].role == MenuRole.slider) {
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                { buttons: ["DpadLeft", "DpadRight"], label: @tr("Adjust") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // Every list panel leaves with Back: a pick is kept as it is made.
        if (Overlays.list-open) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"],
                    label: Overlays.list-index >= 0 && Overlays.list-index < Overlays.list-entries.length
                    && (Overlays.list-entries[Overlays.list-index].role == MenuRole.toggle-off
                        || Overlays.list-entries[Overlays.list-index].role == MenuRole.toggle-on)
                    ? @tr("Toggle") : @tr("Select") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Overlays.letter-open) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Select") },
                { buttons: ["ButtonB"], label: @tr("Cancel") },
            ];
        }
        if (Overlays.crt-calibration-open) {
            return [
                { buttons: ["Dpad"], label: @tr("Adjust") },
                { buttons: ["ButtonX"], label: Overlays.crt-size-mode ? @tr("Position") : @tr("Size") },
                { buttons: ["ButtonA"], label: @tr("Save") },
            ];
        }
        // The Menu chip row has focus: it walks sideways, Accept runs the
        // chip, and Back returns to the content.
        if (PageBar.focused) {
            if (PageBar.active-count() > 1) {
                return [
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: @tr("Select") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["ButtonA"], label: @tr("Select") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Shell.active-screen == Screen.hub) {
            // Mid-reorder: the d-pad repositions the held tile, Accept
            // places it, Cancel reverts; nothing else is live.
            if (HubView.move-armed) {
                return [
                    { buttons: ["Dpad"], label: @tr("Reposition") },
                    { buttons: ["ButtonA"], label: @tr("Place") },
                    { buttons: ["ButtonB"], label: @tr("Cancel") },
                ];
            }
            // A tile whose precondition is not met names its reason in
            // the active label and offers no Accept.
            if (HubView.label-reason != DisabledReason.none) {
                if (HubView.options-available) {
                    return [
                        self.move-cue(HubView.total-pages),
                        { buttons: ["ButtonX"], label: @tr("Options") },
                        { buttons: ["ButtonY"], label: @tr("Menu") },
                    ];
                }
                return [
                    self.move-cue(HubView.total-pages),
                    { buttons: ["ButtonY"], label: @tr("Menu") },
                ];
            }
            if (HubView.options-available) {
                return [
                    self.move-cue(HubView.total-pages),
                    { buttons: ["ButtonA"], label: HubView.hub-error != "" && HubView.focused-is-category ? @tr("Retry") : @tr("Open") },
                    { buttons: ["ButtonX"], label: @tr("Options") },
                    { buttons: ["ButtonY"], label: @tr("Menu") },
                ];
            }
            return [
                self.move-cue(HubView.total-pages),
                { buttons: ["ButtonA"], label: HubView.hub-error != "" && HubView.focused-is-category ? @tr("Retry") : @tr("Open") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
            ];
        }
        if (Shell.active-screen == Screen.systems || Shell.active-screen == Screen.favorite-systems
            || Shell.active-screen == Screen.top-played-systems) {
            if (Shell.transitioning) {
                return [{ buttons: ["ButtonB"], label: @tr("Back") }];
            }
            // Nothing can be opened yet, and Accept on an error or an empty
            // list reloads it. The favorites View menu stays reachable on
            // an empty list: it carries the grouping switch.
            if (SystemsView.loading) {
                return [{ buttons: ["ButtonB"], label: @tr("Back") }];
            }
            if (SystemsView.error != "" || SystemsView.count == 0) {
                if ((Shell.active-screen == Screen.favorite-systems || Shell.active-screen == Screen.top-played-systems)
                    && SystemsView.error == "") {
                    return [
                        { buttons: ["ButtonA"], label: @tr("Retry") },
                        { buttons: ["ButtonY"], label: @tr("Menu") },
                        { buttons: ["ButtonB"], label: @tr("Back") },
                    ];
                }
                return [
                    { buttons: ["ButtonA"], label: @tr("Retry") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                self.move-cue(SystemsView.total-pages),
                { buttons: ["ButtonA"], label: @tr("Open") },
                { buttons: ["ButtonX"], label: @tr("Options") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Shell.active-screen == Screen.settings) {
            // Options pins the focused tile to the Hub.
            if (SettingsView.page == SettingsPage.root) {
                if (SettingsView.rows.length > 1) {
                    return [
                        { buttons: ["Dpad"], label: @tr("Move") },
                        { buttons: ["ButtonA"], label: @tr("Open") },
                        { buttons: ["ButtonX"], label: @tr("Options") },
                        { buttons: ["ButtonB"], label: @tr("Back") },
                    ];
                }
                return [
                    { buttons: ["ButtonA"], label: @tr("Open") },
                    { buttons: ["ButtonX"], label: @tr("Options") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (!self.focused-settings-enabled()) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (self.focused-settings-control() == ControlKind.toggle) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Change") },
                    { buttons: ["ButtonA"], label: @tr("Toggle") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (self.focused-settings-control() == ControlKind.action) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: SettingsLabels.action(SettingsView.rows[SettingsView.index].value) },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (self.focused-settings-control() == ControlKind.slider) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Adjust") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (self.focused-settings-control() == ControlKind.picker) {
                return [
                    { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                    { buttons: ["ButtonA"], label: @tr("Change") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Open") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // The Update screen's state machine chooses the hints; at most three.
        if (Shell.active-screen == Screen.update) {
            if (UpdateView.help.length >= 3) { return [root.update-help-entry(0), root.update-help-entry(1), root.update-help-entry(2)]; }
            if (UpdateView.help.length == 2) { return [root.update-help-entry(0), root.update-help-entry(1)]; }
            if (UpdateView.help.length == 1) { return [root.update-help-entry(0)]; }
            return [];
        }
        if (Shell.active-screen == Screen.about) {
            if (AboutView.maximum-scroll-milli <= 0) { return [{ buttons: ["ButtonB"], label: @tr("Back") }]; }
            return [
                { buttons: ["DpadUp", "DpadDown"], label: @tr("Scroll") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (Shell.active-screen == Screen.search && !Shell.transitioning) {
            return root.search-help-entries();
        }
        if (Shell.active-screen == Screen.rename && !Shell.transitioning) {
            return root.rename-help-entries();
        }
        if (Shell.active-screen == Screen.ra-login && !Shell.transitioning) {
            return root.ra-login-help-entries();
        }
        if (Shell.active-screen == Screen.file-browser && !Shell.transitioning) {
            return root.file-browser-help-entries();
        }
        if (Shell.active-screen == Screen.music && !Shell.transitioning) {
            return root.music-help-entries();
        }
        // Games, Favorites, Recents and Search results share the
        // games-style rows.
        if (Shell.transitioning) {
            return [{ buttons: ["ButtonB"], label: @tr("Back") }];
        }
        if (GamesView.error != "") {
            return [
                { buttons: ["ButtonA"], label: @tr("Retry") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        if (GamesView.count == 0 && !GamesView.loading) {
            if (!GamesView.page-menu) {
                return [
                    { buttons: ["ButtonA"], label: @tr("Retry") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                { buttons: ["ButtonA"], label: @tr("Retry") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // A deck item picked up by Move: Up and Down carry it, A puts it
        // down there, B puts it back.
        if (GamesView.moving) {
            return [
                { buttons: ["Dpad"], label: @tr("Move") },
                { buttons: ["ButtonA"], label: @tr("Drop") },
                { buttons: ["ButtonB"], label: @tr("Cancel") },
            ];
        }
        // Left and Right step the pane's images when set to and there is
        // more than one: the move cue keeps only what still moves.
        if (GamesView.detail-image-count > 1) {
            if (!GamesView.page-menu) {
                if (!GamesView.options-available) {
                    return [
                        self.list-move-cue(GamesView.total-pages),
                        { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                        { buttons: ["ButtonA"], label: GamesView.mode == GamesMode.deck ? @tr("Play") : @tr("Open") },
                        { buttons: ["ButtonB"], label: @tr("Back") },
                    ];
                }
                return [
                    self.list-move-cue(GamesView.total-pages),
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                    { buttons: ["ButtonA"], label: GamesView.mode == GamesMode.deck ? @tr("Play") : @tr("Open") },
                    { buttons: ["ButtonX"], label: @tr("Options") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            if (!GamesView.options-available) {
                return [
                    self.list-move-cue(GamesView.total-pages),
                    { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                    { buttons: ["ButtonA"], label: GamesView.mode == GamesMode.deck ? @tr("Play") : @tr("Open") },
                    { buttons: ["ButtonY"], label: @tr("Menu") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                self.list-move-cue(GamesView.total-pages),
                { buttons: ["DpadLeft", "DpadRight"], label: @tr("Image") },
                { buttons: ["ButtonA"], label: GamesView.mode == GamesMode.deck ? @tr("Play") : @tr("Open") },
                { buttons: ["ButtonX"], label: @tr("Options") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // Options only where the focused row has a menu to open. Recents
        // and a live folder have no Menu.
        if (!GamesView.page-menu) {
            if (!GamesView.options-available) {
                return [
                    self.move-cue(GamesView.total-pages),
                    { buttons: ["ButtonA"], label: @tr("Open") },
                    { buttons: ["ButtonB"], label: @tr("Back") },
                ];
            }
            return [
                self.move-cue(GamesView.total-pages),
                { buttons: ["ButtonA"], label: @tr("Open") },
                { buttons: ["ButtonX"], label: @tr("Options") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        // Inside a deck, A plays the deck from the focused item.
        if (!GamesView.options-available) {
            return [
                self.move-cue(GamesView.total-pages),
                { buttons: ["ButtonA"], label: GamesView.mode == GamesMode.deck ? @tr("Play") : @tr("Open") },
                { buttons: ["ButtonY"], label: @tr("Menu") },
                { buttons: ["ButtonB"], label: @tr("Back") },
            ];
        }
        return [
            self.move-cue(GamesView.total-pages),
            { buttons: ["ButtonA"], label: GamesView.mode == GamesMode.deck ? @tr("Play") : @tr("Open") },
            { buttons: ["ButtonX"], label: @tr("Options") },
            { buttons: ["ButtonY"], label: @tr("Menu") },
            { buttons: ["ButtonB"], label: @tr("Back") },
        ];
    }

    // Hub state.

    // Systems state.

    // Settings state.

    // About screen state.

    // Header HUD status icon keys (ordered, visible only).

    // Game-info modal state.

    // Context-menu state (games-style rows).

    // Card-writer modal state.

    // List-picker modal state (the West "View" menu).

    // Jump-to-letter picker state.

    // Games state.

    // Raw key press and release, forwarded to the Rust key path. The
    // toolkit's own auto-repeat is dropped: it bursts unpredictably
    // under load and is not tunable on the framebuffer build, so Rust
    // drives its own cadence off the press/release pair.
    callback key-pressed(string);
    callback key-released(string);
    // The window went away mid-hold (alt-tab, a compositor grab): the
    // release will never arrive, so cancel the repeat rather than let
    // it tick forever.
    callback input-lost();
    // Fired on resize so Rust can re-solve the grid shapes.
    callback viewport-changed(length, length);
    // The help entries started or stopped fitting one row. Rust re-solves
    // the sizing table with the bar's row count, then every screen.
    callback help-wrap-changed();
    out property <bool> help-entries-wrap: help-bar.wrap-entries;

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (!Shell.dormant && !event.repeat) {
                root.key-pressed(event.text);
            }
            accept
        }
        key-released(event) => {
            if (!Shell.dormant) {
                root.key-released(event.text);
            }
            accept
        }
        focus-lost(reason) => {
            root.input-lost();
        }
    }

    // Keep Sizing in logical scene space. In tate mode that space is
    // B x A even though the physical framebuffer remains A x B.
    changed scene-width => {
        Sizing.screen-width = self.scene-width;
        root.viewport-changed(self.scene-width, self.scene-height);
    }
    changed scene-height => {
        Sizing.screen-height = self.scene-height;
        root.viewport-changed(self.scene-width, self.scene-height);
    }

    // The prepared background, 1:1 with the window. Held back while the
    // boot curtain is up so the restored screen and its background appear
    // in the same frame.
    if Backdrop.on && !Shell.boot-curtain && !Backdrop.host-painted: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: Backdrop.image;
        image-fit: fill;
    }
    if Backdrop.on && !Shell.boot-curtain && !Backdrop.host-painted && Backdrop.fade-ms > 0ms: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: Backdrop.next;
        image-fit: fill;
        opacity: Backdrop.fade ? 1 : 0;
        animate opacity { duration: Backdrop.fade ? Backdrop.fade-ms : 0ms; }
    }
    // A glass card's darker area: the same image at the card's darkness,
    // inside the card's outline, moving with the card in the same frame.
    if Backdrop.on && !Shell.boot-curtain && !Backdrop.host-painted && Backdrop.glass && Backdrop.card-shown: Rectangle {
        x: Backdrop.card-x;
        y: Backdrop.card-y;
        width: Backdrop.card-w;
        height: Backdrop.card-h;
        border-radius: Backdrop.card-radius;
        clip: true;
        Image {
            x: -parent.x;
            y: -parent.y;
            width: root.width;
            height: root.height;
            source: Backdrop.card-image;
            image-fit: fill;
        }
        if Backdrop.fade-ms > 0ms: Image {
            x: -parent.x;
            y: -parent.y;
            width: root.width;
            height: root.height;
            source: Backdrop.card-next;
            image-fit: fill;
            opacity: Backdrop.fade ? 1 : 0;
            animate opacity { duration: Backdrop.fade ? Backdrop.fade-ms : 0ms; }
        }
    }

    // Extend modal dimming into the CRT overscan bands. The regular
    // scrim lives inside `scene`; this sibling only paints behind it.
    if Theme.crt && root.has-modal(): Rectangle {
        background: Theme.scrim;
    }

    scene := Rectangle {
        x: Sizing.snap((root.width - self.width) / 2);
        y: Sizing.snap((root.height - self.height) / 2);
        width: root.scene-width;
        height: root.scene-height;
    // Only one live screen. Async navigation retains this coherent source;
    // readiness replaces it atomically without an entrance effect.
    stage := Rectangle {
        clip: true;

        RouteScreen {
            screen-token: Shell.active-screen;
        }
        if Shell.transitioning: TouchArea {
            scroll-event(event) => { return accept; }
        }
    }

    // Cold-launch curtain (BootOverlay port): the window background
    // paints through - no new fill - and a single centered cue tracks
    // the connection state ("Connecting… / Reconnecting… / Loading
    // library…" plus the escalated unreachable message from Rust).
    if Shell.boot-curtain: Rectangle {
        // There from the first frame, so no delay; the hourglass drops
        // away once the line reports that Core cannot be reached.
        WaitCue {
            x: Sizing.pct-w(10);
            width: parent.width - 2 * Sizing.pct-w(10);
            waiting: true;
            immediate: true;
            icon: Shell.boot-status != BootStatus.unreachable;
            glyph: Sizing.font-size(3.2);
            text: Labels.boot(Shell.boot-status);
        }
    }

    header := HeaderBar {
        x: 0;
        y: Sizing.header-top-margin;
        clock-text: Shell.clock-text;
        clock-sample: Shell.clock-sample;
        status-keys: Shell.status-keys;
        status-icons-enabled: Shell.status-icons-enabled;
        music-playing: Shell.music-playing;
        has-battery: Shell.has-battery;
        battery-percent: Shell.battery-percent;
        browse-title: root.browse-header-title();
        // The curtain carries its own cue; a restore filling beneath it
        // does not add a second one here.
        app-text: Shell.transition-cue && !Shell.boot-curtain ? Labels.loading(Shell.transition-target, Shell.active-list)
            : Shell.status-text == AppCue.loading-list ? Labels.loading(Shell.active-screen, Shell.active-list)
            : Labels.status(Shell.status-text, Shell.status-arg, Shell.status-arg2);
    }

    // Modal scrims swallow pointer events rather than forwarding them to
    // the screen underneath. Modal controls paint after this blocker.
    if root.has-modal(): TouchArea {
        scroll-event(event) => { return accept; }
    }

    // Game-info modal, mounted above the screens. Static scrim (instant
    // dim): at native 1080p a fading full-screen translucent surface
    // costs ~100ms frames, so the ban on fading translucent overlays
    // earns its place at this resolution too. The one-frame repaint on
    // open is fine.
    info-modal := GameInfoModal {}
    manual-reader := ManualReader {}

    if Overlays.card-write-open: CardWriteModal {}

    if Overlays.qr-open: QrCodeModal {
        qr: Overlays.qr-image;
        modules: Overlays.qr-modules;
    }

    if Overlays.pair-open: PairDeviceModal {}

    if Overlays.online-open: OnlineLinkModal {}
    if Overlays.online-list-open: OnlineListModal {}
    if Overlays.launcher-prefs-open: LauncherPrefsModal {}

    if LogUploadView.open: LogUploadModal {
        phase: LogUploadView.phase;
        button-pressed: PressFeedback.active(PressOwner.log, 0);
        url: LogUploadView.url;
        qr: LogUploadView.qr;
        qr-modules: LogUploadView.qr-modules;
        confirmed => { LogUploadInput.confirmed(); }
    }

    if SetupModalView.open: SetupModal {
        kind: SetupModalView.kind;
        picker-page: SetupModalView.picker-page;
        picker-title: SetupModalView.picker-title;
        rows: SetupModalView.rows;
        index: SetupModalView.index;
        picker-rows: SetupModalView.picker-rows;
        picker-first: SetupModalView.picker-first;
        picker-top: SetupModalView.picker-top;
        picker-visible: SetupModalView.picker-visible;
        picker-count: SetupModalView.picker-count;
        picker-sel: SetupModalView.picker-sel;
        picker-checked: SetupModalView.picker-checked;
        picker-toggle: SetupModalView.picker-toggle;
        has-above: SetupModalView.has-above;
        has-below: SetupModalView.has-below;
        activate-pulse: SetupModalView.activate-pulse;
        row-hovered(i) => { SetupInput.row-hovered(i); }
        row-clicked(i) => { SetupInput.row-clicked(i); }
        picker-hovered(i) => { SetupInput.picker-hovered(i); }
        picker-clicked(i) => { SetupInput.picker-clicked(i); }
    }

    if Overlays.context-open: ContextMenu {
        entries: Overlays.context-entries;
        current-index: Overlays.context-index;
        strip: Overlays.context-page == ContextPage.root ? Overlays.context-strip : [];
        strip-index: Overlays.context-strip-index;
        anchor-x: Overlays.context-anchor-x;
        anchor-y: Overlays.context-anchor-y;
        anchor-w: Overlays.context-anchor-w;
        anchor-h: Overlays.context-anchor-h;
        anchor-radius: Overlays.context-anchor-radius;
        anchor-zoomed: Overlays.context-anchor-zoomed;
    }

    if Overlays.list-open: ListModal {
        title-text: Labels.menu(Overlays.list-title, "");
        setting-id: Overlays.list-setting-id;
        entries: Overlays.list-entries;
        current-index: Overlays.list-index;
        windowed: Overlays.list-form;
    }

    if Overlays.letter-open: LetterJumpModal {
        buckets: Overlays.letter-buckets;
        current-index: Overlays.letter-index;
        state: Overlays.letter-state;
        columns: Overlays.letter-columns;
    }


    // Alerts own input above every other modal, matching the router.
    if Overlays.dialog-open: TouchArea {
        scroll-event(event) => { return accept; }
    }
    // Core's picker sits above every other surface but the decision dialog.
    if CoreUiView.kind == CoreUiKind.picker: CorePickerModal {}

    if Overlays.dialog-open: DialogModal {}

    // The help bar band for the background's bake: from the bar's top to
    // the window's bottom edge, or nothing with the bar off.
    property <length> backdrop-bar-top: Sizing.help-bar-enabled && Sizing.help-bar-height > 0px
        ? scene.y + help-bar.y : root.height;
    init => { Backdrop.bar-moved(self.backdrop-bar-top); }
    changed backdrop-bar-top => { Backdrop.bar-moved(self.backdrop-bar-top); }

    // Hidden with the setting off (Settings > Appearance), when Rust gives
    // it no height. It stays instantiated so its wrap measurement holds.
    help-bar := HelpBar {
        x: 0;
        y: parent.height - self.height;
        visible: Sizing.help-bar-enabled;
        entries: root.help-entries();
        changed wrap-entries => { root.help-wrap-changed(); }
        // Bleed past the CRT safe-area inset so the fill reaches the
        // framebuffer edge and the keyline lands on the safe-area line.
        bleed: Math.max(root.crt-inset-w, root.crt-inset-h) / 2;
    }

    }

    // Burn protection covers the entire framebuffer including the CRT
    // overscan bands, so no UI bleeds through at the edges.
    if Shell.saver-armed: ScreensaverOverlay {}

    // Desktop remains mapped behind the launched game. If the compositor
    // exposes it, cover every live pixel with a static, opaque dormant face:
    // no alpha blend, animation, or full-screen repaint loop. MiSTer uses only
    // the dark fill while its wrapper takes over; desktop adds the logo so the
    // state looks intentional when raised.
    if Shell.dormant: dormant-surface := Rectangle {
        background: #030405;

        if !Shell.is-mister: Image {
            width: Sizing.pct-w(24);
            height: self.width / Brand.aspect;
            x: Sizing.snap((parent.width - self.width) / 2);
            y: Sizing.snap((parent.height - self.height) / 2);
            source: Brand.logo(false, self.width);
            image-fit: contain;
        }
    }

    // Pointer input is disabled globally, including modal controls, while
    // the setting is off or a screen transition owns input.
    if Shell.dormant || !Shell.mouse-enabled || Shell.saver-armed
        || ((Shell.boot-curtain || Shell.transitioning) && !root.has-modal()): TouchArea {
        clicked => {
            if (!Shell.dormant) { Overlays.pointer-choice(PressOwner.wake, 0, true); }
        }
        scroll-event(event) => { return accept; }
    }

    // Calibration deliberately bypasses scene rotation and the CRT safe
    // inset: its edge frame must identify true framebuffer pixels.
    if Theme.crt && Overlays.crt-calibration-open: CrtCalibrationPattern {}
}
