//
// The on-screen keyboard: a grid of raised keys with one travelling focus
// ring. Pure presentation. Rust lays the keys out
// (`zaparoo_app::keyboard`), owns the text, and moves the focus.

import { Theme, Sizing, Motion } from "theme.slint";
import { GlyphSource } from "chrome.slint";
import { PressableSurface } from "tiles.slint";
import { FocusCursor } from "focus.slint";
import { KeyKind } from "state_types.slint";

// One key. `start` and `span` are in grid units along its row.
export struct KeyCell {
    kind: KeyKind,
    text: string,
    row: int,
    start: int,
    span: int,
}

export component OnScreenKeyboard inherits Rectangle {
    in property <[KeyCell]> keys;
    in property <int> rows: 4;
    in property <int> columns: 10;
    in property <int> current-index: 0;
    // The keyboard holds focus; the ring hides while another zone has it.
    in property <bool> focused: true;
    // The key being pressed, or -1.
    in property <int> pressed-index: -1;
    in property <bool> enabled: true;
    in property <bool> submit-enabled: true;
    in property <string> submit-glyph: "icons/Search";
    in property <bool> shift-active: false;
    // Shift is locked (caps), not just on for the next character: its
    // arrow gains a bar, drawn into the glyph so it matches the stroke at
    // every size, which colour alone could not say at 240p.
    in property <bool> shift-locked: false;
    in property <bool> symbols-active: false;
    // Separates this keyboard's focus moves from another's.
    in property <string> scope: "keyboard";
    callback key-hovered(int);
    callback key-clicked(int);

    property <length> gap: Math.max(1px, Sizing.pct-min(0.7));
    property <length> cell-w: (root.width - (root.columns - 1) * root.gap) / Math.max(1, root.columns);
    property <length> cell-h: (root.height - (root.rows - 1) * root.gap) / Math.max(1, root.rows);
    property <length> ring-gap: Sizing.card-border-width;
    property <KeyCell> current: root.current-index >= 0 && root.current-index < root.keys.length
        ? root.keys[root.current-index] : { kind: KeyKind.char, text: "", row: 0, start: 0, span: 1 };
    property <bool> current-pressed: root.pressed-index == root.current-index;
    property <float> press-t: root.current-pressed ? 1 : 0;
    animate press-t {
        duration: Motion.dur(root.current-pressed ? Motion.press-ms : Motion.settle-ms);
        easing: ease-out-quad;
    }

    // Key edges land on whole pixels on the pixel grid, where the
    // centered labels need a whole-pixel origin to stay sharp.
    pure function key-x(key: KeyCell) -> length {
        return Sizing.snap(key.start * (root.cell-w + root.gap));
    }
    pure function key-w(key: KeyCell) -> length {
        return Sizing.snap(key.start * (root.cell-w + root.gap) + key.span * root.cell-w + (key.span - 1) * root.gap)
            - root.key-x(key);
    }
    pure function key-ink(key: KeyCell) -> color {
        if (!root.enabled || (key.kind == KeyKind.submit && !root.submit-enabled)) {
            return Theme.text-label;
        }
        if ((key.kind == KeyKind.shift && root.shift-active)
            || (key.kind == KeyKind.symbols && root.symbols-active)) {
            return Theme.accent;
        }
        return Theme.text-primary;
    }
    pure function key-glyph(key: KeyCell) -> string {
        if (key.kind == KeyKind.backspace) { return "icons/NavLeft"; }
        if (key.kind == KeyKind.shift) { return root.shift-locked ? "icons/ShiftLock" : "icons/NavUp"; }
        if (key.kind == KeyKind.submit) { return root.submit-glyph; }
        return "";
    }

    for key[i] in root.keys: face := PressableSurface {
        x: root.key-x(key);
        y: key.row * (root.cell-h + root.gap);
        width: root.key-w(key);
        height: root.cell-h;
        pressed: root.pressed-index == i;
        property <length> glyph-size: Math.round(Math.min(self.width, self.face-height) * 0.5 / 1px) * 1px;

        if key.kind == KeyKind.char || key.kind == KeyKind.symbols: Text {
            x: 0;
            width: Sizing.even(parent.width);
            height: face.face-height;
            text: key.text;
            color: root.key-ink(key);
            font-size: Sizing.font-body;
            font-weight: FontWeight.medium;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        // Space is drawn, not lettered: an open-topped bracket.
        if key.kind == KeyKind.space: Rectangle {
            property <length> stroke: Math.max(1px, Sizing.stroke(1.5));
            x: (parent.width - self.width) / 2;
            y: face.face-height * 0.55;
            width: Math.min(parent.width * 0.6, Sizing.pct-w(12));
            height: Math.max(self.stroke * 3, face.face-height * 0.14);
            Rectangle { x: 0; y: parent.height - parent.stroke; height: parent.stroke; background: root.key-ink(key); }
            Rectangle { x: 0; y: 0; width: parent.stroke; background: root.key-ink(key); }
            Rectangle { x: parent.width - parent.stroke; y: 0; width: parent.stroke; background: root.key-ink(key); }
        }
        if root.key-glyph(key) != "": Image {
            x: (parent.width - self.width) / 2;
            y: (face.face-height - self.height) / 2;
            width: face.glyph-size;
            height: face.glyph-size;
            source: GlyphSource.glyph(root.key-glyph(key), face.glyph-size, root.key-ink(key));
        }
        TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { if (self.has-hover) { root.key-hovered(i); } }
            clicked => { root.key-clicked(i); }
        }
    }

    FocusCursor {
        radius: Math.max(0px, Sizing.radius-sm - root.ring-gap);
        stroke: Sizing.card-border-width * 2;
        target: {
            x: root.key-x(root.current) + root.ring-gap,
            y: root.current.row * (root.cell-h + root.gap) + root.ring-gap + root.press-t * Sizing.press-edge-height,
            w: root.key-w(root.current) - 2 * root.ring-gap,
            h: root.cell-h - Sizing.press-edge-height - 2 * root.ring-gap,
            column: root.current.start,
            row: root.current.row,
            scope: root.scope + ":" + root.keys.length,
            valid: root.focused && root.enabled && root.current-index >= 0 && root.current-index < root.keys.length
        };
    }
}

// A named field: its name, then its value. Focus is the accent ring, the
// same ring the keys wear, so the name keeps its contrast.
export component Field inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> focused;
    // Where a host's own content starts, after the name.
    out property <length> value-x: name.x + name.width + Sizing.surface-pad;
    background: Theme.surface-card;
    border-radius: Sizing.radius-sm;
    border-width: root.focused ? Sizing.card-border-width * 2 : Sizing.card-border-width;
    border-color: root.focused ? Theme.accent : Theme.border-mid;
    clip: true;
    name := Text {
        x: Sizing.surface-pad;
        height: parent.height;
        text: root.label;
        color: Theme.text-label;
        font-size: Sizing.font-caption;
        vertical-alignment: center;
    }
    if root.value != "": Text {
        x: root.value-x;
        width: Math.max(0px, parent.width - self.x - Sizing.surface-pad);
        height: parent.height;
        text: root.value;
        color: Theme.text-primary;
        font-size: Sizing.font-body;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

// The field being typed in: a block cursor marks where typing lands. It
// blinks while the keyboard has focus and rests dimmed while anything else
// does (docs/style.md, "Text entry"). Rust splits the text around the
// cursor and swaps a space beside it for a no-break one, which keeps its
// advance, so the cursor clears the last letter.
export component TextField inherits Field {
    in property <string> before;
    in property <string> at;
    in property <string> after;
    in property <bool> typing;
    focused: false;

    property <bool> blink-on: true;
    property <string> edited: root.before + "\u{1f}" + root.at;
    changed edited => { self.blink-on = true; }
    property <bool> block-shown: !root.typing || self.blink-on;
    Timer {
        interval: 530ms;
        running: root.typing && Motion.enabled;
        triggered => { root.blink-on = !root.blink-on; }
    }

    before-text := Text {
        x: root.value-x;
        // An empty Text still claims a sliver of width, which pushed the
        // cursor off the gap the other fields keep.
        width: root.before == "" ? 0px : self.preferred-width;
        height: parent.height;
        text: root.before;
        color: Theme.text-primary;
        font-size: Sizing.font-body;
        font-weight: FontWeight.medium;
        vertical-alignment: center;
    }
    at-measure := Text {
        visible: false;
        text: root.at;
        font-size: Sizing.font-body;
        font-weight: FontWeight.medium;
    }
    cursor := Rectangle {
        x: before-text.x + before-text.width + (root.before != "" ? Sizing.stroke(1) : 0px);
        y: (parent.height - self.height) / 2;
        width: root.at != "" ? Math.max(at-measure.preferred-width, Sizing.font-body * 0.3)
            : Sizing.font-body * 0.55;
        height: Sizing.font-body * 1.25;
        background: !root.block-shown ? transparent
            : (root.typing ? Theme.accent : Theme.text-label);
        Text {
            width: parent.width;
            height: parent.height;
            text: root.at;
            color: root.block-shown ? Theme.on-accent : Theme.text-primary;
            font-size: Sizing.font-body;
            font-weight: FontWeight.medium;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: cursor.x + cursor.width + Sizing.stroke(1);
        height: parent.height;
        text: root.after;
        color: Theme.text-primary;
        font-size: Sizing.font-body;
        font-weight: FontWeight.medium;
        vertical-alignment: center;
    }
}
