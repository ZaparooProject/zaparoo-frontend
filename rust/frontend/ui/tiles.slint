//
// Grid tiles: the tile itself, the raised pressable surface it is built
// on, the empty slot and the cell layer of the paged grid. Navigation
// lives in Rust (`zaparoo_app::paged_grid`); the grid view here renders
// one page of cells at the geometry Rust resolved and reports pointer
// events back.

import { Theme, Sizing, Motion, Layout } from "theme.slint";
import { GlyphSource } from "chrome.slint";
import { Labels } from "labels.slint";
import { Wordmark } from "wordmark.slint";
import { FocusCursor, TileDisplacement } from "focus.slint";

// One grid cell, as Rust projects it. Art is either a glyph key the
// rasterizer serves tinted (`categories/...`, `icons/...`), a raster
// cover with its focused twin (system logos, media art), or nothing,
// in which case the name renders as a wordmark.
export struct GridCell {
    label-key: string,
    name: string,
    glyph-key: string,
    cover: image,
    cover-focus: image,
    has-cover: bool,
    has-cover-focus: bool,
    // The cover is a bitmap prepared for this tile's art box (a system
    // logo), to be painted one pixel for one where bitmaps are painted
    // that way. Media covers and user images are fitted to the box.
    cover-exact: bool,
    // The name doubles as a fitted wordmark when there is no art.
    wordmark: bool,
    favorite: bool,
    hidden: bool,
    disabled: bool,
    // Dim suffix after the caption (tags, "Hidden").
    tags: string,
    top-label: string,
    // A structural placeholder: paints nothing, ever.
    is-empty: bool,
    // Core's average cover colour: fills the art slot while the art
    // loads, then fades out under it. A solid fill, cheap everywhere.
    placeholder: color,
    has-placeholder: bool,
}

// One-line caption with the focused-overflow marquee: fits -> static
// (centered), overflows unfocused -> elided, overflows focused ->
// integer-pixel scroll-reveal stepped by a 40 ms timer after an 800 ms
// dwell. One bounded pass per focus, never a perpetual loop. Accessible
// text always carries the complete name.
export component MarqueeCaption inherits Rectangle {
    in property <string> content;
    // Sibling-diffed token suffix, dim, inline after the name. Empty
    // for items with no variants (the common case).
    in property <string> tags;
    in property <bool> focused;
    // Floor for anything meant to be READ: 3.0% keeps captions at or
    // above 16px even at the DRS motion res (540p-class).
    in property <length> caption-font-size: Sizing.font-size(3.0);
    in property <color> caption-color: Theme.text-primary;
    in property <color> tags-color: Theme.text-variant;
    in property <int> caption-weight: FontWeight.normal;
    // Tile captions center a fitting name; list rows left-align.
    in property <bool> center-content: true;

    clip: true;

    property <bool> has-tags: root.tags != "";
    property <length> gap-w: root.has-tags ? Sizing.pct-w(1.2) : 0px;
    property <int> scroll-x: 0;
    property <int> dir: -1;
    property <int> pause-ticks: 20;
    property <bool> finished: false;
    accessible-role: text;
    accessible-label: root.content + (root.tags == "" ? "" : " " + root.tags);
    changed content => { root.restart(); }
    changed tags => { root.restart(); }
    changed focused => { root.restart(); }
    function restart() {
        root.scroll-x = 0;
        root.dir = -1;
        root.pause-ticks = 20;
        root.finished = false;
    }
    property <length> name-full-w: label.preferred-width;
    property <length> tags-full-w: root.has-tags ? suffix.preferred-width : 0px;
    property <length> full-w: root.name-full-w + root.gap-w + root.tags-full-w;
    property <bool> overflows: root.full-w > root.width;
    property <bool> marquee: root.focused && root.overflows && Motion.enabled;
    property <int> scroll-dist: Math.max(0, Math.round((root.full-w - root.width) / 1px));

    // Static-overflow width policy: the name keeps at least 58% of the
    // width, so a long suffix cannot crowd it out, and the suffix takes
    // what the name leaves. The suffix elides on the right (Slint has no
    // left elide); the marquee reveals the full text.
    property <length> name-static-w: Math.min(root.name-full-w, Math.max(root.width * 0.58, root.width - root.gap-w - root.tags-full-w));
    property <length> name-render-w: (root.marquee || !root.overflows) ? root.name-full-w : root.name-static-w;
    property <length> tags-render-w: (root.marquee || !root.overflows)
        ? root.tags-full-w
        : Math.min(root.tags-full-w, Math.max(0px, root.width - root.gap-w - root.name-render-w));
    property <length> block-x: root.marquee
        ? root.scroll-x * 1px
        : (root.overflows || !root.center-content
            ? 0px
            : (root.width - root.full-w) / 2);

    changed marquee => {
        if (!self.marquee) {
            self.scroll-x = 0;
            self.dir = -1;
            self.pause-ticks = 20;
        }
    }

    Timer {
        interval: 40ms;
        running: root.marquee && !root.finished;
        triggered => {
            if (root.pause-ticks > 0) {
                root.pause-ticks -= 1;
            } else if (root.scroll-x + root.dir <= -root.scroll-dist) {
                root.scroll-x = -root.scroll-dist;
                root.dir = 1;
                root.pause-ticks = 20;
            } else if (root.scroll-x + root.dir >= 0) {
                root.scroll-x = 0;
                root.finished = true;
            } else {
                root.scroll-x = root.scroll-x + root.dir;
            }
        }
    }

    label := Text {
        x: root.block-x;
        y: (parent.height - self.height) / 2;
        width: root.name-render-w;
        overflow: elide;
        text: root.content;
        color: root.caption-color;
        font-size: root.caption-font-size;
        font-weight: root.caption-weight;
    }

    if root.has-tags: suffix-view := Text {
        x: root.block-x + root.name-render-w + root.gap-w;
        y: (parent.height - self.height) / 2;
        width: root.tags-render-w;
        overflow: elide;
        text: root.tags;
        color: root.tags-color;
        font-size: root.caption-font-size;
        font-weight: root.caption-weight;
    }

    // Hidden measuring twin for the suffix (preferred-width needs an
    // unconditional element to read from).
    suffix := Text {
        visible: false;
        text: root.tags;
        font-size: root.caption-font-size;
        font-weight: root.caption-weight;
    }
}


// Raised control surface: an opaque face over a front edge that reads as
// depth. Activation lowers the face by the edge depth and holds it there;
// the edge band collapses under it. The optional focus ring is the same
// two-rect construction Tile draws, inset inside the face.
export component PressableSurface inherits Rectangle {
    in property <color> face-color: Theme.surface-card;
    in property <color> edge-color: Theme.control-edge;
    in property <length> radius: Sizing.radius-sm;
    in property <length> edge-height: Sizing.press-edge-height;
    in property <bool> focused: false;
    in property <bool> pressed: false;

    property <float> press-t: root.pressed ? 1 : 0;
    animate press-t {
        duration: Motion.dur(root.pressed ? Motion.press-ms : Motion.settle-ms);
        easing: ease-out-quad;
    }
    property <length> edge-band: Math.min(root.edge-height + root.radius, root.height);
    property <length> press-depth: Math.min(root.edge-height, root.height);
    out property <length> face-y: root.press-t * root.press-depth;
    // The face is shorter than the cell by the depth the press travels;
    // content and the focus ring belong to the face, never to the front
    // edge below it.
    out property <length> face-height: Math.max(0px, root.height - root.press-depth);
    property <length> ring-gap: Sizing.card-border-width;
    property <length> ring-width: Sizing.card-border-width * 2;

    clip: true;

    // Edge band, clipped to the part the face has not covered.
    Rectangle {
        x: 0;
        y: parent.height - self.height;
        height: (1 - root.press-t) * root.edge-band;
        clip: true;
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            height: root.edge-band;
            background: root.edge-color;
            border-bottom-left-radius: root.radius;
            border-bottom-right-radius: root.radius;
        }
    }

    face := Rectangle {
        x: 0;
        y: root.face-y;
        height: Math.max(0px, parent.height - root.press-depth);
        background: root.face-color;
        border-radius: root.radius;
        border-width: Sizing.card-border-width;
        border-color: Theme.border-mid;

        if root.focused: Rectangle {
            x: root.ring-gap;
            y: root.ring-gap;
            width: parent.width - 2 * root.ring-gap;
            height: parent.height - 2 * root.ring-gap;
            background: Theme.accent;
            border-radius: Math.max(0px, root.radius - root.ring-gap);
            Rectangle {
                x: root.ring-width;
                y: root.ring-width;
                width: parent.width - 2 * root.ring-width;
                height: parent.height - 2 * root.ring-width;
                background: root.face-color;
                border-radius: Math.max(0px, parent.border-radius - root.ring-width);
            }
        }

        @children
    }
}

// Unified grid tile: a raised card with a centered art area, an accent
// ring inside the card edge while focused, the favorite heart, and, in
// caption mode, a one-line name band along the bottom. A hidden
// or disabled tile mutes its front edge and keeps its art at the resting
// tint; the worded reason lives in the host's caption. Held tiles remain
// visible throughout a Move session.
export component Tile inherits Rectangle {
    in property <GridCell> cell;
    in property <bool> selected: false;
    in property <bool> own-ring: true;
    // One shared owner moves both face and retained ring, through launch reply.
    in property <bool> press-held: false;
    // The section owning this tile has user focus.
    in property <bool> section-focused: true;
    in property <bool> focus-ready: true;
    in property <bool> held: false;
    in property <bool> moving: false;
    // Hub and Settings tiles: art fills the card up to the ring's inner
    // edge plus a small clearance instead of the 2% band.
    in property <bool> compact-padding: false;
    in property <bool> show-caption: false;
    // Resolved caption text (the host composes translations).
    in property <string> caption: "";
    in property <length> card-radius: Layout.card-radius;
    // The size this tile rests at. A host that animates the tile's size
    // (the focus zoom drawn by size) names where it is heading, so glyphs
    // are rasterized once for that size and not again at every step on the
    // way there.
    in property <length> settled-width: self.width;
    in property <length> settled-height: self.height;
    // The focused tile's larger copy of an exact cover, prepared for the
    // art box of the grown tile, in the focus tint and in the resting one
    // a muted tile keeps. Until it lands the tile paints its resting copy.
    in property <image> zoomed-cover;
    in property <image> zoomed-cover-muted;
    in property <bool> has-zoomed-cover: false;

    // Exact-pixel contract. The software renderer samples bitmaps
    // nearest-neighbor, so a glyph or logo fitted to a box that is not its
    // own size loses or repeats rows and columns: uneven strokes, stepped
    // diagonals. Where that renderer draws (`Motion.zoom-by-size`), these
    // bitmaps are prepared for the whole pixels of the art box and painted
    // at their own pixel size, centered on a whole pixel, never fitted.
    property <bool> exact-art: Motion.zoom-by-size;

    property <length> outline-gap: Sizing.pct-h(0.4);
    property <length> outline-width: Sizing.focus-ring-width;
    property <length> ring-inner-edge: root.outline-gap + root.outline-width;
    property <length> pad: root.compact-padding ? root.ring-inner-edge + Sizing.pct-h(0.4) : Sizing.pct-h(2);
    property <length> caption-height: Sizing.pct-h(5.5);
    property <length> caption-gap: Sizing.pct-h(0.4);
    property <bool> has-top-label: root.cell.top-label != "";
    property <length> top-label-height: root.caption-height;
    property <length> top-label-gap: root.caption-gap;
    property <bool> focused-selection: root.selected && root.section-focused && root.focus-ready;
    property <bool> muted: root.cell.hidden || root.cell.disabled;
    property <color> art-tint: (!root.muted && root.focused-selection) ? Theme.logo-focus-primary : Theme.logo-primary;
    property <bool> system-cover: root.cell.wordmark;

    // Held cue (Options -> Move), and only this: the WHOLE tile blinks out
    // of existence and back. No tint, no recolor, no lift -- nothing is
    // painted in that cell for the instant it is off, focus ring included,
    // and it returns exactly as it was. A hard cut, never a fade.
    // `opacity` rather than `visible` because opacity cascades to every
    // child, so one binding takes the art, the caption and the ring with
    // it. Under Reduce motion the tile just stays on: freezing a
    // disappear cue on "gone" would hide the very thing being moved, and
    // the help bar's move-mode line carries the state instead.
    // Movement is already the cue: reveal immediately, then restart a full
    // visible blink interval once the retained tile reaches its destination.
    property <bool> blinking: root.held && !root.moving && Motion.enabled;
    property <bool> held-blink-on: true;
    opacity: (root.blinking && !root.held-blink-on) ? 0.0 : 1.0;
    Timer {
        interval: Motion.held-blink-ms;
        running: root.blinking;
        triggered => { root.held-blink-on = !root.held-blink-on; }
    }
    changed blinking => { root.held-blink-on = true; }

    surface := PressableSurface {
        radius: root.card-radius;
        face-color: Theme.surface-card;
        edge-color: root.muted ? Theme.border-mid : Theme.tile-edge;
        pressed: root.press-held;

        // Focus ring inside the card edge: an accent pill and a face
        // colored mask punched back out of its center. Sized to the face
        // so it never reaches down over the front edge.
        if root.focused-selection && root.own-ring: Rectangle {
            x: root.outline-gap;
            y: root.outline-gap;
            width: parent.width - 2 * root.outline-gap;
            height: parent.face-height - 2 * root.outline-gap;
            background: Theme.accent;
            border-radius: Math.max(0px, root.card-radius - root.outline-gap);
            Rectangle {
                x: root.outline-width;
                y: root.outline-width;
                width: parent.width - 2 * root.outline-width;
                height: parent.height - 2 * root.outline-width;
                background: Theme.surface-card;
                border-radius: Math.max(0px, parent.border-radius - root.outline-width);
            }
        }

        // `zaparoo_app::sizing::tile_art_box` mirrors this box: covers are
        // resized to it before they are cached. Change both together.
        property <length> art-top: root.has-top-label ? root.top-label-height + root.top-label-gap : root.pad;
        property <length> art-bottom: root.show-caption ? root.caption-height + root.caption-gap : root.pad;
        property <length> art-w: Math.max(0px, self.width - 2 * root.pad);
        property <length> art-h: Math.max(0px, self.face-height - self.art-top - self.art-bottom);
        // The same box at the tile's settled size.
        property <length> settled-art-w: Math.max(0px, self.art-w + root.settled-width - root.width);
        property <length> settled-art-h: Math.max(0px, self.art-h + root.settled-height - root.height);

        if root.has-top-label: MarqueeCaption {
            x: root.pad;
            y: 0;
            width: parent.art-w;
            height: root.top-label-height;
            content: root.cell.top-label;
            focused: root.focused-selection;
            caption-font-size: Sizing.font-small;
            caption-color: root.focused-selection ? Theme.text-primary : Theme.text-label;
        }

        if root.cell.glyph-key != "": Image {
            // The square raster is asked for at the whole pixels of the
            // settled art box and painted at the size it came back at.
            property <length> side: Math.min(parent.settled-art-w, parent.settled-art-h);
            x: root.exact-art ? Math.round((root.pad + (parent.art-w - self.width) / 2) / 1px) * 1px : root.pad;
            y: root.exact-art ? Math.round((parent.art-top + (parent.art-h - self.height) / 2) / 1px) * 1px : parent.art-top;
            width: root.exact-art ? self.source.width * 1px : parent.art-w;
            height: root.exact-art ? self.source.height * 1px : parent.art-h;
            source: GlyphSource.glyph(root.cell.glyph-key,
                root.exact-art ? Math.floor(self.side / 1px) * 1px : self.side, root.art-tint);
            image-fit: contain;
        }

        // The art's own colour stands in until the art lands, then fades
        // out as the art fades in over it.
        if root.cell.glyph-key == "" && root.cell.has-placeholder: Rectangle {
            x: root.pad;
            y: parent.art-top;
            width: parent.art-w;
            height: parent.art-h;
            background: root.cell.placeholder;
            border-radius: Math.max(0px, root.card-radius - root.pad);
            opacity: 1;
            states [
                covered when root.cell.has-cover: {
                    opacity: 0;
                    in {
                        animate opacity { duration: Motion.dur(Motion.tile-cover-reveal-ms); easing: ease-out; }
                    }
                }
            ]
        }

        // Kept mounted so its art can fade in when it lands (see
        // `Motion.tile-cover-reveal-ms`); invisible until then.
        if root.cell.glyph-key == "": Image {
            property <bool> zoomed: root.exact-art && root.cell.cover-exact && root.has-zoomed-cover;
            // One pixel for one when the bitmap fits the box the tile is
            // settling at; anything larger is fitted as it always was. The
            // focused tile's larger copy is painted at once while the card
            // grows to meet it, so it is never scaled on the way.
            property <bool> exact: root.exact-art && root.cell.cover-exact
                && self.source.width * 1px <= parent.settled-art-w + 0.01px
                && self.source.height * 1px <= parent.settled-art-h + 0.01px;
            x: self.exact ? Math.round((root.pad + (parent.art-w - self.width) / 2) / 1px) * 1px : root.pad;
            y: self.exact ? Math.round((parent.art-top + (parent.art-h - self.height) / 2) / 1px) * 1px : parent.art-top;
            width: self.exact ? self.source.width * 1px : parent.art-w;
            height: self.exact ? self.source.height * 1px : parent.art-h;
            source: self.zoomed
                ? (root.muted ? root.zoomed-cover-muted : root.zoomed-cover)
                : (!root.muted && root.focused-selection && root.cell.has-cover-focus)
                    ? root.cell.cover-focus : root.cell.cover;
            image-fit: contain;
            opacity: 0;
            states [
                shown when root.cell.has-cover: {
                    opacity: 1;
                    in {
                        animate opacity { duration: Motion.dur(Motion.tile-cover-reveal-ms); easing: ease-out; }
                    }
                }
            ]
        }

        // Wordmark fallback for a system without art; other tiles stay
        // blank until their art lands (the caption already names them).
        if root.cell.glyph-key == "" && !root.cell.has-cover && root.system-cover && !root.show-caption: Wordmark {
            x: root.pad + Sizing.pct-h(1);
            y: parent.art-top + Sizing.pct-h(1);
            width: Math.max(0px, parent.art-w - 2 * Sizing.pct-h(1));
            height: Math.max(0px, parent.art-h - 2 * Sizing.pct-h(1));
            text: root.cell.name;
            ink: root.art-tint;
        }

        if root.cell.favorite: Image {
            x: root.exact-art ? Math.round(parent.width / 12 / 1px) * 1px : parent.width / 12;
            y: self.x;
            width: root.exact-art ? self.source.width * 1px : parent.width / 6;
            height: self.width;
            source: GlyphSource.glyph("icons/Heart", root.settled-width / 6, Colors.transparent);
            image-fit: contain;
        }

        if root.show-caption: MarqueeCaption {
            x: root.pad;
            y: parent.face-height - root.caption-height;
            width: parent.art-w;
            height: root.caption-height;
            content: root.caption;
            tags: Labels.tags(root.cell.tags, root.cell.hidden);
            focused: root.focused-selection;
            caption-font-size: Sizing.font-small;
            caption-color: root.focused-selection ? Theme.text-primary : Theme.text-label;
        }
    }
}

// One page of a paged grid, the cell layer only. Rust resolves
// the cell fit and centering (`zaparoo_app::paged_grid::fit`) and hands
// the page's cells over; this lays them out row-major and reports
// pointer events by page-local index. Blank cells paint nothing.
export component PagedGridView inherits Rectangle {
    in property <[GridCell]> cells: [];
    in property <string> focus-scope: "";
    in property <bool> focus-motion: true;
    in property <[int]> move-origins: [];
    in property <int> move-pulse: 0;
    in property <int> columns: 1;
    in property <length> cell-width: 0px;
    in property <length> cell-height: 0px;
    in property <length> block-offset-x: 0px;
    in property <length> block-offset-y: 0px;
    in property <length> left-inset: 0px;
    in property <length> top-inset: 0px;
    in property <length> column-gap: 0px;
    in property <length> row-gap: 0px;
    in property <int> selected-local: -1;
    in property <bool> section-focused: true;
    in property <bool> focus-ready: true;
    in property <int> held-local: -1;
    // A context menu about the selected tile takes the ring off it: the
    // panel is the mark for that state and a ring as well is two. Only the
    // ring, though. The tile keeps its zoom, its focus tint and its focused
    // cover, because the menu is about that tile and it should look exactly
    // as it did minus the ring. `section-focused` used to carry this and
    // dropped all four.
    in property <bool> ring-suppressed: false;
    // The focused tile's larger copy of its art, for the cell at
    // `focus-art-local` of this page; -1 while there is none to paint.
    in property <image> focus-art;
    in property <image> focus-art-muted;
    in property <int> focus-art-local: -1;
    in property <bool> press-held: false;
    in property <bool> compact-padding: false;
    in property <bool> show-caption: false;
    in property <length> card-radius: Layout.card-radius;
    // Blank cells refuse the pointer while this is set.
    in property <bool> skip-empty-cells: false;
    // The host resolves each cell's caption (translations live there).
    pure callback caption-for(GridCell) -> string;

    callback cell-hovered(int);
    callback cell-clicked(int);
    callback cell-right-clicked(int);
    callback wheel(int);

    property <int> selected-col: Math.mod(Math.max(0, root.selected-local), Math.max(1, root.columns));
    property <int> selected-row: Math.floor(Math.max(0, root.selected-local) / Math.max(1, root.columns));
    property <length> selected-x: root.left-inset + root.block-offset-x + root.selected-col * (root.cell-width + root.column-gap);
    property <length> selected-y: root.top-inset + root.block-offset-y + root.selected-row * (root.cell-height + root.row-gap);
    property <bool> has-selection: root.selected-local >= 0 && root.selected-local < root.cells.length
        && !root.cells[root.selected-local].is-empty && root.section-focused && root.focus-ready;
    property <length> ring-gap: Sizing.pct-h(0.4);
    // The retained focus ring belongs to the moving face, not the fixed edge.
    property <float> press-t: root.press-held ? 1 : 0;
    animate press-t {
        duration: Motion.dur(root.press-held ? Motion.press-ms : Motion.settle-ms);
        easing: ease-out-quad;
    }
    property <length> press-y: root.press-t * Sizing.press-edge-height;

    // A focused tile grows over its neighbours rather than pushing them,
    // so the clip is widened by exactly that growth and the cell layer is
    // pushed back in by the same amount. Nothing moves, and a tile on the
    // grid's own edge is no longer trimmed on its outer side.
    property <percent> zoom: Motion.enabled ? Motion.focus-zoom : 100%;
    property <length> headroom:
        Math.max(root.cell-width, root.cell-height) * (Motion.focus-zoom - 100%) / 2;
    // Where the growth is drawn by size (`Motion.zoom-by-size`) the ring is
    // laid out on the grown cell, so it keeps its gap to the card's edge.
    property <float> ring-grow: Motion.zoom-by-size ? root.zoom - 100% : 0%;
    property <length> ring-grow-x: root.cell-width * root.ring-grow / 2;
    property <length> ring-grow-y: root.cell-height * root.ring-grow / 2;

    Rectangle {
        x: -root.headroom;
        y: -root.headroom;
        width: parent.width + 2 * root.headroom;
        height: parent.height + 2 * root.headroom;
        clip: true;
    Rectangle {
        x: root.headroom;
        y: root.headroom;
        width: root.width;
        height: root.height;

    // Two passes: every unselected tile, then the selected one on top so
    // its ring stays whole at the cell boundaries (`z` is static in
    // Slint, so the layering is done by draw order).
    for cell[i] in root.cells: Rectangle {
        property <int> cell-col: Math.mod(i, root.columns);
        property <int> cell-row: Math.floor(i / root.columns);
        property <int> origin: i < root.move-origins.length ? root.move-origins[i] : i;
        property <int> origin-col: Math.mod(Math.max(0, self.origin), Math.max(1, root.columns));
        property <int> origin-row: Math.floor(Math.max(0, self.origin) / Math.max(1, root.columns));
        displacement := TileDisplacement {
            pulse: root.move-pulse;
            from-x: (parent.origin-col - parent.cell-col) * (root.cell-width + root.column-gap);
            from-y: (parent.origin-row - parent.cell-row) * (root.cell-height + root.row-gap);
            allowed: root.held-local >= 0 && i != root.held-local && parent.origin >= 0
                && Math.abs(parent.origin-col - parent.cell-col) + Math.abs(parent.origin-row - parent.cell-row) == 1;
        }
        property <bool> zoomed: root.has-selection && i == root.selected-local;
        // The growth drawn by size, as a share of the cell: the cell's own
        // rectangle grows about its center to the one the transform below
        // would cover. It is a cut, not an animation: the growth is a few
        // pixels, so its steps in between are whole-pixel jumps with the
        // art resampled at each one, which reads as a shimmer. Zero
        // wherever the transform does the work.
        property <float> settled-grow: Motion.zoom-by-size && self.zoomed ? root.zoom - 100% : 0%;
        property <float> grow: self.settled-grow;
        x: root.left-inset + root.block-offset-x + self.cell-col * (root.cell-width + root.column-gap) + displacement.offset-x
            - root.cell-width * self.grow / 2;
        y: root.top-inset + root.block-offset-y + self.cell-row * (root.cell-height + root.row-gap) + displacement.offset-y
            - root.cell-height * self.grow / 2;
        width: root.cell-width * (1 + self.grow);
        height: root.cell-height * (1 + self.grow);
        // On the cell, not on the Tile inside it: the Tile is destroyed
        // and rebuilt when focus moves, and a new element starts at its
        // target value, so an animation on it never runs. The cell
        // survives, so this scales both up and down.
        transform-scale-x: !Motion.zoom-by-size && self.zoomed ? root.zoom : 100%;
        transform-scale-y: !Motion.zoom-by-size && self.zoomed ? root.zoom : 100%;
        animate transform-scale-x, transform-scale-y {
            duration: Motion.dur(Motion.zoom-ms);
            easing: ease-out-quad;
        }

        if !cell.is-empty && i != root.selected-local: Tile {
            cell: cell;
            settled-width: root.cell-width * (1 + parent.settled-grow);
            settled-height: root.cell-height * (1 + parent.settled-grow);
            selected: i == root.selected-local;
            section-focused: root.section-focused;
            focus-ready: root.focus-ready;
            held: i == root.held-local;
            compact-padding: root.compact-padding;
            show-caption: root.show-caption;
            caption: root.caption-for(cell);
            card-radius: root.card-radius;
        }

        if !cell.is-empty && i == root.selected-local && root.held-local < 0: Tile {
            cell: cell;
            settled-width: root.cell-width * (1 + parent.settled-grow);
            settled-height: root.cell-height * (1 + parent.settled-grow);
            selected: true;
            zoomed-cover: root.focus-art;
            zoomed-cover-muted: root.focus-art-muted;
            has-zoomed-cover: root.focus-art-local == i;
            own-ring: false;
            press-held: root.press-held;
            section-focused: root.section-focused;
            focus-ready: root.focus-ready;
            held: i == root.held-local;
            compact-padding: root.compact-padding;
            show-caption: root.show-caption;
            caption: root.caption-for(cell);
            card-radius: root.card-radius;
        }

        TouchArea {
            enabled: !(root.skip-empty-cells && cell.is-empty);
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) { root.cell-hovered(i); }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up) {
                    if (event.button == PointerEventButton.right) {
                        root.cell-right-clicked(i);
                    } else if (event.button == PointerEventButton.left) {
                        root.cell-clicked(i);
                    }
                }
            }
            scroll-event(event) => {
                if (event.delta-y != 0) {
                    root.wheel(event.delta-y < 0 ? 1 : -1);
                    return accept;
                }
                return reject;
            }
        }
    }


    // Scales about the same centre as the tile, so the ring stays on it.
    FocusCursor {
        transform-scale-x: Motion.zoom-by-size ? 100% : root.zoom;
        transform-scale-y: Motion.zoom-by-size ? 100% : root.zoom;
        animate transform-scale-x, transform-scale-y {
            duration: Motion.dur(Motion.zoom-ms);
            easing: ease-out-quad;
        }
        motion: Motion.enabled && root.focus-motion;
        radius: Math.max(0px, root.card-radius - root.ring-gap);
        target: { x: root.selected-x + root.ring-gap - root.ring-grow-x,
            y: root.selected-y + root.ring-gap + root.press-y - root.ring-grow-y,
            w: root.cell-width - 2 * root.ring-gap + 2 * root.ring-grow-x,
            h: root.cell-height - Sizing.press-edge-height - 2 * root.ring-gap + 2 * root.ring-grow-y,
            column: root.selected-col, row: root.selected-row, scope: root.focus-scope,
            valid: root.has-selection && root.held-local < 0 && !root.ring-suppressed };
    }

    // One retained held tile retargets from its current position on repeated
    // moves. Cross-page changes snap through focus-scope, like the cursor.
    held-cursor := FocusCursor {
        motion: Motion.enabled && root.focus-motion;
        stroke: 0px;
        target: { x: root.selected-x, y: root.selected-y,
            w: root.cell-width, h: root.cell-height,
            column: root.selected-col, row: root.selected-row, scope: root.focus-scope,
            valid: root.has-selection && root.held-local >= 0 };
        if root.has-selection && root.held-local >= 0: Tile {
            cell: root.cells[root.selected-local];
            selected: true;
            held: true;
            moving: held-cursor.moving || !root.focus-motion;
            compact-padding: root.compact-padding;
            show-caption: root.show-caption;
            caption: root.caption-for(root.cells[root.selected-local]);
            card-radius: root.card-radius;
        }
    }
    }
    }
}
