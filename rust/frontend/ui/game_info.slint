import { Theme, Sizing, Motion } from "theme.slint";
import { ScrollAction, ManualState, ManualFit } from "state_types.slint";
import { DetailRow, MetaLabels } from "browse_list.slint";
import { GlyphSource, SectionHeader, ScrollCue, ModalShell, WaitCue } from "chrome.slint";

export global GameInfoView {
    in-out property <bool> modal-open: false;
    in-out property <string> modal-name: "";
    in-out property <string> modal-system: "";
    in-out property <string> modal-path: "";
    in-out property <string> modal-description: "";
    in-out property <[DetailRow]> rows: [];
    in-out property <bool> loading: false;
    in-out property <bool> failed: false;
    in-out property <bool> media-missing: false;
    in-out property <image> modal-cover;
    in-out property <bool> modal-has-cover: false;
    // Core has no image for the one selected: nothing is coming.
    in-out property <bool> modal-cover-absent: false;
    in-out property <int> image-index: 0;
    in-out property <int> image-count: 0;
    // Screen-height units keep mirrored windows independent of pixel density.
    in-out property <float> scroll-position: 0;
    // The painted art box, in pixels, so a cover can be resized to it.
    callback art-box(int, int);
    // The game has a manual Core can serve; the menu button opens it.
    in-out property <bool> has-manual: false;
    // The manual page, read in this panel's place; `closed` shows the details.
    in-out property <ManualState> manual-state: ManualState.closed;
    in-out property <image> manual-image;
    in-out property <bool> manual-has-image: false;
    in-out property <int> manual-page: 0;
    in-out property <int> manual-pages: 0;
    in-out property <ManualFit> manual-fit: ManualFit.width;
    // Screen-height units, as `scroll-position` is.
    in-out property <float> manual-scroll: 0;
    // The page box, in pixels, so a page is rendered to fit it.
    callback manual-box(int, int);
}

export component GameInfoModal inherits ModalShell {
    visible: GameInfoView.modal-open;
    property <length> line-h: Math.ceil(Sizing.font-body * 1.362 / 1px) * 1px;
    property <length> body-h: GameInfoView.loading ? loading-label.height
        : GameInfoView.failed ? error-label.preferred-height : contents.preferred-height;
    // Lip, title, gap, rule, gap, scroll cue, body, scroll cue, lip. The
    // cues sit in a reserved band outside the viewport rather than in the
    // lip, the same shape `ListPickerModal` uses, so the panel does not
    // resize as the body scrolls past either end.
    property <length> arrow: Sizing.pct-h(3);
    property <length> arrow-band: root.arrow + Sizing.pct-h(0.5);
    // The tallest body this panel may show, from the screen down rather
    // than from the panel: taking it off the panel's own height would
    // close a loop through `content-height`.
    property <length> body-budget: Math.max(0px, root.height - Sizing.pct-h(16)
        - root.content-y - root.pad - 2 * root.arrow-band);
    out property <length> viewport-height: Math.min(root.body-budget, root.body-h);
    out property <length> maximum-scroll: Math.max(0px, root.body-h - root.viewport-height);
    out property <bool> scrollable: !root.reading && !GameInfoView.loading && !GameInfoView.failed && root.maximum-scroll > 0px;

    // The manual takes the panel at its largest, the page under the title,
    // once there is a page; its wait and its errors are one line in the
    // details' own panel.
    out property <bool> reading: GameInfoView.manual-state != ManualState.closed;
    property <bool> paging: GameInfoView.manual-state == ManualState.ready;
    property <length> manual-status-h: GameInfoView.manual-state == ManualState.loading
        ? manual-wait.height : manual-error.preferred-height;
    property <length> page-count-band: Math.ceil(Sizing.font-small * 1.362 / 1px) * 1px;
    property <length> page-box-h: Math.max(0px, root.body-budget - root.page-count-band);
    // Pages arrive rendered for this box, one image pixel per screen pixel.
    // Only a mirror on a smaller screen gets one larger than its box, and
    // scales it down rather than cropping it.
    property <length> page-raw-w: GameInfoView.manual-image.width * 1phx;
    property <length> page-raw-h: GameInfoView.manual-image.height * 1phx;
    property <float> page-scale: Math.min(1,
        root.page-raw-w > root.content-width ? root.content-width / root.page-raw-w : 1,
        GameInfoView.manual-fit == ManualFit.page && root.page-raw-h > root.page-box-h ? root.page-box-h / root.page-raw-h : 1);
    property <length> page-image-w: root.page-raw-w * root.page-scale;
    property <length> page-image-h: root.page-raw-h * root.page-scale;
    property <length> manual-max-scroll: GameInfoView.manual-has-image ? Math.max(0px, root.page-image-h - root.page-box-h) : 0px;
    out property <bool> manual-scrollable: GameInfoView.manual-state == ManualState.ready && root.manual-max-scroll > 0px;
    // Not animated: a glide repaints the whole page every frame, which the
    // software renderer cannot afford at this size.
    property <length> manual-scroll-y: Math.min(root.manual-max-scroll,
        Math.max(0px, GameInfoView.manual-scroll * Sizing.screen-height));

    title: GameInfoView.modal-name;
    panel-width: Sizing.crt
        ? root.width - 12px
        : root.paging ? root.width - Sizing.pct-w(6)
        : Math.min(Math.min(root.width * 0.92, Sizing.pct-h(150)),
            root.width - Sizing.pct-w(6));
    content-height: root.paging ? root.body-budget + 2 * root.arrow-band
        : root.reading ? root.manual-status-h + 2 * root.arrow-band
        : root.viewport-height + 2 * root.arrow-band;

    property <length> scroll-y: Math.min(root.maximum-scroll,
        Math.max(0px, GameInfoView.scroll-position * Sizing.screen-height));

    // What the body is drawn at: it glides to a stepped position, and
    // tracks a drag exactly so the text stays under the finger.
    property <length> shown-y: root.scroll-y;
    animate shown-y { duration: body-touch.pressed ? 0ms : Motion.dur(Motion.page-ms); easing: ease-out; }

    public function move-scroll(delta: length) {
        if (!GameInfoView.loading && !GameInfoView.failed) {
            GameInfoView.scroll-position = Math.max(0px,
                Math.min(root.maximum-scroll, root.scroll-y + delta)) / Math.max(1px, Sizing.screen-height);
        }
    }
    public function scroll(action: ScrollAction) {
        if (root.reading) {
            if (action == ScrollAction.up || action == ScrollAction.down) {
                GameInfoView.manual-scroll = Math.max(0px, Math.min(root.manual-max-scroll,
                    root.manual-scroll-y + (action == ScrollAction.up ? -1 : 1) * Math.max(Sizing.pct-h(12), root.page-box-h / 2)))
                    / Math.max(1px, Sizing.screen-height);
            }
            return;
        }
        if (action == ScrollAction.up) { root.move-scroll(-Sizing.pct-h(8)); }
        if (action == ScrollAction.down) { root.move-scroll(Sizing.pct-h(8)); }
        if (action == ScrollAction.page-prev) { root.move-scroll(-Math.max(Sizing.pct-h(12), root.viewport-height - Sizing.pct-h(8))); }
        if (action == ScrollAction.page-next) { root.move-scroll(Math.max(Sizing.pct-h(12), root.viewport-height - Sizing.pct-h(8))); }
    }

    label-measure := VerticalLayout {
        visible: false;
        for key in ["system", "platform", "year", "release_date", "genre", "players", "play_mode", "cooperative", "developer", "publisher", "rating", "filename"]: Text {
            text: MetaLabels.label(key);
            font-size: Sizing.font-body;
        }
    }
    property <length> label-w: Math.ceil(label-measure.preferred-width / 1px) * 1px + Sizing.stroke(2);

        loading-label := WaitCue {
            x: root.pad;
            y: root.content-y + root.arrow-band;
            width: root.content-width;
            height: self.glyph;
            glyph: Sizing.font-body;
            waiting: GameInfoView.loading && !root.reading;
            text: @tr("Loading details…");
        }
        error-label := Text {
            x: root.pad;
            y: root.content-y + root.arrow-band;
            width: root.content-width;
            text: @tr("Could not load details. Check Zaparoo Core and try again.");
            font-size: Sizing.font-body;
            color: Theme.text-primary;
            wrap: word-wrap;
            visible: !root.reading && !GameInfoView.loading && GameInfoView.failed;
        }

        viewport := Rectangle {
            x: root.pad;
            y: root.content-y + root.arrow-band;
            width: root.content-width;
            height: root.viewport-height;
            clip: true;
            visible: !root.reading && !GameInfoView.loading && !GameInfoView.failed;

            contents := VerticalLayout {
                y: -root.shown-y;
                height: self.preferred-height;
                spacing: Sizing.pct-h(2.4);

                if GameInfoView.image-count > 0: Rectangle {
                    height: Sizing.pct-h(32);
                    property <length> gutter: GameInfoView.image-count > 1 ? Sizing.pct-w(4) : 0px;
                    // The count gets its own strip rather than sitting over
                    // the art, where it lands on whatever the picture has
                    // at that spot.
                    property <length> count-band: GameInfoView.image-count > 1
                        ? Math.ceil(Sizing.font-small * 1.362 / 1px) * 1px : 0px;
                    // `self`, not `parent`: this property is declared on the
                    // row, so `parent` here is the layout around it.
                    property <length> art-h: self.height - self.count-band;
                    Image {
                        x: parent.gutter;
                        // Pinned to the top: an element with no `y` is
                        // centred in its parent, which slid the art down
                        // into the count's strip by half its height.
                        y: 0px;
                        width: parent.width - 2 * parent.gutter;
                        height: parent.art-h;
                        source: GameInfoView.modal-cover;
                        image-fit: contain;
                        image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
                        visible: GameInfoView.modal-has-cover;
                        init => { GameInfoView.art-box(Math.round(self.width / 1px), Math.round(self.height / 1px)); }
                        changed width => { GameInfoView.art-box(Math.round(self.width / 1px), Math.round(self.height / 1px)); }
                        changed height => { GameInfoView.art-box(Math.round(self.width / 1px), Math.round(self.height / 1px)); }
                    }
                    WaitCue {
                        height: parent.art-h;
                        glyph: Sizing.font-caption;
                        waiting: !GameInfoView.modal-has-cover && !GameInfoView.modal-cover-absent;
                        text: @tr("Loading image…");
                    }
                    // Same cue and the same size as the body's scroll
                    // arrows; this pair used to sit one type step larger.
                    for next in [false, true]: ScrollCue {
                        x: next ? parent.width - self.width : 0px;
                        y: Sizing.snap((parent.art-h - self.height) / 2);
                        width: root.arrow;
                        glyph: next ? "icons/NavRight" : "icons/NavLeft";
                        live: next ? GameInfoView.image-index + 1 < GameInfoView.image-count : GameInfoView.image-index > 0;
                        visible: GameInfoView.image-count > 1;
                    }
                    // Direction alone never said how many there were.
                    if GameInfoView.image-count > 1: Text {
                        x: Sizing.snap((parent.width - self.width) / 2);
                        y: parent.height - self.height;
                        text: @tr("{}/{}", GameInfoView.image-index + 1, GameInfoView.image-count);
                        color: Theme.text-label;
                        font-size: Sizing.font-small;
                    }
                }
                if GameInfoView.media-missing: Text {
                    text: @tr("This game's file is missing.");
                    color: Theme.error;
                    font-size: Sizing.font-body;
                    wrap: word-wrap;
                }
                if GameInfoView.rows.length > 0: VerticalLayout {
                    spacing: Sizing.pct-h(0.8);
                    for row[i] in GameInfoView.rows: Rectangle {
                        property <length> top: i > 0 ? Sizing.pct-h(0.8) : 0px;
                        height: Math.max(Sizing.pct-h(3), value.height) + self.top;
                        if i > 0: Rectangle { y: 0px; height: Sizing.stroke(1); background: Theme.border-subtle; }
                        Text {
                            x: 0px;
                            y: parent.top;
                            width: Math.min(root.label-w, parent.width);
                            text: MetaLabels.label(row.key);
                            font-size: Sizing.font-body;
                            color: Theme.text-label;
                            overflow: elide;
                        }
                        value := Text {
                            x: root.label-w + Sizing.pct-w(1.4);
                            y: parent.top;
                            width: Math.max(0px, parent.width - self.x);
                            height: Math.min(Math.ceil(self.preferred-height / 1px) * 1px, root.line-h * 2);
                            text: row.value;
                            font-size: Sizing.font-body;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }
                }
                if GameInfoView.modal-description != "": SectionHeader {
                    label-inset: 0px;
                    label: @tr("Description");
                }
                if GameInfoView.modal-description != "": Text {
                    text: GameInfoView.modal-description;
                    font-size: Sizing.font-body;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
            }
            body-touch := TouchArea {
                property <length> drag-y;
                property <float> drag-scroll;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.drag-y = self.mouse-y;
                        self.drag-scroll = GameInfoView.scroll-position;
                    }
                }
                changed mouse-y => {
                    if (self.pressed) {
                        root.move-scroll(self.drag-scroll * Sizing.screen-height - (self.mouse-y - self.drag-y) - root.scroll-y);
                    }
                }
                scroll-event(event) => { root.move-scroll(-event.delta-y); return accept; }
            }
        }
        for down in [false, true]: ScrollCue {
            x: Sizing.snap((root.panel-width - self.width) / 2);
            y: down ? viewport.y + viewport.height + Sizing.pct-h(0.5) : viewport.y - self.height - Sizing.pct-h(0.5);
            width: root.arrow;
            glyph: down ? "icons/ScrollDown" : "icons/ScrollUp";
            live: down ? root.scroll-y < root.maximum-scroll : root.scroll-y > 0px;
            visible: root.scrollable;
        }

        manual-wait := WaitCue {
            x: root.pad;
            y: root.content-y + root.arrow-band;
            width: root.content-width;
            height: self.glyph;
            glyph: Sizing.font-body;
            waiting: GameInfoView.manual-state == ManualState.loading;
            text: @tr("Loading manual…");
        }
        manual-error := Text {
            x: root.pad;
            y: root.content-y + root.arrow-band;
            width: root.content-width;
            text: GameInfoView.manual-state == ManualState.too-large
                ? @tr("This manual is too large to open.")
                : @tr("Could not open the manual. Check Zaparoo Core and try again.");
            font-size: Sizing.font-body;
            color: Theme.text-primary;
            wrap: word-wrap;
            visible: GameInfoView.manual-state == ManualState.too-large || GameInfoView.manual-state == ManualState.failed;
        }

        if root.paging: Rectangle {
            x: root.pad;
            y: root.content-y + root.arrow-band;
            width: root.content-width;
            height: root.body-budget;

            page-box := Rectangle {
                y: 0px;
                height: root.page-box-h;
                clip: true;
                init => { GameInfoView.manual-box(Math.round(self.width / 1phx), Math.round(self.height / 1phx)); }
                changed width => { GameInfoView.manual-box(Math.round(self.width / 1phx), Math.round(self.height / 1phx)); }
                changed height => { GameInfoView.manual-box(Math.round(self.width / 1phx), Math.round(self.height / 1phx)); }

                // Rendered at the size it is shown: one image pixel per
                // screen pixel, never scaled again here.
                Image {
                    x: Sizing.snap((parent.width - self.width) / 2);
                    y: root.manual-max-scroll > 0px ? -root.manual-scroll-y : Sizing.snap((parent.height - self.height) / 2);
                    width: root.page-image-w;
                    height: root.page-image-h;
                    source: GameInfoView.manual-image;
                    visible: GameInfoView.manual-has-image;
                }
                WaitCue {
                    x: 0px;
                    y: 0px;
                    height: self.glyph;
                    glyph: Sizing.font-body;
                    waiting: GameInfoView.manual-state == ManualState.ready && !GameInfoView.manual-has-image;
                    text: @tr("Loading page…");
                }
            }
            // At the side: the scroll cue holds the middle of this strip.
            if GameInfoView.manual-state == ManualState.ready && GameInfoView.manual-pages > 1: Text {
                x: parent.width - self.width;
                y: parent.height - self.height;
                text: @tr("{}/{}", GameInfoView.manual-page + 1, GameInfoView.manual-pages);
                color: Theme.text-label;
                font-size: Sizing.font-small;
            }
        }
        for down in [false, true]: ScrollCue {
            x: Sizing.snap((root.panel-width - self.width) / 2);
            y: down ? root.content-y + root.arrow-band + root.page-box-h + Sizing.pct-h(0.5)
                : root.content-y + root.arrow-band - self.height - Sizing.pct-h(0.5);
            width: root.arrow;
            glyph: down ? "icons/ScrollDown" : "icons/ScrollUp";
            live: down ? root.manual-scroll-y < root.manual-max-scroll : root.manual-scroll-y > 0px;
            visible: root.manual-scrollable;
        }
}
