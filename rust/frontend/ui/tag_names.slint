// The names of game tags and their values in the details view, and the
// view's own labels for them. Keys come from `zaparoo_app::game_details`;
// the strings are the Zaparoo App's, so both read the same. Every string
// carries a context: "Save", "Menu" or "Final" as a tag mean something
// other than the same word on a button.

export global TagNames {
    // A fact row's label, by tag type.
    public pure function label(kind: string) -> string {
        if (kind == "year") { return @tr("tag-type" => "Release year"); }
        if (kind == "players") { return @tr("tag-type" => "Players"); }
        if (kind == "developer") { return @tr("tag-type" => "Developer"); }
        if (kind == "publisher") { return @tr("tag-type" => "Publisher"); }
        if (kind == "genre") { return @tr("tag-type" => "Genre"); }
        if (kind == "gamegenre") { return @tr("tag-type" => "Game Genre"); }
        if (kind == "rating") { return @tr("tag-type" => "Rating"); }
        if (kind == "gamefamily") { return @tr("tag-type" => "Series"); }
        if (kind == "series") { return @tr("tag-type" => "Series"); }
        if (kind == "arcadeboard") { return @tr("tag-type" => "Arcade board"); }
        if (kind == "region") { return @tr("tag-type" => "Region"); }
        if (kind == "lang") { return @tr("tag-type" => "Language"); }
        if (kind == "edition") { return @tr("tag-type" => "Edition"); }
        if (kind == "rev") { return @tr("tag-type" => "Revision"); }
        if (kind == "disc") { return @tr("tag-type" => "Disc"); }
        if (kind == "disctotal") { return @tr("tag-type" => "Total Discs"); }
        if (kind == "release") { return @tr("tag-type" => "Release"); }
        if (kind == "rerelease") { return @tr("tag-type" => "Re-release"); }
        if (kind == "builddate") { return @tr("tag-type" => "Build Date"); }
        if (kind == "input") { return @tr("tag-type" => "Input"); }
        if (kind == "perspective") { return @tr("tag-type" => "Perspective"); }
        if (kind == "art") { return @tr("tag-type" => "Art Style"); }
        if (kind == "category") { return @tr("tag-type" => "Category"); }
        if (kind == "based") { return @tr("tag-type" => "Based On"); }
        if (kind == "platform") { return @tr("tag-type" => "Platform"); }
        if (kind == "port") { return @tr("tag-type" => "Port"); }
        if (kind == "media") { return @tr("tag-type" => "Media"); }
        if (kind == "video") { return @tr("tag-type" => "Video"); }
        if (kind == "save") { return @tr("tag-type" => "Save"); }
        if (kind == "addon") { return @tr("tag-type" => "Add-on"); }
        if (kind == "embedded") { return @tr("tag-type" => "Embedded"); }
        if (kind == "cabinet") { return @tr("tag-type" => "Arcade Cabinet"); }
        if (kind == "protection") { return @tr("tag-type" => "Copy Protection"); }
        if (kind == "mameparent") { return @tr("tag-type" => "MAME Parent"); }
        if (kind == "compatibility") { return @tr("tag-type" => "Compatibility"); }
        if (kind == "accessibility") { return @tr("tag-type" => "Accessibility"); }
        if (kind == "distribution") { return @tr("tag-type" => "Distribution"); }
        if (kind == "copyright") { return @tr("tag-type" => "Copyright"); }
        if (kind == "credit") { return @tr("tag-type" => "Credit"); }
        if (kind == "dump") { return @tr("tag-type" => "Dump Status"); }
        if (kind == "alt") { return @tr("tag-type" => "Alternate"); }
        if (kind == "patch") { return @tr("tag-type" => "Patch"); }
        if (kind == "unfinished") { return @tr("tag-type" => "Unfinished"); }
        if (kind == "unlicensed") { return @tr("tag-type" => "Unlicensed"); }
        if (kind == "reboxed") { return @tr("tag-type" => "Reboxed"); }
        if (kind == "multigame") { return @tr("tag-type" => "Multi-game"); }
        if (kind == "set") { return @tr("tag-type" => "Set"); }
        if (kind == "supplement") { return @tr("tag-type" => "Supplement"); }
        if (kind == "season") { return @tr("tag-type" => "Season"); }
        if (kind == "episode") { return @tr("tag-type" => "Episode"); }
        if (kind == "volume") { return @tr("tag-type" => "Volume"); }
        if (kind == "issue") { return @tr("tag-type" => "Issue"); }
        if (kind == "track") { return @tr("tag-type" => "Track"); }
        if (kind == "extension") { return @tr("tag-type" => "Extension"); }
        if (kind == "system") { return @tr("tag-type" => "System"); }
        if (kind == "tags") { return @tr("tag-type" => "Tags"); }
        if (kind == "path") { return @tr("tag-type" => "Path"); }
        if (kind == "launcher") { return @tr("tag-type" => "Launcher"); }
        return kind;
    }

    // A value's name (`game_details::Name`): `key` empty shows `text`.
    public pure function name(key: string, arg: string, text: string) -> string {
        if (key == "") { return text; }
        if (key == "rev") { return @tr("tag-value" => "Revision {}", arg); }
        if (key == "players") {
            return @tr("tag-value" => "{n} player" | "{n} players" % Math.round(arg.to-float()));
        }
        if (key == "players-of") { return @tr("tag-value" => "{} players", arg); }
        if (key == "numbered") { return @tr("tag-value" => "{} {}", root.vocabulary(text, ""), arg); }
        return root.vocabulary(key, arg);
    }

