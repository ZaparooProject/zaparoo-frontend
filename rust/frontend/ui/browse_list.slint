//
// The detailed list layout shared by Games, Favorites, Recents and
// Systems: one card split into the windowed row list and a detail pane
// carrying the cover, title and metadata table. Rust windows the rows and
// pushes the row metrics; every other length comes from the browse layout
// profile in `Layout`.

import { Wordmark } from "wordmark.slint";
import { Theme, Sizing, Motion, Layout } from "theme.slint";
import { GlyphSource, WaitCue } from "chrome.slint";
import { GridCell, MarqueeCaption } from "tiles.slint";
import { InfoLineData, InfoFacts, InfoLabels } from "info_line.slint";
import { Labels } from "labels.slint";
import { ScrollOffset, SelectionCursor, SelectionClip } from "focus.slint";

// One metadata table row: a canonical key the vocabulary translates,
// plus Core's value.
export struct DetailRow {
    key: string,
    value: string,
}

// The metadata label vocabulary: one set of strings for the detail pane
// and the details modal. Unknown keys read as themselves.
export global MetaLabels {
    public pure function label(key: string) -> string {
        if (key == "system") { return @tr("System"); }
        if (key == "platform") { return @tr("Platform"); }
        if (key == "category") { return @tr("Category"); }
        if (key == "year") { return @tr("Year"); }
        if (key == "release_date") { return @tr("Release date"); }
        if (key == "genre") { return @tr("Genre"); }
        if (key == "players") { return @tr("Players"); }
        if (key == "play_mode") { return @tr("Play mode"); }
        if (key == "cooperative") { return @tr("Cooperative"); }
        if (key == "developer") { return @tr("Developer"); }
        if (key == "publisher") { return @tr("Publisher"); }
        if (key == "manufacturer") { return @tr("Manufacturer"); }
        if (key == "rating") { return @tr("Rating"); }
        if (key == "filename") { return @tr("Filename"); }
        if (key == "collections") { return @tr("Collections"); }
        if (key == "versions") { return @tr("Versions"); }
        if (key == "play_time") { return @tr("Play time"); }
        if (key == "owner") { return @tr("Owner"); }
        if (key == "hidden") { return @tr("Hidden"); }
        return key;
    }
    // The packed form a narrow label column falls back to; empty when
    // a key has none.
    public pure function short(key: string) -> string {
        if (key == "system") { return @tr("Sys"); }
        if (key == "platform") { return @tr("Plat"); }
        if (key == "category") { return @tr("Cat"); }
        if (key == "year") { return @tr("Yr"); }
        if (key == "release_date") { return @tr("Date"); }
        if (key == "genre") { return @tr("Gen"); }
        if (key == "players") { return @tr("Plyr"); }
        if (key == "play_mode") { return @tr("Mode"); }
        if (key == "cooperative") { return @tr("Co-op"); }
        if (key == "developer") { return @tr("Dev"); }
        if (key == "publisher") { return @tr("Pub"); }
        if (key == "manufacturer") { return @tr("Mfr"); }
        if (key == "rating") { return @tr("Rtg"); }
        if (key == "filename") { return @tr("File"); }
        if (key == "collections") { return @tr("Coll"); }
        if (key == "versions") { return @tr("Vers"); }
        if (key == "play_time") { return @tr("Time"); }
        if (key == "owner") { return @tr("Own"); }
        if (key == "hidden") { return @tr("Hid"); }
        return "";
    }
}

// The windowed rows with the inverse-video selection bar, the scrolling
// caption and the favorite heart. Rows are the slice Rust centered on the
// selection; `selected` is local to it.
export component BrowseList inherits Rectangle {
    in property <[GridCell]> rows: [];
    in property <int> model-top: 0;
    in property <int> scroll-top: 0;
    in property <string> scope: "";
    in property <int> selected: -1;
    in property <bool> focus-ready: true;
    in property <int> activate-pulse: 0;
    in property <int> release-pulse: 0;
    in property <bool> settling: false;
    in property <length> row-height: Sizing.pct-h(6);
    in property <bool> show-chrome: true;
    // The list glides to follow the selection. A tap eases a row or a page
    // over `Motion.scroll-ms`, as the Settings cards do. A held key that
    // walks row by row sets `step`, a little over its repeat interval, and
    // the list follows at constant speed: it is still moving when the next
    // repeat lands, so the walk reads as one continuous scroll at any
    // cadence. Rust clears `glide` only for a held step that jumps a page
    // or a letter, and pushes a page of rows either side of the window so
    // a glide has rows to show the whole way.
    in property <bool> glide: true;
    in property <duration> step: 0ms;
    // The selected row is picked up (Options -> Move) and blinks, the
    // same hard cut as a held tile; see `Tile` in tiles.slint.
    in property <bool> held: false;
    // A text list with no detail pane shows the focused item's facts
    // (collections, versions, play time, owner, hidden) at its row's right
    // end; other rows keep only the heart.
    in property <bool> show-focus-facts: false;
    in property <InfoLineData> focus-info;
    callback row-hovered(int);
    callback row-clicked(int);
    callback row-right-clicked(int);
    callback empty-right-clicked();
    callback wheel(int);

    background: root.show-chrome ? Theme.surface-card : transparent;
    border-radius: root.show-chrome ? Layout.card-radius : 0px;
    border-width: root.show-chrome ? Sizing.card-border-width : 0px;
    border-color: Theme.border-mid;
    clip: true;

    property <length> stride: root.row-height + Layout.row-spacing;
    property <length> heart-size: GlyphSource.side(Sizing.pct-h(3.2));
    // Under Reduce motion the row stays on; the help bar's move line
    // carries the state. Each step restarts a full visible interval.
    property <bool> blinking: root.held && Motion.enabled;
    property <bool> held-blink-on: true;
    property <bool> held-off: root.blinking && !root.held-blink-on;
    Timer {
        interval: Motion.held-blink-ms;
        running: root.blinking;
        triggered => { root.held-blink-on = !root.held-blink-on; }
    }
    changed blinking => { root.held-blink-on = true; }
    changed selected => { root.held-blink-on = true; }
    scroll := ScrollOffset {
        target: root.scroll-top * root.stride;
        step: root.stride;
        focus-start: (root.selected + root.model-top) * root.stride;
        focus-size: root.row-height;
        viewport: root.height - Layout.card-padding-top - Layout.card-padding-bottom;
        scope: root.scope + ":" + Motion.epoch;
        // The cursor is positioned in the content it scrolls, so a row
        // past the window rides in with it.
        reveal: true;
        glide-span: root.glide ? Math.max(root.stride, self.viewport + root.stride) : 0px;
        duration: root.step > 0ms ? root.step : Motion.scroll-ms;
        steady: root.step > 0ms;
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.empty-right-clicked();
            }
        }
        scroll-event(event) => {
            if (event.delta-y != 0) {
                root.wheel(event.delta-y < 0 ? 1 : -1);
                return accept;
            }
            reject
        }
    }

    Rectangle {
    y: Layout.card-padding-top;
    height: Math.max(0px, root.height - Layout.card-padding-top - Layout.card-padding-bottom);
    clip: true;
    sel := SelectionCursor {
        opacity: root.held-off ? 0.0 : 1.0;
        motion: Motion.enabled && !scroll.moving;
        radius: Layout.row-radius;
        activate-pulse: root.activate-pulse;
        release-pulse: root.release-pulse;
        screen-settling: root.settling;
        target: { x: Layout.card-padding-left,
            y: (root.selected + root.model-top) * root.stride - scroll.offset,
            w: root.width - Layout.card-padding-left - Layout.card-padding-right, h: root.row-height,
            column: 0, row: root.selected + root.model-top,
            scope: root.scope + ":" + root.scroll-top,
            valid: root.focus-ready && root.selected >= 0 && root.selected < root.rows.length };
    }
    for row[i] in root.rows: Rectangle {
        x: Layout.card-padding-left;
        y: (i + root.model-top) * root.stride - scroll.offset;
        width: parent.width - Layout.card-padding-left - Layout.card-padding-right;
        height: root.row-height;
        opacity: (root.held-off && i == root.selected) ? 0.0 : 1.0;
        // The highlight waits for the host to finalize the selection, so
        // row 0 never lights up before a restore lands.
        property <bool> highlighted: i == root.selected && root.focus-ready;
        // Whether the travelling fill is over any part of this row. The
        // caption is drawn again inside that band, inverted, so the color
        // boundary is the fill's edge rather than the row's.
        property <bool> lit: root.focus-ready
            && sel.fill-bottom > self.y && sel.fill-top < self.y + self.height;
        // The focused row of a text list trades its heart for the facts,
        // which carry the heart among the collections.
        property <bool> facts-here: root.show-focus-facts && highlighted && InfoLabels.has-facts(root.focus-info);
        property <length> facts-w: self.facts-here ? Math.ceil(facts-measure.preferred-width / 1px) * 1px : 0px;
        property <length> favorite-slot: self.facts-here
            ? Layout.favorite-right-padding + self.facts-w
            : (row.favorite ? Layout.favorite-right-padding + root.heart-size : 0px);
        // The same chevron and size as a context-menu row that opens a page.
        property <length> chevron: GlyphSource.side(Sizing.pct-h(3));
        property <length> chevron-slot: row.opens ? Layout.favorite-right-padding + self.chevron : 0px;
        property <length> caption-w: Math.max(0px, self.width - Layout.row-text-left-padding - Layout.row-text-right-padding - favorite-slot - chevron-slot);

        MarqueeCaption {
            x: Layout.row-text-left-padding;
            y: 0;
            width: caption-w;
            content: row.name;
            tags: row.tags;
            focused: highlighted;
            center-content: false;
            caption-font-size: Sizing.font-section;
            caption-weight: FontWeight.normal;
            caption-color: row.hidden ? Theme.text-variant : Theme.text-primary;
            tags-color: Theme.text-variant;
        }
        if lit: SelectionClip {
            radius: Layout.row-radius;
            row-top: parent.y; row-height: parent.height;
            fill-top: sel.fill-top; fill-bottom: sel.fill-bottom;
            fill: sel.fill;
            // `focused` stays the logical selection in both copies, so the
            // marquee scrolls in step and the two never disagree at the
            // boundary; only the colors differ.
            MarqueeCaption {
                x: Layout.row-text-left-padding;
                y: 0;
                width: caption-w;
                content: row.name;
                tags: row.tags;
                focused: highlighted;
                center-content: false;
                caption-font-size: Sizing.font-section;
                caption-weight: FontWeight.medium;
                caption-color: row.hidden ? sel.content-muted : sel.content;
                tags-color: sel.content-muted;
            }
        }

        if row.opens: Image {
            x: parent.width - Layout.favorite-right-padding - parent.favorite-slot - self.width;
            y: Sizing.snap((parent.height - self.height) / 2);
            width: parent.chevron;
            height: self.width;
            source: GlyphSource.glyph("icons/NavRight", Math.max(1px, self.width), highlighted ? sel.content : Theme.text-label);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }
        facts-measure := InfoFacts {
            visible: false;
            info: root.focus-info;
            icon-size: root.heart-size;
            font-size: Sizing.font-section;
        }
        if facts-here: InfoFacts {
            x: parent.width - Layout.favorite-right-padding - parent.facts-w;
            y: 0;
            width: parent.facts-w;
            height: parent.height;
            info: root.focus-info;
            icon-size: root.heart-size;
            font-size: Sizing.font-section;
            ink: sel.content;
        }
        if row.favorite && !facts-here: Image {
            x: parent.width - Layout.favorite-right-padding - root.heart-size;
            y: Sizing.snap((parent.height - self.height) / 2);
            width: root.heart-size;
            height: root.heart-size;
            // On the row's own surface the heart is text colored, like the
            // info line's icons; only a heart over art keeps its keyline.
            source: GlyphSource.glyph("icons/HeartFilled", root.heart-size, highlighted ? sel.content : Theme.text-primary);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }

        TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) { root.row-hovered(i); }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up) {
                    if (event.button == PointerEventButton.right) {
                        root.row-right-clicked(i);
                    } else if (event.button == PointerEventButton.left) {
                        root.row-clicked(i);
                    }
                }
            }
            scroll-event(event) => {
                if (event.delta-y != 0) {
                    root.wheel(event.delta-y < 0 ? 1 : -1);
                    return accept;
                }
                reject
            }
        }
    }
    }
}

// The detail pane: the focused row's cover (or the file chip once
// Core confirmed there is none, or the wordmark for a system without
// logo art), the title, and the label/value metadata table. Sections
// stack per the detail profile: cover above metadata, or side by side.
// One fact row of the detail pane, after the metadata: the label as the
// metadata rows draw theirs, then the fact's icons and text.
component DetailFactRow inherits Rectangle {
    in property <length> label-w;
    in property <length> label-gap;
    in property <string> label;
    x: 0;
    Text {
        x: 0;
        y: Sizing.snap((parent.height - self.height) / 2);
        width: Math.min(root.label-w, parent.width);
        horizontal-alignment: right;
        overflow: elide;
        text: root.label;
        color: Theme.text-label;
        font-size: Sizing.font-small;
    }
    HorizontalLayout {
        x: root.label-w + root.label-gap;
        width: Math.max(0px, parent.width - root.label-w - root.label-gap);
        alignment: start;
        @children
    }
}

export component BrowseDetailPane inherits Rectangle {
    // The focused item's facts, as rows after the metadata.
    in property <InfoLineData> info;
    // The painted art box, reported so a cover can be resized to it
    // before it is shown.
    callback art-box(length, length);
    in property <string> title: "";
    in property <bool> show-title: true;
    in property <image> cover;
    in property <bool> has-cover: false;
    // The cover is a bitmap prepared for the reported art box (a system
    // logo), painted one pixel for one where bitmaps are painted that way.
    in property <bool> cover-exact: false;
    // Core confirmed no art exists: show the chip. Pending fetches stay
    // blank, like the grid tiles.
    in property <bool> cover-absent: false;
    // A system row with no bundled logo: the fitted name stands in.
    in property <bool> wordmark: false;
    in property <string> placeholder-key: "icons/File";
    in property <[DetailRow]> rows: [];
    in property <bool> loading: false;
    in property <string> loading-text: @tr("Loading…");
    in property <bool> show-chrome: true;
    // Which of the game's images the art is, when Left and Right step
    // them; a count under two shows nothing.
    in property <int> image-index: 0;
    in property <int> image-count: 0;
    in property <string> image-kind: "";

    background: root.show-chrome ? Theme.surface-card : transparent;
    border-radius: root.show-chrome ? Layout.card-radius : 0px;
    border-width: root.show-chrome ? Sizing.card-border-width : 0px;
    border-color: Theme.border-mid;
    clip: true;

    // Content box inside the pane padding.
    property <length> content-x: Layout.pane-padding-left;
    property <length> content-y: Layout.pane-padding-top;
    property <length> content-w: Math.max(0px, root.width - Layout.pane-padding-left - Layout.pane-padding-right);
    property <length> content-h: Math.max(0px, root.height - Layout.pane-padding-top - Layout.pane-padding-bottom);
    property <bool> horizontal: !Layout.detail-vertical;
    property <int> share-total: Math.max(1, Layout.image-share + Layout.metadata-share);
    property <length> primary-span: root.horizontal
        ? Math.floor((root.content-w - Layout.section-gap) * Layout.image-share / root.share-total / 1px) * 1px
        : Math.floor((root.content-h - Layout.section-gap) * Layout.image-share / root.share-total / 1px) * 1px;
    property <bool> title-visible: root.show-title && root.title != "";
    // Image slot: the share-based span keeps the cover footprint stable
    // from the first frame; with a title the profile's ratio applies.
    property <length> image-avail-w: Math.max(0px, root.content-w - Layout.image-padding-left - Layout.image-padding-right);
    property <length> image-limit: root.title-visible
        ? Math.floor(root.content-h * Layout.image-height-ratio-with-title / 100 / 1px) * 1px
        : Math.max(0px, root.primary-span - Layout.image-bottom-margin);
    property <length> image-slot-x: root.horizontal ? 0px : Layout.image-padding-left;
    property <length> image-slot-w: root.horizontal
        ? Math.max(0px, root.primary-span)
        : Math.max(0px, Math.min(root.image-avail-w, root.image-avail-w + Layout.image-reserved-width));
    property <length> image-slot-h: root.horizontal
        ? root.content-h
        : Math.max(0px, Math.min(root.content-h, Math.min(root.image-avail-w, root.image-limit) + Layout.image-reserved-height));
    property <length> secondary-span: root.horizontal
        ? Math.max(0px, root.content-w - root.primary-span - Layout.section-gap)
        : Math.max(0px, root.content-h - root.image-slot-h - Layout.section-gap);
    property <length> metadata-x: root.horizontal ? root.primary-span + Layout.section-gap : 0px;
    property <length> metadata-y: root.horizontal ? 0px : root.image-slot-h + Layout.section-gap;
    property <length> metadata-w: root.horizontal ? root.secondary-span : root.content-w;
    property <length> metadata-h: root.horizontal ? root.content-h : root.secondary-span;
    property <length> inner-x: root.metadata-x + (root.horizontal ? Layout.metadata-padding-left : Layout.metadata-left-margin);
    property <length> inner-y: root.metadata-y + (root.horizontal ? Layout.metadata-padding-top : 0px);
    property <length> inner-w: Math.max(0px, root.metadata-w
        - (root.horizontal ? Layout.metadata-padding-left + Layout.metadata-padding-right : Layout.metadata-left-margin + Layout.metadata-right-margin));
    property <length> inner-h: Math.max(0px, root.metadata-h - (root.horizontal ? Layout.metadata-padding-top + Layout.metadata-padding-bottom : 0px));

    // Title: up to three wrapped lines, elided.
    property <length> title-line: Math.ceil(Theme.ascent(Sizing.font-title) * 1.362 / 1px) * 1px;
    property <length> title-h: root.title-visible ? Math.min(3 * root.title-line, title-measure.preferred-height) : 0px;
    property <length> body-top: root.title-visible ? root.title-h + Layout.title-bottom-margin : 0px;
    property <bool> bottom-aligned-compact: !root.title-visible && !root.horizontal && Layout.metadata-bottom-aligned;
    property <length> body-y: root.body-top + (root.bottom-aligned-compact ? 0px : Layout.metadata-top-margin);

    // Tag rows never sit shorter than the font's real line box.
    property <length> tag-row-h: Math.max(Layout.tag-row-height, row-measure.preferred-height);
    // The info line's facts as rows ahead of Core's metadata, each only
    // when it applies: Collections, Versions, Play time, Owner, Hidden.
    // First, so a long metadata list is what the pane's bottom edge cuts.
    property <bool> has-collections: root.info.favorite || root.info.liked || root.info.disliked || root.info.play-later;
    property <bool> has-versions: root.info.versions > 0;
    property <bool> has-time: root.info.has-play-time;
    property <bool> has-owner: root.info.owner != "" || root.info.locked;
    property <bool> has-hidden: root.info.hidden;
    property <int> at-collections: 0;
    property <int> at-versions: root.at-collections + (root.has-collections ? 1 : 0);
    property <int> at-time: root.at-versions + (root.has-versions ? 1 : 0);
    property <int> at-owner: root.at-time + (root.has-time ? 1 : 0);
    property <int> at-hidden: root.at-owner + (root.has-owner ? 1 : 0);
    property <int> fact-count: root.at-hidden + (root.has-hidden ? 1 : 0);
    property <int> row-count: root.fact-count + root.rows.length;
    property <length> fact-icon: GlyphSource.side(Sizing.font-small);
    property <length> natural-h: root.row-count <= 0 ? 0px
        : root.row-count * root.tag-row-h + (root.row-count - 1) * Layout.tag-row-spacing;
    property <length> compact-h: Math.min(root.metadata-h, root.natural-h);
    property <length> body-h: root.horizontal
        ? Math.max(0px, root.inner-h - root.body-y)
        : (root.title-visible
            ? Math.max(0px, root.inner-h - root.body-y + Layout.metadata-height-adjustment)
            : (root.bottom-aligned-compact
                ? Math.max(0px, Math.min(root.compact-h + Layout.metadata-top-margin, root.inner-h))
                : Math.max(0px, Math.min(root.compact-h, root.inner-h - root.body-y))));
    property <length> table-y: root.bottom-aligned-compact ? Math.max(0px, root.body-h - root.natural-h) : 0px;

    // Label column: the widest full label on screen plus the hinting
    // slack; when a profile caps the column and the full labels exceed
    // it, every row packs to its short form instead of truncating.
    property <length> slack: Theme.crt ? 0px : 2px;
    property <length> facts-label-w: Math.max(root.has-collections ? e0.preferred-width : 0px,
        Math.max(root.has-versions ? e1.preferred-width : 0px, Math.max(root.has-time ? e2.preferred-width : 0px,
        Math.max(root.has-owner ? e3.preferred-width : 0px, root.has-hidden ? e4.preferred-width : 0px))));
    property <length> facts-short-w: Math.max(root.has-collections ? f0.preferred-width : 0px,
        Math.max(root.has-versions ? f1.preferred-width : 0px, Math.max(root.has-time ? f2.preferred-width : 0px,
        Math.max(root.has-owner ? f3.preferred-width : 0px, root.has-hidden ? f4.preferred-width : 0px))));
    property <length> natural-label-w: Math.max(root.facts-label-w, Math.max(m0.preferred-width, Math.max(m1.preferred-width, Math.max(m2.preferred-width,
        Math.max(m3.preferred-width, Math.max(m4.preferred-width, Math.max(m5.preferred-width, Math.max(m6.preferred-width, m7.preferred-width))))))))
        + (root.row-count > 0 ? root.slack : 0px);
    property <length> short-label-w: Math.max(root.facts-short-w, Math.max(s0.preferred-width, Math.max(s1.preferred-width, Math.max(s2.preferred-width,
        Math.max(s3.preferred-width, Math.max(s4.preferred-width, Math.max(s5.preferred-width, Math.max(s6.preferred-width, s7.preferred-width))))))))
        + (root.row-count > 0 ? root.slack : 0px);
    property <bool> use-short: Layout.metadata-label-max-width > 0px && root.natural-label-w > Layout.metadata-label-max-width;
    property <length> label-w: root.use-short
        ? Math.min(root.short-label-w, Layout.metadata-label-max-width)
        : root.natural-label-w;
    property <length> label-gap: Sizing.pct-w(1.4);
    pure function row-label(key: string) -> string {
        if (root.use-short && MetaLabels.short(key) != "") { return MetaLabels.short(key); }
        return MetaLabels.label(key);
    }
    pure function key-at(i: int) -> string {
        return i < root.rows.length ? root.rows[i].key : "";
    }

    // Measurement texts (never painted).
    title-measure := Text {
        visible: false;
        width: root.inner-w;
        wrap: word-wrap;
        text: root.title;
        font-size: Sizing.font-title;
    }
    row-measure := Text { visible: false; text: "Ag"; font-size: Sizing.font-small; }
    m0 := Text { visible: false; text: MetaLabels.label(root.key-at(0)); font-size: Sizing.font-small; }
    m1 := Text { visible: false; text: MetaLabels.label(root.key-at(1)); font-size: Sizing.font-small; }
    m2 := Text { visible: false; text: MetaLabels.label(root.key-at(2)); font-size: Sizing.font-small; }
    m3 := Text { visible: false; text: MetaLabels.label(root.key-at(3)); font-size: Sizing.font-small; }
    m4 := Text { visible: false; text: MetaLabels.label(root.key-at(4)); font-size: Sizing.font-small; }
    m5 := Text { visible: false; text: MetaLabels.label(root.key-at(5)); font-size: Sizing.font-small; }
    m6 := Text { visible: false; text: MetaLabels.label(root.key-at(6)); font-size: Sizing.font-small; }
    m7 := Text { visible: false; text: MetaLabels.label(root.key-at(7)); font-size: Sizing.font-small; }
    s0 := Text { visible: false; text: root.row-label(root.key-at(0)); font-size: Sizing.font-small; }
    s1 := Text { visible: false; text: root.row-label(root.key-at(1)); font-size: Sizing.font-small; }
    s2 := Text { visible: false; text: root.row-label(root.key-at(2)); font-size: Sizing.font-small; }
    s3 := Text { visible: false; text: root.row-label(root.key-at(3)); font-size: Sizing.font-small; }
    s4 := Text { visible: false; text: root.row-label(root.key-at(4)); font-size: Sizing.font-small; }
    s5 := Text { visible: false; text: root.row-label(root.key-at(5)); font-size: Sizing.font-small; }
    s6 := Text { visible: false; text: root.row-label(root.key-at(6)); font-size: Sizing.font-small; }
    s7 := Text { visible: false; text: root.row-label(root.key-at(7)); font-size: Sizing.font-small; }
    e0 := Text { visible: false; text: MetaLabels.label("collections"); font-size: Sizing.font-small; }
    e1 := Text { visible: false; text: MetaLabels.label("versions"); font-size: Sizing.font-small; }
    e2 := Text { visible: false; text: MetaLabels.label("play_time"); font-size: Sizing.font-small; }
    e3 := Text { visible: false; text: MetaLabels.label("owner"); font-size: Sizing.font-small; }
    e4 := Text { visible: false; text: MetaLabels.label("hidden"); font-size: Sizing.font-small; }
    f0 := Text { visible: false; text: root.row-label("collections"); font-size: Sizing.font-small; }
    f1 := Text { visible: false; text: root.row-label("versions"); font-size: Sizing.font-small; }
    f2 := Text { visible: false; text: root.row-label("play_time"); font-size: Sizing.font-small; }
    f3 := Text { visible: false; text: root.row-label("owner"); font-size: Sizing.font-small; }
    f4 := Text { visible: false; text: root.row-label("hidden"); font-size: Sizing.font-small; }

    content := Rectangle {
        x: root.content-x;
        y: root.content-y;
        width: root.content-w;
        height: root.content-h;
        clip: true;

        image-slot := Rectangle {
            x: root.image-slot-x;
            y: 0;
            width: root.image-slot-w;
            height: root.image-slot-h;
            clip: true;
            property <length> art-x: root.horizontal ? Layout.image-padding-left : 0px;
            property <length> art-y: Layout.image-padding-top;
            property <length> art-w: Math.max(0px, self.width - (root.horizontal ? Layout.image-padding-left + Layout.image-padding-right : 0px));
            property <length> art-h: Math.max(0px, self.height - Layout.image-padding-top - Layout.image-padding-bottom);
            init => { root.art-box(self.art-w, self.art-h); }
            changed art-w => { root.art-box(self.art-w, self.art-h); }
            changed art-h => { root.art-box(self.art-w, self.art-h); }

            // The cover's colour until it lands, like a grid tile.
            // No average-colour fill here: that stand-in belongs to the
            // grid's tiles. The pane's cover only fades in as it lands.
            Image {
                // Exact-pixel contract, as on a grid tile: a prepared logo
                // that fits the box is painted at its own pixel size,
                // centered on a whole pixel, because the software renderer
                // samples a fitted bitmap nearest-neighbor.
                property <bool> exact: Motion.zoom-by-size && root.cover-exact
                    && self.source.width * 1px <= parent.art-w + 0.01px
                    && self.source.height * 1px <= parent.art-h + 0.01px;
                x: self.exact ? Math.round((parent.art-x + (parent.art-w - self.width) / 2) / 1px) * 1px : parent.art-x;
                y: self.exact ? Math.round((parent.art-y + (parent.art-h - self.height) / 2) / 1px) * 1px : parent.art-y;
                width: self.exact ? self.source.width * 1px : parent.art-w;
                height: self.exact ? self.source.height * 1px : parent.art-h;
                source: root.cover;
                image-fit: contain;
                image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
                opacity: 0;
                states [
                    shown when root.has-cover: {
                        opacity: 1;
                        in {
                            animate opacity { duration: Motion.dur(Motion.cover-reveal-ms); easing: ease-out; }
                        }
                    }
                ]
            }
            // Only a confirmed no-cover state shows the chip; the pane
            // never shows an hourglass.
            if !root.has-cover && !root.wordmark && root.cover-absent: Image {
                property <length> s: GlyphSource.side(parent.art-w * 0.5);
                x: parent.art-x + (parent.art-w - self.s) / 2;
                y: parent.art-y + (parent.art-h - self.s) / 2;
                width: self.s;
                height: self.s;
                source: GlyphSource.glyph(root.placeholder-key, self.s, Theme.text-label);
                image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
            }
            // Over the art's corner on a card-colored plate, so the art box
            // and the covers fitted to it stay the size they always are.
            // The image's type names what it is: a map or the box's back
            // is not always plain from the picture alone.
            if root.image-count > 1: Rectangle {
                property <length> pad: Sizing.pct-h(0.5);
                property <length> gap: Labels.image-type(root.image-kind) == "" ? 0px : Sizing.pct-w(0.8);
                x: parent.art-x + parent.art-w - self.width;
                y: parent.art-y + parent.art-h - self.height;
                width: Math.min(parent.art-w, kind-text.preferred-width + self.gap + count-text.preferred-width + 2 * self.pad);
                height: count-text.preferred-height + self.pad;
                background: Theme.surface-card;
                border-radius: Sizing.radius-md;
                kind-text := Text {
                    x: parent.pad;
                    width: Math.max(0px, parent.width - 2 * parent.pad - parent.gap - count-text.preferred-width);
                    text: Labels.image-type(root.image-kind);
                    color: Theme.text-primary;
                    font-size: Sizing.font-small;
                    overflow: elide;
                }
                count-text := Text {
                    x: parent.width - parent.pad - self.width;
                    width: self.preferred-width;
                    text: @tr("{}/{}", root.image-index + 1, root.image-count);
                    color: Theme.text-label;
                    font-size: Sizing.font-small;
                }
            }
            // Wordmark fallback for a system without curated logo art
            // (the grid tile's fitted-text treatment).
            if !root.has-cover && root.wordmark && root.title != "": Wordmark {
                x: parent.art-x + Sizing.pct-h(1);
                y: parent.art-y + Sizing.pct-h(1);
                width: Math.max(0px, parent.art-w - 2 * Sizing.pct-h(1));
                height: Math.max(0px, parent.art-h - 2 * Sizing.pct-h(1));
                text: root.title;
                ink: Theme.logo-focus-primary;
            }
        }

        metadata := Rectangle {
            x: root.inner-x;
            y: root.inner-y;
            width: root.inner-w;
            height: root.inner-h;
            clip: true;

            if root.title-visible: Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.title-h;
                wrap: word-wrap;
                overflow: elide;
                text: root.title;
                color: Theme.text-primary;
                font-size: Sizing.font-title;
            }

            body := Rectangle {
                x: 0;
                y: root.body-y;
                height: root.body-h;
                clip: true;

                for meta[j] in root.rows: Rectangle {
                    x: 0;
                    y: root.table-y + (root.fact-count + j) * (root.tag-row-h + Layout.tag-row-spacing);
                    height: root.tag-row-h;
                    Text {
                        x: 0;
                        y: Sizing.snap((parent.height - self.height) / 2);
                        width: Math.min(root.label-w, parent.width);
                        horizontal-alignment: right;
                        overflow: elide;
                        text: root.row-label(meta.key);
                        color: Theme.text-label;
                        font-size: Sizing.font-small;
                    }
                    Text {
                        x: root.label-w + root.label-gap;
                        y: Sizing.snap((parent.height - self.height) / 2);
                        width: Math.max(0px, parent.width - root.label-w - root.label-gap);
                        overflow: elide;
                        text: meta.value;
                        color: Theme.text-primary;
                        font-size: Sizing.font-small;
                    }
                }

                if root.has-collections: DetailFactRow {
                    y: root.table-y + root.at-collections * (root.tag-row-h + Layout.tag-row-spacing);
                    height: root.tag-row-h;
                    label-w: root.label-w;
                    label-gap: root.label-gap;
                    label: root.row-label("collections");
                    InfoFacts {
                        info: { favorite: root.info.favorite, liked: root.info.liked, disliked: root.info.disliked, play-later: root.info.play-later, item-count: -1 };
                        icon-size: root.fact-icon;
                        font-size: Sizing.font-small;
                    }
                }
                if root.has-versions: DetailFactRow {
                    y: root.table-y + root.at-versions * (root.tag-row-h + Layout.tag-row-spacing);
                    height: root.tag-row-h;
                    label-w: root.label-w;
                    label-gap: root.label-gap;
                    label: root.row-label("versions");
                    InfoFacts {
                        info: { versions: root.info.versions, item-count: -1 };
                        icon-size: root.fact-icon;
                        font-size: Sizing.font-small;
                    }
                }
                if root.has-time: DetailFactRow {
                    y: root.table-y + root.at-time * (root.tag-row-h + Layout.tag-row-spacing);
                    height: root.tag-row-h;
                    label-w: root.label-w;
                    label-gap: root.label-gap;
                    label: root.row-label("play_time");
                    InfoFacts {
                        info: { has-play-time: true, hours: root.info.hours, minutes: root.info.minutes, item-count: -1 };
                        icon-size: root.fact-icon;
                        font-size: Sizing.font-small;
                    }
                }
                if root.has-owner: DetailFactRow {
                    y: root.table-y + root.at-owner * (root.tag-row-h + Layout.tag-row-spacing);
                    height: root.tag-row-h;
                    label-w: root.label-w;
                    label-gap: root.label-gap;
                    label: root.row-label("owner");
                    InfoFacts {
                        info: { owner: root.info.owner, locked: root.info.locked, item-count: -1 };
                        icon-size: root.fact-icon;
                        font-size: Sizing.font-small;
                    }
                }
                if root.has-hidden: DetailFactRow {
                    y: root.table-y + root.at-hidden * (root.tag-row-h + Layout.tag-row-spacing);
                    height: root.tag-row-h;
                    label-w: root.label-w;
                    label-gap: root.label-gap;
                    label: root.row-label("hidden");
                    InfoFacts {
                        info: { hidden: true, item-count: -1 };
                        icon-size: root.fact-icon;
                        font-size: Sizing.font-small;
                    }
                }
            }
        }

        // The loading cue paints only when the pane has nothing else to
        // show, under the shared delay so quick loads never flash it.
        WaitCue {
            waiting: root.loading && !root.has-cover && root.row-count == 0 && root.title == "";
            text: root.loading-text;
        }
    }
}

// The card, split by the list profile's shares (rows left and detail
// right, or rows above detail in TATE).
export component BrowseListDetailView inherits Rectangle {
    in property <[GridCell]> rows: [];
    in property <int> model-top: 0;
    in property <int> scroll-top: 0;
    in property <string> scope: "";
    in property <int> selected: -1;
    in property <bool> focus-ready: true;
    in property <int> activate-pulse: 0;
    in property <int> release-pulse: 0;
    in property <bool> settling: false;
    in property <length> row-height: Sizing.pct-h(6);
    in property <bool> glide: true;
    in property <duration> step: 0ms;
    in property <bool> held: false;
    // The focused item's facts, as the pane's rows after its metadata.
    in property <InfoLineData> info;
    in property <string> detail-title: "";
    in property <bool> show-title: true;
    in property <image> cover;
    in property <bool> has-cover: false;
    in property <bool> cover-exact: false;
    in property <bool> cover-absent: false;
    in property <bool> wordmark: false;
    in property <string> placeholder-key: "icons/File";
    in property <[DetailRow]> detail-rows: [];
    in property <bool> detail-loading: false;
    in property <string> loading-text: @tr("Loading…");
    in property <int> image-index: 0;
    in property <int> image-count: 0;
    in property <string> image-kind: "";
    callback row-hovered(int);
    callback row-clicked(int);
    callback row-right-clicked(int);
    callback empty-right-clicked();
    callback wheel(int);
    callback art-box(length, length);

    background: Theme.surface-card;
    border-radius: Layout.card-radius;
    border-width: Sizing.card-border-width;
    border-color: Theme.border-mid;
    clip: true;

    property <bool> vertical: Layout.list-vertical;
    property <int> share-total: Math.max(1, Layout.list-share + Layout.detail-share);
    property <length> list-span: root.vertical
        ? Math.max(0px, Math.floor((root.height - Layout.divider-width) * Layout.list-share / root.share-total / 1px) * 1px + Layout.divider-margin)
        : Math.max(0px, Math.floor((root.width - Layout.divider-width) * Layout.list-share / root.share-total / 1px) * 1px + Layout.divider-margin);
    property <length> detail-span: root.vertical
        ? Math.max(0px, root.height - root.list-span - Layout.divider-width)
        : Math.max(0px, root.width - root.list-span - Layout.divider-width);

    BrowseList {
        x: 0;
        y: 0;
        width: root.vertical ? root.width : root.list-span;
        height: root.vertical ? root.list-span : root.height;
        show-chrome: false;
        rows: root.rows;
        model-top: root.model-top;
        scroll-top: root.scroll-top;
        scope: root.scope;
        glide: root.glide;
        step: root.step;
        selected: root.selected;
        held: root.held;
        focus-ready: root.focus-ready;
        activate-pulse: root.activate-pulse;
        release-pulse: root.release-pulse;
        settling: root.settling;
        row-height: root.row-height;
        row-hovered(i) => { root.row-hovered(i); }
        row-clicked(i) => { root.row-clicked(i); }
        row-right-clicked(i) => { root.row-right-clicked(i); }
        empty-right-clicked => { root.empty-right-clicked(); }
        wheel(delta) => { root.wheel(delta); }
    }

    Rectangle {
        x: root.vertical ? 0px : root.list-span;
        y: root.vertical ? root.list-span : 0px;
        width: root.vertical ? root.width : Layout.divider-width;
        height: root.vertical ? Layout.divider-width : root.height;
        background: Theme.border-mid;
    }

    BrowseDetailPane {
        info: root.info;
        x: root.vertical ? 0px : root.list-span + Layout.divider-width;
        y: root.vertical ? root.list-span + Layout.divider-width : 0px;
        width: root.vertical ? root.width : root.detail-span;
        height: root.vertical ? root.detail-span : root.height;
        show-chrome: false;
        art-box(w, h) => { root.art-box(w, h); }
        title: root.detail-title;
        show-title: root.show-title;
        cover: root.cover;
        has-cover: root.has-cover;
        cover-exact: root.cover-exact;
        cover-absent: root.cover-absent;
        wordmark: root.wordmark;
        placeholder-key: root.placeholder-key;
        rows: root.detail-rows;
        loading: root.detail-loading;
        loading-text: root.loading-text;
        image-index: root.image-index;
        image-count: root.image-count;
        image-kind: root.image-kind;
    }
}
