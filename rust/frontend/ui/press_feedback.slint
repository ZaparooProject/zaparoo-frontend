import { PressOwner } from "state_types.slint";

// One pending commitment, owned by the router and mirrored to the CRT.
export global PressFeedback {
    in-out property <PressOwner> owner: PressOwner.none;
    in-out property <int> index: -1;
    public pure function active(owner: PressOwner, index: int) -> bool {
        return self.owner == owner && self.index == index;
    }
}
