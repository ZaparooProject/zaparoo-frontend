//
// Shared chrome: the header (logo, host HUD, status line), the three-slot
// top status strip and its page indicator, the big focused-name caption,
// the bottom help bar with controller glyphs, the segmented progress
// track, the section heading and the inverse-video selection bar. Every
// geometry value comes from the Sizing and Layout globals Rust pushes, so
// these components carry almost no percentages of their own.

import { Theme, Sizing, Motion, Layout, Backdrop } from "theme.slint";
import { ContentState, StatusKind, HeaderPad, PadFill, HeaderLogo } from "state_types.slint";

// Glyph provider implemented in Rust: the SVG sources under
// resources/images are rasterized with resvg at the exact requested
// pixel size, keyed by their resource path ("icons/ScrollUp",
// "status/NFC", "buttons/style_a/FaceEast"). The binding depends on the
// element's size, so a res switch re-rasterizes automatically.
export global GlyphSource {
    // The tint is baked into the raster rather than applied as a
    // draw-time `colorize`: one cached image per (key, size, color), and
    // no per-item offscreen colorize pass in the renderer. A fully
    // transparent color keeps the artwork's own colors (the two-tone
    // heart, real art). The last argument is `Sizing.pixel-grid`, where the
    // small glyphs swap to hand-drawn pixel art; passing it here makes the
    // binding depend on it, so a switch between CRT and HDMI redraws them.
    pure callback raster(string, length, color, bool) -> image;
    public pure function glyph(key: string, size: length, tint: color) -> image {
        return self.raster(key, size, tint, Sizing.pixel-grid);
    }
    // Exact-pixel contract: the side a square glyph is both rasterized and
    // painted at. A glyph is rasterized at a whole pixel size, and the
    // software renderer samples bitmaps nearest-neighbor, so a box that is
    // not that size loses or repeats rows and columns of it. Where that
    // renderer draws (`Motion.zoom-by-size`) the box is the raster's size.
    public pure function side(length: length) -> length {
        return Motion.zoom-by-size ? Math.round(length / 1px) * 1px : length;
    }
    // The help bar's controller glyphs: the 16 px the button art is drawn
    // at on the 240p tier, whose bar Rust sizes around them; 4% of the
    // height above it.
    public pure function help-side() -> length {
        return Sizing.tier-240 ? Sizing.help-glyph-size : self.side(Sizing.pct-h(4));
    }
}

// Rust filters the embedded master into a cached raster at the painted size.
// This avoids nearest-neighbor downsampling of a larger rung on software.
// The header and the screensaver show the logo setting's choice (`mode`);
// About and the desktop dormant screen always show the Zaparoo logo.
export global Brand {
    pure callback logo(bool, length) -> image;
    // The user's image filtered to exactly the painted width and height.
    // The first argument is `revision`, so a newly loaded image re-runs
    // every binding that draws it.
    pure callback custom(int, length, length) -> image;
    // The master asset's own aspect ratio (width / height), which is also
    // the logo box a custom image fits inside.
    out property <float> aspect: 600 / 135;
    in property <HeaderLogo> mode: HeaderLogo.zaparoo;
    // The loaded custom image's aspect ratio (width / height).
    in property <float> custom-aspect: 600 / 135;
    // Bumped by Rust each time a custom image finishes loading.
    in property <int> revision: 0;
    // Exact-pixel contract: a custom image is rasterized at whole pixels
    // and painted at that size, keeping its aspect inside the logo box.
    public pure function custom-width(box-width: length, box-height: length) -> length {
        return Math.max(1px, Math.round(Math.min(box-width, box-height * self.custom-aspect) / 1px) * 1px);
    }
    public pure function custom-height(box-width: length, box-height: length) -> length {
        return Math.max(1px, Math.round(Math.min(box-height, box-width / self.custom-aspect) / 1px) * 1px);
    }
    public pure function custom-image(box-width: length, box-height: length) -> image {
        return self.custom(self.revision, self.custom-width(box-width, box-height), self.custom-height(box-width, box-height));
    }
    // The screensaver's bouncing copy always uses the on-dark variant:
    // its backstop is solid black regardless of the preset.
    public pure function saver-logo(painted-width: length) -> image {
        return self.logo(false, painted-width);
    }
}

// Help-bar glyph resolution. Rust pushes the style directory and the four
// positional files from the controller report and the Controls settings;
// "ButtonA"/"ButtonB"/"ButtonX"/"ButtonY" (confirm, cancel, options, menu)
// are semantic tokens that
// resolve through them, never literal letters.
export global Buttons {
    in-out property <string> style: "style_d";
    in-out property <string> confirm: "FaceEast";
    in-out property <string> cancel: "FaceSouth";
    in-out property <string> options: "FaceNorth";
    in-out property <string> menu: "FaceWest";

    public pure function file(token: string) -> string {
        if (token == "ButtonA") { return self.confirm; }
        if (token == "ButtonB") { return self.cancel; }
        if (token == "ButtonX") { return self.options; }
        if (token == "ButtonY") { return self.menu; }
        if (token == "ButtonL") { return "ShoulderL"; }
        if (token == "ButtonR") { return "ShoulderR"; }
        return token;
    }
    public pure function key(token: string) -> string {
        return "buttons/" + self.style + "/" + self.file(token);
    }
}

// One help-bar entry: the glyph tokens (one or more) and the label they
// describe. Wrapping happens between entries, never inside one.
export struct HelpEntry {
    buttons: [string],
    label: string,
}

// The resolved status ladder, pushed by Rust from
// `zaparoo_app::status_line`. `kind` is the stable message id; the
// sentence is composed here so it stays in the translation catalogs.
export global Status {
    in-out property <StatusKind> kind: StatusKind.none;
    in-out property <string> arg: "";
    in-out property <string> arg2: "";
    in-out property <bool> is-error: false;
    // The line is reporting trouble with the Core link, which the
    // router's own cue never displaces.
    in-out property <bool> link-trouble: false;
    in-out property <bool> show-track: false;
    in-out property <bool> paused: false;
    in-out property <bool> total-known: true;
    in-out property <int> current-step: 0;
    in-out property <int> total-steps: 0;
    // Whole percent of the active task, or -1 when Core reports no total.
    in-out property <int> percent: -1;

    public pure function label() -> string {
        if (self.kind == StatusKind.disconnected) { return @tr("Disconnected"); }
        if (self.kind == StatusKind.reconnecting) { return @tr("Reconnecting…"); }
        if (self.kind == StatusKind.connecting) { return @tr("Connecting…"); }
        if (self.kind == StatusKind.core-error) {
            return self.arg == "" ? @tr("Core error") : @tr("Core error: {}", self.arg);
        }
        if (self.kind == StatusKind.indexing-paused) { return @tr("Indexing paused: game running"); }
        if (self.kind == StatusKind.indexing) {
            // Core leaves the step display empty right at the start of a
            // run; a bare "Indexing: " reads as broken.
            return self.arg == "" ? @tr("Indexing…") : @tr("Indexing: {}", self.arg);
        }
        if (self.kind == StatusKind.optimizing) {
            return self.arg == "" ? @tr("Optimizing database…") : @tr("Optimizing database: {}", self.arg);
        }
        if (self.kind == StatusKind.importing-paused) { return @tr("Importing paused: game running"); }
        if (self.kind == StatusKind.importing) {
            return self.arg == "" ? @tr("Importing…") : @tr("Importing: {}", self.arg);
        }
        if (self.kind == StatusKind.indexed-files) { return @tr("Indexed {} files", self.arg); }
        if (self.kind == StatusKind.indexing-complete) { return @tr("Indexing complete"); }
        if (self.kind == StatusKind.import-failed) { return @tr("Import failed: {}", self.arg); }
        if (self.kind == StatusKind.imported) { return @tr("Imported {} of {}", self.arg, self.arg2); }
        if (self.kind == StatusKind.playtime-warning) { return @tr("Playtime limit in {}", self.arg); }
        if (self.kind == StatusKind.inbox) { return self.arg; }
        // Core's own words, as it sent them.
        if (self.kind == StatusKind.core-loader) { return self.arg == "" ? @tr("Loading…") : self.arg; }
        if (self.kind == StatusKind.core-notice) { return self.arg; }
        return "";
    }
    public pure function percent-text() -> string {
        return self.percent < 0 ? "" : @tr("{}%", self.percent);
    }
}

// Segmented block progress track. Determinate: cells
// up to the fill fraction paint accent, the rest border-subtle.
// Indeterminate: one lit cell marches, stopping under Reduce motion and
// while paused. Determinate cells change only with actual progress. Slint
// snaps the cells to physical pixels when rendering.
//
// Exactly one cell blinks: the fill's leading edge when determinate, the
// marching cell when not. Without it a determinate track that is waiting
// on a slow system is indistinguishable from a stalled one, which is the
// whole reason the header carries a track rather than a percentage. The
// blink is a hard cut every `pulse-ms`, never a crossfade -- the timer
// flips a bool the `background` binding reads straight through. It is the
// one persistent animation in the app: header chrome, never over content,
// one small cell's worth of dirty rect, and off entirely under Reduce
// motion rather than looping at 0ms. See docs/style.md -> "Header status
// line".
export component ProgressTrack inherits Rectangle {
    in property <bool> active: false;
    in property <bool> paused: false;
    in property <bool> total-known: true;
    in property <int> current-step: 0;
    in property <int> total-steps: 0;
    in property <int> cell-count: Sizing.tier-240 ? 8 : 12;
    in property <length> cell-height: Sizing.font-small;
    in property <length> cell-gap: Sizing.pct-w(0.3);

    out property <length> cell-width: Sizing.tier-240
        ? 4px
        : Math.max(Sizing.stroke(2), root.cell-height * 1.6);
    property <int> filled-cells: (!root.active || !root.total-known || root.total-steps <= 0)
        ? 0
        : Math.min(root.cell-count, Math.round(Math.max(0, Math.min(1, root.current-step / root.total-steps)) * root.cell-count));
    property <int> march-index: 0;
    property <bool> pulsing: root.active && !root.paused && Motion.enabled;
    // `max(0, ...)` covers the just-started frame: cell 0 blinks before
    // anything is technically filled, which reads as "starting up".
    property <int> pulse-cell: root.total-known ? Math.max(0, root.filled-cells - 1) : root.march-index;
    property <bool> blink-on: true;

    width: root.cell-count * root.cell-width + Math.max(0, root.cell-count - 1) * root.cell-gap;
    height: root.cell-height;

    Timer {
        interval: Motion.dur(Motion.pulse-ms * 2);
        running: root.active && !root.total-known && !root.paused && Motion.enabled;
        triggered => {
            root.march-index = Math.mod(root.march-index + 1, root.cell-count);
        }
    }

    // The blink itself. Nothing animates the color; the bool is the whole
    // state machine, so every tick is a one-frame cut.
    Timer {
        interval: Motion.dur(Motion.pulse-ms);
        running: root.pulsing;
        triggered => { root.blink-on = !root.blink-on; }
    }
    // A stopped blink must not freeze the track dark: leave the cue lit.
    changed pulsing => { if (!root.pulsing) { root.blink-on = true; } }

    for i in root.cell-count: Rectangle {
        property <bool> is-filled: root.active && (i < root.filled-cells || (!root.total-known && i == root.march-index));
        property <bool> is-pulse-cell: root.pulsing && i == root.pulse-cell;
        x: i * (root.cell-width + root.cell-gap);
        y: 0;
        width: root.cell-width;
        height: root.cell-height;
        border-radius: Sizing.radius-sm;
        background: self.is-pulse-cell
            ? (root.blink-on ? Theme.accent : Theme.border-subtle)
            : (self.is-filled ? Theme.accent : Theme.border-subtle);
    }
}

// Header status line: a right-aligned cluster of label,
// fixed-width percentage and track hugging the header's right margin.
// Plain text on the header background, no card. The label shrink-wraps
// to its content and only elides once it would run past the logo.
// `app-text` is the router's transient line: what the user's own action
// is waiting on, or its confirmation. It takes the slot from a background
// task for as long as it has something to say, and yields only to trouble
// with the Core link.
export component StatusLine inherits Rectangle {
    in property <string> app-text: "";

    property <string> ladder-label: Status.label();
    property <bool> app-owns: root.app-text != "" && !Status.link-trouble;
    property <string> label: root.app-owns || root.ladder-label == "" ? root.app-text : root.ladder-label;
    property <bool> show-track: Status.show-track && !root.app-owns;
    property <bool> percent-known: Status.percent >= 0 && !root.app-owns;
    property <length> cells-spacing: Sizing.pct-w(1);
    property <length> track-reserve: root.show-track ? track.width + root.cells-spacing : 0px;
    property <length> percent-slot: Math.ceil(percent-measure.preferred-width / 1px) * 1px;
    property <length> percent-reserve: root.percent-known ? root.percent-slot + root.cells-spacing : 0px;
    property <length> label-natural-width: Math.ceil(label-measure.preferred-width / 1px) * 1px;
    property <length> label-width: Math.min(root.label-natural-width, Math.max(0px, root.width - root.track-reserve - root.percent-reserve));

    visible: root.label != "";
    height: root.visible ? Sizing.header-row-height : 0px;

    label-measure := Text {
        visible: false;
        text: root.label;
        font-size: Sizing.font-small;
    }
    percent-measure := Text {
        visible: false;
        text: @tr("{}%", 100);
        font-size: Sizing.font-small;
    }

    track := ProgressTrack {
        x: parent.width - self.width;
        y: Sizing.snap((parent.height - self.height) / 2);
        visible: root.show-track;
        active: root.show-track;
        paused: Status.paused;
        total-known: Status.total-known;
        current-step: Status.current-step;
        total-steps: Status.total-steps;
    }

    if root.percent-known: Text {
        x: track.x - root.cells-spacing - self.width;
        y: Sizing.snap((parent.height - self.preferred-height) / 2);
        width: root.percent-slot;
        horizontal-alignment: right;
        text: Status.percent-text();
        color: Theme.text-primary;
        font-size: Sizing.font-small;
    }

    Text {
        x: parent.width - root.track-reserve - root.percent-reserve - self.width;
        y: Sizing.snap((parent.height - self.preferred-height) / 2);
        width: root.label-width;
        overflow: elide;
        text: root.label;
        color: Status.is-error && !root.app-owns ? Theme.error : Theme.text-primary;
        font-size: Sizing.font-small;
    }
}

// Top header bar: logo bottom-left, host status row
// (NFC / Wi-Fi / LAN / Bluetooth / controller batteries / Battery icons plus
// the clock)
// right-anchored, and the status line stacked under it. Height is fixed
// at Sizing.header-height so the status line's slot stays reserved when
// idle. The CRT profile pins the status row to the top, the HUD to the
// bottom, and carries the browse title in the header.
export component HeaderBar inherits Rectangle {
    in property <string> clock-text;
    // Widest clock reading for the format, so the slot never reflows.
    in property <string> clock-sample: "23:59";
    in property <[string]> status-keys: [];
    in property <bool> status-icons-enabled: false;
    // Background music is playing: a music note leads the status icons.
    in property <bool> music-playing: false;
    // A controller is running flat. The compact header (240p and the CRT
    // profile) has room for one glyph, a warning before the battery that
    // never carries a percentage.
    in property <bool> controller-battery-low: false;
    // Every other header shows a glyph per controller battery instead.
    in property <[HeaderPad]> controller-batteries: [];
    in property <bool> has-battery: false;
    in property <int> battery-percent: 0;
    in property <string> browse-title: "";
    in property <string> app-text: "";

    height: Sizing.header-height;

    // At 240p the CRT profile puts status on the upper 8px row; only the
    // kangaroo tip occupies it, so status can use the remaining span.
    property <bool> compact-status-header: Sizing.tier-240 && Layout.status-pill-pinned-top;
    property <length> logo-h: root.compact-status-header
        ? Math.max(1px, Sizing.header-height - 1px)
        : Sizing.header-height;
    // The logo box: the Zaparoo logo fills it; a custom image fits inside
    // it, left and bottom aligned, so the header's layout never changes.
    property <length> logo-painted-width: root.logo-h * Brand.aspect;
    property <length> custom-width: Brand.custom-width(root.logo-painted-width, root.logo-h);
    // Where the logo actually ends: nothing at all with no logo.
    property <length> logo-right: Brand.mode == HeaderLogo.none
        ? 0px
        : (Brand.mode == HeaderLogo.custom ? root.custom-width : root.logo-painted-width);

    if Brand.mode == HeaderLogo.zaparoo: Image {
        x: Sizing.header-side-margin;
        y: parent.height - self.height;
        width: root.logo-painted-width;
        height: root.logo-h;
        source: Brand.logo(Theme.light-surface, root.logo-painted-width);
        image-fit: contain;
        image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        horizontal-alignment: left;
        vertical-alignment: bottom;
    }
    if Brand.mode == HeaderLogo.custom: Image {
        x: Sizing.header-side-margin;
        y: parent.height - self.height;
        width: root.custom-width;
        height: Brand.custom-height(root.logo-painted-width, root.logo-h);
        source: Brand.custom-image(root.logo-painted-width, root.logo-h);
        image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
    }

    property <string> battery-icon: root.battery-percent >= 75
        ? "status/BatteryFull"
        : (root.battery-percent >= 40
            ? "status/BatteryHalf"
            : (root.battery-percent >= 15 ? "status/BatteryLow" : "status/BatteryEmpty"));
    property <bool> battery-visible: root.status-icons-enabled && root.has-battery;
    // The percentage reading is hidden on the CRT profile: its
    // native-resolution HUD only has room for the icon.
    property <bool> battery-label-visible: root.battery-visible && !Theme.crt;
    property <length> icon-size: Sizing.font-caption;
    property <length> hud-spacing: Sizing.pct-w(1);
    property <int> music-slot: root.status-icons-enabled && root.music-playing ? 1 : 0;
    property <bool> compact-pads: Theme.crt || Sizing.tier-240;
    property <int> controller-slot: root.status-icons-enabled && root.compact-pads && root.controller-battery-low ? 1 : 0;
    property <int> pad-slots: root.status-icons-enabled && !root.compact-pads ? root.controller-batteries.length : 0;
    // A charging mark tucks against its pad: the bolt's own margin
    // overlaps the glyph's, so it adds only part of a slot.
    property <length> mark-width: root.icon-size * 0.6;
    property <int> mark-count: root.pad-slots > 0
        ? root.controller-batteries[root.pad-slots - 1].marks-before
            + (root.controller-batteries[root.pad-slots - 1].charging ? 1 : 0)
        : 0;
    property <length> pads-before-x: (root.status-keys.length + root.music-slot) * (root.icon-size + root.hud-spacing);
    property <int> icon-count: (root.status-icons-enabled ? root.status-keys.length : 0) + (root.battery-visible ? 1 : 0) + root.music-slot + root.controller-slot + root.pad-slots;
    property <length> battery-label-width: root.battery-label-visible ? Math.ceil(battery-measure.preferred-width / 1px) * 1px : 0px;
    property <length> clock-width: Math.ceil(clock-measure.preferred-width / 1px) * 1px;
    property <bool> clock-visible: root.clock-text != "";
    property <length> hud-width: root.icon-count * (root.icon-size + root.hud-spacing)
        + root.mark-count * root.mark-width
        + (root.battery-label-visible ? root.battery-label-width + root.hud-spacing : 0px)
        + (root.clock-visible ? root.clock-width : 0px);
    property <length> hud-x: root.width - Sizing.header-side-margin - root.hud-width;
    property <length> hud-y: Layout.hud-bottom-aligned ? root.height - Sizing.header-row-height : 0px;

    battery-measure := Text {
        visible: false;
        text: @tr("{}%", 100);
        font-size: Sizing.font-caption;
    }
    clock-measure := Text {
        visible: false;
        text: root.clock-sample;
        font-size: Sizing.header-row-height;
    }

    // Host status row. Icons and the clock both center on the row's
    // plain geometric middle, with no metrics correction. A measurement
    // put the rendered clock ink 0.64 px off that middle at a 24 px row,
    // and an ascent/descent-based correction shifted it almost 4 px the
    // wrong way and was reverted. Re-measure the rendered ink before
    // adding one.
    if root.status-icons-enabled: Rectangle {
        x: root.hud-x;
        y: root.hud-y;
        width: root.hud-width;
        height: Sizing.header-row-height;
        if root.music-slot > 0: Image {
            x: 0;
            y: Sizing.snap((parent.height - self.height) / 2);
            width: root.icon-size;
            height: root.icon-size;
            source: GlyphSource.glyph("status/Music", root.icon-size, Theme.text-primary);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }
        for key[i] in root.status-keys: Image {
            x: (i + root.music-slot) * (root.icon-size + root.hud-spacing);
            y: Sizing.snap((parent.height - self.height) / 2);
            width: root.icon-size;
            height: root.icon-size;
            source: GlyphSource.glyph("status/" + key, root.icon-size, Theme.text-primary);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }
        if root.controller-slot > 0: Image {
            x: (root.status-keys.length + root.music-slot) * (root.icon-size + root.hud-spacing);
            y: Sizing.snap((parent.height - self.height) / 2);
            width: root.icon-size;
            height: root.icon-size;
            source: GlyphSource.glyph("status/ControllerLow", root.icon-size, Theme.text-primary);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }
        for pad[i] in root.pad-slots > 0 ? root.controller-batteries : []: Rectangle {
            x: root.pads-before-x + i * (root.icon-size + root.hud-spacing) + pad.marks-before * root.mark-width;
            width: root.icon-size + (pad.charging ? root.mark-width : 0px);
            property <color> tint: pad.low ? Theme.error : Theme.text-primary;
            Image {
                x: 0;
                y: Sizing.snap((parent.height - self.height) / 2);
                width: root.icon-size;
                height: root.icon-size;
                source: GlyphSource.glyph(
                    pad.fill == PadFill.full ? "status/ControllerFull"
                        : pad.fill == PadFill.half ? "status/ControllerHalf"
                        : pad.fill == PadFill.low ? "status/ControllerLow"
                        : "status/ControllerEmpty",
                    root.icon-size, parent.tint);
                image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
            }
            if pad.charging: Image {
                x: root.icon-size * 0.8;
                y: Sizing.snap((parent.height - self.height) / 2);
                width: root.icon-size;
                height: root.icon-size;
                source: GlyphSource.glyph("icons/Charging", root.icon-size, Theme.text-primary);
                image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
            }
        }
        if root.battery-visible: Image {
            x: root.pads-before-x + (root.controller-slot + root.pad-slots) * (root.icon-size + root.hud-spacing) + root.mark-count * root.mark-width;
            y: Sizing.snap((parent.height - self.height) / 2);
            width: root.icon-size;
            height: root.icon-size;
            source: GlyphSource.glyph(root.battery-icon, root.icon-size, Theme.text-primary);
            image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
        }
        if root.battery-label-visible: Text {
            x: root.icon-count * (root.icon-size + root.hud-spacing) + root.mark-count * root.mark-width;
            y: Sizing.snap((parent.height - self.preferred-height) / 2);
            width: root.battery-label-width;
            text: @tr("{}%", root.battery-percent);
            color: Theme.text-primary;
            font-size: Sizing.font-caption;
        }
    }
    if root.clock-visible: Text {
        x: parent.width - Sizing.header-side-margin - root.clock-width;
        y: Sizing.snap(root.hud-y + (Sizing.header-row-height - self.preferred-height) / 2);
        width: root.clock-width;
        horizontal-alignment: right;
        text: root.clock-text;
        color: Theme.text-primary;
        font-size: Sizing.header-row-height;
    }

    // Browse title in the header (CRT profile only), centered between the
    // logo and the HUD and kept clear of the wider of the two; never less
    // than a third of the header.
    property <length> title-side: Sizing.header-side-margin + Math.max(root.logo-right,
        Layout.hud-bottom-aligned ? root.hud-width : 0px) + Sizing.pct-w(1.5);
    if Layout.title-in-header && root.browse-title != "": Text {
        property <length> natural: Math.ceil(title-measure.preferred-width / 1px) * 1px;
        property <length> room: parent.width - 2 * root.title-side;
        x: Sizing.snap((parent.width - self.width) / 2);
        y: parent.height - Sizing.header-row-height
            + Sizing.snap((Sizing.header-row-height - self.preferred-height) / 2);
        width: Math.min(Math.max(Math.floor(parent.width / 3px) * 1px, self.room), self.natural);
        overflow: elide;
        text: root.browse-title;
        color: Theme.text-primary;
        font-weight: FontWeight.medium;
        font-size: Sizing.header-row-height;
    }
    title-measure := Text {
        visible: false;
        text: root.browse-title;
        font-weight: FontWeight.medium;
        font-size: Sizing.header-row-height;
    }

    // Core / task / event status line under the HUD (or pinned to the
    // top on the CRT profile), spanning from the logo's right edge to
    // the header's right margin so it knows its true elide budget. With
    // no logo it takes the whole width. On the compact header only the
    // Zaparoo logo's kangaroo tip reaches the status row; a custom image
    // can fill its box, so the line clears all of it.
    StatusLine {
        property <length> left: Brand.mode == HeaderLogo.none
            ? Sizing.header-side-margin
            : (root.compact-status-header && Brand.mode == HeaderLogo.zaparoo
                ? Sizing.header-side-margin + root.logo-painted-width * 0.14
                : Sizing.header-side-margin + root.logo-right + Sizing.pct-w(1));
        x: self.left;
        y: Layout.status-pill-pinned-top
            ? 0px
            : root.hud-y + Sizing.header-row-height + Sizing.header-stack-gap;
        width: Math.max(0px, parent.width - Sizing.header-side-margin - self.left);
        app-text: root.app-text;
    }
}

// A line inside a surface. One hairline, one place, because hand-rolled
// rules drift to two weights and two colors: a structural line marks the
// boundary between a pinned region and one that scrolls under it and is
// painted in `border-mid`, because structure has to survive 240p where
// `border-subtle` against `surface-card` does not; a decorative row
// separator inside a table has no contrast requirement and takes the
// quieter role. Width is the parent's, so mounting it on the surface
// gives a full-width rule and mounting it in the content box gives an
// inset one. See docs/style.md -> "Lines".
export component Divider inherits Rectangle {
    in property <bool> decorative: false;
    height: Sizing.stroke(1);
    background: root.decorative ? Theme.border-subtle : Theme.border-mid;
}

// A membership row's box: an outline, filled inside while `checked`. Every
// checklist draws this one (the context menu, the setup picker, the list
// panel); the row sets its side and ink.
export component CheckBox inherits Rectangle {
    in property <bool> checked: false;
    in property <color> ink;

    property <length> line: Sizing.card-border-width * (Sizing.tier-240 ? 1 : 2);
    height: self.width;
    border-radius: Sizing.radius-sm;
    border-width: root.line;
    border-color: root.ink;

    if root.checked: Rectangle {
        x: 2 * root.line;
        y: 2 * root.line;
        width: parent.width - 4 * root.line;
        height: parent.height - 4 * root.line;
        border-radius: Math.max(0px, Sizing.radius-sm - 2 * root.line);
        background: root.ink;
    }
}

// A scannable code on the plate a scanner needs. Both surfaces that show
// one used to draw it differently: the log uploader put it on a hardcoded
// white plate with a `border-subtle` frame, the QR modal drew the raster
// bare with no plate at all.
//
// The four-module quiet zone is baked into the raster (`qr.rs`) and is the
// same `qr-light` as the plate, so a corner radius eats light margin and
// never a module. That is the one hard limit here: a radius wider than the
// quiet zone clips data and the code stops scanning, so it is clamped to
// the zone rather than trusted to be small enough.
export component QrPlate inherits Rectangle {
    in property <image> code;
    // Width of the baked quiet zone at the rendered scale.
    in property <length> quiet-zone;
    // What sits behind the plate. The corners are painted back in this
    // color rather than clipped, because Slint's `clip` is rectangular:
    // the raster's own square light corners would otherwise sit on top of
    // a rounded background and nothing would look rounded at all. Same
    // four masks the context menu cuts its scrim hole with.
    in property <color> behind: Theme.bg-panel;

    property <length> corner: Math.min(Sizing.radius-md, root.quiet-zone);

    background: Theme.qr-light;
    border-radius: root.corner;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.code;
        image-rendering: pixelated;
    }

    if root.corner > 0px: Image {
        x: 0; y: 0; width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-tl", root.corner, root.behind);
    }
    if root.corner > 0px: Image {
        x: parent.width - root.corner; y: 0; width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-tr", root.corner, root.behind);
    }
    if root.corner > 0px: Image {
        x: 0; y: parent.height - root.corner; width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-bl", root.corner, root.behind);
    }
    if root.corner > 0px: Image {
        x: parent.width - root.corner; y: parent.height - root.corner;
        width: root.corner; height: root.corner;
        source: GlyphSource.glyph("corners/cut-br", root.corner, root.behind);
    }
}

// The one place a modal's chrome lives. Without it, bespoke panels drift:
// four different title gaps, two QR presentations and three different
// header treatments, with a change to any one of them landing on a single
// modal at a time.
//
// A host supplies a width and the height of its own content, then places
// that content against `content-y`; everything above that line belongs
// here.
//
// One trap: `@children` are laid out inside the panel, but `parent` in a
// host's own declaration still resolves lexically to the host's root,
// which is the full-screen scrim. Position against `root.panel-width` and
// `root.content-width`, never `parent.width`, or the content is measured
// against the screen and clipped away at the panel edge.
//
// Every titled panel separates its title from its content with the same
// rule, unconditionally. Gating it on anything -- whether the body
// scrolls, how many rows there are -- puts a line on one panel and not on
// its neighbour doing the same job, which reads as a defect rather than as
// information. See docs/style.md, "Lines".
export component ModalShell inherits Rectangle {
    in property <string> title;
    in property <length> panel-width;
    in property <length> content-height;

    // The shared surface inset: all four sides, and every gap between the
    // blocks stacked inside (docs/style.md, "Surface containment").
    out property <length> pad: Sizing.surface-pad;
    out property <length> title-height: Math.ceil(shell-title.preferred-height / 1px) * 1px;
    out property <length> rule-y: root.pad + root.title-height + root.pad;
    out property <length> content-y: root.rule-y + Sizing.stroke(1) + root.pad;
    out property <length> content-width: Math.max(0px, root.panel-width - 2 * root.pad);
    out property <length> panel-height: root.content-y + root.content-height + root.pad;

    background: Theme.scrim;

    Rectangle {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: Sizing.snap((parent.height - self.height) / 2);
        width: root.panel-width;
        height: root.panel-height;
        background: Theme.bg-panel;
        // Flat modal chrome uses the scrim, not an outline, for separation
        // (docs/style.md, "Surface containment").
        border-radius: Sizing.radius-md;
        clip: true;

        shell-title := Text {
            x: Sizing.snap((parent.width - self.width) / 2);
            y: root.pad;
            width: Math.min(self.preferred-width, parent.width - 2 * root.pad);
            overflow: elide;
            text: root.title;
            color: Theme.text-primary;
            font-size: Sizing.font-title;
        }
        Divider { x: 0; y: root.rule-y; width: parent.width; }
        @children
    }
}

// One directional cue: a scroll arrow, or one half of `PageIndicator`'s
// pair, or a carousel arrow. Painted whether or not the direction is live,
// because a press the other way brings it straight back and hiding it
// takes away the only sign that the surface scrolls at all. What toggles
// is the color, and the spent color is `Theme.cue-spent` rather than
// `text-label`: a state carried by color alone needs 3:1 between the two,
// and `text-label` manages that on three of the twenty presets. Hosts hide
// the whole pair when nothing scrolls; that is a different question from
// one direction being spent. See docs/style.md -> "Spent cues".
export component ScrollCue inherits Image {
    in property <string> glyph: "icons/ScrollDown";
    in property <bool> live: true;
    width: GlyphSource.side(Sizing.pct-h(3));
    height: self.width;
    image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
    source: GlyphSource.glyph(root.glyph, Math.max(1px, self.width),
        root.live ? Theme.text-primary : Theme.cue-spent);
}

// Compact "where am I" cue: an up/down chevron pair
// plus "N/M". Reserves its full width unconditionally so arming a
// second page changes only the text, never the chevrons' position.
// Unavailable directions dim to text-label; with a single page the
// whole cue hides (but still reserves its width).
export component PageIndicator inherits Rectangle {
    in property <int> current-page: 0;
    in property <int> total-pages: 1;
    in property <bool> item-position-mode: false;
    in property <int> current-item: 0;
    in property <int> total-items: 0;
    // Continuously scrolled prose has no items to count, so it reads out a
    // percentage instead. `fraction` is 0 at the top and 1 at the bottom.
    in property <bool> percent-mode: false;
    in property <float> fraction: 0;
    // False for cursor-paginated lists whose final page is unknown:
    // shows a bare "N" instead of a growing denominator.
    in property <bool> page-total-known: true;
    in property <bool> has-pages-above: false;
    in property <bool> has-pages-below: false;
    in property <length> chevron-size: Sizing.pct-h(4);
    // The chevron art carries its own side bearing, so the pair sits
    // tight; the text keeps the normal item gap.
    in property <length> chevron-spacing: 0px;
    in property <length> item-spacing: Sizing.pct-w(0.6);

    callback page-requested(int);

    out property <bool> has-navigation-range: root.has-pages-above || root.has-pages-below;
    out property <string> page-text: root.percent-mode
        ? @tr("{}%", Math.round(Math.max(0, Math.min(1, root.fraction)) * 100))
        : (root.item-position-mode
            ? @tr("{}/{}", Math.min(Math.max(0, root.current-item), Math.max(0, root.total-items - 1)) + 1, Math.max(1, root.total-items))
            : (root.page-total-known
                ? @tr("{}/{}", root.current-page + 1, Math.max(1, root.total-pages))
                : @tr("{}", root.current-page + 1)));
    property <length> text-width: Math.ceil(text-measure.preferred-width / 1px) * 1px;
    // Baseline of the page-count text within this component, so a host
    // can baseline-align it against a Text of its own.
    out property <length> text-baseline-offset: page-count.y + Theme.ascent(Sizing.font-section);

    width: 2 * root.chevron-size + root.chevron-spacing + root.item-spacing + root.text-width;
    height: root.chevron-size;

    text-measure := Text {
        visible: false;
        text: root.page-text;
        font-size: Sizing.font-section;
    }

    up := ScrollCue {
        x: 0;
        y: Sizing.snap((parent.height - self.height) / 2) - (Sizing.crt ? 2px : 0px);
        width: root.chevron-size;
        visible: root.has-navigation-range;
        glyph: "icons/ScrollUp";
        live: root.has-pages-above;
        TouchArea {
            enabled: root.has-pages-above;
            clicked => { root.page-requested(-1); }
        }
    }
    down := ScrollCue {
        x: up.x + up.width + root.chevron-spacing;
        y: Sizing.snap((parent.height - self.height) / 2) - (Sizing.crt ? 2px : 0px);
        width: root.chevron-size;
        visible: root.has-navigation-range;
        glyph: "icons/ScrollDown";
        live: root.has-pages-below;
        TouchArea {
            enabled: root.has-pages-below;
            clicked => { root.page-requested(1); }
        }
    }
    page-count := Text {
        x: down.x + down.width + root.item-spacing;
        y: Sizing.snap((parent.height - self.preferred-height) / 2) - (Sizing.crt ? 1px : 0px);
        width: root.text-width;
        visible: root.has-navigation-range;
        overflow: elide;
        text: root.page-text;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
    }
}

// Hub has no title strip, and CRT keeps its calibrated caption-row cue.
// Neither case reserves extra height below a content card.
export component FooterIndicator inherits PageIndicator {
    in property <length> cue-y;
    in property <length> right-margin;
    x: Sizing.screen-width - root.right-margin - self.width;
    y: root.cue-y;
    chevron-size: Layout.grid-page-chevron-size;
}

// Centered title, the item count at the far left and the page position at
// the right. The title takes what the sides leave it, and never less than a
// third, and each side is bounded so it cannot overlap the title.
export component TopStatusStrip inherits Rectangle {
    in property <string> title: "";
    in property <int> current-page: 0;
    in property <int> total-pages: 1;
    in property <bool> page-total-known: true;
    in property <string> total-text: "";
    // The active browse filter's name, shown with a funnel in the left slot
    // after the count (the CRT strip hides the filter).
    in property <string> filter-text: "";
    in property <string> right-text-override: "";
    in property <bool> show-page-counter: true;
    // True mounts a PageIndicator (chevrons + "N/M") in the right slot
    // instead of plain "Page N / M" text.
    in property <bool> page-indicator-mode: false;
    in property <bool> item-position-mode: false;
    in property <int> current-item: 0;
    in property <int> total-items: 0;
    in property <bool> percent-mode: false;
    in property <float> fraction: 0;
    in property <bool> has-pages-above: false;
    in property <bool> has-pages-below: false;
    in property <length> page-indicator-chevron-size: Sizing.pct-h(4);
    in property <length> slot-margin: Sizing.pct-w(3);

    callback page-requested(int);

    out property <string> page-text: root.right-text-override != ""
        ? root.right-text-override
        : (root.page-total-known
            ? @tr("Page {} / {}", root.current-page + 1, root.total-pages)
            : @tr("Page {}", root.current-page + 1));
    property <length> slot-width: root.width / 3;
    property <length> side-slot-width: Math.max(0px, root.slot-width - root.slot-margin);
    property <bool> plain-counter: !root.page-indicator-mode && root.show-page-counter
        && (root.right-text-override != "" || !root.page-total-known || root.total-pages > 1);
    property <length> counter-width: root.plain-counter
        ? Math.min(page-measure.preferred-width, root.side-slot-width)
        : (indicator.visible ? indicator.width : 0px);
    // The left slot runs from the margin to the title: the item count
    // first, at the far left, then the active filter after it.
    property <length> left-room: Math.max(0px, (root.width - root.title-text-width) / 2 - root.slot-margin - Sizing.pct-w(1.5));
    property <length> count-width: root.total-text == "" ? 0px
        : (Sizing.crt ? root.side-slot-width : Math.min(total-measure.preferred-width, root.left-room));
    property <length> filter-x: root.slot-margin + (root.total-text == "" ? 0px : root.count-width + Sizing.pct-w(1.5));
    property <length> title-measured: Math.ceil(title-measure.preferred-width / 1px) * 1px;
    // What the sides show at their natural width. The centered title keeps
    // clear of the wider one on both sides; a side wider than its third
    // gives way to the title instead.
    property <length> left-natural: (root.total-text == "" ? 0px : total-measure.preferred-width)
        + (root.filter-shown
            ? (root.total-text == "" ? 0px : Sizing.pct-w(1.5)) + root.filter-glyph-size
                + 2 * root.filter-glyph-gap + filter-text-measure.preferred-width
            : 0px);
    property <length> right-natural: root.plain-counter ? page-measure.preferred-width
        : (indicator.visible ? indicator.width : 0px);
    property <length> side-need: Math.min(root.side-slot-width, Math.max(root.left-natural, root.right-natural));
    property <length> title-room: root.width - 2 * (root.slot-margin + root.side-need
        + (root.side-need > 0 ? Sizing.pct-w(1.5) : 0px));
    property <length> title-text-width: Math.min(Math.max(root.slot-width, root.title-room), root.title-measured);
    // Center the full line box, not the em size: otherwise descenders can
    // spill into the cached grid band and travel with a page transition.
    property <length> title-y: Sizing.snap((root.height - title-measure.preferred-height) / 2);
    // Side texts share the title's baseline: offset by the difference
    // of the two ascents, since Slint has no baseline alignment.
    property <length> side-y: root.title-y + Theme.ascent(Sizing.font-hero) - Theme.ascent(Sizing.font-section);

    title-measure := Text {
        visible: false;
        text: root.title;
        font-weight: FontWeight.medium;
        font-size: Sizing.font-hero;
    }

    total-measure := Text {
        visible: false;
        text: root.total-text;
        font-size: Sizing.font-section;
    }
    page-measure := Text {
        visible: false;
        text: root.page-text;
        font-size: Sizing.font-section;
    }

    if root.total-text != "": Text {
        x: root.slot-margin;
        y: root.side-y;
        width: root.count-width;
        overflow: elide;
        text: root.total-text;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
    }

    property <length> filter-glyph-size: Sizing.font-section;
    property <length> filter-glyph-gap: Sizing.pct-w(0.8);
    property <bool> filter-shown: root.filter-text != "" && !Sizing.crt;

    // The line box the filter text sits in, to center the funnel on it.
    filter-measure := Text {
        visible: false;
        text: "A";
        font-size: Sizing.font-section;
    }
    filter-text-measure := Text {
        visible: false;
        text: root.filter-text;
        font-size: Sizing.font-section;
    }

    if root.filter-shown: Image {
        x: root.filter-x;
        y: Sizing.snap(root.side-y + (filter-measure.preferred-height - self.height) / 2);
        width: root.filter-glyph-size;
        height: root.filter-glyph-size;
        source: GlyphSource.glyph("icons/Filter", self.height, Theme.text-primary);
    }

    if root.filter-shown: Text {
        x: root.filter-x + root.filter-glyph-size + root.filter-glyph-gap;
        y: root.side-y;
        width: Math.max(0px, (parent.width - root.title-text-width) / 2 - root.filter-x
            - root.filter-glyph-size - 2 * root.filter-glyph-gap);
        overflow: elide;
        text: root.filter-text;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
    }

    // Keep the natural line box so descenders remain intact.
    Text {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: root.title-y;
        width: root.title-text-width;
        overflow: elide;
        text: root.title;
        color: Theme.text-primary;
        font-weight: FontWeight.medium;
        font-size: Sizing.font-hero;
    }

    if root.plain-counter: Text {
        x: parent.width - root.slot-margin - self.width;
        y: root.side-y;
        width: root.counter-width;
        horizontal-alignment: right;
        overflow: elide;
        text: root.page-text;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
    }

    indicator := PageIndicator {
        x: parent.width - root.slot-margin - self.width;
        y: root.title-y + Theme.ascent(Sizing.font-hero) - self.text-baseline-offset;
        visible: root.page-indicator-mode && root.show-page-counter && self.has-navigation-range;
        percent-mode: root.percent-mode;
        fraction: root.fraction;
        chevron-size: root.page-indicator-chevron-size;
        current-page: root.current-page;
        total-pages: root.total-pages;
        item-position-mode: root.item-position-mode;
        current-item: root.current-item;
        total-items: root.total-items;
        page-total-known: root.page-total-known;
        has-pages-above: root.has-pages-above;
        has-pages-below: root.has-pages-below;
        page-requested(delta) => { root.page-requested(delta); }
    }
}

// Big single-line caption for the focused-tile name: hero size, medium
// weight, centered, elided, never wrapped. `tags` is the dim
// disambiguation suffix; the name gets first claim on the width and the
// tags take what is left.
export component ActiveLabel inherits Rectangle {
    in property <string> text: "";
    in property <string> tags: "";
    // Margin reserved on each side; footer hosts bind it to their
    // corner slot width so a long name elides before reaching a badge.
    in property <length> side-inset: Sizing.pct-w(3);

    property <length> avail-width: Math.max(0px, root.width - 2 * root.side-inset);
    property <bool> has-tags: root.tags != "";
    property <length> requested-gap: root.has-tags ? Sizing.pct-w(1.5) : 0px;
    property <length> name-measured: Math.ceil(name-measure.preferred-width / 1px) * 1px;
    property <length> tags-measured: root.has-tags ? Math.ceil(tags-measure.preferred-width / 1px) * 1px : 0px;
    property <length> name-width: Math.min(root.name-measured, root.avail-width);
    property <length> tags-width: Math.min(root.tags-measured, Math.max(0px, root.avail-width - root.name-width - root.requested-gap));
    property <length> gap: root.tags-width > 0px ? root.requested-gap : 0px;
    property <length> block-width: root.name-width + root.gap + root.tags-width;
    property <length> block-x: Sizing.snap((root.width - root.block-width) / 2);
    property <length> text-y: Sizing.snap((root.height - Sizing.font-hero) / 2);

    name-measure := Text {
        visible: false;
        text: root.text;
        font-weight: FontWeight.medium;
        font-size: Sizing.font-hero;
    }
    tags-measure := Text {
        visible: false;
        text: root.tags;
        font-weight: FontWeight.medium;
        font-size: Sizing.font-hero;
    }

    Text {
        x: root.block-x;
        y: Sizing.snap(root.text-y + (Sizing.font-hero - self.preferred-height) / 2);
        width: root.name-width;
        overflow: elide;
        text: root.text;
        color: Theme.text-primary;
        font-weight: FontWeight.medium;
        font-size: Sizing.font-hero;
    }
    if root.has-tags: Text {
        x: root.block-x + root.name-width + root.gap;
        y: Sizing.snap(root.text-y + (Sizing.font-hero - self.preferred-height) / 2);
        width: root.tags-width;
        overflow: elide;
        text: root.tags;
        color: Theme.text-variant;
        font-weight: FontWeight.medium;
        font-size: Sizing.font-hero;
    }
}

// Atomic help-bar group: the glyphs and the label they describe, never
// split across rows.
component HelpEntryView inherits HorizontalLayout {
    in property <HelpEntry> entry;
    property <length> icon-size: GlyphSource.help-side();

    spacing: Sizing.pct-w(0.6);
    height: Math.max(root.icon-size, Sizing.font-body);

    for token in root.entry.buttons: Image {
        y: Sizing.snap((root.height - self.height) / 2);
        width: root.icon-size;
        height: root.icon-size;
        source: GlyphSource.glyph(Buttons.key(token), root.icon-size, Theme.text-primary);
        image-rendering: Sizing.crt ? ImageRendering.pixelated : ImageRendering.smooth;
    }
    Text {
        vertical-alignment: center;
        text: root.entry.label;
        color: Theme.text-primary;
        font-size: Sizing.font-body;
    }
}

// Bottom instructions bar: a bg-bar fill with a single top keyline, both
// bleeding past the CRT safe-area inset by `bleed` so the fill reaches
// the framebuffer edge, and the entries centered in one row, or two rows
// at 240p when one would overflow. Entries are `HelpEntry` values; the
// App decides the vocabulary per screen and modal.
//
// The bar is one row tall until the entries wrap: Rust reads
// `wrap-entries` and re-solves `Sizing.help-bar-height` for two rows. The
// wrap decision is the entries' width against the safe width and nothing
// else, so the height it changes can never flip it back.
export component HelpBar inherits Rectangle {
    in property <[HelpEntry]> entries: [];
    in property <length> bleed: 0px;
    in property <length> side-margin: Sizing.pct-w(2);

    height: Sizing.help-bar-height;

    property <length> entry-height: Math.max(Sizing.tier-240 ? Sizing.help-glyph-size : Sizing.pct-h(4), Sizing.font-body);
    property <length> row-spacing: Sizing.pct-h(1);
    property <length> entry-gap: Sizing.pct-w(2);
    property <int> split-index: Math.ceil(root.entries.length / 2);
    property <length> safe-width: Math.max(0px, root.width - 2 * root.side-margin);
    out property <bool> wrap-entries: Sizing.tier-240 && measure.preferred-width > root.safe-width;

    Rectangle {
        x: -root.bleed;
        y: 0;
        width: parent.width + 2 * root.bleed;
        height: parent.height + root.bleed;
        // Over a background image the bar's darker band is in the image.
        background: Backdrop.on ? transparent : Theme.bg-bar;
    }
    Rectangle {
        x: -root.bleed;
        y: 0;
        width: parent.width + 2 * root.bleed;
        height: Sizing.stroke(1);
        background: Theme.border-subtle;
    }

    // Measuring twin for the single-row width.
    measure := HorizontalLayout {
        visible: false;
        spacing: root.entry-gap;
        for e in root.entries: HelpEntryView { entry: e; }
    }

    if !root.wrap-entries: HorizontalLayout {
        x: Sizing.snap((parent.width - self.preferred-width) / 2);
        y: Sizing.snap((parent.height - root.entry-height) / 2 + Sizing.pct-h(0.2));
        width: self.preferred-width;
        height: root.entry-height;
        spacing: root.entry-gap;
        for e in root.entries: HelpEntryView { entry: e; }
    }

    // Two-row layout: measure each row with its own dedicated
    // HorizontalLayout that iterates only that row's entries by index,
    // avoiding the visible-toggle preferred-width bug.
    property <int> r1-count: root.split-index;
    property <int> r2-count: root.entries.length - root.split-index;
    row1-measure := HorizontalLayout {
        visible: false;
        spacing: root.entry-gap;
        if root.r1-count > 0: HelpEntryView { entry: root.entries[0]; }
        if root.r1-count > 1: HelpEntryView { entry: root.entries[1]; }
        if root.r1-count > 2: HelpEntryView { entry: root.entries[2]; }
        if root.r1-count > 3: HelpEntryView { entry: root.entries[3]; }
        if root.r1-count > 4: HelpEntryView { entry: root.entries[4]; }
    }
    row2-measure := HorizontalLayout {
        visible: false;
        spacing: root.entry-gap;
        if root.r2-count > 0: HelpEntryView { entry: root.entries[root.split-index]; }
        if root.r2-count > 1: HelpEntryView { entry: root.entries[root.split-index + 1]; }
        if root.r2-count > 2: HelpEntryView { entry: root.entries[root.split-index + 2]; }
        if root.r2-count > 3: HelpEntryView { entry: root.entries[root.split-index + 3]; }
    }

    if root.wrap-entries: Rectangle {
        property <int> si: root.split-index;
        property <int> n1: root.r1-count;
        property <int> n2: root.r2-count;
        x: root.side-margin;
        y: Sizing.snap((parent.height - self.height) / 2);
        width: root.safe-width;
        height: 2 * root.entry-height + root.row-spacing;
        HorizontalLayout {
            x: Sizing.snap((parent.width - row1-measure.preferred-width) / 2);
            y: 0;
            width: row1-measure.preferred-width;
            height: root.entry-height;
            spacing: root.entry-gap;
            if n1 > 0: HelpEntryView { entry: root.entries[0]; }
            if n1 > 1: HelpEntryView { entry: root.entries[1]; }
            if n1 > 2: HelpEntryView { entry: root.entries[2]; }
            if n1 > 3: HelpEntryView { entry: root.entries[3]; }
            if n1 > 4: HelpEntryView { entry: root.entries[4]; }
        }
        HorizontalLayout {
            x: Sizing.snap((parent.width - row2-measure.preferred-width) / 2);
            y: root.entry-height + root.row-spacing;
            width: row2-measure.preferred-width;
            height: root.entry-height;
            spacing: root.entry-gap;
            if n2 > 0: HelpEntryView { entry: root.entries[si]; }
            if n2 > 1: HelpEntryView { entry: root.entries[si + 1]; }
            if n2 > 2: HelpEntryView { entry: root.entries[si + 2]; }
            if n2 > 3: HelpEntryView { entry: root.entries[si + 3]; }
        }
    }
}

// Non-focusable group heading: a label-colored heading over a hairline
// rule, inset like the row labels under it.
// Color and a rule, not size or weight, because the bitmap tier
// quantizes the two type sizes to the same strike.
export component SectionHeader inherits Rectangle {
    in property <string> label;
    in property <length> label-inset: Sizing.pct-w(2);

    property <length> top-gap: Sizing.pct-h(1.5);
    property <length> rule-gap: Sizing.pct-h(0.8);

    height: root.top-gap + label-text.preferred-height + root.rule-gap + Sizing.stroke(1);

    label-text := Text {
        x: root.label-inset;
        y: root.top-gap;
        width: Math.max(0px, parent.width - 2 * root.label-inset);
        overflow: elide;
        text: root.label;
        color: Theme.text-label;
        font-weight: FontWeight.semi-bold;
        font-size: Sizing.font-body;
    }
    Divider {
        x: 0;
        y: parent.height - self.height;
    }
}

// The worded cue for a surface that is waiting and has nothing else to
// show: a screen body, a modal body, the boot curtain. The hourglass and a
// line naming what is loading, centered in this element. It follows the
// shared timing (`Motion.cue-delay-ms`, `Motion.cue-hold-ms`) unless
// `immediate`, which is for a wait that is the whole screen from its first
// frame. A surface with content to keep puts its cue in the header line
// instead (`crate::cue`).
export component WaitCue inherits Rectangle {
    in property <bool> waiting: false;
    in property <string> text: @tr("Loading…");
    in property <bool> immediate: false;
    // False for a line that reports a problem rather than a wait.
    in property <bool> icon: true;
    in property <length> glyph: Sizing.font-size(3);
    in property <color> ink: Theme.text-primary;
    // On screen now, which outlasts `waiting` by up to the hold.
    out property <bool> shown: root.immediate ? root.waiting : root.held-shown;

    property <bool> held-shown: false;
    property <bool> hold: false;
    property <length> spacing: Sizing.pct-w(0.6);
    // With no text the hourglass stands alone, over a sentence of the
    // caller's own.
    property <length> icon-w: root.icon ? root.glyph + (root.text == "" ? 0px : root.spacing) : 0px;
    property <length> label-w: Math.min(Math.ceil(label.preferred-width / 1px) * 1px,
        Math.max(0px, root.width - root.icon-w));
    property <length> content-w: root.icon-w + root.label-w;

    changed waiting => {
        if (!self.waiting && !self.hold) { self.held-shown = false; }
    }
    Timer {
        interval: Motion.cue-delay-ms;
        running: !root.immediate && root.waiting && !root.held-shown;
        triggered => {
            root.held-shown = true;
            root.hold = true;
        }
    }
    Timer {
        interval: Motion.cue-hold-ms;
        running: root.hold;
        triggered => {
            root.hold = false;
            if (!root.waiting) { root.held-shown = false; }
        }
    }

    Image {
        x: Sizing.snap((parent.width - root.content-w) / 2);
        y: (parent.height - root.glyph) / 2;
        width: root.glyph;
        height: root.glyph;
        visible: root.shown && root.icon;
        source: GlyphSource.glyph("icons/Loading", root.glyph, root.ink);
    }
    // A full line tall, centered on the glyph: a box one font size tall
    // cuts off descenders.
    label := Text {
        x: Sizing.snap((parent.width - root.content-w) / 2) + root.icon-w;
        y: (parent.height - self.height) / 2;
        width: root.label-w;
        height: Math.ceil(root.glyph * 1.362 / 1px) * 1px;
        visible: root.shown;
        vertical-alignment: center;
        overflow: elide;
        text: root.text;
        color: root.ink;
        font-size: root.glyph;
    }
}

// In-screen state cue: the empty or failed message centered over the
// content area, with an optional detail line.
// Ready paints nothing. Loading waits before painting and holds briefly.
export component StateCue inherits Rectangle {
    // Delay and minimum visibility prevent a fast fill from flashing.
    in property <ContentState> state: ContentState.ready;
    in property <string> empty-text: @tr("Nothing here");
    in property <string> empty-detail: "";
    in property <string> error-detail: @tr("Check Zaparoo Core and try again.");
    in property <string> loading-text: @tr("Loading…");
    // Vertical center of the loading cue, so a content rect that starts
    // below the header can still center the cue on the screen.
    in property <length> cue-center-y: root.height / 2;

    property <bool> loading: root.state == ContentState.loading;
    property <bool> loading-shown: wait.shown;
    out property <bool> loading-visible: root.loading-shown;
    property <ContentState> message-state: root.loading-shown || root.loading ? ContentState.ready : root.state;
    visible: root.loading-shown || root.message-state != ContentState.ready;

    property <string> headline: root.message-state == ContentState.error ? @tr("Failed to load") : root.empty-text;
    property <string> detail: root.message-state == ContentState.error ? root.error-detail : root.empty-detail;
    property <length> text-w: root.width * 0.7;
    property <length> gap: Sizing.pct-h(0.6);
    property <length> block-h: headline-text.preferred-height + (root.detail != "" ? root.gap + detail-text.preferred-height : 0px);

    // Loading cue: the glyph and the text side by side, centered on
    // `cue-center-y`.
    wait := WaitCue {
        x: 0;
        y: Sizing.snap(root.cue-center-y - self.height / 2);
        height: self.glyph;
        waiting: root.loading;
        text: root.loading-text;
    }

    headline-text := Text {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: Sizing.snap((parent.height - root.block-h) / 2);
        width: root.text-w;
        visible: root.message-state != ContentState.ready;
        wrap: word-wrap;
        horizontal-alignment: center;
        text: root.headline;
        color: Theme.text-primary;
        font-size: Sizing.font-section;
    }
    detail-text := Text {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: headline-text.y + headline-text.preferred-height + root.gap;
        width: root.text-w;
        visible: root.message-state != ContentState.ready && root.detail != "";
        wrap: word-wrap;
        horizontal-alignment: center;
        text: root.detail;
        color: Theme.text-primary;
        font-size: Sizing.font-caption;
    }
}

// The fast-scroll rail. With letters, it lists them top to bottom with
// the current one highlighted and repeated large in a bubble beside it;
// without, it is a track with a position marker. Only the rail's own area
// changes as the scroll moves, and it never waits on art. Where
// `Motion.rail-ms` is pushed to 0 it appears, moves and leaves in cuts.
// The rail and the bubble are as wide as their widest label needs: a digits
// bucket reads "0-9", three glyphs where every letter is one.
export component FastScrollRail inherits Rectangle {
    in property <bool> shown: false;
    in property <[string]> letters: [];
    in property <int> current: -1;
    in property <string> letter: "";
    in property <float> fraction: 0;

    property <bool> has-letters: root.letters.length > 0;
    property <length> cell: root.has-letters ? root.height / root.letters.length : 0px;
    property <length> bubble: Sizing.pct-h(14);
    property <length> label-size: Math.min(Sizing.font-size(2.2), root.cell * 0.8);
    // Clear space between a label and the border on either side.
    property <length> label-inset: Sizing.card-border-width + Sizing.pct-h(1.5);
    property <length> bubble-width: Math.max(root.bubble,
        Math.ceil(bubble-measure.preferred-width / 1px) * 1px + 2 * root.label-inset);
    property <length> thumb: Math.max(Sizing.pct-h(4), root.height * 0.08);
    property <length> mark-y: root.current >= 0 ? root.current * root.cell : 0px;
    // Glides keep pace with the steps (a page every 90 ms), so the marks
    // never trail the letter; no glide where the rail cuts.
    property <duration> glide: Motion.rail-ms > 0ms ? Motion.dur(Motion.focus-ms) : 0ms;

    width: Math.max(Sizing.pct-h(5),
        Math.ceil(measure.preferred-width / 1px) * 1px + 2 * root.label-inset);
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity { duration: Motion.dur(Motion.rail-ms); easing: ease-out; }

    // Measuring twins: a column is as wide as its widest label.
    measure := VerticalLayout {
        visible: false;
        for label in root.letters: Text {
            text: label;
            font-size: root.label-size;
        }
    }
    bubble-measure := Text {
        visible: false;
        text: root.letter;
        font-size: Sizing.font-size(7);
    }

    Rectangle {
        background: Theme.surface-card;
        border-width: Sizing.card-border-width;
        border-color: Theme.border-mid;
        border-radius: Sizing.radius-md;
    }

    // Letter-based highlight and labels: hidden on CRT where the
    // small text cannot resolve on the scanline grid.
    if root.has-letters && !Sizing.crt && root.current >= 0: Rectangle {
        x: Sizing.card-border-width;
        y: root.mark-y;
        width: parent.width - 2 * Sizing.card-border-width;
        height: root.cell;
        background: Theme.accent;
        border-radius: Math.min(Sizing.radius-md, self.height / 2);
        animate y { duration: root.glide; easing: ease-out; }
    }

    if !Sizing.crt: Rectangle {
        for label[i] in root.letters: Text {
            y: i * root.cell;
            width: parent.width;
            height: root.cell;
            text: label;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: root.label-size;
            color: i == root.current ? Theme.on-accent : Theme.text-label;
        }
    }

    // CRT thumb: a wide bar with 1px inset from the rail edges.
    if Sizing.crt && root.has-letters && root.current >= 0: Rectangle {
        x: 1px + Sizing.card-border-width;
        y: root.mark-y;
        width: parent.width - 2px - 2 * Sizing.card-border-width;
        height: root.cell;
        background: Theme.accent;
        border-radius: 1px;
        animate y { duration: root.glide; easing: ease-out; }
    }

    // Simple thumb rail: used when there are no letters.
    if !root.has-letters: Rectangle {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: root.fraction * (parent.height - self.height);
        width: parent.width * 0.5;
        height: root.thumb;
        background: Theme.accent;
        border-radius: self.width / 2;
        animate y { duration: root.glide; easing: ease-out; }
    }

    // The bubble: the current letter at reading size, level with the
    // highlight and kept inside the rail's span.
    if root.has-letters && root.letter != "": Rectangle {
        x: -root.bubble-width - Sizing.pct-h(1.5);
        y: Math.max(0px, Math.min(parent.height - root.bubble, root.mark-y + root.cell / 2 - root.bubble / 2));
        width: root.bubble-width;
        height: root.bubble;
        background: Theme.surface-card;
        border-width: Sizing.card-border-width;
        border-color: Theme.accent;
        border-radius: Sizing.radius-md;
        animate y { duration: root.glide; easing: ease-out; }

        Text {
            // The bubble's own box: without one a Text is its preferred
            // size at the origin and its alignment centers nothing.
            // The 6x8 bitmap face leaves its last column and its last row
            // blank in every cell, so the cell's center is half of each
            // away from the ink's; the box is offset by that half.
            property <length> ink-bias: Theme.crt ? self.font-size / 16 : 0px;
            x: self.ink-bias - (Sizing.crt ? 2px : 0px);
            y: self.ink-bias;
            width: parent.width;
            height: parent.height;
            text: root.letter;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.text-primary;
            font-size: Sizing.font-size(7);
        }
    }
}
