    // What a dimmed row says instead of its description, when the reason
    // is one the user can act on. Empty for a row that is only busy.
    public pure function disabled-reason(id: string) -> string {
        if (id == "onlineAllFeatures" || id == "onlineRemoteControl" || id == "playtimeSync"
            || id == "onlineLibrarySync" || id == "onlineCloudBackup" || id == "onlineBackupSchedule"
            || id == "onlineManageBackups") {
            return @tr("Link your Zaparoo Online account first.");
        }
        // The two media jobs cannot run at once; each waits for the other.
        if (id == "updateMediaDb") { return @tr("Wait for the metadata update to finish."); }
        if (id == "runScraper") { return @tr("Wait for the media database update to finish."); }
        if (id == "raLaunchers") { return @tr("Install RetroAchievements with Update All first."); }
        return "";
    }
    public pure function description(id: string) -> string {
        if (id == "addGameFolder") { return @tr("Adds a folder of system folders. Update media database scans it."); }
        if (id == "detectLaunchers") { return @tr("Scans a folder you choose for launchers already installed."); }
        if (id == "playtimeAccess") { return @tr("Allows exact game time in system settings. Optional."); }
        if (id == "colorScheme") { return @tr("Changes colors across screens, including text and highlights."); }
        if (id == "colorIntensity") { return @tr("Controls how strongly accent colors tint tiles and backgrounds."); }
        if (id == "systemLogoStyle") { return @tr("Shows system logos in original colors or tinted to match colors."); }
        if (id == "showMenuRow") { return @tr("Shows page actions as a row. Off, the Menu button lists them."); }
        if (id == "showHelpBar") { return @tr("Shows button hints along the bottom. Off, screens use the space."); }
        if (id == "headerLogo") { return @tr("Replaces or hides the Zaparoo logo in the top bar."); }
        if (id == "headerLogoImage") { return @tr("Picks the image shown in place of the Zaparoo logo."); }
        if (id == "reduceMotion") { return @tr("Turns off animation throughout the interface."); }
        if (id == "screensaver") { return @tr("Sets when the screensaver starts and what it shows."); }
        if (id == "screensaverTimeout") { return @tr("Sets idle time before the screensaver starts. Off disables it."); }
        if (id == "screensaverStyle") { return @tr("Picks what plays while the screensaver is on."); }
        if (id == "screensaverBouncing") { return @tr("Picks what bounces around the screen."); }
        if (id == "backgroundImage") { return @tr("Shows an image, or a random one from a folder, behind screens."); }
        if (id == "gameBackground") { return @tr("Shows the focused game's art behind game lists."); }
        if (id == "backgroundBlur") { return @tr("Softens the background image."); }
        if (id == "backgroundDim") { return @tr("Darkens the background so text stays readable."); }
        if (id == "backgroundListStyle") { return @tr("Sets whether cards are solid or show the background through."); }
        if (id == "resolution") { return @tr("Sets the interface's render resolution. Restarts the frontend."); }
        if (id == "interfaceProfile") { return @tr("Adjusts layout density for standard and handheld screens."); }
        if (id == "orientation") { return @tr("Rotates the interface for a sideways screen or tate cabinet."); }
        if (id == "crtEnabled") { return @tr("Outputs 15 kHz analog video. Restarts the frontend."); }
        if (id == "crtVideoStandard") { return @tr("Matches analog output to NTSC or PAL. Restarts the frontend."); }
        if (id == "crtCalibration") { return @tr("Opens a test pattern to set analog picture position and width."); }
