        if (id == "clockFormat") { return @tr("Shows 12-hour or 24-hour time in the top bar."); }
        if (id == "buttonLayout") { return @tr("Matches on-screen prompt icons to your controller."); }
        if (id == "swapConfirmCancel") { return @tr("Flips which controller button accepts and which cancels."); }
        if (id == "swapOptionsView") { return @tr("Swaps which controller button opens Options and Menu."); }
        if (id == "mouseEnabled") { return @tr("Lets a mouse click tiles and menu rows."); }
        if (id == "controllers") { return @tr("Shows connected controllers and pairs new Bluetooth ones."); }
        if (id == "pairedControllers") { return @tr("Lists every paired controller. Options can forget one."); }
        if (id == "updateMediaDb") { return @tr("Rescans game folders for added or removed files."); }
        if (id == "runScraper") { return @tr("Adds artwork and details from the sources Core offers."); }
        if (id == "systemsLayout") { return @tr("Shows systems as a grid, a detailed list, or plain text."); }
