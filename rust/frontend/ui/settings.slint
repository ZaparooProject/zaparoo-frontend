    // The label an action row's control carries.
    public pure function action(key: string) -> string {
        if (key == "cancel") { return @tr("Cancel"); }
        if (key == "configure") { return @tr("Configure"); }
        if (key == "upload") { return @tr("Upload"); }
        if (key == "detect") { return @tr("Detect"); }
        if (key == "pair") { return @tr("Pair"); }
        if (key == "link") { return @tr("Link"); }
        if (key == "unlink") { return @tr("Unlink"); }
        if (key == "logIn") { return @tr("Log in"); }
        if (key == "logOut") { return @tr("Log out"); }
        return @tr("Open");
    }

    public pure function value(id: string, value: string) -> string {
        if (id == "resolution") {
            if (value == "") { return @tr("Automatic"); }
            return @tr("{} × {}", self.resolution-width(value), self.resolution-height(value));
        }
        if (id == "language") { return SettingsLabels.language(value); }
        if (id == "colorScheme") { return SettingsLabels.color-scheme(value); }
        if (id == "screensaverTimeout") { return SettingsLabels.screensaver(value); }
        if (id == "screensaverStyle") { return SettingsLabels.screensaver-style(value); }
        if (id == "screensaverBouncing") { return SettingsLabels.screensaver-bouncing(value); }
        if (id == "mediaImageType") { return SettingsLabels.artwork(value); }
        if (id == "backgroundImage" || id == "headerLogoImage") { return @tr("None"); }
        // How many controllers Core lists as connected.
        if (id == "controllers") {
            if (value == "0") { return @tr("None connected"); }
            return @tr("{n} connected" | "{n} connected" % value.to-float());
        }
        if (id == "headerLogo") {
            if (value == "custom") { return @tr("Custom image"); }
            if (value == "none") { return @tr("None"); }
            return @tr("Zaparoo");
        }
        if (id == "gameBackground") {
            if (value == "off") { return @tr("Off"); }
            return Labels.image-type(value);
        }
        if (id == "backgroundBlur") { return @tr("{}%", value); }
        if (id == "backgroundDim") {
            if (value.to-float() <= -6) { return @tr("No dimming"); }
            if (value.to-float() < 0) { return @tr("Lighter {}", -value.to-float()); }
            if (value.to-float() > 0) { return @tr("Darker {}", value); }
            return @tr("Readable");
        }
        if (id == "backgroundListStyle") {
            if (value == "solid") { return @tr("Solid"); }
            return @tr("Glass");
        }
        if (id == "listLeftRight") {
            if (value == "image") { return @tr("Change image"); }
            return @tr("Change page");
        }
        if (id == "buttonLayout") {
            if (value == "style_a") { return @tr("Style A"); }
            if (value == "style_b") { return @tr("Style B"); }
            if (value == "style_c") { return @tr("Style C"); }
            if (value == "style_d") { return @tr("Style D"); }
            if (value == "style_e") { return @tr("Style E"); }
            return @tr("Automatic");
        }
        if (id == "clockFormat") {
            if (value == "12h") { return @tr("12-hour"); }
            if (value == "24h") { return @tr("24-hour"); }
            return @tr("Automatic");
        }
        if (id == "region") {
            if (value == "us") { return @tr("Americas"); }
            if (value == "eu") { return @tr("Europe"); }
            if (value == "jp") { return @tr("Japan"); }
            return @tr("Automatic");
        }
        if (id == "interfaceProfile") {
            if (value == "standard") { return @tr("Standard"); }
            if (value == "handheld") { return @tr("Handheld"); }
            return @tr("Automatic");
        }
        if (id == "orientation") {
            if (value == "cw") { return @tr("Rotated CW"); }
            if (value == "ccw") { return @tr("Rotated CCW"); }
            return @tr("Horizontal");
        }
        if (id == "systemsLayout" || id == "gamesLayout") {
            if (value == "list") { return @tr("Detailed list"); }
            if (value == "list-only") { return @tr("Text only"); }
            return @tr("Grid");
        }
        if (id == "systemLogoStyle") {
            if (value == "color") { return @tr("Full color"); }
            return @tr("Tinted");
        }
        if (id == "colorIntensity") {
            if (value == "vivid") { return @tr("Vivid"); }
            return @tr("Subtle");
        }
        if (id == "crtVideoStandard") {
            if (value == "pal") { return @tr("PAL"); }
            if (value == "480i") { return @tr("480i"); }
            return @tr("NTSC");
        }
        if (id == "onlineBackupSchedule") {
            if (value == "daily") { return @tr("Daily"); }
            if (value == "weekly") { return @tr("Weekly"); }
            return @tr("Manual");
        }
        if (id == "raPopupPosition") {
            if (value == "center") { return @tr("Center"); }
            if (value == "right") { return @tr("Right"); }
            return @tr("Left");
        }
        if (id == "raAccount") {
            if (value == "loggedIn") { return @tr("Logged in"); }
            return @tr("Not logged in");
        }
        if (id == "raInstall") { return @tr("Not installed"); }
        if (id == "onlineStatus") {
            if (value == "linked") { return @tr("Linked"); }
            return @tr("Not linked");
        }
        if (id == "onlineWarp") {
            if (value == "active") { return @tr("Active"); }
            if (value == "inactive") { return @tr("Not active"); }
            return @tr("Checking…");
        }
        if (id == "onlineRemoteStatus") {
            if (value == "disabled") { return @tr("Off"); }
            if (value == "unlinked") { return @tr("Not linked"); }
            if (value == "connecting") { return @tr("Connecting…"); }
            if (value == "waiting") { return @tr("Waiting for commands…"); }
            if (value == "not_remote_device") { return @tr("Not the remote device"); }
            if (value == "unavailable") { return @tr("Not available"); }
            if (value == "credential_rejected") { return @tr("Link rejected"); }
            if (value == "error") { return @tr("Server unreachable"); }
            return @tr("Unknown");
        }
        return value;
    }

    pure function language(value: string) -> string {
        if (value == "en") { return @tr("English"); }
        if (value == "it_IT") { return @tr("Italian"); }
        if (value == "es") { return @tr("Spanish"); }
        if (value == "eu") { return @tr("Basque"); }
        if (value == "de") { return @tr("German"); }
        if (value == "el") { return @tr("Greek"); }
        if (value == "ja") { return @tr("Japanese"); }
        if (value == "ko") { return @tr("Korean"); }
        if (value == "nl") { return @tr("Dutch"); }
        if (value == "ro") { return @tr("Romanian"); }
        if (value == "sk") { return @tr("Slovak"); }
        if (value == "uk") { return @tr("Ukrainian"); }
        if (value == "zh_CN") { return @tr("Chinese (Simplified)"); }
        if (value == "zh_TW") { return @tr("Chinese (Traditional)"); }
        if (value == "he") { return @tr("Hebrew"); }
        if (value == "ar") { return @tr("Arabic"); }
        if (value == "hi") { return @tr("Hindi"); }
        if (value == "fr") { return @tr("French"); }
        return @tr("Automatic");
    }

    pure function color-scheme(value: string) -> string {
        if (value == "zaparoo-light") { return @tr("Zaparoo Light"); }
        if (value == "classic-purple") { return @tr("Classic Purple"); }
        if (value == "amber-phosphor") { return @tr("Amber Phosphor"); }
        if (value == "game-boy") { return @tr("Game Boy"); }
        if (value == "green-phosphor") { return @tr("Green Phosphor"); }
        if (value == "neo-geo") { return @tr("Neo Geo"); }
        if (value == "nes") { return @tr("NES"); }
        if (value == "virtual-boy") { return @tr("Virtual Boy"); }
        if (value == "dracula") { return @tr("Dracula"); }
        if (value == "everforest") { return @tr("Everforest"); }
        if (value == "gruvbox") { return @tr("Gruvbox"); }
        if (value == "nord") { return @tr("Nord"); }
        if (value == "oxocarbon") { return @tr("Oxocarbon"); }
        if (value == "rose-pine") { return @tr("Rosé Pine"); }
        if (value == "solarized-dark") { return @tr("Solarized Dark"); }
        if (value == "synthwave-84") { return @tr("Synthwave '84"); }
        if (value == "flexoki-paper") { return @tr("Flexoki Paper"); }
        if (value == "solarized-light") { return @tr("Solarized Light"); }
        return @tr("Zaparoo Dark");
    }

    pure function screensaver(value: string) -> string {
        if (value == "off") { return @tr("Off"); }
        if (value == "1") { return @tr("1 second"); }
        if (value == "60") { return @tr("1 minute"); }
        if (value == "120") { return @tr("2 minutes"); }
        if (value == "300") { return @tr("5 minutes"); }
        if (value == "600") { return @tr("10 minutes"); }
        if (value == "900") { return @tr("15 minutes"); }
        if (value == "1800") { return @tr("30 minutes"); }
        return @tr("{} seconds", value);
    }

    pure function screensaver-style(value: string) -> string {
        if (value == "spinning-logo") { return @tr("Spinning logo"); }
        if (value == "system-logos") { return @tr("System logos"); }
        if (value == "cover-wall") { return @tr("Cover wall"); }
        if (value == "recent-games") { return @tr("Recent games"); }
        if (value == "paddle-clock") { return @tr("Paddle clock"); }
        if (value == "starfield") { return @tr("Starfield"); }
        if (value == "flyby") { return @tr("Flyby"); }
        if (value == "polygons") { return @tr("Polygons"); }
        if (value == "snakes") { return @tr("Snakes"); }
        if (value == "life") { return @tr("Life"); }
        if (value == "maze") { return @tr("Maze"); }
        if (value == "random") { return @tr("Random"); }
        return @tr("Bouncing");
    }

    pure function screensaver-bouncing(value: string) -> string {
        if (value == "clock") { return @tr("Clock"); }
        if (value == "recent-game") { return @tr("Recent game"); }
        return @tr("Logo");
    }

    pure function artwork(value: string) -> string {
        return Labels.image-type(value) == "" ? @tr("Automatic") : Labels.image-type(value);
    }
}

// A stepped value as a row of cells, lit from the left: the Volume
// page's slider, and Blur and Dimming on Settings. Each cell is a whole
// number of pixels, so the fill moves a cell at a time and stays sharp. A
// lit cell is solid and an unlit one an outline, so the level reads by
// shape on any fill, selected or not. `selected` draws it in the
// selection's colors, `ink` the color on the selection.
export component SegmentedTrack inherits Rectangle {
    in property <int> cells: 10;
    in property <int> lit: 0;
    in property <length> cell-w;
    in property <length> cell-h;
    in property <bool> selected: false;
    in property <color> ink: Theme.on-accent;
    property <length> cell-gap: Math.max(1px, Sizing.stroke(1));
    width: root.cells * root.cell-w + Math.max(0, root.cells - 1) * root.cell-gap;
    height: root.cell-h;
    for n in root.cells: Rectangle {
        property <bool> on: n < root.lit;
        property <color> fill: root.selected ? root.ink : Theme.accent;
        x: n * (root.cell-w + root.cell-gap);
        width: root.cell-w;
        height: root.cell-h;
        border-radius: Sizing.radius-sm;
        background: self.on ? self.fill : transparent;
        border-width: Sizing.stroke(1);
        border-color: self.on ? self.fill : (root.selected ? root.ink : Theme.text-label);
    }
}

// One settings row: an inverse-video row carrying the label, then the
// value, the toggle knob or the action label. The host draws it twice --
// once resting and once with `focused` inside the list's `SelectionClip`
// -- so the inversion boundary is the travelling fill's own edge.
// A toggle switch: a track and a knob that rests left (off) or right
// (on), or in the middle (`level` 1) for a tri-toggle where some of what
// it covers is on. The knob slides; that slide is a toggle row's whole
// activation cue, so its row does not flash. `focused` draws it in the
// selection's colors, for the inverted copy of a selected row, with
// `fill-color` as the fill it sits on. Settings rows and list panel rows
// share it.
export component ToggleSwitch inherits Rectangle {
    in property <length> knob-h;
    in property <int> level;
    in property <bool> focused;
    in property <color> fill-color: Theme.selection-fill;
    property <length> inset: Sizing.card-border-width * (Sizing.tier-240 ? 1 : 2);
    width: root.knob-h * 1.85;
    height: root.knob-h;
    border-radius: Sizing.radius-sm;
    background: root.focused
        ? (root.level == 2 ? Theme.on-accent : Theme.on-accent-muted)
        : (root.level == 2 ? Theme.accent
            : root.level == 1 ? Theme.accent.mix(Theme.border-mid, 0.5) : Theme.border-mid);

    Rectangle {
        property <length> knob-x: root.inset + (root.width - self.width - 2 * root.inset) * root.level / 2;
        x: self.knob-x;
        y: root.inset;
        width: root.height - 2 * root.inset;
        height: self.width;
        border-radius: Sizing.radius-sm;
        background: root.focused ? root.fill-color : Theme.surface-card;
        border-width: Sizing.card-border-width;
        border-color: root.focused ? Theme.on-accent : Theme.accent;
        animate knob-x { duration: Motion.dur(Motion.settle-ms); easing: ease-out; }
    }
}

export component SettingsRowView inherits Rectangle {
    in property <SettingsRow> entry;
    in property <bool> focused: false;
    // The list cursor's activation flash. During it the fill and the row's
    // content swap colors, so the inverted copy has to swap with them or it
    // goes invisible against `Theme.on-accent` for the length of the cue.
    in property <bool> flashing: false;

    // A row that cannot be used right now is muted through its text tier,
    // never through opacity: an alpha multiplier has no contrast floor.
    // See docs/style.md, "Disabled controls". An info row with no value
    // is a page's lone message (No paired controllers): muted the same way,
    // like the Controllers page's "No controllers connected".
    property <bool> dim: !root.entry.enabled
        || (root.entry.control == ControlKind.info && root.value-text == "");

    property <bool> is-action: root.entry.control == ControlKind.action;
    property <length> pad: Sizing.pct-w(2);
    property <length> knob-h: Sizing.pct-h(3.8);

    // The selected row's two colors, and the weight that goes with them.
    // Dark-on-light text reads thinner than light-on-dark at the same
    // weight, so a selected row steps up to Medium; a no-op on the
    // single-strike bitmap face.
    property <color> fill-color: root.flashing ? Theme.on-accent : Theme.selection-fill;
    property <color> content-color: root.flashing ? Theme.selection-fill : Theme.on-accent;
    property <int> content-weight: root.focused ? FontWeight.medium : FontWeight.normal;

    // A running media job reports under its own row, one type size down.
    // Rust adds exactly that line plus its gap to the row's height, so the
    // pair is centered as the two-line stack it is; reserving a second
    // *body* line for a caption sat them high with a gap underneath.
    property <bool> has-status: root.entry.status-key != ActionStatus.none;
    property <length> status-gap: Sizing.pct-h(0.3);
    property <length> stack-height: root.has-status
        ? label.height + root.status-gap + status-measure.preferred-height
        : label.height;

    // A controller or Bluetooth device row is named after the thing itself.
    property <string> label-text: (root.entry.id == "foundDevice" || root.entry.id == "pairedDevice")
        ? SettingsLabels.device-name(root.entry.value-name, root.entry.name-tail, root.entry.item + 1)
        : SettingsLabels.label(root.entry.id);

    label-measure := Text {
        visible: false;
        text: root.label-text;
        font-size: Sizing.font-body;
        font-weight: FontWeight.medium;
    }
    status-measure := Text {
        visible: false;
        text: SettingsLabels.action-status(root.entry.status-key, root.entry.status-count);
        font-size: Sizing.font-caption;
    }
    // A device row's state is the point of the row, so it keeps its room
    // and a long name elides before it does.
    property <length> value-reserve: root.entry.device != DeviceValue.none && root.value-text != ""
        // The value's own width and the two gaps its Text keeps clear.
        ? Math.ceil(value-measure.preferred-width / 1px) * 1px + Sizing.pct-w(4)
        : 0px;
    value-measure := Text {
        visible: false;
        text: root.value-text;
        font-size: Sizing.font-body;
        font-weight: FontWeight.medium;
    }
    // The Pro badge after a premium row's label, and the room it takes.
    property <length> badge-gap: Sizing.pct-w(1);
    property <length> badge-room: root.entry.premium ? badge.width + root.badge-gap : 0px;

    label := Text {
        x: root.is-action ? Sizing.snap((parent.width - self.width) / 2) : root.pad;
        y: Sizing.snap((parent.height - root.stack-height) / 2);
        width: Math.min(Math.ceil(label-measure.preferred-width / 1px) * 1px + Sizing.stroke(2),
            parent.width - 2 * root.pad - root.value-reserve - root.badge-room);
        overflow: elide;
        text: root.label-text;
        color: root.focused ? (root.dim ? Theme.on-accent-muted : root.content-color)
            : (root.dim ? Theme.text-label : (root.is-action ? Theme.accent : Theme.text-primary));
        font-size: Sizing.font-body;
        font-weight: root.content-weight;
    }

    // A borderless pill in the accent, inverted on the selected row so it
    // stays distinct from the selection fill.
    badge := Rectangle {
        visible: root.entry.premium;
        x: Sizing.snap(label.x + label.width + root.badge-gap);
        y: Sizing.snap((parent.height - self.height) / 2);
        width: Math.ceil(badge-text.preferred-width / 1px) * 1px + 2 * Sizing.snap(self.height / 2);
        height: Math.ceil(badge-text.preferred-height / 1px) * 1px + 2 * Sizing.stroke(Sizing.pct-h(0.3) / 1px);
        border-radius: self.height / 2;
        background: root.focused ? root.content-color : Theme.accent;
        badge-text := Text {
            x: Sizing.snap((parent.width - self.width) / 2);
            y: Sizing.snap((parent.height - self.height) / 2);
            text: @tr("Pro");
            color: root.focused ? root.fill-color : Theme.on-accent;
            font-size: Sizing.font-caption;
            font-weight: FontWeight.medium;
        }
    }

    if root.has-status: Text {
        x: Sizing.snap((parent.width - self.width) / 2);
        y: label.y + label.height + root.status-gap;
        width: Math.min(self.preferred-width, parent.width - 2 * root.pad);
        overflow: elide;
        text: SettingsLabels.action-status(root.entry.status-key, root.entry.status-count);
        color: root.focused ? root.content-color : Theme.text-label;
        font-size: Sizing.font-caption;
        font-weight: root.content-weight;
    }

    property <string> value-text: root.entry.device != DeviceValue.none
        ? SettingsLabels.device-value(root.entry.device)
        : (root.entry.id == "systems" || root.entry.id == "source")
        ? SettingsLabels.scope(root.entry.scope-kind, root.entry.value-name)
        : (root.entry.id == "onlineStatus" && root.entry.value == "linked" && root.entry.value-name != "")
            ? @tr("Linked as {}", root.entry.value-name)
            : (root.entry.id == "raAccount" && root.entry.value == "loggedIn" && root.entry.value-name != "")
                ? @tr("Logged in as {}", root.entry.value-name)
                // A user color scheme, a chosen background or logo image,
                // and the systems a RetroAchievements preference skips show
                // their own names, as written.
                : ((root.entry.id == "colorScheme" || root.entry.id == "raConflict" || root.entry.id == "backgroundImage" || root.entry.id == "headerLogoImage") && root.entry.value-name != "")
                    ? root.entry.value-name
                    : SettingsLabels.value(root.entry.id, root.entry.value);

    // An info row only reports: its value sits flush right in the label
    // color, with no chevron, so it does not read as something to open.
    // Notice and device rows read the same way, though they take focus.
    property <bool> is-info: root.entry.control == ControlKind.info || root.entry.control == ControlKind.notice
        || root.entry.control == ControlKind.device;

    // The background image, logo image and Controllers rows are navigations
    // that still name what they hold.
    property <bool> shows-value: root.entry.control == ControlKind.picker || root.is-info
        || root.is-slider || root.entry.id == "backgroundImage" || root.entry.id == "headerLogoImage"
        || root.entry.id == "controllers";
    property <bool> is-slider: root.entry.control == ControlKind.slider;
    // The slider's cells: the Volume page's cell size, from the same
    // share of the row, so the two sliders match.
    property <length> cell-w: Math.max(2px, Math.floor((root.width * 0.3 - 9 * Math.max(1px, Sizing.stroke(1))) / 10 / 1px) * 1px);
    property <length> cell-h: Sizing.pct-h(2.6);
    property <length> track-w: track.width;

    if root.shows-value: Text {
        x: root.is-info
            ? parent.width - self.width - root.pad
            : root.is-slider
                ? parent.width - self.width - root.pad - root.track-w - Sizing.pct-w(2)
                : parent.width - self.width - root.pad - chevron.width - Sizing.pct-w(1);
        y: Sizing.snap((parent.height - self.height) / 2);
        // Up to whatever stands at the right: the track on a slider, the
        // chevron otherwise.
        width: Math.min(self.preferred-width, Math.max(0px,
            (root.is-slider ? track.x : chevron.x) - Sizing.pct-w(2) - label.x - label.width - root.badge-room - Sizing.pct-w(2)));
        overflow: elide;
        text: root.value-text;
        color: root.focused ? (root.dim ? Theme.on-accent-muted : root.content-color)
            : (root.is-info || root.dim ? Theme.text-label : Theme.text-primary);
        font-size: Sizing.font-body;
        font-weight: root.content-weight;
    }

    // A slider's cells. Left and Right step it.
    track := SegmentedTrack {
        visible: root.is-slider;
        x: parent.width - self.width - root.pad;
        y: Sizing.snap((parent.height - self.height) / 2);
        cells: root.entry.cells;
        lit: root.entry.lit;
        cell-w: root.cell-w;
        cell-h: root.cell-h;
        selected: root.focused;
        ink: root.content-color;
    }

    // A toggle's knob rests left (off) or right (on). A tri-toggle adds the
    // middle: some of what it covers is on. `level` is 0, 1 or 2.
    property <int> level: root.entry.control == ControlKind.tri-toggle
        ? (root.entry.value == "on" ? 2 : root.entry.value == "mixed" ? 1 : 0)
        : (root.entry.checked ? 2 : 0);

    if root.entry.control == ControlKind.toggle || root.entry.control == ControlKind.tri-toggle: ToggleSwitch {
        x: parent.width - self.width - root.pad;
        y: Sizing.snap((parent.height - self.height) / 2);
        knob-h: root.knob-h;
        level: root.level;
        focused: root.focused;
        fill-color: root.fill-color;
    }

    chevron := Image {
        x: parent.width - self.width - root.pad;
        y: Sizing.snap((parent.height - self.height) / 2);
        width: root.entry.control == ControlKind.picker || root.entry.control == ControlKind.navigate
            ? GlyphSource.side(Sizing.pct-h(3)) : 0px;
        height: self.width;
        visible: root.entry.control == ControlKind.picker || root.entry.control == ControlKind.navigate;
        source: GlyphSource.glyph("icons/NavRight", Math.max(1px, self.width), root.focused ? root.content-color : Theme.text-label);
    }
}
