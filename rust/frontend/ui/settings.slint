//
// The Settings screen: the root category grid and its per-page rows,
// with the row anatomy those pages share. Rust pushes rows as ids and
// values; every user-visible string is translated here.

import { Theme, Sizing, Motion, Layout } from "theme.slint";
import { GlyphSource } from "chrome.slint";
import { GridCell, Tile } from "tiles.slint";
import { Labels } from "labels.slint";
import { SettingsPage, RowKind, ControlKind, DeviceValue, PairFailure, PairSearch, ActionStatus, SetupKind, ScopeKind, SetupAction, StateTokens } from "state_types.slint";

// One row: a group header, or a field with its control and state.
export struct SettingsRow {
    kind: RowKind,
    // Vocabulary key: the field id, or the header's own key.
    id: string,
    control: ControlKind,
    // Picker: the canonical value. Action: the label key its control
    // shows. Navigate on the root grid: the category glyph.
    value: string,
    checked: bool,
    enabled: bool,
    // An action whose job is already running says so under its label.
    busy: bool,
    status-key: ActionStatus,
    status-count: string,
    // Where the row sits in the card and how tall it is; Rust stacks
    // them so a busy action's taller box shifts everything below it.
    y-offset: length,
    height: length,
    // Setup scope/source rows keep their discriminant separate from text.
    scope-kind: ScopeKind,
    value-name: string,
    // A slider's cells, and how many of them are lit.
    cells: int,
    lit: int,
    // A Bluetooth device row: where it stands, and why its pairing
    // failed. It is named by `value-name` (empty for a device with no
    // name, which reads as "Controller {item + 1}") and `name-tail`, the
    // end of its address when another row shares its name.
    device: DeviceValue,
    pair-error: PairFailure,
    item: int,
    name-tail: string,
    // Needs Zaparoo Pro or Warp: the row carries the Pro badge, and
    // Accept explains instead of changing it.
    premium: bool,
}

// The Settings string table: labels, the hint line under the list, and
// the display name of every canonical value.
export global SettingsLabels {
    pure callback resolution-width(string) -> string;
    pure callback resolution-height(string) -> string;

    // A picker choice's note, shown in the right-hand column beside its name.
    public pure function picker-note(id: string, value: string) -> string {
        if (id == "resolution") {
            if (value == "") { return @tr("Recommended"); }
            if (self.resolution-height(value).to-float() >= 1080) { return @tr("No animations"); }
        }
        if (id == "crtVideoStandard") { return value == "pal" ? @tr("50 Hz") : @tr("60 Hz"); }
        if (id == "screensaverTimeout" && value == "1") { return @tr("Testing"); }
        return "";
    }
    public pure function action-status(key: ActionStatus, count: string) -> string {
        if (key == ActionStatus.folders-ready) { return @tr("Saved folder permissions: {}", count); }
        if (key == ActionStatus.folder-opening) { return @tr("Choose a folder in the system picker"); }
        if (key == ActionStatus.folder-saved) { return @tr("Folder access saved: {} total", count); }
        if (key == ActionStatus.folder-cancelled) { return @tr("Canceled: {} folder permissions saved", count); }
        if (key == ActionStatus.folder-denied) { return @tr("Read access could not be saved. Choose the folder again."); }
        if (key == ActionStatus.folder-failed) { return @tr("Could not open or save the folder. Try again."); }
        if (key == ActionStatus.folder-revoked) { return @tr("Folder access was removed. Choose the folder again."); }
        if (key == ActionStatus.launcher-ready) { return @tr("Choose a folder to scan for installed launchers"); }
        if (key == ActionStatus.launcher-opening) { return @tr("Choose the folder to scan in the system picker"); }
        if (key == ActionStatus.launcher-detected) { return @tr("{} launchers detected", count); }
        if (key == ActionStatus.launcher-cancelled) { return @tr("Canceled: {} launchers detected", count); }
        if (key == ActionStatus.launcher-denied) { return @tr("Read access could not be saved. Choose the folder again."); }
        if (key == ActionStatus.launcher-failed) { return @tr("Could not scan that folder. Try again."); }
        if (key == ActionStatus.launcher-unavailable) { return @tr("Scanning for launchers is unavailable"); }
        if (key == ActionStatus.playtime-verified) { return @tr("Verified: exact foreground playtime"); }
        if (key == ActionStatus.playtime-unverified) { return @tr("Off: playtime cannot be verified"); }
        if (key == ActionStatus.online-linked) { return @tr("Linked to Zaparoo Online"); }
        if (key == ActionStatus.online-unlinked) { return @tr("Not linked"); }
        if (key == ActionStatus.optimizing) { return @tr("Optimizing…"); }
        if (key == ActionStatus.paused) { return @tr("Paused"); }
        if (key == ActionStatus.running) { return @tr("In progress…"); }
        if (key == ActionStatus.indexed) { return @tr("{} indexed", count); }
        if (key == ActionStatus.imported) { return @tr("{} imported", count); }
        return "";
    }
    // What a Bluetooth device row reads on its right. A found device
    // that has not been tried reads nothing: its name is the point.
    public pure function device-value(value: DeviceValue) -> string {
        if (value == DeviceValue.pairing) { return @tr("Pairing…"); }
        if (value == DeviceValue.paired) { return @tr("Paired"); }
        if (value == DeviceValue.connected) { return @tr("Connected"); }
        if (value == DeviceValue.not-connected) { return @tr("Not connected"); }
        if (value == DeviceValue.failed) { return @tr("Failed"); }
        return "";
    }
    // What a controller card says beside its battery bar. A pad that
    // reports only a level says it with the bar alone.
    public pure function card-reading(value: DeviceValue, percent: int) -> string {
        if (value == DeviceValue.wired) { return @tr("Wired"); }
        if (value == DeviceValue.percent || value == DeviceValue.charging-percent) { return @tr("{}%", percent); }
        if (value == DeviceValue.charging) { return @tr("Charging"); }
        if (value == DeviceValue.charged) { return @tr("Charged"); }
        return "";
    }
    // A controller or device's name: the one Core gives, with the end of
    // its address when another entry shares it, or its place when it has
    // none.
    public pure function device-name(name: string, tail: string, ordinal: int) -> string {
        if (name == "") { return @tr("Controller {}", ordinal); }
        if (tail == "") { return name; }
        return @tr("{} ({})", name, tail);
    }
    // The status line over the Controllers page's found list.
    public pure function pair-search(search: PairSearch) -> string {
        if (search == PairSearch.adapter-off) { return @tr("The Bluetooth adapter is off"); }
        if (search == PairSearch.failed) { return @tr("Could not search for controllers"); }
        if (search == PairSearch.pairing) { return @tr("Pairing…"); }
        return @tr("Searching for controllers…");
    }
    // The hint under a Bluetooth device row: what Accept or Options does
    // there, or why its pairing failed.
    public pure function device-description(id: string, value: DeviceValue, error: PairFailure) -> string {
        if (id == "pairedDevice") {
            if (value == DeviceValue.connected) { return @tr("Connected. Options can forget it."); }
            return @tr("Turn it on to connect. Options can forget it.");
        }
        if (value == DeviceValue.found) { return @tr("Pairs this controller and connects it."); }
        if (value == DeviceValue.pairing) { return @tr("Keep the controller in pairing mode until it connects."); }
        if (value == DeviceValue.paired) { return @tr("Paired. Turn it on to connect."); }
        if (value == DeviceValue.connected) { return @tr("Paired and connected."); }
        if (error == PairFailure.pin-required) { return @tr("This controller needs a PIN, which is not supported."); }
        if (error == PairFailure.not-powered) { return @tr("The Bluetooth adapter is off."); }
        if (error == PairFailure.timeout) { return @tr("No answer. Put the controller in pairing mode and try again."); }
        if (error == PairFailure.rejected) { return @tr("The controller refused. Put it in pairing mode and try again."); }
        if (error == PairFailure.not-found) { return @tr("The controller went out of range. Bring it closer and try again."); }
        return @tr("Pairing failed. Put the controller in pairing mode and retry.");
    }
    // The hint band's text for a row: its description, or for a device
    // row, what its state says.
    public pure function row-description(row: SettingsRow) -> string {
        if (row.id == "foundDevice" || row.id == "pairedDevice") { return self.device-description(row.id, row.device, row.pair-error); }
        return self.description(row.id);
    }

    public pure function page-title(page: SettingsPage) -> string {
        if (page == SettingsPage.root) { return @tr("Settings"); }
        return SettingsLabels.label(StateTokens.page(page));
    }

    // The media-job setup forms (IndexSetupModal, ScrapeSetupModal).
    public pure function setup-title(kind: SetupKind) -> string {
        if (kind == SetupKind.scrape) { return @tr("Update metadata"); }
        return @tr("Update media database");
    }
    // The scope a job runs over, and the source it runs from.
    public pure function scope(kind: ScopeKind, name: string) -> string {
        if (kind == ScopeKind.all) { return @tr("All systems"); }
        if (kind == ScopeKind.category) { return @tr("All {} systems", Labels.hub("category:" + name, name)); }
        // Several checked systems: the name is how many.
        if (kind == ScopeKind.systems) { return @tr("{n} system" | "{n} systems" % name.to-float()); }
        // A manufacturer's name over its systems; unnamed ones share one.
        if (kind == ScopeKind.header) { return name == "" ? @tr("Other") : name; }
        // The systems that were checked when the picker opened.
        if (kind == ScopeKind.selected) { return @tr("Selected"); }
        // The Source row before Core has listed the sources.
        if (kind == ScopeKind.source-loading) { return @tr("Loading sources…"); }
        return name;
    }
    public pure function setup-action(key: SetupAction) -> string {
        if (key == SetupAction.select) { return @tr("Select"); }
        if (key == SetupAction.start) { return @tr("Start"); }
        if (key == SetupAction.toggle) { return @tr("Toggle"); }
        return @tr("Change");
    }

