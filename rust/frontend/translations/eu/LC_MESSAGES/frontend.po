#: rust/frontend/ui/settings.slint:203
msgid "Wait for the metadata update to finish."
msgstr "Itxaron metadatuen eguneraketa amaitu arte."

#: rust/frontend/ui/settings.slint:204
msgid "Wait for the media database update to finish."
msgstr "Itxaron multimedia datu-basearen eguneraketa amaitu arte."

#: rust/frontend/ui/settings.slint:208
msgid "Choose a folder containing system folders, then use Update media database to scan."
msgstr "Aukeratu sistemen karpetak dituen karpeta bat, eta erabili Eguneratu multimedia datu-basea eskaneatzeko."

#: rust/frontend/ui/settings.slint:209
msgid "Scans a folder you choose for launchers already installed."
msgstr "Aukeratzen duzun karpetan instalatutako abiarazleak bilatzen ditu."

#: rust/frontend/ui/settings.slint:210
msgid "Allow exact game time in system settings. Optional."
msgstr "Baimendu joko-denbora zehatza sistemaren ezarpenetan. Aukerakoa."

#: rust/frontend/ui/settings.slint:211
msgid "Changes colors across screens, including text and highlights."
msgstr "Pantaila guztietako koloreak aldatzen ditu, testua eta nabarmentzeak barne."

#: rust/frontend/ui/settings.slint:212
msgid "Controls how strongly accent colors tint tiles and backgrounds."
msgstr "Azentu-koloreek lauzak eta atzeko planoak zenbat tindatzen dituzten zehazten du."

#: rust/frontend/ui/settings.slint:213
msgid "Shows system logos in original colors or tinted to match colors."
msgstr "Sistemen logoak jatorrizko koloreetan edo eskemaren kolorez tindatuta erakusten ditu."

#: rust/frontend/ui/settings.slint:214
msgid "Shows page actions as a row. Off, the Menu button lists them."
msgstr "Orriko ekintzak errenkadan erakusten ditu. Bestela, Menua botoiak zerrendatzen ditu."

#: rust/frontend/ui/settings.slint:215
msgid "Turns off animation throughout the interface."
msgstr "Interfaze osoko animazioak desaktibatzen ditu."

#: rust/frontend/ui/settings.slint:216
msgid "Sets idle time before the screensaver starts. Off disables it."
msgstr "Pantaila babeslea hasi aurreko inaktibitate-denbora. Desaktibatuta aukerak kendu egiten du."

#: rust/frontend/ui/settings.slint:217
msgid "The resolution the interface renders at. Restarts the frontend."
msgstr "Interfazea errendatzen den bereizmena. Frontend-a berrabiarazten du."

#: rust/frontend/ui/settings.slint:218
msgid "Adjusts layout density for standard and handheld screens."
msgstr "Diseinuaren dentsitatea pantaila estandar eta eramangarrietara doitzen du."

#: rust/frontend/ui/settings.slint:219
msgid "Rotates the interface for a sideways screen or tate cabinet."
msgstr "Interfazea biratzen du pantaila bertikal edo tate kabinete baterako."

#: rust/frontend/ui/settings.slint:220
msgid "Outputs 15 kHz analog video through MiSTer. Restarts frontend."
msgstr "15 kHz-eko bideo analogikoa ateratzen du MiSTer bidez. Frontend-a berrabiarazten du."

#: rust/frontend/ui/settings.slint:221
msgid "Matches analog output to NTSC or PAL. Restarts the frontend."
msgstr "Irteera analogikoa NTSC edo PAL estandarrera egokitzen du. Frontend-a berrabiarazten du."

#: rust/frontend/ui/settings.slint:222
msgid "Opens a test pattern to position the analog picture with arrows."
msgstr "Proba-patroi bat irekitzen du irudi analogikoa geziekin kokatzeko."

#: rust/frontend/ui/settings.slint:223
msgid "The language used for interface text. Restarts the frontend."
msgstr "Interfazeko testuaren hizkuntza. Frontend-a berrabiarazten du."

#: rust/frontend/ui/settings.slint:224
msgid "Selects regional system and game names, such as Mega Drive."
msgstr "Sistemen eta jokoen eskualdeko izenak aukeratzen ditu, adibidez Mega Drive."

#: rust/frontend/ui/settings.slint:225
msgid "12-hour or 24-hour time in the top bar."
msgstr "12 edo 24 orduko formatua goiko barran."

#: rust/frontend/ui/settings.slint:226
msgid "Matches on-screen prompt icons to your controller."
msgstr "Pantailako botoi-ikonoak zure aginteari egokitzen dizkio."

#: rust/frontend/ui/settings.slint:227
msgid "Flips which controller button accepts and which cancels."
msgstr "Aginteko zein botoik onartzen eta zeinek uzten duen trukatzen du."

#: rust/frontend/ui/settings.slint:228
msgid "Swaps which controller button opens Options and Menu."
msgstr "Aukerak eta Menua irekitzen dituzten botoiak trukatzen ditu."

#: rust/frontend/ui/settings.slint:229
msgid "Lets a mouse click tiles and menu rows."
msgstr "Saguarekin lauzetan eta menuko errenkadetan klik egiten uzten du."

#: rust/frontend/ui/settings.slint:230
msgid "Rescans game folders for added or removed files. Choose systems."
msgstr "Jokoen karpetak berriro eskaneatzen ditu fitxategi berri edo kenduen bila. Aukeratu sistemak."

#: rust/frontend/ui/settings.slint:231
msgid "Adds artwork and details from the sources Core offers."
msgstr "Core-k eskaintzen dituen iturburuetatik artelanak eta xehetasunak gehitzen ditu."

#: rust/frontend/ui/settings.slint:232
msgid "Shows systems as a cover grid or a list with details."
msgstr "Sistemak azalen sare gisa edo xehetasundun zerrenda gisa erakusten ditu."

#: rust/frontend/ui/settings.slint:233
msgid "Sets grid or list layout for Games, Favorites, and Recents."
msgstr "Sare edo zerrenda diseinua ezartzen du Jokoak, Gogokoak eta Azkenak pantailetarako."

#: rust/frontend/ui/settings.slint:234
msgid "Prefers an artwork type when games have multiple images."
msgstr "Artelan mota bat hobesten du jokoek irudi bat baino gehiago dutenean."

#: rust/frontend/ui/settings.slint:235
msgid "Shows hidden items so they can be unhidden."
msgstr "Ezkutuko elementuak erakusten ditu, berriro ikusgai jarri ahal izateko."

#: rust/frontend/ui/settings.slint:236
msgid "Shows real filenames instead of cleaned-up display titles."
msgstr "Benetako fitxategi-izenak erakusten ditu, izenburu txukunduen ordez."

#: rust/frontend/ui/settings.slint:237
msgid "Shows region, revision, and disc tags after game names."
msgstr "Eskualde, berrikuspen eta disko etiketak erakusten ditu izenen ondoren."

#: rust/frontend/ui/settings.slint:238
msgid "Turns the page or changes the image in the detailed list."
msgstr "Orria pasatzen du edo irudia aldatzen du xehetasun zerrendan."

#: rust/frontend/ui/settings.slint:239
msgid "Connects this device to your Zaparoo Online account with a code."
msgstr "Gailu hau zure Zaparoo Online kontura konektatzen du kode baten bidez."

#: rust/frontend/ui/settings.slint:240
msgid "Removes this device's Zaparoo Online account credentials."
msgstr "Gailu honetako Zaparoo Online kontuaren kredentzialak kentzen ditu."

#: rust/frontend/ui/settings.slint:241
msgid "Turns every online feature on or off. Each can still be changed on its own."
msgstr "Online eginbide guztiak aktibatzen edo desaktibatzen ditu. Bakoitza bere aldetik alda daiteke oraindik."

#: rust/frontend/ui/settings.slint:242
msgid "Uploads verified playtime to your account. Estimates stay local."
msgstr "Egiaztatutako jolas-denbora zure kontura igotzen du. Estimazioak lokalean geratzen dira."

#: rust/frontend/ui/settings.slint:243
msgid "Allows your linked Zaparoo Online account to send approved commands to this device."
msgstr "Lotutako Zaparoo Online kontuari onartutako komandoak gailu honetara bidaltzea baimentzen dio."

#: rust/frontend/ui/settings.slint:244
msgid "Syncs your game list, favorites, likes and decks with your linked Zaparoo Online account."
msgstr "Zure joko-zerrenda, gogokoak, atsegiteak eta deck-ak lotutako Zaparoo Online kontuarekin sinkronizatzen ditu."

#: rust/frontend/ui/settings.slint:245
msgid "Backs up this device to the cloud on a schedule."
msgstr "Gailu honen babeskopia egiten du hodeian, programazio baten arabera."

#: rust/frontend/ui/settings.slint:246
msgid "How often automatic cloud backup runs."
msgstr "Hodeiko babeskopia automatikoa zenbatean behin egiten den."

#: rust/frontend/ui/settings.slint:247
msgid "Back up now, view and restore cloud backup snapshots."
msgstr "Egin babeskopia orain, eta ikusi eta leheneratu hodeiko babeskopiak."

#: rust/frontend/ui/settings.slint:248
msgid "See what a linked account's remote commands have done on this device."
msgstr "Ikusi lotutako kontuaren urruneko komandoek gailu honetan egin dutena."

#: rust/frontend/ui/settings.slint:249
msgid "Shows a PIN for pairing a new device with Core."
msgstr "Gailu berri bat Core-rekin parekatzeko PINa erakusten du."

#: rust/frontend/ui/settings.slint:250
msgid "Version, build date, license terms, and contributors."
msgstr "Bertsioa, konpilazio-data, lizentzia-baldintzak eta laguntzaileak."

#: rust/frontend/ui/settings.slint:251
msgid "Shows a code for opening the Frontend guide on your phone."
msgstr "Frontend-en gida telefonoan irekitzeko kodea erakusten du."

#: rust/frontend/ui/settings.slint:252
msgid "Adds troubleshooting detail to logs. Restarts the frontend."
msgstr "Arazoak konpontzeko xehetasunak gehitzen ditu erregistroetan. Frontend-a berrabiarazten du."

#: rust/frontend/ui/settings.slint:253
msgid "Uploads the log and provides a link for problem reports."
msgstr "Log fitxategia igotzen du eta arazoen berri emateko esteka ematen du."

