//
// Design tokens for the Slint demo, mirroring the QML `Zaparoo.Theme`
// and `Sizing` singletons. Simple percent helpers live here as pure
// functions; anything with loops or config tables (grid shape solver)
// lives in `src/sizing.rs` and is pushed in as properties by Rust.
// All geometry snaps to integer pixels; fractional geometry is a bug
// at every resolution, exactly as in the QML app.

export global Theme {
    pure callback preview-color(string, int) -> color;
    in-out property <bool> crt: false;

    // The palette roles Theme.qml publishes, pushed by Rust
    // (src/theme.rs, from zaparoo_app::palette) at startup and on a scheme
    // change. Defaults are zaparoo-dark at Subtle so the first frame
    // already matches the default preset.
    in-out property <color> bg-deep: #050608;
    in-out property <color> bg-panel: #11171d;
    in-out property <color> bg-bar: #030405;
    in-out property <color> surface-card: #181f26;
    in-out property <color> tile-edge: #293d56;
    in-out property <color> control-edge: #324b69;
    // 80% black. Slint reads `#RRGGBBAA`, Qt `#AARRGGBB`: the palette's
    // own `#cc000000` is the Qt spelling of this, and copying it here
    // verbatim made every scrim in the app fully transparent.
    in-out property <color> scrim: #000000cc;
    in-out property <color> border-subtle: #262b30;
    in-out property <color> border-mid: #4f565c;
    in-out property <color> text-primary: #f7f7f5;
    in-out property <color> text-label: #9b9b9b;
    in-out property <color> text-variant: #8091a1;
    in-out property <color> accent: #168bff;
    in-out property <color> selection-fill: #4c8edd;
    in-out property <color> on-accent: #050608;
    in-out property <color> on-accent-muted: #242629;
    in-out property <color> logo-primary: #8c8c8c;
    in-out property <color> logo-secondary: #5e5e5e;
    in-out property <color> logo-shadow: #3d3d3d;
    in-out property <color> logo-focus-primary: #8fc1ff;
    in-out property <color> logo-focus-secondary: #168bff;
    in-out property <color> logo-focus-shadow: #004c94;
    in-out property <color> marker: #ec5545;
    in-out property <color> marker-outline: #f6e4e0;
    in-out property <color> error: #ff4f91;
    in-out property <color> qr-light: #ecf4ff;
    in-out property <color> qr-dark: #0054a2;

    // Theme.qml's lightSurface: the preset's surfaces are light, so the
    // logo and any on-surface art pick their on-light variants.
    in-out property <bool> light-surface: false;

    // CRT and embedded sub-400p use the same face as Qt's bitmapType.
    in-out property <bool> bitmap-fonts: crt;
    out property <string> font-ui: bitmap-fonts ? "MxPlus HP 100LX 6x8" : "Noto Sans";

    // Distance from the top of a Text box to its baseline for a font size:
    // Noto Sans has a 1.069 em ascender (hhea and OS/2 agree); the 6x8
    // bitmap face sits its baseline on the seventh row. QML anchors side
    // texts on `anchors.baseline`; Slint has no baseline anchor, so hosts
    // offset the smaller text by the difference of the two ascents.
    public pure function ascent(size: length) -> length {
        return size * (self.crt ? 0.875 : 1.069);
    }
}

// Motion.qml: the three shared durations, collapsed to zero under Reduce
// motion (Rust pushes `enabled` from the persisted setting).
export global Motion {
    in-out property <bool> enabled: true;
    // Transient route/model generation, never persisted.
    in-out property <int> epoch: 0;
    out property <duration> focus-ms: 80ms;
    out property <duration> press-ms: 34ms;
    out property <duration> settle-ms: 110ms;
    out property <duration> pulse-ms: 250ms;
    public pure function dur(ms: duration) -> duration {
        return self.enabled ? ms : 0ms;
    }
}

export global Sizing {
    pure callback fit-letter-columns(int, length, length, length) -> int;
    // Bound to the Window dimensions by App; Slint snaps rendered geometry
    // to physical pixels.
    in-out property <length> screen-width: 1280px;
    in-out property <length> screen-height: 720px;
    in-out property <bool> crt: false;
    // Rotated scenes use swapped logical dimensions, but percentage
    // tokens stay based on the physical axes. This matches the Qt
    // Sizing.swapPercentageAxes contract and prevents portrait mode
    // from inflating type/vertical chrome against the long axis.
    in-out property <bool> swap-axes: false;
    // Bitmap type has only two usable sizes; HDMI uses the semantic ladder.
    in-out property <bool> bitmap-fonts: crt;

    public pure function pct-h(p: float) -> length {
        return p / 100 * (self.swap-axes ? self.screen-width : self.screen-height);
    }
    public pure function pct-w(p: float) -> length {
        return p / 100 * (self.swap-axes ? self.screen-height : self.screen-width);
    }
    // Mirrors Sizing.qml fontSize: minimum 8 px for 240p legibility;
    // the CRT path quantizes to 8 or 16 so the 6x8 bitmap font only
    // renders at integer multiples.
    public pure function font-size(p: float) -> length {
        return self.quantize(Math.max(8, self.pct-h(p) / 1px)) * 1px;
    }
    pure function quantize(size: int) -> int {
        return self.bitmap-fonts ? (size < 12 ? 8 : 16) : size;
    }
    // Stroke width that never rounds to zero.
    // Hairline width in device pixels, exactly as `Sizing.stroke` in
    // Sizing.qml: `max(1, round(value))`. The argument is a pixel count,
    // NOT a percentage - a keyline stays a keyline at every resolution.
    // Percentage-derived thicknesses (card borders, the focus ring) come
    // from `zaparoo_app::sizing`, which composes the two the way the QML
    // does (`stroke(pctH(0.2))`).
    public pure function stroke(p: float) -> length {
        return Math.max(1, Math.round(p)) * 1px;
    }

    // Everything below is Sizing.qml's derived table, resolved by
    // `zaparoo_app::sizing::derive` (pinned to tests/fixtures/
    // sizing_golden.txt) and pushed by Rust whenever the scene changes.
    // Defaults are the 1280x720 standard values so an unpushed frame
    // still lays out sanely.
    in-out property <bool> tier-240: false;
    in-out property <bool> handheld: false;
    // Radius ladder: every rounded-square surface uses radius-md, the
    // small pill/row radius is its half (docs/style.md).
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-sm: 4px;
    // Type roles (fontSize 4 / 3.2 / 2.9 / 2.6 / 2.4 / 2.2 with the
    // 240p and bitmap snaps applied).
    in-out property <length> font-hero: 29px;
    in-out property <length> font-title: 23px;
    in-out property <length> font-section: 21px;
    in-out property <length> font-body: 19px;
    in-out property <length> font-caption: 17px;
    in-out property <length> font-small: 16px;
    in-out property <length> card-border-width: 1px;
    in-out property <length> focus-border-width: 2px;
    in-out property <length> focus-ring-width: 3px;
    in-out property <length> press-edge-height: 2px;
    // Header geometry: two stacked rows of header-row-height plus the
    // stack gap, below the top margin. Screen content clears
    // header-bottom.
    in-out property <length> header-row-height: 24px;
    in-out property <length> header-stack-gap: 6px;
    in-out property <length> header-top-margin: 14px;
    in-out property <length> header-side-margin: 26px;
    in-out property <length> header-height: 54px;
    in-out property <length> header-bottom: 68px;
    // Bottom help bar band and the clearance content keeps above it.
    in-out property <length> help-bar-height: 43px;
    in-out property <length> help-bar-clearance: 57px;
    in-out property <int> visible-covers: 5;
    // Hub page geometry (Settings previews reuse it).
    in-out property <int> hub-grid-columns: 5;
    in-out property <int> hub-grid-rows: 2;
    in-out property <length> hub-active-label-height: 50px;
    in-out property <length> hub-grid-top-margin: 0px;
    in-out property <length> hub-grid-height-budget: 0px;
    in-out property <length> hub-grid-side-inset: 38px;
    in-out property <length> hub-grid-column-gap: 26px;
    in-out property <length> hub-grid-top-inset: 14px;
    in-out property <length> hub-grid-bottom-inset: 14px;
    in-out property <length> hub-grid-row-gap: 29px;
    in-out property <length> hub-tile-width: 0px;
    in-out property <length> hub-tile-height: 0px;
}

// BrowseLayouts.qml's profile for the browse view on screen, resolved
// by `zaparoo_app::layouts::profile` (pinned to tests/fixtures/
// layout_golden.txt) and pushed by Rust on every scene or view change.
// Names follow the QML `section.key` spelling with the section as a
// prefix. Lengths are whole pixels.
export global Layout {
    // header
    in-out property <bool> title-in-header: false;
    in-out property <bool> hud-bottom-aligned: false;
    in-out property <bool> status-pill-pinned-top: false;
    // status
    in-out property <bool> top-strip-visible: true;
    in-out property <length> strip-height: 50px;
    in-out property <length> slot-margin: 38px;
    in-out property <length> top-margin: 7px;
    // grid
    in-out property <length> grid-left-inset: 26px;
    in-out property <length> grid-right-inset: 26px;
    in-out property <length> grid-column-gap: 26px;
    in-out property <length> grid-top-inset: 14px;
    in-out property <length> grid-bottom-inset: 14px;
    in-out property <length> grid-row-gap: 22px;
    in-out property <length> grid-page-chevron-size: 29px;
    // footer
    in-out property <bool> page-cue-in-footer: false;
    in-out property <length> active-label-height: 50px;
    in-out property <length> active-label-bottom-margin: 58px;
    in-out property <length> bottom-status-left-margin: 38px;
    in-out property <length> bottom-status-right-margin: 38px;
    in-out property <length> grid-bottom-margin: 108px;
    in-out property <length> bottom-unsafe-height: 58px;
    // list
    in-out property <bool> list-vertical: false;
    in-out property <int> list-share: 2;
    in-out property <int> detail-share: 1;
    in-out property <length> divider-width: 1px;
    in-out property <length> divider-margin: 0px;
    in-out property <length> card-side-margin: 38px;
    in-out property <length> card-top-margin: 14px;
    in-out property <length> card-bottom-margin: 58px;
    in-out property <length> card-padding-left: 26px;
    in-out property <length> card-padding-right: 26px;
    in-out property <length> card-padding-top: 14px;
    in-out property <length> card-padding-bottom: 14px;
    in-out property <length> row-height: 0px;
    in-out property <length> row-spacing: 5px;
    in-out property <int> center-slot: -1;
    in-out property <length> row-text-left-padding: 20px;
    in-out property <length> row-text-right-padding: 20px;
    in-out property <length> favorite-right-padding: 20px;
    in-out property <length> overlay-bottom-margin: 108px;
    // detail
    in-out property <bool> detail-vertical: true;
    in-out property <length> section-gap: 14px;
    in-out property <int> image-share: 2;
    in-out property <int> metadata-share: 1;
    in-out property <int> image-height-ratio-with-title: 48;
    in-out property <length> image-reserved-width: 0px;
    in-out property <length> image-reserved-height: 0px;
    in-out property <length> image-bottom-margin: 0px;
    in-out property <length> pane-padding-left: 26px;
    in-out property <length> pane-padding-right: 26px;
    in-out property <length> pane-padding-top: 14px;
    in-out property <length> pane-padding-bottom: 14px;
    in-out property <length> image-padding-left: 0px;
    in-out property <length> image-padding-right: 0px;
    in-out property <length> image-padding-top: 0px;
    in-out property <length> image-padding-bottom: 0px;
    in-out property <length> metadata-padding-left: 0px;
    in-out property <length> metadata-padding-right: 0px;
    in-out property <length> metadata-padding-top: 0px;
    in-out property <length> metadata-padding-bottom: 0px;
    in-out property <length> metadata-top-margin: 12px;
    in-out property <length> metadata-left-margin: 0px;
    in-out property <length> metadata-right-margin: 0px;
    in-out property <length> metadata-height-adjustment: 0px;
    in-out property <bool> metadata-bottom-aligned: false;
    // 0 means no cap (only the CRT non-rotated lists cap the label column).
    in-out property <length> metadata-label-max-width: 0px;
    in-out property <length> title-bottom-margin: 14px;
    in-out property <length> tag-row-height: 22px;
    in-out property <length> tag-row-spacing: 4px;
    // surface
    in-out property <length> card-radius: 8px;
    in-out property <length> row-radius: 4px;
}
