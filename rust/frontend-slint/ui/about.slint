import { Theme, Sizing } from "theme.slint";
import { Brand, GlyphSource, ScrollCue, TopStatusStrip } from "chrome.slint";

export global AboutView {
    in-out property <string> version;
    in-out property <string> commit;
    in-out property <string> channel;
    in-out property <string> build-date;
    // Thousandths of scroll range: both heads can reach the same content
    // endpoint even when their fonts and wrapping produce different heights.
    in-out property <int> scroll-milli: 0;
    in-out property <int> maximum-scroll-milli: 0;
    callback scroll-requested(int);
    public function move(delta: int) {
        AboutView.scroll-requested(Math.max(0, Math.min(1000,
            Math.min(1000, AboutView.scroll-milli)
                + Math.round(delta * 1000 / Math.max(1, AboutView.maximum-scroll-milli)))));
    }
}

component CenteredLine inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Sizing.font-body;
    in property <color> ink: Theme.text-primary;
    height: Math.ceil(label.preferred-height / 1px) * 1px;
    label := Text {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: Math.min(Math.ceil(self.preferred-width / 1px) * 1px, parent.width);
        text: root.text;
        font-size: root.font-size;
        color: root.ink;
        wrap: word-wrap;
    }
}

export component AboutScreen inherits Rectangle {
    property <length> maximum-scroll: Math.max(0px, content.preferred-height - viewport.height);
    property <length> scroll-y: Math.min(root.maximum-scroll,
        AboutView.scroll-milli * root.maximum-scroll / 1000);
    changed maximum-scroll => {
        AboutView.maximum-scroll-milli = Math.ceil(root.maximum-scroll / Math.max(1px, Sizing.screen-height) * 1000);
    }
    TopStatusStrip {
        y: Sizing.header-bottom + Sizing.pct-h(1);
        height: Sizing.pct-h(7);
        title: @tr("About / License");
        show-page-counter: false;
    }
    // The shared surface inset, all four sides (docs/style.md, "Surface
    // containment"); the sides used to be `pct-w(3)` against `pct-h(4)`
    // ends, a third pair of numbers for the same job.
    property <length> pad: Sizing.surface-pad;
    // The scroll cues get a reserved band inside the lip, the same shape
    // `ListPickerModal` uses; folding them into the padding is what made
    // the old `pct-h(4)` end inset look like a considered number.
    property <length> arrow: Sizing.pct-h(3);
    property <length> arrow-band: root.arrow + Sizing.pct-h(0.5);

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: Sizing.header-bottom + Sizing.pct-h(10);
        width: Math.min(parent.width - Sizing.pct-w(10), Sizing.pct-w(50));
        // Clears the help bar the way every other screen does, rather
        // than a flat `pct-h(8)`: at 240p the bar is `pct_h(10)`, so the
        // flat figure left the card 10px short of it.
        height: Math.max(0px, parent.height - self.y - Sizing.help-bar-clearance);
        background: Theme.surface-card;
        border-radius: Sizing.radius-md;
        // The card edge, at the card weight -- this was the one
        // `surface-card` in the app outlined with a bare hairline.
        border-width: Sizing.card-border-width;
        border-color: Theme.border-mid;
        viewport := Rectangle {
            x: root.pad;
            y: root.pad + root.arrow-band;
            width: parent.width - 2 * root.pad;
            height: Math.max(0px, parent.height - 2 * self.y);
            clip: true;
            content := VerticalLayout {
                y: -root.scroll-y;
                height: self.preferred-height;
                spacing: Sizing.pct-h(2);
                Rectangle {
                    height: Math.min(parent.width, Sizing.pct-h(35)) * 135 / 600;
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: Math.min(parent.width, Sizing.pct-h(35));
                        height: parent.height;
                        source: Brand.logo(Theme.light-surface, self.width);
                        image-fit: contain;
                    }
                }
                CenteredLine { text: @tr("Zaparoo Frontend"); font-size: Sizing.font-title; }
                CenteredLine { text: @tr("Version {} · {} · {}", AboutView.version, AboutView.commit, AboutView.channel); font-size: Sizing.font-caption; ink: Theme.text-label; }
                CenteredLine { text: @tr("Built {}", AboutView.build-date); font-size: Sizing.font-small; ink: Theme.text-label; }
                CenteredLine { text: @tr("Copyright 2026 Wizzo Pty Ltd and the Zaparoo Project contributors."); }
                CenteredLine { text: @tr("Source available under the PolyForm Noncommercial License 1.0.0. Free for personal, non-commercial use. Commercial use requires a separate license."); }
                CenteredLine { text: @tr("Commercial licensing: legal@zaparoo.com"); }
                CenteredLine { text: @tr("Project: https://zaparoo.org"); }
                CenteredLine { text: @tr("Created by"); font-size: Sizing.font-caption; ink: Theme.text-label; }
                VerticalLayout {
                    spacing: 0px;
                    for name in ["Andrea Bogazzi", "BossRighteous", "Carlos R.", "devilschile2", "Giancarlo Erra", "José Manuel Barroso Galindo", "Peter Brittain", "Tim Wilsie", "Wilfried Jeanniard", "Wizzo"]: CenteredLine { text: name; }
                }
                CenteredLine { text: @tr("Translations"); font-size: Sizing.font-caption; ink: Theme.text-label; }
                CenteredLine { text: @tr("Italiano - Andrea Bogazzi\nEspañol - Carlos R.\nEuskara - devilschile2\nFrançais - Wilfried"); }
                CenteredLine { text: @tr("Full license text in COPYING."); font-size: Sizing.font-caption; ink: Theme.text-label; }
            }
            TouchArea {
                property <length> drag-y;
                property <int> drag-scroll;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        self.drag-y = self.mouse-y;
                        self.drag-scroll = AboutView.scroll-milli;
                    }
                }
                changed mouse-y => {
                    if (self.pressed) {
                        AboutView.scroll-requested(Math.max(0, Math.min(1000, self.drag-scroll
                            - Math.round((self.mouse-y - self.drag-y) / Math.max(1px, root.maximum-scroll) * 1000))));
                    }
                }
                scroll-event(event) => {
                    AboutView.move(Math.round(-event.delta-y / Math.max(1px, Sizing.screen-height) * 1000));
                    return accept;
                }
            }
        }
        for below in [false, true]: ScrollCue {
            x: (parent.width - self.width) / 2;
            y: below ? parent.height - root.pad - root.arrow : root.pad;
            width: root.arrow;
            visible: root.maximum-scroll > 0px;
            glyph: below ? "icons/ScrollDown" : "icons/ScrollUp";
            live: below ? root.scroll-y < root.maximum-scroll : root.scroll-y > 0px;
        }
    }
}
