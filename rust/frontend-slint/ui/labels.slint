//
// The shared label vocabulary: Rust pushes stable keys, this file turns
// them into translated text. Kept in its own file so every screen and
// modal can reach it without importing the app tree.

// Key-to-copy vocabulary for labels Rust hands over as stable ids.
export global Labels {
    public pure function loading(target: string) -> string {
        if (target == "systems") { return @tr("Loading systems…"); }
        if (target == "games") { return @tr("Loading games…"); }
        if (target == "favorites") { return @tr("Loading favorites…"); }
        if (target == "recents") { return @tr("Loading recently played…"); }
        return @tr("Loading…");
    }
    public pure function hub(key: string, name: string) -> string {
        if (key == "category:Arcade") { return @tr("Arcade"); }
        // Core sends the canonical singular ids; the plurals are what an
        // older Core (and a hub item written by one) can still carry,
        // canonicalized here the way CategoryIds.qml does.
        if (key == "category:Computer" || key == "category:Computers") { return @tr("Computers"); }
        if (key == "category:Console" || key == "category:Consoles") { return @tr("Consoles"); }
        if (key == "category:Handheld" || key == "category:Handhelds") { return @tr("Handhelds"); }
        if (key == "category:Other") { return @tr("Other"); }
        if (key == "action:resume") { return name == "" ? @tr("Resume") : @tr("Resume: {}", name); }
        if (key == "action:favorites") { return @tr("Favorites"); }
        if (key == "action:recents") { return @tr("Recently played"); }
        if (key == "action:update") { return @tr("Update"); }
        if (key == "action:settings") { return @tr("Settings"); }
        return name;
    }
    // Counts arrive already grouped by Rust (`zaparoo_app::format`)
    // through `Shell.count-*`; this keeps a plain number readable when a
    // view has only the integer.
    public pure function count(n: int) -> string {
        return n;
    }
    // The values the two favorites rows can carry, named on their own so
    // the row that shows one can compose it (a Slint function cannot
    // call itself).
    public pure function menu-value(key: string) -> string {
        if (key == "sort:name") { return @tr("A-Z"); }
        if (key == "sort:default") { return @tr("Default"); }
        if (key == "group:none") { return @tr("None"); }
        if (key == "group:system") { return @tr("System"); }
        return "";
    }

    // Menu rows and picker titles. Rust pushes the id it routes on; a
    // key this table does not know falls through to the Hub vocabulary
    // (a hub item's own `category:`/`action:` key) and then to the name
    // the driver sent, which is already the item's own text.
    public pure function menu(key: string, name: string) -> string {
        // Games, favorites and recents rows.
        if (key == "more_info") { return @tr("Details"); }
        if (key == "favorite:add") { return @tr("Add to favorites"); }
        if (key == "favorite:remove") { return @tr("Remove from favorites"); }
        if (key == "change_launcher") { return @tr("Change launcher"); }
        if (key == "write_card") { return @tr("Write to NFC token"); }
        if (key == "qr_code") { return @tr("Write with App"); }
        if (key == "discover") { return @tr("Discover alt. versions"); }
        if (key == "discover:searching") { return @tr("Searching…"); }
        if (key == "discover:none") { return @tr("No alternates found"); }
        if (key == "add_to_hub") { return @tr("Add to Hub"); }
        if (key == "scrape_game") { return @tr("Update metadata"); }
        // Systems rows.
        if (key == "launch_system") { return @tr("Launch system"); }
        if (key == "launch_random_system" || key == "launch_random_favorite") { return @tr("Random game"); }
        if (key == "hide:hide") { return @tr("Hide"); }
        if (key == "hide:unhide") { return @tr("Unhide"); }
        if (key == "index_category" || key == "index_system") { return @tr("Update media database"); }
        if (key == "scrape_category" || key == "scrape_system") { return @tr("Update metadata"); }
        if (key == "jump_letter") { return @tr("Go to…"); }
        // Hub rows and its View menu.
        if (key == "hub_add") { return @tr("Add item…"); }
        if (key == "hub_move") { return @tr("Move"); }
        if (key == "hub_remove:hide") { return @tr("Hide"); }
        if (key == "hub_remove:remove") { return @tr("Remove"); }
        if (key == "hub_reset") { return @tr("Reset layout"); }
        if (key == "hub_settings") { return @tr("Settings"); }
        if (key == "hub_quit") { return @tr("Quit"); }
        if (key == "back_to_hub") { return @tr("Back to Hub"); }
        // The favorites View menu and its pages.
        // The two rows that show their current value; `name` carries the
        // value's own key so both halves get translated.
        if (key == "favorites_sort") { return @tr("Sort: {}", Labels.menu-value(name)); }
        if (key == "favorites_grouping") { return @tr("Group by: {}", Labels.menu-value(name)); }
        if (key == "sort:name" || key == "sort:default"
            || key == "group:none" || key == "group:system") {
            return Labels.menu-value(key);
        }
        // Launcher picker rows.
        if (key == "launcher:default") { return @tr("Default"); }
        if (key == "launcher:current") { return @tr("Current: {}", name); }
        // Picker titles.
        if (key == "title:view") { return @tr("View"); }
        if (key == "title:add_item") { return @tr("Add item"); }
        if (key == "title:sort") { return @tr("Sort"); }
        if (key == "title:group_by") { return @tr("Group by"); }
        if (key == "title:change_launcher") { return @tr("Change launcher"); }
        if (key == "title:alternate_versions") { return @tr("Alternate versions"); }
        return Labels.hub(key, name);
    }

    // The header's transient app line. Rust pushes a key; today the
    // only one is the launch cue.
    public pure function status(key: string) -> string {
        if (key == "launching") { return @tr("Launching…"); }
        return "";
    }

    public pure function hub-reason(reason: string) -> string {
        if (reason == "no-recent-games") { return @tr("No recent games"); }
        if (reason == "no-internet") { return @tr("No internet connection"); }
        if (reason == "not-available") { return @tr("Not available"); }
        return "";
    }
}

// The dialog vocabulary. Rust pushes a kind, an optional sub-kind or
// second value (`detail`) and one runtime value (`arg`); every word a
// dialog shows is composed here so it can be translated. `detail`
// carries the failure kind for an alert, the minimum version for the
// Core warning, and the first-run phase; `arg` carries the item name,
// the running version, or the file count.
export global DialogLabels {
    public pure function title(kind: string, detail: string) -> string {
        if (kind == "quit_confirm") { return @tr("Quit Zaparoo Frontend?"); }
        if (kind == "restart_setting") { return @tr("Quit and restart Zaparoo Frontend?"); }
        if (kind == "notice") { return @tr("Welcome to Zaparoo Frontend"); }
        if (kind == "core_version") { return @tr("Update Zaparoo Core"); }
        if (kind == "first_run") { return @tr("First-time setup"); }
        if (kind == "hub_full") { return @tr("Nothing left to add"); }
        if (kind == "action_error") { return DialogLabels.error-title(detail); }
        return "";
    }

    public pure function body(kind: string, detail: string, arg: string) -> string {
        if (kind == "quit_confirm") { return @tr("Are you sure you want to exit?"); }
        if (kind == "restart_setting") { return @tr("This setting needs a frontend restart to take effect."); }
        if (kind == "notice") {
            return @tr("Copyright 2026 Wizzo Pty Ltd and the Zaparoo Project contributors.\n\nThis free source-available build is for personal and non-commercial use only. Commercial use requires a separate license.\n\nContact: legal@zaparoo.com\n\nFull details available any time under Settings > About / License.\n\nCreated by\nAndrea Bogazzi, BossRighteous, Tim Wilsie, Wizzo");
        }
        if (kind == "core_version") {
            return @tr("This frontend needs Zaparoo Core {} or newer. You're running {}. Some features may not work until you update.", detail, arg);
        }
        if (kind == "first_run") {
            if (detail == "done") { return @tr("Done. {} files indexed.", arg); }
            return @tr("Zaparoo needs to scan your games before you can use the frontend. This usually takes a few minutes.");
        }
        if (kind == "hub_full") {
            return @tr("All categories and actions are already on the Hub. To add a game or system, open its Options menu and choose \"Add to Hub\".");
        }
        if (kind == "action_error") { return DialogLabels.error-body(detail, arg); }
        return "";
    }

    // The first-run scan's progress line.
    public pure function status(key: string, step: int, total: int, name: string) -> string {
        if (key == "preparing") { return @tr("Preparing…"); }
        if (key == "optimizing") { return @tr("Optimizing database - almost done"); }
        if (key == "paused") { return @tr("Indexing paused"); }
        if (key == "step") {
            if (name == "") { return @tr("Step {} of {}", step, total); }
            return @tr("Step {} of {} - {}", step, total, name);
        }
        return "";
    }

    public pure function button(key: string) -> string {
        if (key == "yes") { return @tr("Yes"); }
        if (key == "no") { return @tr("No"); }
        if (key == "ok") { return @tr("OK"); }
        if (key == "retry") { return @tr("Retry"); }
        if (key == "cancel") { return @tr("Cancel"); }
        if (key == "i_understand") { return @tr("I understand"); }
        if (key == "start_scan") { return @tr("Start scan"); }
        return key;
    }

    // A failed user action. The technical detail is already in the log;
    // these say what failed and what the user can do about it.
    public pure function error-title(kind: string) -> string {
        if (kind == "launch") { return @tr("Launch failed"); }
        if (kind == "favorite") { return @tr("Favorite update failed"); }
        if (kind == "add_to_hub") { return @tr("Add to Hub failed"); }
        if (kind == "media_index") { return @tr("Media update failed"); }
        if (kind == "media_scrape") { return @tr("Update metadata failed"); }
        if (kind == "media_scrapers") { return @tr("Source list unavailable"); }
        if (kind == "media_cancel") { return @tr("Cancel failed"); }
        if (kind == "launcher") { return @tr("Launcher update failed"); }
        if (kind == "alternate_discovery") { return @tr("Alternate versions unavailable"); }
        if (kind == "qr_code") { return @tr("QR code failed"); }
        if (kind == "card_write") { return @tr("Token write failed"); }
        if (kind == "setting") { return @tr("Setting not saved"); }
        return @tr("Action failed");
    }

    public pure function error-body(kind: string, context: string) -> string {
        if (kind == "launch") {
            if (context == "") { return @tr("Could not start this item. Check Zaparoo Core and try again."); }
            return @tr("Could not start {}. Check Zaparoo Core and try again.", context);
        }
        if (kind == "favorite") { return @tr("Could not update this favorite. Check Zaparoo Core and try again."); }
        if (kind == "add_to_hub") {
            if (context == "") { return @tr("Could not add this item to the Hub. Check Zaparoo Core and try again."); }
            return @tr("Could not add {} to the Hub. Check Zaparoo Core and try again.", context);
        }
        if (kind == "media_index") { return @tr("Could not start the media database update. Check Zaparoo Core and try again."); }
        if (kind == "media_scrape") { return @tr("Could not start updating metadata. Check Zaparoo Core and try again."); }
        if (kind == "media_scrapers") { return @tr("Could not load the list of metadata sources. Check Zaparoo Core and try again."); }
        if (kind == "media_cancel") { return @tr("Could not cancel the media operation. Check Zaparoo Core and try again."); }
        if (kind == "launcher") { return @tr("Could not change the launcher. Check Zaparoo Core and try again."); }
        if (kind == "alternate_discovery") { return @tr("Could not find alternate versions. Check Zaparoo Core and try again."); }
        if (kind == "qr_code") { return @tr("Could not create the QR code for this item."); }
        if (kind == "card_write") { return @tr("Could not write to this token. Check that it is writable and try again."); }
        if (kind == "setting") { return @tr("Could not save this setting. Try again."); }
        return @tr("The action could not be completed. Check Zaparoo Core and try again.");
    }
}
