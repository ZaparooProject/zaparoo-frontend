# Binary assets — prevent git from messing with them
*.png    binary
*.ttf    binary
*.otf    binary
*.ico    binary
*.icns   binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary

# Text files — enforce LF line endings everywhere
*.rs     text eol=lf
*.slint  text eol=lf
*.toml   text eol=lf
*.po     text eol=lf
*.pot    text eol=lf
*.hbs    text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.svg    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Diff hints
*.rs     diff=rust
